# Environnement jetable réservé aux captures vidéo.
# `make video-setup` le copie vers `.env.video.e2e`, qui reste local et gitignoré.

DATABASE_URL="postgresql://benevoles:benevoles@localhost:45433/benevoles_video"

ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="video-admin-password"
AUTH_SECRET=""
ADMIN_NOTIFICATION_EMAIL="video-fallback@localhost"
ORG_ADMIN_EMAIL="org-admin@localhost"
ORG_ADMIN_PASSWORD="video-org-admin-password"

SMTP_HOST="localhost"
SMTP_PORT="41026"
SMTP_SECURE="false"
SMTP_USER="video"
SMTP_PASSWORD="video"
EMAIL_FROM="Bénévoles vidéo <notifications@benevol.app>"

NEXT_PUBLIC_APP_URL="http://localhost:43100"
AUTH_URL="http://localhost:43100"
AUTH_TRUST_HOST="true"
