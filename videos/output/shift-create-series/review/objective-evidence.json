    {
      "scene": "duration",
      "startMs": 26357,
      "endMs": 43139,
      "sentences": [
        {
          "text": "La durée découpe la plage en équipes de deux heures.",
          "startMs": 364,
          "endMs": 3055,
          "method": "silence",
          "globalStartMs": 26721,
          "globalEndMs": 29412
        },
        {
          "text": "Le nombre de personnes s’applique à chaque créneau :",
          "startMs": 3806,
          "endMs": 5895,
          "method": "silence",
          "globalStartMs": 30163,
          "globalEndMs": 32252
        },
        {
          "text": "avec trois places, chaque relève accueille trois bénévoles.",
          "startMs": 6022,
          "endMs": 8422,
          "method": "silence",
          "globalStartMs": 32379,
          "globalEndMs": 34779
        },
        {
          "text": "La pause ajoute un intervalle entre deux relèves.",
          "startMs": 9175,
          "endMs": 11337,
          "method": "silence",
          "globalStartMs": 35532,
          "globalEndMs": 37694
        },
        {
          "text": "Ici, choisissons zéro minute :",
          "startMs": 11782,
          "endMs": 13337,
          "method": "silence",
          "globalStartMs": 38139,
          "globalEndMs": 39694
        },
        {
          "text": "les créneaux se suivent sans interruption, pour garder la buvette couverte.",
          "startMs": 13723,
          "endMs": 16386,
          "method": "silence",
          "globalStartMs": 40080,
          "globalEndMs": 42743
        }
      ],
