          "endMs": 6941,
          "method": "silence",
          "globalStartMs": 62423,
          "globalEndMs": 63521
        },
        {
          "text": "chacune possède son propre effectif et peut recevoir ses inscriptions.",
          "startMs": 7737,
          "endMs": 12173,
          "method": "silence",
          "globalStartMs": 64317,
          "globalEndMs": 68753
        }
      ],
