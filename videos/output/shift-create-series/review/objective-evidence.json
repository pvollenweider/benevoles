          "startMs": 4730,
          "endMs": 6543,
          "method": "silence",
          "globalStartMs": 74366,
          "globalEndMs": 76179
        },
        {
          "text": "faisons passer sa capacité de trois à quatre personnes.",
          "startMs": 6804,
          "endMs": 9463,
          "method": "silence",
          "globalStartMs": 76440,
          "globalEndMs": 79099
        },
        {
          "text": "Enregistrons.",
          "startMs": 10378,
          "endMs": 10863,
          "method": "silence",
          "globalStartMs": 80014,
          "globalEndMs": 80499
        },
        {
          "text": "Cette modification concerne seulement cette plage, pas ses voisines :",
          "startMs": 11605,
          "endMs": 14778,
          "method": "silence",
          "globalStartMs": 81241,
          "globalEndMs": 84414
        },
        {
          "text": "la série accélère le départ, sans enfermer le planning dans une règle rigide.",
          "startMs": 15432,
          "endMs": 18907,
          "method": "silence",
          "globalStartMs": 85068,
          "globalEndMs": 88543
        }
      ],
