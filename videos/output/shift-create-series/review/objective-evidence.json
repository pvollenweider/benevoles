    {
      "scene": "preview",
      "startMs": 43593,
      "endMs": 56126,
      "sentences": [
        {
          "text": "L’aperçu est la vérification essentielle :",
          "startMs": 382,
          "endMs": 2839,
          "method": "silence",
          "globalStartMs": 43975,
          "globalEndMs": 46432
        },
        {
          "text": "dix heures–midi, midi–quatorze heures, puis les relèves suivantes jusqu’à vingt-deux heures.",
          "startMs": 3349,
          "endMs": 7716,
          "method": "silence",
          "globalStartMs": 46942,
          "globalEndMs": 51309
        },
        {
          "text": "Si la plage ne se divise pas exactement, contrôlez le dernier créneau avant de confirmer.",
          "startMs": 8427,
          "endMs": 12122,
          "method": "silence",
          "globalStartMs": 52020,
          "globalEndMs": 55715
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
