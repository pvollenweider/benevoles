    {
      "scene": "adjust",
      "startMs": 69636,
      "endMs": 88914,
      "sentences": [
        {
          "text": "Après la création, passons en Liste et ouvrons un seul créneau.",
          "startMs": 432,
          "endMs": 4007,
          "method": "silence",
          "globalStartMs": 70068,
          "globalEndMs": 73643
        },
        {
