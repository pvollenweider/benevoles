      "scene": "welcome",
      "startMs": 1104,
      "endMs": 14003,
      "sentences": [
        {
          "text": "Créer une série est idéal lorsqu’un même poste doit être couvert toute la journée par équipes successives.",
          "startMs": 255,
          "endMs": 5435,
          "method": "silence",
          "globalStartMs": 1359,
          "globalEndMs": 6539
        },
        {
          "text": "Au lieu de saisir chaque plage séparément, on définit une règle commune, on contrôle l’aperçu, puis on crée tous les créneaux en une fois.",
          "startMs": 6176,
          "endMs": 12488,
          "method": "silence",
          "globalStartMs": 7280,
          "globalEndMs": 13592
        }
      ],
      "anchors": [
        {
          "segmentId": "welcome",
          "phrase": "Au lieu de saisir chaque",
