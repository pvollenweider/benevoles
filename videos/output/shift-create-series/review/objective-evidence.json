          "atMs": 7755
        }
      ]
    },
    {
      "scene": "range",
      "startMs": 14456,
      "endMs": 25904,
      "sentences": [
        {
          "text": "Choisissez le poste, la date et la plage globale à couvrir.",
          "startMs": 378,
          "endMs": 2228,
          "method": "silence",
          "globalStartMs": 14834,
          "globalEndMs": 16684
        },
        {
          "text": "Ici, la buvette fonctionne de dix heures à vingt-deux heures.",
          "startMs": 2406,
          "endMs": 3673,
          "method": "silence",
          "globalStartMs": 16862,
          "globalEndMs": 18129
        },
        {
          "text": "Cette plage décrit le besoin complet ;",
          "startMs": 4304,
          "endMs": 6589,
          "method": "silence",
          "globalStartMs": 18760,
          "globalEndMs": 21045
        },
        {
          "text": "elle ne signifie pas qu’une même personne doit rester douze heures.",
          "startMs": 7219,
          "endMs": 11082,
          "method": "silence",
          "globalStartMs": 21675,
          "globalEndMs": 25538
        }
      ],
