          "endMs": 3673,
          "method": "silence",
          "globalStartMs": 16856,
          "globalEndMs": 18123
        },
        {
          "text": "Cette plage décrit le besoin complet ;",
          "startMs": 4304,
          "endMs": 6589,
          "method": "silence",
          "globalStartMs": 18754,
          "globalEndMs": 21039
        },
        {
