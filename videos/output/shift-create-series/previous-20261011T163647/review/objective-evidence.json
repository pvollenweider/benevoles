      "scene": "preview",
      "startMs": 43585,
      "endMs": 56117,
      "sentences": [
        {
          "text": "L’aperçu est la vérification essentielle :",
          "startMs": 382,
          "endMs": 2839,
          "method": "silence",
          "globalStartMs": 43967,
          "globalEndMs": 46424
        },
        {
          "text": "dix heures–midi, midi–quatorze heures, puis les relèves suivantes jusqu’à vingt-deux heures.",
          "startMs": 3349,
          "endMs": 7716,
          "method": "silence",
          "globalStartMs": 46934,
          "globalEndMs": 51301
        },
        {
