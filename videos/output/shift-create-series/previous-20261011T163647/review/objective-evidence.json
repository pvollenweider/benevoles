    {
      "scene": "duration",
      "startMs": 26349,
      "endMs": 43132,
      "sentences": [
        {
          "text": "La durée découpe la plage en équipes de deux heures.",
          "startMs": 364,
          "endMs": 3055,
          "method": "silence",
          "globalStartMs": 26713,
          "globalEndMs": 29404
        },
        {
