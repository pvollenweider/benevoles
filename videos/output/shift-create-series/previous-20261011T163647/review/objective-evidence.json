          "endMs": 13337,
          "method": "silence",
          "globalStartMs": 38131,
          "globalEndMs": 39686
        },
        {
          "text": "les créneaux se suivent sans interruption, pour garder la buvette couverte.",
          "startMs": 13723,
          "endMs": 16386,
          "method": "silence",
          "globalStartMs": 40072,
          "globalEndMs": 42735
        }
