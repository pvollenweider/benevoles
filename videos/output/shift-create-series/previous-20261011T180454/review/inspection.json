  "chapters": [
    {
      "id": "welcome",
      "startMs": 1101,
      "endMs": 13999,
      "sentences": [
        {
          "text": "Créer une série est idéal lorsqu’un même poste doit être couvert toute la journée par équipes successives.",
          "startMs": 255,
          "endMs": 5435,
          "method": "silence",
          "absoluteStartS": 1.356,
          "absoluteEndS": 6.536
        },
        {
          "text": "Au lieu de saisir chaque plage séparément, on définit une règle commune, on contrôle l’aperçu, puis on crée tous les créneaux en une fois.",
          "startMs": 6176,
          "endMs": 12488,
          "method": "silence",
          "absoluteStartS": 7.277,
          "absoluteEndS": 13.589
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 7750
        }
      ]
    },
    {
      "id": "range",
      "startMs": 14452,
      "endMs": 25900,
      "sentences": [
        {
          "text": "Choisissez le poste, la date et la plage globale à couvrir.",
          "startMs": 378,
          "endMs": 2228,
          "method": "silence",
          "absoluteStartS": 14.83,
          "absoluteEndS": 16.68
        },
        {
          "text": "Ici, la buvette fonctionne de dix heures à vingt-deux heures.",
          "startMs": 2406,
          "endMs": 3673,
          "method": "silence",
          "absoluteStartS": 16.858,
          "absoluteEndS": 18.125
        },
        {
          "text": "Cette plage décrit le besoin complet ;",
          "startMs": 4304,
