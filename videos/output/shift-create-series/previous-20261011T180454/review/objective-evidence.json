    {
      "scene": "preview",
      "startMs": 43587,
      "endMs": 56119,
      "sentences": [
        {
          "text": "L’aperçu est la vérification essentielle :",
          "startMs": 382,
          "endMs": 2839,
          "method": "silence",
          "globalStartMs": 43969,
          "globalEndMs": 46426
        },
        {
          "text": "dix heures–midi, midi–quatorze heures, puis les relèves suivantes jusqu’à vingt-deux heures.",
          "startMs": 3349,
          "endMs": 7716,
          "method": "silence",
          "globalStartMs": 46936,
          "globalEndMs": 51303
        },
        {
          "text": "Si la plage ne se divise pas exactement, contrôlez le dernier créneau avant de confirmer.",
          "startMs": 8427,
          "endMs": 12122,
          "method": "silence",
          "globalStartMs": 52014,
          "globalEndMs": 55709
        }
