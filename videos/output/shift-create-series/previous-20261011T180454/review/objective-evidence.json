    {
      "scene": "duration",
      "startMs": 26353,
      "endMs": 43133,
      "sentences": [
        {
          "text": "La durée découpe la plage en équipes de deux heures.",
          "startMs": 364,
          "endMs": 3055,
          "method": "silence",
          "globalStartMs": 26717,
          "globalEndMs": 29408
        },
        {
          "text": "Le nombre de personnes s’applique à chaque créneau :",
          "startMs": 3806,
          "endMs": 5895,
          "method": "silence",
          "globalStartMs": 30159,
          "globalEndMs": 32248
        },
        {
          "text": "avec trois places, chaque relève accueille trois bénévoles.",
          "startMs": 6022,
          "endMs": 8422,
          "method": "silence",
          "globalStartMs": 32375,
          "globalEndMs": 34775
        },
        {
          "text": "La pause ajoute un intervalle entre deux relèves.",
          "startMs": 9175,
          "endMs": 11337,
          "method": "silence",
          "globalStartMs": 35528,
          "globalEndMs": 37690
        },
        {
          "text": "Ici, choisissons zéro minute :",
          "startMs": 11782,
          "endMs": 13337,
          "method": "silence",
          "globalStartMs": 38135,
          "globalEndMs": 39690
        },
        {
          "text": "les créneaux se suivent sans interruption, pour garder la buvette couverte.",
          "startMs": 13723,
          "endMs": 16386,
          "method": "silence",
          "globalStartMs": 40076,
          "globalEndMs": 42739
        }
      ],
