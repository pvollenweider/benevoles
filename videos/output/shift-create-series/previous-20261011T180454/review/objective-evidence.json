      "startMs": 56573,
      "endMs": 69177,
      "sentences": [
        {
          "text": "Créons la série.",
          "startMs": 414,
          "endMs": 1147,
          "method": "silence",
          "globalStartMs": 56987,
          "globalEndMs": 57720
        },
        {
          "text": "Les nouvelles barres apparaissent dans la Frise avec le même poste, la même capacité et des horaires consécutifs.",
          "startMs": 1855,
          "endMs": 5660,
          "method": "silence",
          "globalStartMs": 58428,
          "globalEndMs": 62233
        },
        {
          "text": "Elles restent pourtant indépendantes :",
