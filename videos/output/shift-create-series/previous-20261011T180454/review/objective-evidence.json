    {
      "scene": "adjust",
      "startMs": 69628,
      "endMs": 88908,
      "sentences": [
        {
          "text": "Après la création, passons en Liste et ouvrons un seul créneau.",
          "startMs": 432,
          "endMs": 4007,
          "method": "silence",
          "globalStartMs": 70060,
          "globalEndMs": 73635
        },
        {
          "text": "La première relève a besoin de renfort :",
          "startMs": 4730,
          "endMs": 6543,
          "method": "silence",
          "globalStartMs": 74358,
          "globalEndMs": 76171
        },
        {
          "text": "faisons passer sa capacité de trois à quatre personnes.",
          "startMs": 6804,
          "endMs": 9463,
          "method": "silence",
          "globalStartMs": 76432,
          "globalEndMs": 79091
        },
        {
          "text": "Enregistrons.",
          "startMs": 10378,
          "endMs": 10863,
          "method": "silence",
          "globalStartMs": 80006,
          "globalEndMs": 80491
        },
        {
          "text": "Cette modification concerne seulement cette plage, pas ses voisines :",
          "startMs": 11605,
          "endMs": 14778,
          "method": "silence",
          "globalStartMs": 81233,
          "globalEndMs": 84406
        },
        {
          "text": "la série accélère le départ, sans enfermer le planning dans une règle rigide.",
          "startMs": 15432,
          "endMs": 18907,
          "method": "silence",
          "globalStartMs": 85060,
          "globalEndMs": 88535
        }
      ],
