          "atMs": 7750
        }
      ]
    },
    {
      "scene": "range",
      "startMs": 14452,
      "endMs": 25900,
      "sentences": [
        {
          "text": "Choisissez le poste, la date et la plage globale à couvrir.",
          "startMs": 378,
          "endMs": 2228,
          "method": "silence",
          "globalStartMs": 14830,
          "globalEndMs": 16680
        },
        {
          "text": "Ici, la buvette fonctionne de dix heures à vingt-deux heures.",
          "startMs": 2406,
          "endMs": 3673,
          "method": "silence",
          "globalStartMs": 16858,
          "globalEndMs": 18125
        },
        {
          "text": "Cette plage décrit le besoin complet ;",
          "startMs": 4304,
          "endMs": 6589,
          "method": "silence",
          "globalStartMs": 18756,
          "globalEndMs": 21041
        },
        {
          "text": "elle ne signifie pas qu’une même personne doit rester douze heures.",
