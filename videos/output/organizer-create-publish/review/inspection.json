          "kind": "click",
          "atMs": 19488
        }
      ]
    },
    {
      "id": "series",
      "startMs": 23307,
      "endMs": 38392,
      "sentences": [
        {
          "text": "Les postes et leurs créneaux peuvent être ajoutés un par un, manuellement.",
          "startMs": 569,
          "endMs": 3957,
          "method": "silence",
          "absoluteStartS": 23.876,
          "absoluteEndS": 27.264
        },
        {
          "text": "Quand les horaires se répètent, la création en série va plus vite :",
          "startMs": 4762,
          "endMs": 7589,
          "method": "silence",
          "absoluteStartS": 28.069,
          "absoluteEndS": 30.896
        },
        {
          "text": "pour l’accueil, indique la plage horaire, la durée et la capacité, et les créneaux sont préparés automatiquement.",
          "startMs": 8332,
          "endMs": 14506,
          "method": "silence",
          "absoluteStartS": 31.639,
          "absoluteEndS": 37.813
        }
      ],
