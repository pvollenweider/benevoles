  "chapters": [
    {
      "id": "overview",
      "startMs": 0,
      "endMs": 12977,
      "sentences": [
        {
          "text": "Voici comment préparer et partager un planning bénévole.",
          "startMs": 141,
          "endMs": 3520,
          "method": "silence",
          "absoluteStartS": 0.141,
          "absoluteEndS": 3.52
        },
        {
          "text": "Pour démarrer, tu peux choisir un modèle déjà prêt, avec ses postes et ses horaires, ou partir d’une page blanche.",
          "startMs": 3708,
          "endMs": 9913,
          "method": "silence",
          "absoluteStartS": 3.708,
          "absoluteEndS": 9.913
        },
        {
          "text": "Ici, on va tout créer depuis le début.",
          "startMs": 10497,
          "endMs": 12508,
          "method": "silence",
          "absoluteStartS": 10.497,
          "absoluteEndS": 12.508
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 3089
        },
        {
          "kind": "click",
          "atMs": 5088
        }
      ]
    },
    {
      "id": "basics",
      "startMs": 13430,
      "endMs": 22853,
      "sentences": [
        {
          "text": "Donne-lui un nom clair, ajoute une courte description, le lieu et les dates.",
          "startMs": 472,
          "endMs": 4611,
          "method": "silence",
          "absoluteStartS": 13.902,
          "absoluteEndS": 18.041
        },
        {
          "text": "L’événement reste en brouillon :",
          "startMs": 4772,
          "endMs": 4774,
          "method": "silence",
          "absoluteStartS": 18.202,
          "absoluteEndS": 18.204
        },
        {
          "text": "rien n’est visible tant que tu n’as pas terminé ton planning.",
          "startMs": 5411,
          "endMs": 8907,
          "method": "silence",
          "absoluteStartS": 18.841,
          "absoluteEndS": 22.337
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 14405
        },
        {
          "kind": "click",
          "atMs": 15422
        },
        {
          "kind": "click",
