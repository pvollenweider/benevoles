    {
      "id": "review",
      "startMs": 76545,
      "endMs": 86646,
      "sentences": [
        {
          "text": "L’écran de vérification résume maintenant les trois postes, les quatre créneaux et toutes les places.",
          "startMs": 544,
          "endMs": 5514,
          "method": "silence",
          "absoluteStartS": 77.089,
          "absoluteEndS": 82.059
        },
        {
          "text": "Tu peux encore revenir corriger un horaire, un effectif ou une consigne.",
