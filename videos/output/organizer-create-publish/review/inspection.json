    {
      "id": "delivery",
      "startMs": 38846,
      "endMs": 51677,
      "sentences": [
        {
          "text": "Ajoute ensuite manuellement un poste Livraison.",
          "startMs": 581,
          "endMs": 2911,
          "method": "silence",
          "absoluteStartS": 39.427,
          "absoluteEndS": 41.757
        },
        {
          "text": "Il faut avoir au moins dix-huit ans et posséder un permis B valide.",
