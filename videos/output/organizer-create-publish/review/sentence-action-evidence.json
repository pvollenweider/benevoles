  {
    "id": "overview",
    "startMs": 0,
    "sentences": [
      {
        "text": "Voici comment préparer et partager un planning bénévole.",
        "startMs": 141,
        "endMs": 3520,
        "method": "silence",
        "absoluteStartMs": 141
      },
      {
        "text": "Pour démarrer, tu peux choisir un modèle déjà prêt, avec ses postes et ses horaires, ou partir d’une page blanche.",
