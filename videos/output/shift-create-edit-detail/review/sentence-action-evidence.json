  {
    "chapter": "practical",
    "startMs": 52548,
    "endMs": 79767,
    "sentences": [
      {
        "text": "Renseignons d'abord le lieu de rendez-vous :",
        "startMs": 293,
        "endMs": 3344,
        "method": "silence",
        "absoluteStartMs": 52841
      },
      {
        "text": "entrée artistes, portail nord.",
        "startMs": 3529,
        "endMs": 4649,
        "method": "silence",
        "absoluteStartMs": 56077
      },
      {
        "text": "Ajoutons une consigne :",
        "startMs": 5248,
        "endMs": 6139,
        "method": "silence",
        "absoluteStartMs": 57796
      },
      {
        "text": "venir dix minutes avant avec des chaussures fermées.",
        "startMs": 6694,
        "endMs": 9120,
        "method": "silence",
        "absoluteStartMs": 59242
      },
      {
        "text": "Le contact opérationnel indique qui appeler sur place :",
        "startMs": 9694,
        "endMs": 12978,
        "method": "silence",
        "absoluteStartMs": 62242
      },
      {
        "text": "ici Léa, accueil artistes, et son téléphone de démonstration.",
        "startMs": 13340,
        "endMs": 15875,
        "method": "silence",
        "absoluteStartMs": 65888
      },
      {
        "text": "Les coordonnées GPS placent ce rendez-vous sur la carte.",
        "startMs": 16134,
        "endMs": 20831,
        "method": "silence",
        "absoluteStartMs": 68682
      },
      {
        "text": "Si un créneau n'a pas de lieu propre, il reprend celui de l'événement.",
        "startMs": 21006,
        "endMs": 24317,
        "method": "silence",
        "absoluteStartMs": 73554
      },
      {
        "text": "Ces détails seront visibles aux personnes inscrites.",
        "startMs": 24690,
        "endMs": 26989,
        "method": "silence",
        "absoluteStartMs": 77238
      }
    ],
