  {
    "chapter": "availability",
    "startMs": 36126,
    "endMs": 50283,
    "sentences": [
      {
        "text": "Deux options complètent le fonctionnement du créneau.",
        "startMs": 197,
        "endMs": 3650,
        "method": "silence",
        "absoluteStartMs": 36323
      },
      {
        "text": "La liste d’attente recueille les volontaires quand toutes les places sont prises.",
