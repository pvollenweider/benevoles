[
  {
    "chapter": "welcome",
    "startMs": 1109,
    "endMs": 16261,
    "sentences": [
      {
        "text": "Un créneau transforme un poste en besoin concret.",
        "startMs": 0,
        "endMs": 3100,
        "method": "silence",
        "absoluteStartMs": 1109
      },
      {
        "text": "Il dit quelle mission doit être assurée, quand, par combien de personnes et avec quelles informations pratiques.",
        "startMs": 3316,
        "endMs": 9972,
        "method": "silence",
        "absoluteStartMs": 4425
      },
      {
        "text": "Prenons le temps de parcourir chaque champ et son résultat côté bénévole.",
        "startMs": 10306,
        "endMs": 14962,
        "method": "silence",
        "absoluteStartMs": 11415
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "identity",
    "startMs": 18521,
    "endMs": 33867,
    "sentences": [
      {
        "text": "Choisissez d’abord le poste et, si nécessaire, un libellé plus précis.",
        "startMs": 189,
        "endMs": 4602,
        "method": "silence",
        "absoluteStartMs": 18710
      },
      {
        "text": "La date, l’heure de début et l’heure de fin placent la barre dans le planning.",
        "startMs": 4898,
        "endMs": 9526,
        "method": "silence",
        "absoluteStartMs": 23419
      },
      {
        "text": "La capacité indique combien de personnes peuvent être confirmées sur cette plage.",
        "startMs": 9867,
        "endMs": 15196,
        "method": "silence",
        "absoluteStartMs": 28388
      }
    ],
