  {
    "chapter": "save",
    "startMs": 82027,
    "endMs": 95745,
    "sentences": [
      {
        "text": "Enregistrons le créneau et vérifions sa place dans le planning.",
        "startMs": 241,
        "endMs": 3887,
        "method": "silence",
        "absoluteStartMs": 82268
      },
      {
        "text": "Le libellé complète le nom du poste sans le remplacer, la capacité apparaît dans les indicateurs et la fiche détaillée rassemble les consignes utiles au jour J.",
        "startMs": 4336,
        "endMs": 13483,
        "method": "silence",
        "absoluteStartMs": 86363
      }
    ],
