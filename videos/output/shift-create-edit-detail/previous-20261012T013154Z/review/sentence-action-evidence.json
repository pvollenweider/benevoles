  {
    "chapter": "change",
    "startMs": 98003,
    "endMs": 116197,
    "sentences": [
      {
        "text": "Dans la liste, le statut indique si les inscriptions sont ouvertes, fermées ou si le créneau est annulé.",
        "startMs": 341,
        "endMs": 5288,
        "method": "silence",
        "absoluteStartMs": 98344
      },
      {
        "text": "Rouvrir l’éditeur permet de corriger l’horaire et les informations pratiques.",
        "startMs": 5806,
        "endMs": 9996,
        "method": "silence",
        "absoluteStartMs": 103809
      },
      {
        "text": "Pour un créneau déjà occupé, relisez toujours le nouveau jour, les heures et le rendez-vous avant de confirmer et de prévenir les bénévoles.",
        "startMs": 10502,
        "endMs": 17865,
        "method": "silence",
        "absoluteStartMs": 108505
      }
    ],
    "anchors": [
      {
        "segmentId": "change",
        "phrase": "Rouvrir l’éditeur permet de corriger",
        "startMs": 5806,
        "endMs": 9996,
        "cueMs": 103811
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 99639
      },
      {
        "kind": "click",
        "atMs": 104289
      }
    ]
  },
  {
    "chapter": "result",
    "startMs": 118458,
    "endMs": 134163,
    "sentences": [
      {
        "text": "Un bon créneau reste court à lire mais complet pour agir :",
        "startMs": 327,
        "endMs": 4352,
        "method": "silence",
        "absoluteStartMs": 118785
      },
      {
        "text": "mission, horaire, capacité, lieu et consigne.",
        "startMs": 4902,
        "endMs": 7499,
        "method": "silence",
        "absoluteStartMs": 123360
      },
      {
        "text": "Plus ces informations sont fiables, moins l’équipe doit répondre aux mêmes questions par email ou par téléphone.",
        "startMs": 8121,
        "endMs": 15493,
        "method": "silence",
        "absoluteStartMs": 126579
      }
    ],
    "anchors": [],
    "interactions": []
  }
]