  "sentences": [
    {
      "scene": "welcome",
      "startMs": 1094,
      "endMs": 19151,
      "sentences": [
        {
          "text": "Dans Paramètres, Emails, le propriétaire choisit les messages utiles pour toute l’organisation.",
          "startMs": 292,
          "endMs": 5678,
          "method": "silence",
          "globalStartMs": 1386,
          "globalEndMs": 6772
        },
        {
          "text": "Les organisateurs peuvent suivre les envois, mais pas changer ces réglages.",
          "startMs": 6378,
          "endMs": 10273,
          "method": "silence",
          "globalStartMs": 7472,
          "globalEndMs": 11367
        },
        {
          "text": "Voyons les rappels, les alertes et l’adresse de réponse, puis vérifions un vrai message de test, sans contacter les bénévoles.",
          "startMs": 10614,
          "endMs": 17795,
          "method": "silence",
          "globalStartMs": 11708,
          "globalEndMs": 18889
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "reminders",
      "startMs": 21310,
      "endMs": 39295,
      "sentences": [
        {
          "text": "Vous pouvez activer le rappel à deux jours, à un jour, puis le jour même, deux à quatre heures avant le premier créneau de la journée.",
          "startMs": 350,
          "endMs": 7131,
          "method": "silence",
          "globalStartMs": 21660,
          "globalEndMs": 28441
        },
        {
          "text": "Décochons puis recochons le premier rappel.",
          "startMs": 7808,
          "endMs": 9706,
          "method": "silence",
          "globalStartMs": 29118,
          "globalEndMs": 31016
        },
        {
          "text": "Pour une personne sur plusieurs créneaux du même événement le même jour, chaque rappel regroupe ses créneaux dans un seul email, pas un email par créneau.",
          "startMs": 10187,
          "endMs": 17697,
          "method": "silence",
          "globalStartMs": 31497,
          "globalEndMs": 39007
        }
      ],
      "anchors": [
        {
          "segmentId": "reminders",
          "phrase": "Décochons puis recochons le premier rappel",
          "startMs": 7808,
          "endMs": 9706,
          "cueMs": 29118
        },
        {
          "segmentId": "reminders",
          "phrase": "Décochons puis recochons le premier rappel",
          "startMs": 7808,
          "endMs": 9706,
          "cueMs": 29904
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 29601
        },
        {
          "kind": "click",
          "atMs": 31053
        }
      ]
    },
    {
      "scene": "event-reminders",
      "startMs": 39748,
      "endMs": 57138,
      "sentences": [
        {
          "text": "Dans les réglages d’un événement, la case Rappels automatiques peut couper tous ses rappels, sans changer les autres événements.",
          "startMs": 284,
          "endMs": 6990,
          "method": "silence",
          "globalStartMs": 40032,
          "globalEndMs": 46738
        },
        {
          "text": "Sa section Communications indique ce qui partira vraiment.",
          "startMs": 7120,
          "endMs": 10177,
          "method": "silence",
          "globalStartMs": 46868,
          "globalEndMs": 49925
        },
        {
          "text": "Un brouillon n’envoie pas de rappel.",
          "startMs": 10752,
          "endMs": 12025,
          "method": "silence",
          "globalStartMs": 50500,
          "globalEndMs": 51773
        },
        {
          "text": "Pour un événement publié, les rappels suivent les choix de l’organisation et son fuseau horaire.",
          "startMs": 12291,
          "endMs": 17388,
          "method": "silence",
          "globalStartMs": 52039,
          "globalEndMs": 57136
        }
      ],
      "anchors": [
        {
          "segmentId": "event-reminders",
          "phrase": "Sa section Communications",
          "startMs": 7120,
          "endMs": 10177,
          "cueMs": 47228
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 43542
        },
        {
          "kind": "click",
          "atMs": 46308
        }
      ]
    },
    {
      "scene": "admin-alert",
      "startMs": 57591,
      "endMs": 71770,
      "sentences": [
        {
          "text": "L’option Prévenir les administrateurs à chaque inscription envoie un email à chaque administrateur actif lorsqu’une personne s’inscrit depuis la page publique.",
          "startMs": 238,
          "endMs": 7867,
          "method": "silence",
          "globalStartMs": 57829,
          "globalEndMs": 65458
        },
        {
          "text": "Elle facilite le suivi d’un petit événement, mais peut devenir bruyante lorsque les inscriptions sont nombreuses.",
          "startMs": 8417,
          "endMs": 14179,
          "method": "silence",
          "globalStartMs": 66008,
          "globalEndMs": 71770
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 62320
        },
        {
          "kind": "click",
          "atMs": 66869
        }
      ]
    },
    {
      "scene": "withdrawal",
      "startMs": 72223,
      "endMs": 91532,
      "sentences": [
        {
          "text": "Prévenir en cas de désistement est un réglage séparé.",
          "startMs": 0,
          "endMs": 2810,
          "method": "silence",
          "globalStartMs": 72223,
          "globalEndMs": 75033
        },
        {
          "text": "Il informe les administrateurs et les responsables du poste quand une place confirmée ou une demande est annulée, avec les places manquantes et le mot éventuel du bénévole.",
          "startMs": 2987,
          "endMs": 10785,
          "method": "silence",
          "globalStartMs": 75210,
          "globalEndMs": 83008
        },
        {
          "text": "Décocher cette option coupe aussi l’email aux responsables.",
          "startMs": 11550,
          "endMs": 14715,
          "method": "silence",
          "globalStartMs": 83773,
          "globalEndMs": 86938
        },
        {
          "text": "Quitter une liste d’attente ou refuser une place proposée n’envoie pas cette alerte.",
          "startMs": 14935,
          "endMs": 19183,
          "method": "silence",
          "globalStartMs": 87158,
          "globalEndMs": 91406
        }
      ],
      "anchors": [
        {
          "segmentId": "withdrawal",
          "phrase": "Décocher cette option coupe aussi",
          "startMs": 11550,
          "endMs": 14715,
          "cueMs": 83777
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 84572
        },
        {
          "kind": "click",
          "atMs": 86985
        }
      ]
    },
    {
      "scene": "addresses",
      "startMs": 91985,
      "endMs": 109833,
      "sentences": [
        {
          "text": "Le résumé quotidien des adresses à vérifier aide à repérer les problèmes de contact.",
          "startMs": 140,
          "endMs": 4349,
          "method": "silence",
          "globalStartMs": 92125,
          "globalEndMs": 96334
        },
        {
          "text": "Il part seulement si une confirmation, une proposition de place ou un rappel a échoué définitivement depuis la veille.",
          "startMs": 4509,
          "endMs": 10277,
          "method": "silence",
          "globalStartMs": 96494,
          "globalEndMs": 102262
        },
        {
          "text": "Un incident temporaire seul ne le déclenche pas.",
          "startMs": 10858,
          "endMs": 12746,
          "method": "silence",
          "globalStartMs": 102843,
          "globalEndMs": 104731
        },
        {
          "text": "L’équipe reçoit au maximum un résumé par jour, même après plusieurs échecs.",
          "startMs": 13438,
          "endMs": 17549,
          "method": "silence",
          "globalStartMs": 105423,
          "globalEndMs": 109534
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 99235
        },
        {
          "kind": "click",
          "atMs": 105300
        }
      ]
    },
    {
      "scene": "reply-to",
      "startMs": 112013,
      "endMs": 128064,
      "sentences": [
        {
          "text": "L’adresse de réponse indique où arrive un message lorsqu’un bénévole répond à un email de la plateforme.",
          "startMs": 288,
          "endMs": 5558,
          "method": "silence",
          "globalStartMs": 112301,
          "globalEndMs": 117571
        },
        {
          "text": "Saisissons benevoles arobase example point org.",
          "startMs": 5894,
          "endMs": 8857,
          "method": "silence",
          "globalStartMs": 117907,
          "globalEndMs": 120870
        },
        {
          "text": "Si le champ reste vide, l’adresse par défaut est utilisée.",
          "startMs": 9163,
          "endMs": 12051,
          "method": "silence",
          "globalStartMs": 121176,
          "globalEndMs": 124064
        },
        {
          "text": "Cette adresse apparaît aussi sur la page personnelle des bénévoles.",
          "startMs": 12651,
          "endMs": 15695,
          "method": "silence",
          "globalStartMs": 124664,
          "globalEndMs": 127708
        }
      ],
