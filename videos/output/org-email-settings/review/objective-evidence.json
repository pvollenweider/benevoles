    {
      "scene": "result",
      "startMs": 166157,
      "endMs": 183690,
      "sentences": [
        {
          "text": "Les réglages sont enregistrés et le message de test est visible dans la boîte de démonstration.",
          "startMs": 363,
          "endMs": 5687,
          "method": "silence",
          "globalStartMs": 166520,
          "globalEndMs": 171844
        },
        {
          "text": "Dans Emails envoyés, Envoyé indique une acceptation par le serveur d’envoi, pas une preuve de remise ni de lecture par le bénévole.",
          "startMs": 6065,
          "endMs": 12925,
          "method": "silence",
          "globalStartMs": 172222,
          "globalEndMs": 179082
        },
        {
          "text": "Pour écrire ponctuellement à un groupe, utilisez plutôt les messages ciblés de l’événement.",
          "startMs": 13231,
          "endMs": 17235,
          "method": "silence",
          "globalStartMs": 179388,
          "globalEndMs": 183392
        }
      ],
