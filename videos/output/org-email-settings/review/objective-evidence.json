    {
      "scene": "save",
      "startMs": 128516,
      "endMs": 143829,
      "sentences": [
        {
          "text": "Enregistrez les réglages avant de les tester.",
          "startMs": 345,
          "endMs": 2497,
          "method": "silence",
          "globalStartMs": 128861,
          "globalEndMs": 131013
        },
        {
          "text": "Le message Réglages enregistrés confirme que vos choix sont conservés.",
          "startMs": 2911,
          "endMs": 6875,
          "method": "silence",
          "globalStartMs": 131427,
          "globalEndMs": 135391
        },
        {
          "text": "Modifier les cases sans enregistrer ne change pas les prochains envois.",
          "startMs": 7620,
          "endMs": 10599,
          "method": "silence",
          "globalStartMs": 136136,
          "globalEndMs": 139115
        },
        {
          "text": "Le test utilise lui aussi la dernière configuration enregistrée.",
          "startMs": 10954,
          "endMs": 15311,
          "method": "silence",
          "globalStartMs": 139470,
          "globalEndMs": 143827
        }
      ],
