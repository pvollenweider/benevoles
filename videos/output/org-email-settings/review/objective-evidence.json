    {
      "scene": "test",
      "startMs": 145991,
      "endMs": 165704,
      "sentences": [
        {
          "text": "M’envoyer un email de test envoie un exemple à votre propre compte, pas aux bénévoles.",
          "startMs": 0,
          "endMs": 4167,
          "method": "silence",
          "globalStartMs": 145991,
          "globalEndMs": 150158
        },
        {
          "text": "Ouvrons le message reçu dans la boîte locale de démonstration.",
          "startMs": 4624,
          "endMs": 7474,
          "method": "silence",
          "globalStartMs": 150615,
          "globalEndMs": 153465
        },
        {
          "text": "Vérifiez l’expéditeur et l’adresse de réponse, ici benevoles arobase example point org, puis le contenu du message.",
          "startMs": 7784,
          "endMs": 14809,
          "method": "silence",
          "globalStartMs": 153775,
          "globalEndMs": 160800
        },
        {
          "text": "Dans cette formation, les emails restent sur notre serveur local et ne partent pas sur Internet.",
          "startMs": 15228,
          "endMs": 19396,
          "method": "silence",
          "globalStartMs": 161219,
          "globalEndMs": 165387
        }
      ],
      "anchors": [
        {
          "segmentId": "test",
          "phrase": "M’envoyer un email de test",
          "startMs": 0,
          "endMs": 4167,
          "cueMs": 146114
        },
        {
