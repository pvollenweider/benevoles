    "startMs": 62440,
    "sentences": [
      {
        "text": "Le fichier est prêt à être ouvert dans ton application de calendrier.",
        "startMs": 562,
        "endMs": 3123,
        "method": "silence",
        "absoluteStartMs": 63002
      },
