    {
      "chapter": "empty",
      "startSeconds": 51.109,
      "endSeconds": 74.767,
      "sentences": [
        {
          "text": "Postes sans personne attire l'attention sur un poste entièrement vide.",
          "startMs": 484,
          "endMs": 4405,
          "method": "silence",
          "videoSeconds": 51.593
        },
        {
          "text": "Ici, Photos comporte deux créneaux et six places à pourvoir.",
          "startMs": 4858,
          "endMs": 8684,
          "method": "silence",
          "videoSeconds": 55.967
        },
        {
          "text": "Cliquez sur le poste pour retrouver le planning et vérifier les dates, les horaires et la mission.",
          "startMs": 9090,
          "endMs": 15302,
          "method": "silence",
          "videoSeconds": 60.199
        },
        {
          "text": "Avant de recruter, assurez-vous que la demande est claire :",
          "startMs": 16076,
          "endMs": 19106,
          "method": "silence",
          "videoSeconds": 67.185
        },
        {
          "text": "quelqu'un doit comprendre ce qu'il fera, où et pendant combien de temps.",
