      "chapter": "requests",
      "startSeconds": 103.253,
      "endSeconds": 127.131,
      "sentences": [
        {
          "text": "Les demandes à traiter gardent leur place pendant la décision.",
          "startMs": 469,
          "endMs": 3681,
          "method": "silence",
          "videoSeconds": 103.722
        },
        {
          "text": "À la navette, deux demandes remplissent donc les deux places réservées, même si aucune n'est encore confirmée.",
          "startMs": 3903,
          "endMs": 9172,
          "method": "silence",
          "videoSeconds": 107.156
        },
        {
          "text": "Le rapport ne les présente pas comme deux places manquantes.",
          "startMs": 9521,
          "endMs": 12883,
          "method": "silence",
          "videoSeconds": 112.774
        },
        {
          "text": "Suivez le lien des demandes pour retrouver Lucas et Marc, puis examinez leurs informations avant de décider.",
          "startMs": 13011,
          "endMs": 18970,
          "method": "silence",
          "videoSeconds": 116.264
        },
        {
          "text": "La confirmation et la demande en attente restent deux situations différentes.",
