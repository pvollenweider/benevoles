    {
      "chapter": "full",
      "startSeconds": 176.396,
      "endSeconds": 200.131,
      "sentences": [
        {
          "text": "Créneaux complets rassemble les horaires sans besoin supplémentaire et sans liste d'attente.",
          "startMs": 307,
          "endMs": 5169,
          "method": "silence",
          "videoSeconds": 176.703
        },
        {
          "text": "L'accueil de midi est rempli par des inscriptions confirmées.",
          "startMs": 5558,
          "endMs": 8491,
          "method": "silence",
          "videoSeconds": 181.954
        },
        {
          "text": "La navette, elle, reste complète grâce aux demandes qui gardent leur place.",
          "startMs": 9290,
          "endMs": 12892,
          "method": "silence",
          "videoSeconds": 185.686
        },
        {
          "text": "Lisez donc aussi les mentions de statut, pas seulement le ratio.",
          "startMs": 13228,
          "endMs": 17784,
          "method": "silence",
          "videoSeconds": 189.624
        },
        {
          "text": "Être complet ne signifie ni que tout le monde est présent, ni que toutes les décisions ont déjà été prises.",
          "startMs": 18024,
          "endMs": 23395,
          "method": "silence",
          "videoSeconds": 194.42
        }
      ],
      "anchors": [],
      "interactions": [],
