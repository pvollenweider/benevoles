      "chapter": "waiting",
      "startSeconds": 127.582,
      "endSeconds": 151.643,
      "sentences": [
        {
          "text": "Dans Personnes en liste d'attente, vous repérez les horaires où des personnes attendent une place.",
          "startMs": 141,
          "endMs": 5675,
          "method": "silence",
          "videoSeconds": 127.723
        },
        {
          "text": "La buvette de l'après-midi affiche ses inscriptions confirmées et ses trois attentes séparément.",
          "startMs": 6215,
          "endMs": 10980,
          "method": "silence",
          "videoSeconds": 133.797
        },
        {
          "text": "En cliquant, vous retrouvez les noms et leurs positions dans la liste.",
          "startMs": 11536,
          "endMs": 14990,
          "method": "silence",
          "videoSeconds": 139.118
        },
        {
          "text": "Vous pouvez ensuite réfléchir à une place supplémentaire ou à un autre horaire ;",
          "startMs": 15770,
          "endMs": 19717,
          "method": "silence",
          "videoSeconds": 143.352
        },
        {
