    {
      "chapter": "overview",
      "startSeconds": 27.824,
      "endSeconds": 50.656,
      "sentences": [
        {
          "text": "En haut, les places pourvues sont les inscriptions confirmées, comparées à la capacité totale.",
          "startMs": 432,
          "endMs": 5753,
          "method": "silence",
          "videoSeconds": 28.256
        },
        {
          "text": "Une personne inscrite à deux horaires occupe deux places :",
          "startMs": 6177,
          "endMs": 9962,
          "method": "silence",
          "videoSeconds": 34.001
        },
        {
          "text": "ce n'est pas un compteur de personnes différentes.",
          "startMs": 10177,
          "endMs": 12284,
          "method": "silence",
          "videoSeconds": 38.001
        },
        {
          "text": "La phrase de besoin et la barre donnent un aperçu, mais lisez aussi les attentes et les demandes.",
          "startMs": 12794,
          "endMs": 18200,
          "method": "silence",
          "videoSeconds": 40.618
        },
        {
          "text": "Un bon chiffre global peut cacher un horaire où il manque encore quelqu'un.",
          "startMs": 18408,
          "endMs": 22352,
          "method": "silence",
          "videoSeconds": 46.232
        }
      ],
