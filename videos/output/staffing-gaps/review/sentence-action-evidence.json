    {
      "chapter": "welcome",
      "startSeconds": 0.198,
      "endSeconds": 27.399,
      "sentences": [
        {
          "text": "Des bénévoles se sont inscrits, mais certains horaires ont encore besoin d'aide.",
          "startMs": 291,
          "endMs": 5214,
          "method": "silence",
          "videoSeconds": 0.489
        },
        {
          "text": "Depuis l'événement, ouvrez Où manque-t-il du monde.",
          "startMs": 5336,
          "endMs": 8840,
          "method": "silence",
          "videoSeconds": 5.534
        },
        {
          "text": "Cette vue regroupe les besoins pour savoir où concentrer vos efforts, plutôt que de parcourir tout le planning.",
          "startMs": 9399,
          "endMs": 15882,
          "method": "silence",
          "videoSeconds": 9.597
        },
        {
          "text": "Notre fête contient des postes vides, des créneaux partiellement remplis, des attentes et des demandes à valider.",
          "startMs": 16020,
          "endMs": 23861,
          "method": "silence",
          "videoSeconds": 16.218
        },
        {
          "text": "Regardons comment lire ces différences.",
          "startMs": 24288,
          "endMs": 26768,
          "method": "silence",
          "videoSeconds": 24.486
        }
      ],
      "anchors": [
