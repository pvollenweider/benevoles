    {
      "chapter": "leaders",
      "startSeconds": 152.118,
      "endSeconds": 175.961,
      "sentences": [
        {
          "text": "Postes sans responsable de secteur est un autre besoin, facultatif cette fois.",
          "startMs": 346,
          "endMs": 4751,
          "method": "silence",
          "videoSeconds": 152.464
        },
        {
          "text": "Le poste peut avoir des bénévoles et manquer seulement d'un relais sur le terrain.",
          "startMs": 5039,
          "endMs": 9448,
          "method": "silence",
          "videoSeconds": 157.157
        },
        {
          "text": "Le lien ouvre la gestion des responsables.",
          "startMs": 9820,
          "endMs": 12361,
          "method": "silence",
          "videoSeconds": 161.938
        },
        {
          "text": "Ceux qui sont déjà nommés pour la buvette et l'accueil restent visibles.",
          "startMs": 13078,
          "endMs": 16150,
          "method": "silence",
          "videoSeconds": 165.196
        },
        {
          "text": "Leur rôle est de suivre leur équipe ;",
          "startMs": 16529,
          "endMs": 18312,
          "method": "silence",
          "videoSeconds": 168.647
        },
        {
          "text": "il ne leur donne pas automatiquement les droits d'un organisateur dans l'administration.",
          "startMs": 18793,
