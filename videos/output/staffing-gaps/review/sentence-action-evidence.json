    {
      "chapter": "needs",
      "startSeconds": 75.253,
      "endSeconds": 101.667,
      "sentences": [
        {
          "text": "Créneaux à compléter va du plus dégarni au plus proche du complet.",
          "startMs": 550,
          "endMs": 4416,
          "method": "silence",
          "videoSeconds": 75.803
        },
        {
          "text": "Chaque ligne indique la date, l'horaire, les places confirmées et le nombre manquant.",
          "startMs": 4853,
          "endMs": 9936,
          "method": "silence",
          "videoSeconds": 80.106
        },
        {
          "text": "Les créneaux fermés aux inscriptions sont exclus de ce groupe.",
          "startMs": 10630,
          "endMs": 13315,
          "method": "silence",
          "videoSeconds": 85.883
        },
        {
          "text": "Cliquons sur la buvette du soir :",
          "startMs": 13816,
          "endMs": 15809,
          "method": "silence",
          "videoSeconds": 89.069
        },
        {
          "text": "la liste des inscriptions s'ouvre déjà filtrée.",
          "startMs": 16123,
          "endMs": 18067,
          "method": "silence",
          "videoSeconds": 91.376
        },
        {
          "text": "Le lien Écrire à ce créneau prépare ensuite un message pour les personnes de cet horaire, pas pour recruter des inconnus.",
          "startMs": 18248,
          "endMs": 25945,
          "method": "silence",
          "videoSeconds": 93.501
        }
      ],
