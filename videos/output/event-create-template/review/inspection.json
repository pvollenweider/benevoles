    {
      "id": "adapt",
      "startMs": 84199,
      "endMs": 102745,
      "sentences": [
        {
          "text": "Dans le planning obtenu, chaque ligne est ordinaire.",
          "startMs": 463,
          "endMs": 2644,
          "method": "silence",
          "absoluteStartS": 84.662,
          "absoluteEndS": 86.843
        },
        {
          "text": "On peut renommer un poste, modifier son libellé, ses horaires, sa capacité, ses conditions ou sa couleur ;",
          "startMs": 3351,
          "endMs": 9608,
          "method": "silence",
          "absoluteStartS": 87.55,
          "absoluteEndS": 93.807
        },
        {
          "text": "on peut aussi supprimer un créneau inutile et en ajouter d’autres.",
          "startMs": 10419,
          "endMs": 12858,
          "method": "silence",
          "absoluteStartS": 94.618,
          "absoluteEndS": 97.057
        },
        {
          "text": "Ajustons par exemple la capacité de la première Buvette pour coller à la taille réelle de l’équipe.",
          "startMs": 13746,
          "endMs": 18093,
          "method": "silence",
          "absoluteStartS": 97.945,
          "absoluteEndS": 102.292
        }
