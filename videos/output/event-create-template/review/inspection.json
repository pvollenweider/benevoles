    {
      "id": "create",
      "startMs": 68602,
      "endMs": 82027,
      "sentences": [
        {
          "text": "Créer le brouillon génère ici dix créneaux et ouvre l’étape du planning.",
          "startMs": 532,
          "endMs": 4131,
          "method": "silence",
          "absoluteStartS": 69.134,
          "absoluteEndS": 72.733
        },
        {
          "text": "Le statut reste Brouillon.",
          "startMs": 4908,
          "endMs": 5988,
          "method": "silence",
          "absoluteStartS": 73.51,
          "absoluteEndS": 74.59
        },
        {
          "text": "Le modèle n’envoie aucun email et n’ouvre aucune inscription :",
          "startMs": 6505,
          "endMs": 9000,
          "method": "silence",
          "absoluteStartS": 75.107,
          "absoluteEndS": 77.602
        },
        {
          "text": "il fournit seulement une base de travail plus rapide à corriger qu’une page vide.",
          "startMs": 9148,
          "endMs": 12961,
          "method": "silence",
          "absoluteStartS": 77.75,
          "absoluteEndS": 81.563
        }
      ],
      "markers": [
