  "chapters": [
    {
      "id": "welcome",
      "startMs": 1,
      "endMs": 12103,
      "sentences": [
        {
          "text": "Un modèle fait gagner du temps quand l’événement ressemble à un cas courant.",
          "startMs": 280,
          "endMs": 3074,
          "method": "silence",
          "absoluteStartS": 0.281,
          "absoluteEndS": 3.075
        },
        {
          "text": "Il crée un brouillon avec des postes, des créneaux, des horaires et des capacités déjà cohérents.",
          "startMs": 3448,
          "endMs": 8336,
          "method": "silence",
          "absoluteStartS": 3.449,
          "absoluteEndS": 8.337
        },
        {
          "text": "Rien n’est publié automatiquement, et tout reste modifiable.",
          "startMs": 9081,
          "endMs": 11559,
          "method": "silence",
          "absoluteStartS": 9.082,
          "absoluteEndS": 11.56
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 3124
        }
      ]
    },
    {
      "id": "compare",
      "startMs": 14270,
      "endMs": 50842,
      "sentences": [
        {
          "text": "Pour un événement daté, cinq points de départ sont proposés.",
          "startMs": 541,
          "endMs": 3694,
          "method": "silence",
          "absoluteStartS": 14.811,
          "absoluteEndS": 17.964
        },
        {
          "text": "Festival couvre plusieurs soirées ;",
          "startMs": 3906,
          "endMs": 5843,
          "method": "silence",
          "absoluteStartS": 18.176,
          "absoluteEndS": 20.113
        },
        {
          "text": "Buvette organise le bar et la caisse sur une journée ;",
          "startMs": 6029,
          "endMs": 8427,
          "method": "silence",
          "absoluteStartS": 20.299,
          "absoluteEndS": 22.697
        },
        {
          "text": "Manifestation sportive prépare dossards, parcours et ravitaillement ;",
          "startMs": 9191,
          "endMs": 12665,
          "method": "silence",
          "absoluteStartS": 23.461,
          "absoluteEndS": 26.935
        },
        {
          "text": "Fête de village s’étale sur deux jours ;",
          "startMs": 13593,
          "endMs": 15350,
          "method": "silence",
          "absoluteStartS": 27.863,
          "absoluteEndS": 29.62
        },
        {
          "text": "Montage, exploitation, démontage sépare clairement les trois phases.",
          "startMs": 15788,
          "endMs": 19450,
          "method": "silence",
          "absoluteStartS": 30.058,
          "absoluteEndS": 33.72
        },
        {
          "text": "Pour une activité qui revient chaque semaine, quatre autres modèles préparent une saison de permanences :",
          "startMs": 20482,
          "endMs": 24565,
          "method": "silence",
          "absoluteStartS": 34.752,
          "absoluteEndS": 38.835
        },
        {
          "text": "épicerie participative, distribution alimentaire, permanence d’accueil et repair café.",
          "startMs": 25183,
          "endMs": 30319,
          "method": "silence",
          "absoluteStartS": 39.453,
          "absoluteEndS": 44.589
        },
        {
          "text": "Une vidéo dédiée les présente.",
          "startMs": 31117,
          "endMs": 32383,
          "method": "silence",
          "absoluteStartS": 45.387,
          "absoluteEndS": 46.653
        },
        {
          "text": "La page blanche reste préférable pour un format très particulier.",
          "startMs": 33469,
          "endMs": 36106,
          "method": "silence",
          "absoluteStartS": 47.739,
          "absoluteEndS": 50.376
        }
