    {
      "id": "preview",
      "startMs": 51294,
      "endMs": 68149,
      "sentences": [
        {
          "text": "Choisissons Fête de village.",
          "startMs": 465,
          "endMs": 2165,
          "method": "silence",
          "absoluteStartS": 51.759,
          "absoluteEndS": 53.459
        },
        {
          "text": "L’aperçu résume les postes, le nombre de créneaux et les places qui seront créées.",
          "startMs": 2796,
          "endMs": 6488,
          "method": "silence",
          "absoluteStartS": 54.09,
          "absoluteEndS": 57.782
        },
        {
          "text": "Avant de continuer, donnez un titre à cette édition et indiquez son premier jour ;",
          "startMs": 7368,
          "endMs": 11383,
          "method": "silence",
          "absoluteStartS": 58.662,
          "absoluteEndS": 62.677
        },
        {
          "text": "prenons le samedi vingt-et-un novembre.",
          "startMs": 11758,
          "endMs": 13303,
          "method": "silence",
          "absoluteStartS": 63.052,
          "absoluteEndS": 64.597
        },
        {
          "text": "Le deuxième jour est calculé automatiquement par le modèle.",
          "startMs": 14189,
          "endMs": 16324,
          "method": "silence",
          "absoluteStartS": 65.483,
          "absoluteEndS": 67.618
        }
