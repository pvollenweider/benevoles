    {
      "id": "create",
      "startMs": 68593,
      "endMs": 82025,
      "sentences": [
        {
          "text": "Créer le brouillon génère ici dix créneaux et ouvre l’étape du planning.",
          "startMs": 532,
          "endMs": 4131,
          "method": "silence",
          "absoluteStartS": 69.125,
          "absoluteEndS": 72.724
        },
        {
          "text": "Le statut reste Brouillon.",
          "startMs": 4908,
          "endMs": 5988,
          "method": "silence",
          "absoluteStartS": 73.501,
          "absoluteEndS": 74.581
        },
        {
          "text": "Le modèle n’envoie aucun email et n’ouvre aucune inscription :",
          "startMs": 6505,
          "endMs": 9000,
          "method": "silence",
          "absoluteStartS": 75.098,
          "absoluteEndS": 77.593
        },
        {
          "text": "il fournit seulement une base de travail plus rapide à corriger qu’une page vide.",
          "startMs": 9148,
          "endMs": 12961,
          "method": "silence",
          "absoluteStartS": 77.741,
          "absoluteEndS": 81.554
        }
      ],
      "markers": [
