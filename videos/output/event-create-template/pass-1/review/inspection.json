  "chapters": [
    {
      "id": "welcome",
      "startMs": 1,
      "endMs": 12100,
      "sentences": [
        {
          "text": "Un modèle fait gagner du temps quand l’événement ressemble à un cas courant.",
          "startMs": 280,
          "endMs": 3074,
          "method": "silence",
          "absoluteStartS": 0.281,
          "absoluteEndS": 3.075
        },
        {
          "text": "Il crée un brouillon avec des postes, des créneaux, des horaires et des capacités déjà cohérents.",
          "startMs": 3448,
          "endMs": 8336,
          "method": "silence",
          "absoluteStartS": 3.449,
          "absoluteEndS": 8.337
        },
        {
          "text": "Rien n’est publié automatiquement, et tout reste modifiable.",
          "startMs": 9081,
          "endMs": 11559,
          "method": "silence",
          "absoluteStartS": 9.082,
          "absoluteEndS": 11.56
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 3115
        }
      ]
    },
    {
      "id": "compare",
      "startMs": 14260,
      "endMs": 50833,
      "sentences": [
        {
          "text": "Pour un événement daté, cinq points de départ sont proposés.",
          "startMs": 541,
          "endMs": 3694,
          "method": "silence",
          "absoluteStartS": 14.801,
          "absoluteEndS": 17.954
        },
        {
          "text": "Festival couvre plusieurs soirées ;",
          "startMs": 3906,
          "endMs": 5843,
          "method": "silence",
          "absoluteStartS": 18.166,
          "absoluteEndS": 20.103
        },
        {
          "text": "Buvette organise le bar et la caisse sur une journée ;",
          "startMs": 6029,
          "endMs": 8427,
          "method": "silence",
          "absoluteStartS": 20.289,
          "absoluteEndS": 22.687
        },
        {
          "text": "Manifestation sportive prépare dossards, parcours et ravitaillement ;",
          "startMs": 9191,
          "endMs": 12665,
          "method": "silence",
          "absoluteStartS": 23.451,
          "absoluteEndS": 26.925
        },
        {
          "text": "Fête de village s’étale sur deux jours ;",
          "startMs": 13593,
          "endMs": 15350,
          "method": "silence",
          "absoluteStartS": 27.853,
          "absoluteEndS": 29.61
        },
        {
          "text": "Montage, exploitation, démontage sépare clairement les trois phases.",
          "startMs": 15788,
          "endMs": 19450,
          "method": "silence",
          "absoluteStartS": 30.048,
          "absoluteEndS": 33.71
        },
        {
          "text": "Pour une activité qui revient chaque semaine, quatre autres modèles préparent une saison de permanences :",
          "startMs": 20482,
          "endMs": 24565,
          "method": "silence",
          "absoluteStartS": 34.742,
          "absoluteEndS": 38.825
        },
        {
          "text": "épicerie participative, distribution alimentaire, permanence d’accueil et repair café.",
          "startMs": 25183,
          "endMs": 30319,
          "method": "silence",
          "absoluteStartS": 39.443,
          "absoluteEndS": 44.579
        },
        {
          "text": "Une vidéo dédiée les présente.",
          "startMs": 31117,
          "endMs": 32383,
          "method": "silence",
          "absoluteStartS": 45.377,
          "absoluteEndS": 46.643
        },
        {
          "text": "La page blanche reste préférable pour un format très particulier.",
          "startMs": 33469,
          "endMs": 36106,
          "method": "silence",
          "absoluteStartS": 47.729,
          "absoluteEndS": 50.366
        }
