    {
      "id": "preview",
      "startMs": 51286,
      "endMs": 68142,
      "sentences": [
        {
          "text": "Choisissons Fête de village.",
          "startMs": 465,
          "endMs": 2165,
          "method": "silence",
          "absoluteStartS": 51.751,
          "absoluteEndS": 53.451
        },
        {
          "text": "L’aperçu résume les postes, le nombre de créneaux et les places qui seront créées.",
          "startMs": 2796,
          "endMs": 6488,
          "method": "silence",
          "absoluteStartS": 54.082,
          "absoluteEndS": 57.774
        },
        {
          "text": "Avant de continuer, donnez un titre à cette édition et indiquez son premier jour ;",
          "startMs": 7368,
          "endMs": 11383,
          "method": "silence",
          "absoluteStartS": 58.654,
          "absoluteEndS": 62.669
        },
        {
          "text": "prenons le samedi vingt-et-un novembre.",
          "startMs": 11758,
          "endMs": 13303,
          "method": "silence",
          "absoluteStartS": 63.044,
          "absoluteEndS": 64.589
        },
        {
          "text": "Le deuxième jour est calculé automatiquement par le modèle.",
          "startMs": 14189,
          "endMs": 16324,
          "method": "silence",
          "absoluteStartS": 65.475,
          "absoluteEndS": 67.61
        }
