[
  {
    "chapter": "welcome",
    "startMs": 1144,
    "endMs": 15956,
    "sentences": [
      {
        "text": "Fermer les inscriptions, archiver et supprimer répondent à trois besoins différents.",
        "startMs": 294,
        "endMs": 4776,
        "method": "silence",
        "absoluteStartMs": 1438
      },
      {
        "text": "Fermer bloque seulement les nouvelles inscriptions.",
        "startMs": 5541,
        "endMs": 7440,
        "method": "silence",
        "absoluteStartMs": 6685
      },
      {
        "text": "Archiver retire l’événement du public tout en gardant ses données consultables.",
        "startMs": 8151,
        "endMs": 11485,
        "method": "silence",
        "absoluteStartMs": 9295
      },
      {
        "text": "Supprimer efface définitivement l’édition.",
        "startMs": 12165,
        "endMs": 14171,
        "method": "silence",
        "absoluteStartMs": 13309
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "prepare",
    "startMs": 16408,
    "endMs": 29937,
    "sentences": [
      {
        "text": "Pour cette démonstration, nous travaillons sur une copie jetable de l’ancienne édition.",
        "startMs": 645,
        "endMs": 4955,
        "method": "silence",
        "absoluteStartMs": 17053
      },
      {
        "text": "Dans la vraie vie, vérifiez d’abord les inscriptions, les invitations, le journal et les rapports.",
        "startMs": 5161,
        "endMs": 9055,
        "method": "silence",
        "absoluteStartMs": 21569
      },
      {
        "text": "Si des bénévoles doivent être prévenus, annulez les créneaux avant l’archivage.",
        "startMs": 9690,
        "endMs": 12885,
        "method": "silence",
        "absoluteStartMs": 26098
      }
    ],
    "anchors": [
      {
        "segmentId": "prepare",
        "phrase": "Si des bénévoles doivent être",
