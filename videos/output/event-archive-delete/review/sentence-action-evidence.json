  {
    "chapter": "delete-open",
    "startMs": 45348,
    "endMs": 59243,
    "sentences": [
      {
        "text": "La suppression définitive n’apparaît qu’après archivage et seulement pour un propriétaire de l’organisation.",
        "startMs": 447,
        "endMs": 5329,
        "method": "silence",
        "absoluteStartMs": 45795
      },
      {
        "text": "Le récapitulatif indique précisément combien de créneaux, d’inscriptions et d’invitations vont disparaître.",
        "startMs": 6118,
        "endMs": 11139,
        "method": "silence",
        "absoluteStartMs": 51466
      },
      {
        "text": "Les membres du pool, eux, sont conservés.",
        "startMs": 11657,
        "endMs": 13408,
        "method": "silence",
        "absoluteStartMs": 57005
      }
    ],
    "anchors": [
