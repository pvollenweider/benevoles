    "startMs": 73539,
    "endMs": 87508,
    "sentences": [
      {
        "text": "La confirmation renforcée demande de saisir le titre de l’événement.",
        "startMs": 419,
        "endMs": 3499,
        "method": "silence",
        "absoluteStartMs": 73958
      },
      {
        "text": "Tant qu’il ne correspond pas, le bouton reste indisponible.",
        "startMs": 4321,
        "endMs": 6727,
        "method": "silence",
        "absoluteStartMs": 77860
      },
      {
        "text": "Une fois la suppression lancée, les liens personnels cessent de fonctionner et les données rattachées ne sont pas récupérables depuis l’application.",
        "startMs": 7411,
        "endMs": 13616,
