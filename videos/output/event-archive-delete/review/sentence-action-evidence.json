        "atMs": 26573
      }
    ]
  },
  {
    "chapter": "archive",
    "startMs": 30390,
    "endMs": 44897,
    "sentences": [
      {
        "text": "Le bouton Archiver demande une confirmation claire.",
        "startMs": 616,
        "endMs": 2904,
        "method": "silence",
        "absoluteStartMs": 31006
      },
      {
        "text": "Après validation, la page publique disparaît, mais l’équipe garde accès au planning, aux inscriptions, aux rapports et au journal.",
        "startMs": 3578,
        "endMs": 8688,
        "method": "silence",
        "absoluteStartMs": 33968
      },
      {
        "text": "On peut donc conserver l’historique sans laisser croire que l’événement accepte encore du monde.",
        "startMs": 9053,
        "endMs": 14071,
        "method": "silence",
        "absoluteStartMs": 39443
      }
    ],
    "anchors": [
      {
