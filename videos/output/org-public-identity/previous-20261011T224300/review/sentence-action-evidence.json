[
  {
    "id": "welcome",
    "startMs": 1108,
    "sentences": [
      {
        "text": "L’identité de l’organisation donne un point d’entrée commun à tous ses événements.",
        "startMs": 268,
        "endMs": 4045,
        "method": "silence",
        "absoluteStartMs": 1376
      },
      {
        "text": "Elle sert à présenter clairement l’association, à fournir une adresse facile à partager et à éviter que les bénévoles confondent un nom technique avec le titre qu’ils voient.",
        "startMs": 4614,
        "endMs": 13068,
        "method": "silence",
        "absoluteStartMs": 5722
      }
    ],
    "inputs": []
  },
  {
    "id": "names",
    "startMs": 15228,
    "sentences": [
      {
        "text": "Dans Paramètres, le nom de l’organisation apparaît dans l’administration, les emails et au-dessus du titre public.",
        "startMs": 599,
        "endMs": 7252,
        "method": "silence",
        "absoluteStartMs": 15827
      },
      {
        "text": "Le titre de la page publique peut être plus accueillant.",
        "startMs": 8077,
        "endMs": 10640,
        "method": "silence",
        "absoluteStartMs": 23305
      },
      {
        "text": "Remplaçons-le par Les bénévoles des Fêtes de Montvert, puis enregistrons.",
        "startMs": 11162,
        "endMs": 15299,
        "method": "silence",
        "absoluteStartMs": 26390
      },
      {
        "text": "Le message Titre enregistré confirme la modification :",
        "startMs": 16397,
        "endMs": 19283,
        "method": "silence",
        "absoluteStartMs": 31625
      },
      {
        "text": "les titres des événements ne changent pas.",
        "startMs": 19768,
        "endMs": 21185,
        "method": "silence",
        "absoluteStartMs": 34996
      }
    ],
