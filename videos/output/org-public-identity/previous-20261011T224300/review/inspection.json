    {
      "id": "logo",
      "startMs": 37521,
      "endMs": 55379,
      "sentences": [
        {
          "text": "Ajoutons le logo de l’association.",
          "startMs": 652,
          "endMs": 2115,
          "method": "silence",
          "absoluteStartS": 38.173,
          "absoluteEndS": 39.636
        },
        {
          "text": "Choisissez une image dans les formats indiqués, vérifiez son aperçu, puis cliquez sur Enregistrer le logo.",
          "startMs": 2621,
          "endMs": 8348,
          "method": "silence",
          "absoluteStartS": 40.142,
          "absoluteEndS": 45.869
        },
        {
          "text": "L’image enregistrée apparaît dans les pages publiques, les emails et les documents.",
          "startMs": 9031,
          "endMs": 12838,
          "method": "silence",
          "absoluteStartS": 46.552,
          "absoluteEndS": 50.359
        },
        {
          "text": "Le nom de l’association reste écrit à côté :",
          "startMs": 13448,
          "endMs": 15469,
          "method": "silence",
          "absoluteStartS": 50.969,
          "absoluteEndS": 52.99
        },
        {
          "text": "le logo ne remplace pas ce repère.",
          "startMs": 15469,
          "endMs": 17296,
          "method": "estimate",
          "absoluteStartS": 52.99,
          "absoluteEndS": 54.817
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 47024
        }
      ]
    },
    {
      "id": "slug",
      "startMs": 55833,
      "endMs": 81339,
      "sentences": [
        {
          "text": "L’identifiant public, ou slug, sert à former l’adresse de votre association sur benevol point app.",
          "startMs": 550,
          "endMs": 5935,
          "method": "silence",
          "absoluteStartS": 56.383,
          "absoluteEndS": 61.768
        },
        {
          "text": "Ici, les adresses appartiennent à notre environnement de démonstration.",
          "startMs": 6585,
          "endMs": 9662,
          "method": "silence",
          "absoluteStartS": 62.418,
          "absoluteEndS": 65.495
        },
        {
          "text": "Si vous changez l’identifiant alors que des événements sont publiés, une confirmation est demandée.",
          "startMs": 10162,
          "endMs": 14679,
          "method": "silence",
          "absoluteStartS": 65.995,
          "absoluteEndS": 70.512
        },
        {
          "text": "Les anciens identifiants continuent de rediriger vers l’actuel tant que vous les conservez.",
          "startMs": 15359,
          "endMs": 19512,
          "method": "silence",
          "absoluteStartS": 71.192,
          "absoluteEndS": 75.345
        },
        {
          "text": "C’est leur suppression qui casse les anciens liens et QR codes.",
          "startMs": 19992,
          "endMs": 22525,
          "method": "silence",
          "absoluteStartS": 75.825,
          "absoluteEndS": 78.358
        },
        {
          "text": "Ici, gardons l’adresse actuelle.",
          "startMs": 23222,
          "endMs": 24973,
          "method": "silence",
          "absoluteStartS": 79.055,
          "absoluteEndS": 80.806
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 58874
        },
        {
          "kind": "click",
          "atMs": 66491
        },
