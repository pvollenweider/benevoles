  "chapters": [
    {
      "id": "welcome",
      "startMs": 1108,
      "endMs": 14774,
      "sentences": [
        {
          "text": "L’identité de l’organisation donne un point d’entrée commun à tous ses événements.",
          "startMs": 268,
          "endMs": 4045,
          "method": "silence",
          "absoluteStartS": 1.376,
          "absoluteEndS": 5.153
        },
        {
          "text": "Elle sert à présenter clairement l’association, à fournir une adresse facile à partager et à éviter que les bénévoles confondent un nom technique avec le titre qu’ils voient.",
          "startMs": 4614,
          "endMs": 13068,
          "method": "silence",
          "absoluteStartS": 5.722,
          "absoluteEndS": 14.176
        }
      ],
      "markers": []
    },
    {
      "id": "names",
      "startMs": 15228,
      "endMs": 37067,
      "sentences": [
        {
          "text": "Dans Paramètres, le nom de l’organisation apparaît dans l’administration, les emails et au-dessus du titre public.",
          "startMs": 599,
          "endMs": 7252,
          "method": "silence",
          "absoluteStartS": 15.827,
          "absoluteEndS": 22.48
        },
        {
          "text": "Le titre de la page publique peut être plus accueillant.",
          "startMs": 8077,
          "endMs": 10640,
          "method": "silence",
          "absoluteStartS": 23.305,
          "absoluteEndS": 25.868
        },
        {
          "text": "Remplaçons-le par Les bénévoles des Fêtes de Montvert, puis enregistrons.",
          "startMs": 11162,
          "endMs": 15299,
          "method": "silence",
          "absoluteStartS": 26.39,
          "absoluteEndS": 30.527
        },
        {
          "text": "Le message Titre enregistré confirme la modification :",
          "startMs": 16397,
          "endMs": 19283,
          "method": "silence",
          "absoluteStartS": 31.625,
          "absoluteEndS": 34.511
        },
        {
          "text": "les titres des événements ne changent pas.",
          "startMs": 19768,
          "endMs": 21185,
          "method": "silence",
          "absoluteStartS": 34.996,
          "absoluteEndS": 36.413
        }
      ],
