    {
      "id": "public-page",
      "startMs": 82951,
      "endMs": 102691,
      "sentences": [
        {
          "text": "Ouvrons la page publique.",
          "startMs": 529,
          "endMs": 1540,
          "method": "silence",
          "absoluteStartS": 83.48,
          "absoluteEndS": 84.491
        },
        {
          "text": "Le nouveau titre et le logo apparaissent au-dessus des deux événements publiés et répertoriés.",
          "startMs": 2427,
          "endMs": 6364,
          "method": "silence",
          "absoluteStartS": 85.378,
          "absoluteEndS": 89.315
        },
        {
          "text": "La rencontre des organisateurs n’est pas dans cette liste :",
          "startMs": 7047,
          "endMs": 9277,
          "method": "silence",
          "absoluteStartS": 89.998,
          "absoluteEndS": 92.228
        },
        {
          "text": "elle est publiée, mais non répertoriée.",
          "startMs": 9586,
          "endMs": 11448,
          "method": "silence",
          "absoluteStartS": 92.537,
          "absoluteEndS": 94.399
        },
        {
          "text": "Ouvrons son lien direct pour vérifier qu’elle reste accessible aux personnes qui le reçoivent.",
          "startMs": 12097,
          "endMs": 15508,
          "method": "silence",
          "absoluteStartS": 95.048,
          "absoluteEndS": 98.459
        },
        {
          "text": "Non répertorié ne signifie pas protégé par un mot de passe.",
          "startMs": 16237,
          "endMs": 19384,
          "method": "silence",
          "absoluteStartS": 99.188,
          "absoluteEndS": 102.335
        }
      ],
      "markers": []
    },
    {
      "id": "event-result",
      "startMs": 103143,
      "endMs": 117797,
      "sentences": [
        {
          "text": "En ouvrant la Fête du village, on retrouve l’identité de l’organisation avec les informations propres à cet événement.",
          "startMs": 366,
          "endMs": 5828,
          "method": "silence",
          "absoluteStartS": 103.509,
          "absoluteEndS": 108.971
        },
        {
          "text": "Le nom de l’événement, son lieu et son planning restent indépendants.",
          "startMs": 6509,
          "endMs": 9807,
          "method": "silence",
          "absoluteStartS": 109.652,
          "absoluteEndS": 112.95
        },
        {
          "text": "On peut donc réutiliser la même page d’organisation pour plusieurs manifestations au fil de l’année.",
          "startMs": 10085,
          "endMs": 14654,
          "method": "silence",
          "absoluteStartS": 113.228,
          "absoluteEndS": 117.797
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 104729
        }
      ]
    },
    {
      "id": "remove-logo",
      "startMs": 118250,
      "endMs": 136381,
      "sentences": [
        {
          "text": "Pour retirer le logo, revenez dans Paramètres et choisissez Retirer le logo.",
          "startMs": 183,
          "endMs": 5451,
          "method": "silence",
          "absoluteStartS": 118.433,
          "absoluteEndS": 123.701
        },
        {
          "text": "La confirmation vous laisse encore annuler.",
          "startMs": 6085,
          "endMs": 7646,
          "method": "silence",
          "absoluteStartS": 124.335,
          "absoluteEndS": 125.896
        },
        {
          "text": "Après validation, l’image disparaît des pages et des prochains documents, mais le nom et le titre restent affichés.",
          "startMs": 8232,
          "endMs": 13968,
          "method": "silence",
          "absoluteStartS": 126.482,
          "absoluteEndS": 132.218
        },
        {
          "text": "Cela ne retire pas une copie déjà téléchargée ou un ancien email.",
          "startMs": 14395,
          "endMs": 17862,
          "method": "silence",
          "absoluteStartS": 132.645,
          "absoluteEndS": 136.112
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 124807
        },
        {
          "kind": "click",
          "atMs": 127439
        }
      ]
    },
    {
      "id": "result",
      "startMs": 136835,
      "endMs": 156509,
      "sentences": [
        {
          "text": "Vous avez une identité cohérente :",
          "startMs": 270,
          "endMs": 2605,
          "method": "silence",
          "absoluteStartS": 137.105,
          "absoluteEndS": 139.44
        },
        {
          "text": "le nom de l’association, un titre public accueillant, un logo facultatif et une adresse identifiable.",
          "startMs": 3097,
          "endMs": 7912,
          "method": "silence",
          "absoluteStartS": 139.932,
          "absoluteEndS": 144.747
        },
        {
          "text": "Ces réglages sont réservés au propriétaire.",
          "startMs": 8043,
          "endMs": 11791,
          "method": "silence",
          "absoluteStartS": 144.878,
          "absoluteEndS": 148.626
        },
        {
          "text": "Pour corriger un texte visible, modifiez son titre plutôt que l’adresse, et conservez les anciens identifiants si vous avez déjà diffusé leurs liens.",
          "startMs": 12521,
          "endMs": 19352,
          "method": "silence",
          "absoluteStartS": 149.356,
          "absoluteEndS": 156.187
        }
      ],
