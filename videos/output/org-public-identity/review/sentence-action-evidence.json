  {
    "id": "public-page",
    "startMs": 82945,
    "sentences": [
      {
        "text": "Ouvrons la page publique.",
        "startMs": 529,
        "endMs": 1540,
        "method": "silence",
        "absoluteStartMs": 83474
      },
      {
        "text": "Le nouveau titre et le logo apparaissent au-dessus des deux événements publiés et répertoriés.",
        "startMs": 2427,
        "endMs": 6364,
        "method": "silence",
        "absoluteStartMs": 85372
      },
      {
        "text": "La rencontre des organisateurs n’est pas dans cette liste :",
        "startMs": 7047,
        "endMs": 9277,
        "method": "silence",
        "absoluteStartMs": 89992
      },
      {
        "text": "elle est publiée, mais non répertoriée.",
        "startMs": 9586,
        "endMs": 11448,
        "method": "silence",
        "absoluteStartMs": 92531
      },
      {
        "text": "Ouvrons son lien direct pour vérifier qu’elle reste accessible aux personnes qui le reçoivent.",
        "startMs": 12097,
        "endMs": 15508,
        "method": "silence",
        "absoluteStartMs": 95042
      },
      {
        "text": "Non répertorié ne signifie pas protégé par un mot de passe.",
        "startMs": 16237,
        "endMs": 19384,
        "method": "silence",
        "absoluteStartMs": 99182
      }
    ],
    "inputs": []
  },
  {
    "id": "event-result",
    "startMs": 103138,
    "sentences": [
      {
        "text": "En ouvrant la Fête du village, on retrouve l’identité de l’organisation avec les informations propres à cet événement.",
        "startMs": 366,
        "endMs": 5828,
        "method": "silence",
        "absoluteStartMs": 103504
      },
      {
        "text": "Le nom de l’événement, son lieu et son planning restent indépendants.",
        "startMs": 6509,
        "endMs": 9807,
        "method": "silence",
        "absoluteStartMs": 109647
      },
      {
        "text": "On peut donc réutiliser la même page d’organisation pour plusieurs manifestations au fil de l’année.",
        "startMs": 10085,
        "endMs": 14654,
        "method": "silence",
        "absoluteStartMs": 113223
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 104757
      }
    ]
  },
  {
    "id": "remove-logo",
    "startMs": 118248,
    "sentences": [
      {
        "text": "Pour retirer le logo, revenez dans Paramètres et choisissez Retirer le logo.",
        "startMs": 183,
        "endMs": 5451,
        "method": "silence",
        "absoluteStartMs": 118431
      },
      {
        "text": "La confirmation vous laisse encore annuler.",
        "startMs": 6085,
        "endMs": 7646,
        "method": "silence",
        "absoluteStartMs": 124333
      },
      {
        "text": "Après validation, l’image disparaît des pages et des prochains documents, mais le nom et le titre restent affichés.",
        "startMs": 8232,
        "endMs": 13968,
        "method": "silence",
        "absoluteStartMs": 126480
      },
      {
        "text": "Cela ne retire pas une copie déjà téléchargée ou un ancien email.",
        "startMs": 14395,
        "endMs": 17862,
        "method": "silence",
        "absoluteStartMs": 132643
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 119998
      },
      {
        "kind": "click",
        "atMs": 126945
      }
    ]
  },
  {
    "id": "result",
    "startMs": 136830,
    "sentences": [
      {
        "text": "Vous avez une identité cohérente :",
        "startMs": 270,
        "endMs": 2605,
        "method": "silence",
        "absoluteStartMs": 137100
      },
      {
        "text": "le nom de l’association, un titre public accueillant, un logo facultatif et une adresse identifiable.",
        "startMs": 3097,
        "endMs": 7912,
        "method": "silence",
        "absoluteStartMs": 139927
      },
      {
        "text": "Ces réglages sont réservés au propriétaire.",
        "startMs": 8043,
        "endMs": 11791,
        "method": "silence",
        "absoluteStartMs": 144873
      },
      {
        "text": "Pour corriger un texte visible, modifiez son titre plutôt que l’adresse, et conservez les anciens identifiants si vous avez déjà diffusé leurs liens.",
        "startMs": 12521,
        "endMs": 19352,
        "method": "silence",
        "absoluteStartMs": 149351
      }
    ],
    "inputs": []
  }
]