  "chapters": [
    {
      "id": "welcome",
      "startMs": 1118,
      "endMs": 14784,
      "sentences": [
        {
          "text": "L’identité de l’organisation donne un point d’entrée commun à tous ses événements.",
          "startMs": 268,
          "endMs": 4045,
          "method": "silence",
          "absoluteStartS": 1.386,
          "absoluteEndS": 5.163
        },
        {
          "text": "Elle sert à présenter clairement l’association, à fournir une adresse facile à partager et à éviter que les bénévoles confondent un nom technique avec le titre qu’ils voient.",
          "startMs": 4614,
          "endMs": 13068,
          "method": "silence",
          "absoluteStartS": 5.732,
          "absoluteEndS": 14.186
        }
      ],
      "markers": []
    },
    {
      "id": "names",
      "startMs": 15237,
      "endMs": 37073,
      "sentences": [
        {
          "text": "Dans Paramètres, le nom de l’organisation apparaît dans l’administration, les emails et au-dessus du titre public.",
          "startMs": 599,
          "endMs": 7252,
          "method": "silence",
          "absoluteStartS": 15.836,
          "absoluteEndS": 22.489
        },
        {
          "text": "Le titre de la page publique peut être plus accueillant.",
          "startMs": 8077,
          "endMs": 10640,
          "method": "silence",
          "absoluteStartS": 23.314,
          "absoluteEndS": 25.877
        },
        {
          "text": "Remplaçons-le par Les bénévoles des Fêtes de Montvert, puis enregistrons.",
          "startMs": 11162,
          "endMs": 15299,
          "method": "silence",
          "absoluteStartS": 26.399,
          "absoluteEndS": 30.536
        },
        {
          "text": "Le message Titre enregistré confirme la modification :",
          "startMs": 16397,
          "endMs": 19283,
          "method": "silence",
          "absoluteStartS": 31.634,
          "absoluteEndS": 34.52
        },
        {
          "text": "les titres des événements ne changent pas.",
          "startMs": 19768,
          "endMs": 21185,
          "method": "silence",
          "absoluteStartS": 35.005,
          "absoluteEndS": 36.422
        }
      ],
