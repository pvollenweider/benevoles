    {
      "id": "logo",
      "startMs": 37525,
      "endMs": 55367,
      "sentences": [
        {
          "text": "Ajoutons le logo de l’association.",
          "startMs": 652,
          "endMs": 2115,
          "method": "silence",
          "absoluteStartS": 38.177,
          "absoluteEndS": 39.64
        },
        {
          "text": "Choisissez une image dans les formats indiqués, vérifiez son aperçu, puis cliquez sur Enregistrer le logo.",
          "startMs": 2621,
          "endMs": 8348,
          "method": "silence",
          "absoluteStartS": 40.146,
          "absoluteEndS": 45.873
        },
        {
          "text": "L’image enregistrée apparaît dans les pages publiques, les emails et les documents.",
          "startMs": 9031,
          "endMs": 12838,
          "method": "silence",
          "absoluteStartS": 46.556,
          "absoluteEndS": 50.363
        },
        {
          "text": "Le nom de l’association reste écrit à côté :",
          "startMs": 13448,
          "endMs": 15469,
          "method": "silence",
          "absoluteStartS": 50.973,
          "absoluteEndS": 52.994
        },
        {
          "text": "le logo ne remplace pas ce repère.",
          "startMs": 15469,
          "endMs": 17296,
          "method": "estimate",
          "absoluteStartS": 52.994,
          "absoluteEndS": 54.821
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 47054
        }
      ]
    },
    {
      "id": "slug",
      "startMs": 55821,
      "endMs": 81326,
      "sentences": [
        {
          "text": "L’identifiant public, ou slug, sert à former l’adresse de votre association sur benevol point app.",
          "startMs": 550,
          "endMs": 5935,
          "method": "silence",
          "absoluteStartS": 56.371,
          "absoluteEndS": 61.756
        },
        {
          "text": "Ici, les adresses appartiennent à notre environnement de démonstration.",
          "startMs": 6585,
          "endMs": 9662,
          "method": "silence",
          "absoluteStartS": 62.406,
          "absoluteEndS": 65.483
        },
        {
          "text": "Si vous changez l’identifiant alors que des événements sont publiés, une confirmation est demandée.",
          "startMs": 10162,
          "endMs": 14679,
          "method": "silence",
          "absoluteStartS": 65.983,
          "absoluteEndS": 70.5
        },
        {
          "text": "Les anciens identifiants continuent de rediriger vers l’actuel tant que vous les conservez.",
          "startMs": 15359,
          "endMs": 19512,
          "method": "silence",
          "absoluteStartS": 71.18,
          "absoluteEndS": 75.333
        },
        {
          "text": "C’est leur suppression qui casse les anciens liens et QR codes.",
          "startMs": 19992,
          "endMs": 22525,
          "method": "silence",
          "absoluteStartS": 75.813,
          "absoluteEndS": 78.346
        },
        {
          "text": "Ici, gardons l’adresse actuelle.",
          "startMs": 23222,
          "endMs": 24973,
          "method": "silence",
          "absoluteStartS": 79.043,
          "absoluteEndS": 80.794
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 58868
        },
        {
