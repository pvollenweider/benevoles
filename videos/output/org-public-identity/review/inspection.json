    {
      "id": "public-page",
      "startMs": 82945,
      "endMs": 102685,
      "sentences": [
        {
          "text": "Ouvrons la page publique.",
          "startMs": 529,
          "endMs": 1540,
          "method": "silence",
          "absoluteStartS": 83.474,
          "absoluteEndS": 84.485
        },
        {
          "text": "Le nouveau titre et le logo apparaissent au-dessus des deux événements publiés et répertoriés.",
          "startMs": 2427,
          "endMs": 6364,
          "method": "silence",
          "absoluteStartS": 85.372,
          "absoluteEndS": 89.309
        },
        {
          "text": "La rencontre des organisateurs n’est pas dans cette liste :",
          "startMs": 7047,
          "endMs": 9277,
          "method": "silence",
          "absoluteStartS": 89.992,
          "absoluteEndS": 92.222
        },
        {
          "text": "elle est publiée, mais non répertoriée.",
          "startMs": 9586,
          "endMs": 11448,
          "method": "silence",
          "absoluteStartS": 92.531,
          "absoluteEndS": 94.393
        },
        {
          "text": "Ouvrons son lien direct pour vérifier qu’elle reste accessible aux personnes qui le reçoivent.",
          "startMs": 12097,
          "endMs": 15508,
          "method": "silence",
          "absoluteStartS": 95.042,
          "absoluteEndS": 98.453
        },
        {
          "text": "Non répertorié ne signifie pas protégé par un mot de passe.",
          "startMs": 16237,
          "endMs": 19384,
          "method": "silence",
          "absoluteStartS": 99.182,
          "absoluteEndS": 102.329
        }
      ],
      "markers": []
    },
    {
      "id": "event-result",
      "startMs": 103138,
      "endMs": 117794,
      "sentences": [
        {
          "text": "En ouvrant la Fête du village, on retrouve l’identité de l’organisation avec les informations propres à cet événement.",
          "startMs": 366,
          "endMs": 5828,
          "method": "silence",
          "absoluteStartS": 103.504,
          "absoluteEndS": 108.966
        },
        {
          "text": "Le nom de l’événement, son lieu et son planning restent indépendants.",
          "startMs": 6509,
          "endMs": 9807,
          "method": "silence",
          "absoluteStartS": 109.647,
          "absoluteEndS": 112.945
        },
        {
          "text": "On peut donc réutiliser la même page d’organisation pour plusieurs manifestations au fil de l’année.",
          "startMs": 10085,
          "endMs": 14654,
          "method": "silence",
          "absoluteStartS": 113.223,
          "absoluteEndS": 117.792
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 104757
        }
      ]
    },
    {
      "id": "remove-logo",
      "startMs": 118248,
      "endMs": 136378,
      "sentences": [
        {
          "text": "Pour retirer le logo, revenez dans Paramètres et choisissez Retirer le logo.",
          "startMs": 183,
          "endMs": 5451,
          "method": "silence",
          "absoluteStartS": 118.431,
          "absoluteEndS": 123.699
        },
        {
          "text": "La confirmation vous laisse encore annuler.",
          "startMs": 6085,
          "endMs": 7646,
          "method": "silence",
          "absoluteStartS": 124.333,
          "absoluteEndS": 125.894
        },
        {
          "text": "Après validation, l’image disparaît des pages et des prochains documents, mais le nom et le titre restent affichés.",
          "startMs": 8232,
          "endMs": 13968,
          "method": "silence",
          "absoluteStartS": 126.48,
          "absoluteEndS": 132.216
        },
        {
          "text": "Cela ne retire pas une copie déjà téléchargée ou un ancien email.",
          "startMs": 14395,
          "endMs": 17862,
          "method": "silence",
          "absoluteStartS": 132.643,
          "absoluteEndS": 136.11
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 119998
        },
        {
          "kind": "click",
          "atMs": 126945
        }
      ]
    },
    {
      "id": "result",
      "startMs": 136830,
      "endMs": 156503,
      "sentences": [
        {
          "text": "Vous avez une identité cohérente :",
          "startMs": 270,
          "endMs": 2605,
          "method": "silence",
          "absoluteStartS": 137.1,
          "absoluteEndS": 139.435
        },
        {
          "text": "le nom de l’association, un titre public accueillant, un logo facultatif et une adresse identifiable.",
          "startMs": 3097,
          "endMs": 7912,
          "method": "silence",
          "absoluteStartS": 139.927,
          "absoluteEndS": 144.742
        },
        {
          "text": "Ces réglages sont réservés au propriétaire.",
          "startMs": 8043,
          "endMs": 11791,
          "method": "silence",
          "absoluteStartS": 144.873,
          "absoluteEndS": 148.621
        },
        {
          "text": "Pour corriger un texte visible, modifiez son titre plutôt que l’adresse, et conservez les anciens identifiants si vous avez déjà diffusé leurs liens.",
          "startMs": 12521,
          "endMs": 19352,
          "method": "silence",
          "absoluteStartS": 149.351,
          "absoluteEndS": 156.182
        }
      ],
