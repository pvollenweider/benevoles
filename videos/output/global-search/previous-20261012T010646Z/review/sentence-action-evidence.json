  {
    "chapter": "shift",
    "startMs": 45035,
    "endMs": 60409,
    "sentences": [
      {
        "text": "Avec Buvette, vous retrouvez les créneaux de plusieurs événements.",
        "startMs": 414,
        "endMs": 3411,
        "method": "silence",
        "absoluteStartMs": 45449
      },
      {
        "text": "Chaque résultat rappelle l’événement, la date et l’horaire.",
        "startMs": 4219,
        "endMs": 6948,
        "method": "silence",
        "absoluteStartMs": 49254
      },
      {
        "text": "Ajoutons village pour ne garder que le service qui nous intéresse, puis ouvrons le résultat :",
        "startMs": 7756,
        "endMs": 12210,
        "method": "silence",
        "absoluteStartMs": 52791
      },
      {
        "text": "la liste des inscriptions est filtrée sur ce créneau.",
