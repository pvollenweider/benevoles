  {
    "chapter": "result",
    "startMs": 77055,
    "endMs": 89340,
    "sentences": [
      {
        "text": "Vous arrivez à la bonne fiche ou à la bonne liste, sans envoi de message.",
        "startMs": 426,
        "endMs": 3589,
        "method": "silence",
        "absoluteStartMs": 77481
      },
      {
        "text": "Utilisez la recherche pour un besoin précis.",
        "startMs": 4366,
        "endMs": 6002,
        "method": "silence",
        "absoluteStartMs": 81421
      },
      {
        "text": "Pour examiner toutes les personnes ou effectuer des actions groupées, revenez aux listes de membres et d’inscriptions avec leurs filtres.",
        "startMs": 6680,
        "endMs": 12036,
        "method": "silence",
        "absoluteStartMs": 83735
      }
    ],
