  {
    "chapter": "limits",
    "startMs": 60860,
    "endMs": 76603,
    "sentences": [
      {
        "text": "La recherche affiche au maximum vingt résultats par catégorie.",
        "startMs": 380,
        "endMs": 2693,
        "method": "silence",
        "absoluteStartMs": 61240
      },
      {
        "text": "Ici, beaucoup de membres portent le nom Morel :",
        "startMs": 3488,
        "endMs": 5663,
        "method": "silence",
        "absoluteStartMs": 64348
      },
      {
        "text": "le message indique qu’il reste d’autres résultats.",
        "startMs": 6032,
        "endMs": 7729,
        "method": "silence",
        "absoluteStartMs": 66892
      },
      {
        "text": "Ajoutez un prénom pour préciser la recherche.",
        "startMs": 8472,
        "endMs": 10167,
        "method": "silence",
        "absoluteStartMs": 69332
      },
      {
        "text": "Les accents et la casse ne bloquent pas la recherche :",
        "startMs": 10931,
        "endMs": 12668,
        "method": "silence",
        "absoluteStartMs": 71791
      },
      {
        "text": "écrire zoe permet aussi de retrouver Zoé.",
        "startMs": 13294,
        "endMs": 15324,
        "method": "silence",
        "absoluteStartMs": 74154
      }
    ],
