  {
    "chapter": "person",
    "startMs": 27879,
    "endMs": 44581,
    "sentences": [
      {
        "text": "Cherchons Léa Morel.",
        "startMs": 459,
        "endMs": 1433,
        "method": "silence",
        "absoluteStartMs": 28338
      },
      {
        "text": "Les résultats distinguent sa fiche de membre et ses inscriptions.",
        "startMs": 2155,
        "endMs": 4522,
        "method": "silence",
        "absoluteStartMs": 30034
      },
      {
        "text": "Ouvrons d’abord sa fiche, puis une inscription :",
        "startMs": 5196,
        "endMs": 7532,
        "method": "silence",
        "absoluteStartMs": 33075
      },
      {
        "text": "la liste de l’événement est déjà filtrée sur Léa.",
        "startMs": 8293,
        "endMs": 10182,
        "method": "silence",
        "absoluteStartMs": 36172
      },
      {
        "text": "Le badge Liste d’attente distingue une demande de place d’une inscription confirmée.",
        "startMs": 10794,
        "endMs": 14326,
        "method": "silence",
        "absoluteStartMs": 38673
      },
      {
        "text": "La recherche elle-même ne modifie rien.",
        "startMs": 15008,
        "endMs": 16301,
        "method": "silence",
        "absoluteStartMs": 42887
      }
    ],
