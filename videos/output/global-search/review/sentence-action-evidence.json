  {
    "chapter": "person",
    "startMs": 27880,
    "endMs": 44584,
    "sentences": [
      {
        "text": "Cherchons Léa Morel.",
        "startMs": 459,
        "endMs": 1433,
        "method": "silence",
        "absoluteStartMs": 28339
      },
      {
        "text": "Les résultats distinguent sa fiche de membre et ses inscriptions.",
        "startMs": 2155,
        "endMs": 4522,
        "method": "silence",
        "absoluteStartMs": 30035
      },
      {
        "text": "Ouvrons d’abord sa fiche, puis une inscription :",
        "startMs": 5196,
        "endMs": 7532,
        "method": "silence",
        "absoluteStartMs": 33076
      },
      {
        "text": "la liste de l’événement est déjà filtrée sur Léa.",
        "startMs": 8293,
        "endMs": 10182,
        "method": "silence",
        "absoluteStartMs": 36173
      },
      {
        "text": "Le badge Liste d’attente distingue une demande de place d’une inscription confirmée.",
        "startMs": 10794,
        "endMs": 14326,
        "method": "silence",
        "absoluteStartMs": 38674
      },
      {
        "text": "La recherche elle-même ne modifie rien.",
        "startMs": 15008,
        "endMs": 16301,
        "method": "silence",
        "absoluteStartMs": 42888
      }
    ],
