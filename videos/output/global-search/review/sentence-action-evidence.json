[
  {
    "chapter": "welcome",
    "startMs": 0,
    "endMs": 12831,
    "sentences": [
      {
        "text": "Quand une association compte plusieurs événements et beaucoup de bénévoles, ouvrir chaque planning prend vite du temps.",
        "startMs": 286,
        "endMs": 5058,
        "method": "silence",
        "absoluteStartMs": 286
      },
      {
        "text": "La recherche globale sert à retrouver une personne, son inscription, un événement ou un poste depuis n’importe quel écran de l’administration.",
        "startMs": 5716,
        "endMs": 12410,
        "method": "silence",
        "absoluteStartMs": 5716
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "open",
    "startMs": 13284,
    "endMs": 25720,
    "sentences": [
      {
        "text": "Ouvrez la loupe dans la barre du haut.",
        "startMs": 424,
        "endMs": 1712,
        "method": "silence",
        "absoluteStartMs": 13708
      },
      {
        "text": "Vous pouvez aussi utiliser Contrôle K, ou Commande K sur Mac :",
        "startMs": 2452,
        "endMs": 5376,
        "method": "silence",
        "absoluteStartMs": 15736
      },
      {
        "text": "le champ s’ouvre et reçoit immédiatement le curseur.",
        "startMs": 5961,
        "endMs": 8359,
        "method": "silence",
        "absoluteStartMs": 19245
      },
      {
        "text": "Échap le referme sans lancer de recherche et rend le focus au bouton.",
        "startMs": 9202,
        "endMs": 11987,
        "method": "silence",
        "absoluteStartMs": 22486
      }
    ],
