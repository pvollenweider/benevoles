  "chapters": [
    {
      "id": "welcome",
      "startMs": 1103,
      "endMs": 18063,
      "sentences": [
        {
          "text": "La visibilité de l’événement et l’ouverture des inscriptions sont deux réglages différents.",
          "startMs": 323,
          "endMs": 5761,
          "method": "silence",
          "absoluteStartS": 1.426,
          "absoluteEndS": 6.864
        },
        {
          "text": "Les séparer permet de montrer une page d’information avant les inscriptions, de partager un événement seulement aux personnes concernées, puis de le ranger proprement après sa fin.",
          "startMs": 6467,
          "endMs": 16482,
          "method": "silence",
          "absoluteStartS": 7.57,
          "absoluteEndS": 17.585
        }
      ],
      "markers": []
    },
    {
      "id": "statuses",
      "startMs": 18514,
      "endMs": 36280,
      "sentences": [
        {
          "text": "Brouillon signifie invisible au public.",
          "startMs": 477,
          "endMs": 3312,
          "method": "silence",
          "absoluteStartS": 18.991,
          "absoluteEndS": 21.826
        },
        {
          "text": "Publié rend la page accessible.",
          "startMs": 3696,
          "endMs": 5864,
          "method": "silence",
          "absoluteStartS": 22.21,
          "absoluteEndS": 24.378
        },
        {
          "text": "Archivé conserve les données et les rapports dans l’administration mais ferme le cycle de vie.",
          "startMs": 6589,
          "endMs": 11836,
          "method": "silence",
          "absoluteStartS": 25.103,
          "absoluteEndS": 30.35
        },
        {
          "text": "Un événement ne peut passer à Publié que s’il possède au moins un créneau actif.",
          "startMs": 12649,
          "endMs": 17329,
          "method": "silence",
          "absoluteStartS": 31.163,
          "absoluteEndS": 35.843
        }
      ],
      "markers": []
    },
    {
      "id": "unlisted",
      "startMs": 38442,
      "endMs": 59769,
      "sentences": [
        {
          "text": "L’option Afficher cet événement sur la page publique de l’organisation agit à part.",
          "startMs": 432,
          "endMs": 5445,
          "method": "silence",
          "absoluteStartS": 38.874,
          "absoluteEndS": 43.887
        },
        {
          "text": "Décochée sur un événement publié, elle le retire de cette page et du référencement, tout en gardant son lien direct et son QR code fonctionnels.",
          "startMs": 5578,
          "endMs": 15212,
          "method": "silence",
          "absoluteStartS": 44.02,
          "absoluteEndS": 53.654
        },
        {
          "text": "Ce n’est donc pas une protection par mot de passe :",
          "startMs": 15977,
          "endMs": 18429,
          "method": "silence",
          "absoluteStartS": 54.419,
          "absoluteEndS": 56.871
        },
        {
          "text": "toute personne qui possède le lien peut l’ouvrir.",
          "startMs": 18593,
          "endMs": 20753,
          "method": "silence",
          "absoluteStartS": 57.035,
          "absoluteEndS": 59.195
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 45309
        }
      ]
    },
    {
      "id": "window",
      "startMs": 61931,
      "endMs": 80457,
      "sentences": [
        {
          "text": "Les inscriptions peuvent être fermées immédiatement ou programmées.",
          "startMs": 585,
          "endMs": 3827,
          "method": "silence",
          "absoluteStartS": 62.516,
          "absoluteEndS": 65.758
        },
        {
          "text": "Indiquons une ouverture et une fermeture dans le fuseau de l’organisation.",
          "startMs": 4600,
          "endMs": 8006,
          "method": "silence",
          "absoluteStartS": 66.531,
          "absoluteEndS": 69.937
        },
        {
          "text": "La page reste visible pendant toute la période, mais le formulaire n’accepte des choix que lorsque la case Inscriptions ouvertes est cochée et que la fenêtre est active.",
          "startMs": 8468,
          "endMs": 18127,
          "method": "silence",
          "absoluteStartS": 70.399,
          "absoluteEndS": 80.058
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 65791
        },
        {
          "kind": "click",
          "atMs": 67609
        }
      ]
    },
    {
      "id": "public-result",
      "startMs": 82055,
      "endMs": 98157,
      "sentences": [
        {
          "text": "Côté bénévole, la page explique clairement que les inscriptions ne sont pas encore ouvertes et affiche la date prévue.",
          "startMs": 353,
          "endMs": 6897,
          "method": "silence",
          "absoluteStartS": 82.408,
          "absoluteEndS": 88.952
        },
        {
          "text": "Les informations de l’événement restent consultables.",
          "startMs": 7733,
          "endMs": 9894,
          "method": "silence",
          "absoluteStartS": 89.788,
          "absoluteEndS": 91.949
        },
        {
          "text": "Une fois la fenêtre ouverte, le même lien présente automatiquement le planning sans nouvelle publication.",
          "startMs": 10596,
          "endMs": 15679,
          "method": "silence",
          "absoluteStartS": 92.651,
          "absoluteEndS": 97.734
        }
      ],
      "markers": []
    },
    {
      "id": "archive",
      "startMs": 98610,
      "endMs": 113981,
      "sentences": [
        {
          "text": "Après l’événement, Archivé retire la page du parcours courant et garde l’historique, les inscriptions et les exports disponibles dans l’administration.",
          "startMs": 427,
          "endMs": 9102,
          "method": "silence",
          "absoluteStartS": 99.037,
          "absoluteEndS": 107.712
        },
        {
          "text": "Fermer les inscriptions suffit pour une pause temporaire ;",
          "startMs": 9776,
          "endMs": 12693,
          "method": "silence",
          "absoluteStartS": 108.386,
          "absoluteEndS": 111.303
        },
        {
          "text": "archiver signifie que l’événement est terminé.",
          "startMs": 12930,
          "endMs": 15031,
          "method": "silence",
          "absoluteStartS": 111.54,
          "absoluteEndS": 113.641
        }
      ],
      "markers": []
    },
    {
      "id": "result",
      "startMs": 114435,
      "endMs": 134725,
      "sentences": [
        {
          "text": "Choisis donc chaque état selon l’intention :",
          "startMs": 197,
          "endMs": 2704,
          "method": "silence",
          "absoluteStartS": 114.632,
          "absoluteEndS": 117.139
        },
        {
          "text": "brouillon pendant la préparation, publié répertorié pour recruter largement, publié non répertorié pour un partage par lien, fenêtre programmée pour maîtriser le calendrier, puis archive pour conserver sans encombrer.",
          "startMs": 3439,
          "endMs": 20003,
          "method": "silence",
          "absoluteStartS": 117.874,
          "absoluteEndS": 134.438
        }
      ],
      "markers": []
    }
  ]
