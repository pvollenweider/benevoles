  "chapters": [
    {
      "id": "welcome",
      "startMs": 1097,
      "endMs": 18056,
      "sentences": [
        {
          "text": "La visibilité de l’événement et l’ouverture des inscriptions sont deux réglages différents.",
          "startMs": 323,
          "endMs": 5761,
          "method": "silence",
          "absoluteStartS": 1.42,
          "absoluteEndS": 6.858
        },
        {
          "text": "Les séparer permet de montrer une page d’information avant les inscriptions, de partager un événement seulement aux personnes concernées, puis de le ranger proprement après sa fin.",
          "startMs": 6467,
          "endMs": 16482,
          "method": "silence",
          "absoluteStartS": 7.564,
          "absoluteEndS": 17.579
        }
      ],
      "markers": []
    },
    {
      "id": "statuses",
      "startMs": 18509,
      "endMs": 36268,
      "sentences": [
        {
          "text": "Brouillon signifie invisible au public.",
          "startMs": 477,
          "endMs": 3312,
          "method": "silence",
          "absoluteStartS": 18.986,
          "absoluteEndS": 21.821
        },
        {
          "text": "Publié rend la page accessible.",
          "startMs": 3696,
          "endMs": 5864,
          "method": "silence",
          "absoluteStartS": 22.205,
          "absoluteEndS": 24.373
        },
        {
          "text": "Archivé conserve les données et les rapports dans l’administration mais ferme le cycle de vie.",
          "startMs": 6589,
          "endMs": 11836,
          "method": "silence",
          "absoluteStartS": 25.098,
          "absoluteEndS": 30.345
        },
        {
          "text": "Un événement ne peut passer à Publié que s’il possède au moins un créneau actif.",
          "startMs": 12649,
          "endMs": 17329,
          "method": "silence",
          "absoluteStartS": 31.158,
          "absoluteEndS": 35.838
        }
      ],
      "markers": []
    },
    {
      "id": "unlisted",
      "startMs": 38427,
      "endMs": 59754,
      "sentences": [
        {
          "text": "L’option Afficher cet événement sur la page publique de l’organisation agit à part.",
          "startMs": 432,
          "endMs": 5445,
          "method": "silence",
          "absoluteStartS": 38.859,
          "absoluteEndS": 43.872
        },
        {
          "text": "Décochée sur un événement publié, elle le retire de cette page et du référencement, tout en gardant son lien direct et son QR code fonctionnels.",
          "startMs": 5578,
          "endMs": 15212,
          "method": "silence",
          "absoluteStartS": 44.005,
          "absoluteEndS": 53.639
        },
        {
          "text": "Ce n’est donc pas une protection par mot de passe :",
          "startMs": 15977,
          "endMs": 18429,
          "method": "silence",
          "absoluteStartS": 54.404,
          "absoluteEndS": 56.856
        },
        {
          "text": "toute personne qui possède le lien peut l’ouvrir.",
          "startMs": 18593,
          "endMs": 20753,
          "method": "silence",
          "absoluteStartS": 57.02,
          "absoluteEndS": 59.18
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 45293
        }
      ]
    },
    {
      "id": "window",
      "startMs": 61928,
      "endMs": 80453,
      "sentences": [
        {
          "text": "Les inscriptions peuvent être fermées immédiatement ou programmées.",
          "startMs": 585,
          "endMs": 3827,
          "method": "silence",
          "absoluteStartS": 62.513,
          "absoluteEndS": 65.755
        },
        {
          "text": "Indiquons une ouverture et une fermeture dans le fuseau de l’organisation.",
          "startMs": 4600,
          "endMs": 8006,
          "method": "silence",
          "absoluteStartS": 66.528,
          "absoluteEndS": 69.934
        },
        {
          "text": "La page reste visible pendant toute la période, mais le formulaire n’accepte des choix que lorsque la case Inscriptions ouvertes est cochée et que la fenêtre est active.",
          "startMs": 8468,
          "endMs": 18127,
          "method": "silence",
          "absoluteStartS": 70.396,
          "absoluteEndS": 80.055
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 67042
        },
        {
          "kind": "click",
          "atMs": 68875
        }
      ]
    },
    {
      "id": "public-result",
      "startMs": 82060,
      "endMs": 98164,
      "sentences": [
        {
          "text": "Côté bénévole, la page explique clairement que les inscriptions ne sont pas encore ouvertes et affiche la date prévue.",
          "startMs": 353,
          "endMs": 6897,
          "method": "silence",
          "absoluteStartS": 82.413,
          "absoluteEndS": 88.957
        },
        {
          "text": "Les informations de l’événement restent consultables.",
          "startMs": 7733,
          "endMs": 9894,
          "method": "silence",
          "absoluteStartS": 89.793,
          "absoluteEndS": 91.954
        },
        {
          "text": "Une fois la fenêtre ouverte, le même lien présente automatiquement le planning sans nouvelle publication.",
          "startMs": 10596,
          "endMs": 15679,
          "method": "silence",
          "absoluteStartS": 92.656,
          "absoluteEndS": 97.739
        }
      ],
      "markers": []
    },
    {
      "id": "archive",
      "startMs": 98618,
      "endMs": 113989,
      "sentences": [
        {
          "text": "Après l’événement, Archivé retire la page du parcours courant et garde l’historique, les inscriptions et les exports disponibles dans l’administration.",
          "startMs": 427,
          "endMs": 9102,
          "method": "silence",
          "absoluteStartS": 99.045,
          "absoluteEndS": 107.72
        },
        {
          "text": "Fermer les inscriptions suffit pour une pause temporaire ;",
          "startMs": 9776,
          "endMs": 12693,
          "method": "silence",
          "absoluteStartS": 108.394,
          "absoluteEndS": 111.311
        },
        {
          "text": "archiver signifie que l’événement est terminé.",
          "startMs": 12930,
          "endMs": 15031,
          "method": "silence",
          "absoluteStartS": 111.548,
          "absoluteEndS": 113.649
        }
      ],
      "markers": []
    },
    {
      "id": "result",
      "startMs": 114443,
      "endMs": 134730,
      "sentences": [
        {
          "text": "Choisis donc chaque état selon l’intention :",
          "startMs": 197,
          "endMs": 2704,
          "method": "silence",
          "absoluteStartS": 114.64,
          "absoluteEndS": 117.147
        },
        {
          "text": "brouillon pendant la préparation, publié répertorié pour recruter largement, publié non répertorié pour un partage par lien, fenêtre programmée pour maîtriser le calendrier, puis archive pour conserver sans encombrer.",
          "startMs": 3439,
          "endMs": 20003,
          "method": "silence",
          "absoluteStartS": 117.882,
          "absoluteEndS": 134.446
        }
      ],
      "markers": []
    }
  ]
