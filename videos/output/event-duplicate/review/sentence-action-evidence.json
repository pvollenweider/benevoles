[
  {
    "chapter": "welcome",
    "startMs": 1092,
    "endMs": 12417,
    "sentences": [
      {
        "text": "Dupliquer évite de reconstruire chaque année un événement qui garde la même organisation.",
        "startMs": 191,
        "endMs": 4424,
        "method": "silence",
        "absoluteStartMs": 1283
      },
      {
        "text": "La copie reste un nouveau brouillon :",
        "startMs": 4787,
        "endMs": 6921,
        "method": "silence",
        "absoluteStartMs": 5879
      },
      {
        "text": "on gagne la structure sans mélanger les bénévoles ni l’historique de deux éditions.",
        "startMs": 7136,
        "endMs": 10969,
        "method": "silence",
        "absoluteStartMs": 8228
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "identity",
    "startMs": 12869,
    "endMs": 25852,
    "sentences": [
      {
        "text": "Commencez par donner le titre de la nouvelle édition et son premier jour.",
        "startMs": 359,
        "endMs": 4222,
        "method": "silence",
        "absoluteStartMs": 13228
      },
      {
        "text": "Toutes les dates suivent le même décalage :",
        "startMs": 4697,
        "endMs": 6385,
        "method": "silence",
        "absoluteStartMs": 17566
      },
      {
        "text": "fin de l’événement, créneaux et programme.",
        "startMs": 6385,
        "endMs": 8859,
        "method": "estimate",
        "absoluteStartMs": 19254
      },
      {
        "text": "Le résumé indique immédiatement de combien de jours elles seront déplacées.",
        "startMs": 9222,
        "endMs": 12602,
        "method": "silence",
        "absoluteStartMs": 22091
      }
    ],
