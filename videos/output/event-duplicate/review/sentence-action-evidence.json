  {
    "chapter": "summary",
    "startMs": 58601,
    "endMs": 72440,
    "sentences": [
      {
        "text": "Le récapitulatif est la dernière vérification.",
        "startMs": 458,
        "endMs": 3542,
        "method": "silence",
        "absoluteStartMs": 59059
      },
      {
        "text": "Il rappelle les éléments copiés et ceux qui ne le sont jamais :",
        "startMs": 3918,
        "endMs": 7146,
        "method": "silence",
        "absoluteStartMs": 62519
      },
      {
        "text": "les inscriptions et les jalons.",
        "startMs": 7357,
        "endMs": 8365,
        "method": "silence",
        "absoluteStartMs": 65958
      },
      {
        "text": "On ne transporte donc ni des engagements obsolètes, ni des tâches déjà terminées.",
        "startMs": 8543,
        "endMs": 13471,
        "method": "silence",
        "absoluteStartMs": 67144
      }
    ],
    "anchors": [
      {
        "segmentId": "summary",
        "phrase": "les inscriptions et les jalons.",
        "startMs": 7357,
        "endMs": 8365,
        "cueMs": 65958
      }
    ],
    "interactions": []
  },
  {
    "chapter": "create",
    "startMs": 72890,
    "endMs": 88957,
    "sentences": [
      {
        "text": "Créons la copie.",
        "startMs": 315,
        "endMs": 1419,
        "method": "silence",
        "absoluteStartMs": 73205
      },
      {
        "text": "Elle s’ouvre dans l’administration avec le statut Brouillon.",
        "startMs": 1950,
        "endMs": 4976,
        "method": "silence",
        "absoluteStartMs": 74840
      },
      {
        "text": "Vérifions ses réglages :",
        "startMs": 5568,
        "endMs": 6758,
        "method": "silence",
        "absoluteStartMs": 78458
      },
      {
        "text": "les inscriptions sont fermées.",
        "startMs": 7082,
        "endMs": 8464,
        "method": "silence",
        "absoluteStartMs": 79972
      },
      {
        "text": "La nouvelle édition n'est donc pas encore proposée aux bénévoles.",
        "startMs": 8904,
        "endMs": 11513,
        "method": "silence",
        "absoluteStartMs": 81794
      },
      {
        "text": "Nous pouvons préparer et relire tranquillement cette copie avant de la publier.",
        "startMs": 11752,
        "endMs": 15647,
        "method": "silence",
        "absoluteStartMs": 84642
      }
    ],
