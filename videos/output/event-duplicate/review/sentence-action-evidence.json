  {
    "chapter": "choices",
    "startMs": 26304,
    "endMs": 43519,
    "sentences": [
      {
        "text": "Choisissez ensuite ce qui doit suivre.",
        "startMs": 356,
        "endMs": 2467,
        "method": "silence",
        "absoluteStartMs": 26660
      },
      {
        "text": "Les créneaux conservent postes, horaires, capacités et consignes, mais reviennent ouverts et sans inscription.",
        "startMs": 2911,
        "endMs": 9087,
        "method": "silence",
        "absoluteStartMs": 29215
      },
      {
        "text": "Les réglages reprennent les messages, questions, téléphone et programme.",
        "startMs": 9698,
        "endMs": 13926,
        "method": "silence",
        "absoluteStartMs": 36002
      },
      {
        "text": "Les pages personnalisées peuvent aussi être copiées.",
        "startMs": 14314,
        "endMs": 16866,
        "method": "silence",
        "absoluteStartMs": 40618
      }
    ],
    "anchors": [
