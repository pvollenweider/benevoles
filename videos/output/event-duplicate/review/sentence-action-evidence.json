        "cueMs": 40618
      }
    ],
    "interactions": []
  },
  {
    "chapter": "leaders",
    "startMs": 43972,
    "endMs": 58147,
    "sentences": [
      {
        "text": "Les responsables de secteur sont volontairement décochés au départ, car les reprendre déclenche immédiatement un email avec un nouveau lien personnel.",
        "startMs": 347,
        "endMs": 7596,
        "method": "silence",
        "absoluteStartMs": 44319
      },
      {
        "text": "Activez cette option seulement après avoir vérifié que ces personnes gardent leur responsabilité pour la nouvelle édition.",
        "startMs": 8070,
        "endMs": 13726,
        "method": "silence",
        "absoluteStartMs": 52042
      }
    ],
    "anchors": [
      {
        "segmentId": "leaders",
