  {
    "chapter": "copied-details",
    "startMs": 89410,
    "endMs": 107310,
    "sentences": [
      {
        "text": "Ouvrons le planning de la nouvelle édition.",
        "startMs": 418,
        "endMs": 2364,
        "method": "silence",
        "absoluteStartMs": 89828
      },
      {
        "text": "Les dates ont été décalées et les créneaux repartent sans inscription.",
        "startMs": 3060,
        "endMs": 6253,
        "method": "silence",
        "absoluteStartMs": 92470
      },
      {
        "text": "Nous retrouvons les postes et leurs horaires, mais aucun engagement de l'année précédente.",
        "startMs": 6801,
        "endMs": 10954,
        "method": "silence",
        "absoluteStartMs": 96211
      },
      {
        "text": "Les pages personnalisées sont également reprises :",
        "startMs": 11676,
        "endMs": 14135,
        "method": "silence",
        "absoluteStartMs": 101086
      },
      {
        "text": "ouvrons leur liste dans cette nouvelle édition pour vérifier leur présence.",
        "startMs": 14705,
        "endMs": 17601,
        "method": "silence",
        "absoluteStartMs": 104115
      }
    ],
    "anchors": [
      {
        "segmentId": "copied-details",
        "phrase": "ouvrons leur liste dans cette nouvelle édition",
        "startMs": 14705,
        "endMs": 17601,
        "cueMs": 104116
      }
    ],
    "interactions": []
  },
  {
    "chapter": "leader-emails",
    "startMs": 107762,
    "endMs": 126688,
    "sentences": [
      {
        "text": "Les responsables que nous avons conservés ont chacun reçu une nouvelle invitation.",
        "startMs": 306,
        "endMs": 4701,
        "method": "silence",
        "absoluteStartMs": 108068
      },
      {
        "text": "Ouvrons le message réellement arrivé dans la boîte de formation.",
        "startMs": 4941,
        "endMs": 7824,
        "method": "silence",
        "absoluteStartMs": 112703
      },
      {
        "text": "Il nomme la nouvelle édition et contient un nouveau lien personnel de responsable.",
        "startMs": 8534,
        "endMs": 13290,
        "method": "silence",
        "absoluteStartMs": 116296
      },
      {
        "text": "Cette vérification permet de distinguer l'invitation de la copie et celle de l'événement d'origine.",
        "startMs": 13429,
        "endMs": 18922,
        "method": "silence",
        "absoluteStartMs": 121191
      }
    ],
    "anchors": [
      {
        "segmentId": "leader-emails",
        "phrase": "Ouvrons le message réellement arrivé",
        "startMs": 4941,
        "endMs": 7824,
        "cueMs": 112705
      }
    ],
    "interactions": []
  },
  {
    "chapter": "result",
    "startMs": 127143,
    "endMs": 140655,
    "sentences": [
      {
        "text": "Avant toute publication, relisez les horaires, adaptez les capacités et les consignes, puis testez le parcours bénévole.",
        "startMs": 150,
        "endMs": 6933,
        "method": "silence",
        "absoluteStartMs": 127293
      },
      {
        "text": "La duplication accélère la préparation, mais elle ne suppose jamais que la nouvelle édition est identique à l’ancienne.",
        "startMs": 7542,
        "endMs": 13196,
        "method": "silence",
        "absoluteStartMs": 134685
      }
    ],
    "anchors": [
