[
  {
    "chapter": "welcome",
    "startMs": 1106,
    "endMs": 14587,
    "sentences": [
      {
        "text": "Certaines missions demandent une règle simple :",
        "startMs": 0,
        "endMs": 2138,
        "method": "silence",
        "absoluteStartMs": 1106
      },
      {
        "text": "un âge minimum, un nombre maximum de créneaux, ou l’appartenance à une équipe déjà formée.",
        "startMs": 2289,
        "endMs": 7381,
        "method": "silence",
        "absoluteStartMs": 3395
      },
      {
        "text": "Ces contrôles évitent les affectations impossibles tout en expliquant clairement la situation avant l’inscription.",
        "startMs": 7558,
        "endMs": 13153,
        "method": "silence",
        "absoluteStartMs": 8664
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
