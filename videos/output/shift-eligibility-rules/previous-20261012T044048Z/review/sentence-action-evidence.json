  {
    "chapter": "eligible",
    "startMs": 78814,
    "endMs": 92438,
    "sentences": [
      {
        "text": "Julien possède le tag sécurité.",
        "startMs": 124,
        "endMs": 1702,
        "method": "silence",
        "absoluteStartMs": 78938
      },
      {
        "text": "En ouvrant son invitation, la même mission devient sélectionnable :",
