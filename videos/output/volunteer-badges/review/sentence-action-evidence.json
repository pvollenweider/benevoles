    {
      "chapter": "colors",
      "startSeconds": 124.485,
      "endSeconds": 145.224,
      "sentences": [
        {
          "text": "Le bandeau peut prendre la couleur du poste, celle de l'événement ou rester noir et blanc.",
          "startMs": 435,
          "endMs": 4326,
          "method": "silence",
          "videoSeconds": 124.92
        },
        {
          "text": "Générons les trois versions pour les comparer.",
          "startMs": 5133,
          "endMs": 6685,
          "method": "silence",
          "videoSeconds": 129.618
        },
        {
          "text": "Avec plusieurs postes, le bandeau ne devient pas multicolore :",
          "startMs": 7641,
          "endMs": 10484,
          "method": "silence",
          "videoSeconds": 132.126
        },
        {
          "text": "une couleur de poste est retenue, avec la couleur d'événement comme solution de repli.",
          "startMs": 10731,
          "endMs": 14245,
          "method": "silence",
          "videoSeconds": 135.216
        },
        {
          "text": "Pour une impression simple, le noir et blanc est pratique.",
          "startMs": 14828,
          "endMs": 17200,
          "method": "silence",
          "videoSeconds": 139.313
        },
        {
          "text": "Dans tous les cas, le prénom et le poste doivent rester faciles à lire.",
          "startMs": 17485,
          "endMs": 20352,
          "method": "silence",
          "videoSeconds": 141.97
        }
