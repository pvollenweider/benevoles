    {
      "chapter": "fields",
      "startSeconds": 147.504,
      "endSeconds": 170.922,
      "sentences": [
        {
          "text": "Vous pouvez alléger le badge en retirant le nom de famille ou les créneaux.",
          "startMs": 225,
          "endMs": 3523,
          "method": "silence",
          "videoSeconds": 147.729
        },
        {
          "text": "Décochons les deux cases, générons et regardons ce qui disparaît :",
          "startMs": 3991,
          "endMs": 7020,
          "method": "silence",
          "videoSeconds": 151.495
        },
        {
          "text": "le prénom reste.",
          "startMs": 7486,
          "endMs": 8279,
          "method": "silence",
          "videoSeconds": 154.99
        },
        {
          "text": "Remettons-les ensuite.",
          "startMs": 8986,
          "endMs": 9796,
          "method": "silence",
          "videoSeconds": 156.49
        },
        {
