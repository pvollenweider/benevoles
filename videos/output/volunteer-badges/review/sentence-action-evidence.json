    {
      "chapter": "individual",
      "startSeconds": 75.236,
      "endSeconds": 99.333,
      "sentences": [
        {
          "text": "Un badge perdu ?",
          "startMs": 494,
          "endMs": 1124,
          "method": "silence",
          "videoSeconds": 75.73
        },
        {
          "text": "Choisissez une personne dans Bénévole, réimpression.",
          "startMs": 1660,
          "endMs": 3791,
          "method": "silence",
          "videoSeconds": 76.896
        },
        {
          "text": "Nous avons deux Camille Berger :",
          "startMs": 3999,
          "endMs": 4566,
          "method": "silence",
          "videoSeconds": 79.235
        },
        {
          "text": "l'adresse affichée dans la sélection permet de les distinguer.",
          "startMs": 5259,
          "endMs": 9377,
          "method": "silence",
          "videoSeconds": 80.495
        },
        {
          "text": "Elle n'est pas imprimée sur le badge.",
