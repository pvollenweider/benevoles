    {
      "chapter": "individual",
      "startSeconds": 75.252,
      "endSeconds": 99.214,
      "sentences": [
        {
          "text": "Un badge perdu ?",
          "startMs": 494,
          "endMs": 1124,
          "method": "silence",
          "videoSeconds": 75.746
        },
        {
          "text": "Choisis une personne dans Bénévole, réimpression.",
          "startMs": 1813,
          "endMs": 3372,
          "method": "silence",
          "videoSeconds": 77.065
        },
        {
          "text": "Nous avons deux Camille Berger :",
          "startMs": 3673,
          "endMs": 4270,
          "method": "silence",
          "videoSeconds": 78.925
        },
        {
          "text": "l'adresse affichée dans la sélection permet de les distinguer.",
          "startMs": 5123,
          "endMs": 9241,
          "method": "silence",
          "videoSeconds": 80.375
        },
        {
          "text": "Elle n'est pas imprimée sur le badge.",
          "startMs": 9817,
          "endMs": 10966,
          "method": "silence",
          "videoSeconds": 85.069
        },
        {
          "text": "Attention au filtre de poste encore actif :",
          "startMs": 11767,
          "endMs": 13415,
          "method": "silence",
          "videoSeconds": 87.019
        },
        {
          "text": "une réimpression individuelle garde cette restriction.",
          "startMs": 13928,
          "endMs": 15959,
          "method": "silence",
          "videoSeconds": 89.18
        },
        {
          "text": "Sélectionnons la bonne Camille, puis générons sa feuille.",
          "startMs": 16709,
          "endMs": 19342,
          "method": "silence",
          "videoSeconds": 91.961
        },
        {
          "text": "Vérifier l'identité avant de cliquer évite de remettre le planning de l'autre personne.",
