    {
      "chapter": "all",
      "startSeconds": 24.227,
      "endSeconds": 48.622,
      "sentences": [
        {
          "text": "Gardons Tous les postes et Tous les bénévoles, puis ouvrons les badges.",
          "startMs": 497,
          "endMs": 4267,
          "method": "silence",
          "videoSeconds": 24.724
        },
        {
          "text": "La série comporte un badge par personne confirmée, pas un badge par inscription.",
          "startMs": 5003,
          "endMs": 8802,
          "method": "silence",
          "videoSeconds": 29.23
        },
        {
          "text": "Léa est sur plusieurs horaires :",
          "startMs": 9569,
          "endMs": 10875,
          "method": "silence",
          "videoSeconds": 33.796
        },
        {
          "text": "elle n'a qu'un badge.",
          "startMs": 11157,
          "endMs": 11905,
          "method": "silence",
          "videoSeconds": 35.384
        },
        {
          "text": "Regardons la première feuille puis la suivante.",
          "startMs": 12757,
          "endMs": 14657,
          "method": "silence",
          "videoSeconds": 36.984
        },
        {
          "text": "Le format prévoit dix badges par page A4, en deux colonnes et cinq rangées.",
          "startMs": 15572,
          "endMs": 17674,
          "method": "silence",
          "videoSeconds": 39.799
        },
        {
          "text": "Les personnes seulement en demande ou en attente ne sont pas présentées comme des bénévoles confirmés.",
          "startMs": 17927,
          "endMs": 23939,
          "method": "silence",
          "videoSeconds": 42.154
        }
      ],
