    {
      "chapter": "fields",
      "startSeconds": 146.643,
      "endSeconds": 169.467,
      "sentences": [
        {
          "text": "Tu peux alléger le badge en retirant le nom de famille ou les créneaux.",
          "startMs": 402,
          "endMs": 3002,
          "method": "silence",
          "videoSeconds": 147.045
        },
        {
          "text": "Décochons les deux cases, générons et regardons ce qui disparaît :",
          "startMs": 3413,
          "endMs": 6442,
          "method": "silence",
          "videoSeconds": 150.056
        },
        {
          "text": "le prénom reste.",
          "startMs": 6907,
          "endMs": 7700,
          "method": "silence",
          "videoSeconds": 153.55
        },
        {
          "text": "Remettons-les ensuite.",
          "startMs": 8407,
          "endMs": 9218,
          "method": "silence",
          "videoSeconds": 155.05
        },
        {
          "text": "Léa a cinq créneaux :",
          "startMs": 10045,
          "endMs": 11265,
