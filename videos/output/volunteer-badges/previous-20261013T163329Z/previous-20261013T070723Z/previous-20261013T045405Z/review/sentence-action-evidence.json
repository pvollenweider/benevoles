    {
      "chapter": "individual",
      "startSeconds": 75.237,
      "endSeconds": 99.195,
      "sentences": [
        {
          "text": "Un badge perdu ?",
          "startMs": 494,
          "endMs": 1124,
          "method": "silence",
          "videoSeconds": 75.731
        },
        {
          "text": "Choisis une personne dans Bénévole, réimpression.",
          "startMs": 1813,
          "endMs": 3372,
          "method": "silence",
          "videoSeconds": 77.05
        },
        {
          "text": "Nous avons deux Camille Berger :",
          "startMs": 3673,
          "endMs": 4270,
          "method": "silence",
          "videoSeconds": 78.91
        },
        {
          "text": "l'adresse affichée dans la sélection permet de les distinguer.",
          "startMs": 5123,
          "endMs": 9241,
          "method": "silence",
          "videoSeconds": 80.36
        },
        {
          "text": "Elle n'est pas imprimée sur le badge.",
          "startMs": 9817,
          "endMs": 10966,
          "method": "silence",
          "videoSeconds": 85.054
        },
        {
          "text": "Attention au filtre de poste encore actif :",
          "startMs": 11767,
          "endMs": 13415,
          "method": "silence",
          "videoSeconds": 87.004
        },
        {
          "text": "une réimpression individuelle garde cette restriction.",
          "startMs": 13928,
          "endMs": 15959,
          "method": "silence",
          "videoSeconds": 89.165
        },
        {
          "text": "Sélectionnons la bonne Camille, puis générons sa feuille.",
          "startMs": 16709,
          "endMs": 19342,
          "method": "silence",
          "videoSeconds": 91.946
        },
        {
          "text": "Vérifier l'identité avant de cliquer évite de remettre le planning de l'autre personne.",
          "startMs": 20057,
