  "chapters": [
    {
      "chapter": "welcome",
      "startSeconds": 1.135,
      "endSeconds": 21.952,
      "sentences": [
        {
          "text": "Un prénom visible et le bon poste :",
          "startMs": 253,
          "endMs": 2123,
          "method": "silence",
          "videoSeconds": 1.388
        },
        {
          "text": "un badge peut suffire à rendre l'accueil plus chaleureux et plus simple.",
          "startMs": 2629,
          "endMs": 5742,
          "method": "silence",
          "videoSeconds": 3.764
        },
        {
          "text": "Depuis Rapports, ouvrons les options des badges.",
          "startMs": 6540,
          "endMs": 8847,
          "method": "silence",
          "videoSeconds": 7.675
        },
        {
          "text": "Nous allons préparer une série, réimprimer une seule personne et vérifier les feuilles avant de les découper.",
          "startMs": 9434,
          "endMs": 14840,
          "method": "silence",
          "videoSeconds": 10.569
        },
        {
          "text": "Ce badge identifie un membre de l'équipe ;",
          "startMs": 15724,
          "endMs": 17595,
          "method": "silence",
          "videoSeconds": 16.859
        },
        {
          "text": "il n'est ni un contrôle d'accès, ni une preuve de présence.",
          "startMs": 17946,
          "endMs": 20328,
          "method": "silence",
          "videoSeconds": 19.081
        }
      ],
      "anchors": [
        {
          "segmentId": "welcome",
          "phrase": "Depuis Rapports, ouvrons les options",
