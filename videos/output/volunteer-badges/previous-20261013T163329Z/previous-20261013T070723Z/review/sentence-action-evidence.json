    {
      "chapter": "fields",
      "startSeconds": 146.638,
      "endSeconds": 169.463,
      "sentences": [
        {
          "text": "Tu peux alléger le badge en retirant le nom de famille ou les créneaux.",
          "startMs": 402,
          "endMs": 3002,
          "method": "silence",
          "videoSeconds": 147.04
        },
        {
          "text": "Décochons les deux cases, générons et regardons ce qui disparaît :",
          "startMs": 3413,
          "endMs": 6442,
          "method": "silence",
          "videoSeconds": 150.051
        },
        {
          "text": "le prénom reste.",
          "startMs": 6907,
          "endMs": 7700,
          "method": "silence",
          "videoSeconds": 153.545
        },
        {
          "text": "Remettons-les ensuite.",
          "startMs": 8407,
          "endMs": 9218,
          "method": "silence",
          "videoSeconds": 155.045
        },
        {
