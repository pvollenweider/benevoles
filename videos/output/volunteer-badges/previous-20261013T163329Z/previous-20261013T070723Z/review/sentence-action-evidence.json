    {
      "chapter": "role",
      "startSeconds": 50.876,
      "endSeconds": 72.966,
      "sentences": [
        {
          "text": "Pour préparer seulement la buvette, revenons au formulaire et choisissons ce poste.",
          "startMs": 464,
          "endMs": 4223,
          "method": "silence",
          "videoSeconds": 51.34
        },
        {
          "text": "Les personnes retenues ont une inscription confirmée à la buvette.",
          "startMs": 5000,
          "endMs": 7630,
          "method": "silence",
          "videoSeconds": 55.876
        },
        {
          "text": "Comparons le badge de Léa avec sa version complète :",
          "startMs": 8651,
          "endMs": 10735,
          "method": "silence",
          "videoSeconds": 59.527
        },
        {
          "text": "ses autres postes ne figurent plus dans cette version filtrée.",
          "startMs": 11560,
          "endMs": 13819,
          "method": "silence",
          "videoSeconds": 62.436
        },
        {
          "text": "Le filtre change le contenu généré, pas ses inscriptions.",
          "startMs": 14459,
          "endMs": 17202,
          "method": "silence",
          "videoSeconds": 65.335
        },
        {
          "text": "Si tu veux son badge pour toute la fête, reviens à Tous les postes avant de le refaire.",
          "startMs": 17782,
