    {
      "chapter": "empty",
      "startSeconds": 101.454,
      "endSeconds": 121.372,
      "sentences": [
        {
          "text": "Si tu combines un poste et une personne qui n'y est pas inscrite, la sélection ne donne aucun badge.",
