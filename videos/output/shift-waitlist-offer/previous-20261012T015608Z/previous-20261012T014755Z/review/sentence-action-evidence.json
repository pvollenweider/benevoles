        "cueMs": 75445
      }
    ],
    "interactions": []
  },
  {
    "chapter": "result",
    "startMs": 83123,
    "endMs": 94879,
    "sentences": [
      {
        "text": "La liste d’attente est utile pour les missions demandées, mais elle doit rester compréhensible.",
        "startMs": 305,
        "endMs": 4741,
        "method": "silence",
        "absoluteStartMs": 83428
      },
      {
        "text": "Vérifie la capacité, l’ordre, l’offre en cours et les délais avant de promettre une place à quelqu’un par un autre canal.",
        "startMs": 5193,
        "endMs": 11445,
        "method": "silence",
        "absoluteStartMs": 88316
      }
    ],
