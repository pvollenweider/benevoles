  {
    "chapter": "admin",
    "startMs": 30359,
    "endMs": 42442,
    "sentences": [
      {
        "text": "Dans l’administration, les inscriptions confirmées et les personnes en attente restent distinctes.",
        "startMs": 245,
        "endMs": 5104,
        "method": "silence",
        "absoluteStartMs": 30604
      },
      {
        "text": "L’ordre dépend du moment d’inscription.",
        "startMs": 5396,
        "endMs": 6854,
        "method": "silence",
        "absoluteStartMs": 35755
      },
      {
        "text": "On peut ainsi répondre à une question sans déplacer manuellement les lignes ni perdre l’historique.",
        "startMs": 7516,
        "endMs": 11837,
        "method": "silence",
        "absoluteStartMs": 37875
      }
    ],
    "anchors": [
      {
        "segmentId": "admin",
        "phrase": "On peut ainsi répondre à",
        "startMs": 7516,
        "endMs": 11837,
        "cueMs": 37875
      }
    ],
    "interactions": []
  },
  {
    "chapter": "release",
    "startMs": 44605,
    "endMs": 56024,
    "sentences": [
      {
        "text": "Quand une personne confirmée se désinscrit, la place n’est pas attribuée silencieusement.",
        "startMs": 136,
        "endMs": 4558,
        "method": "silence",
        "absoluteStartMs": 44741
      },
      {
        "text": "Une offre est envoyée à la première personne en attente.",
        "startMs": 5204,
        "endMs": 7295,
        "method": "silence",
        "absoluteStartMs": 49809
      },
      {
        "text": "Elle dispose de vingt-quatre heures pour accepter depuis son lien personnel.",
        "startMs": 7813,
        "endMs": 11292,
        "method": "silence",
        "absoluteStartMs": 52418
      }
    ],
    "anchors": [],
    "interactions": [
      {
        "kind": "click",
