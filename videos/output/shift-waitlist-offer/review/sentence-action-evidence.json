      },
      {
        "kind": "click",
        "atMs": 51005
      }
    ]
  },
  {
    "chapter": "volunteer",
    "startMs": 56476,
    "endMs": 70861,
    "sentences": [
      {
        "text": "Sur sa page, la personne voit l’offre, son expiration et les actions Prendre la place ou Refuser la place.",
        "startMs": 173,
        "endMs": 5986,
        "method": "silence",
        "absoluteStartMs": 56649
      },
      {
        "text": "Prendre la place confirme immédiatement le créneau.",
        "startMs": 6509,
        "endMs": 8653,
        "method": "silence",
        "absoluteStartMs": 62985
      },
      {
        "text": "Refuser la place conserve une réponse explicite et permet de contacter la personne suivante.",
        "startMs": 9286,
        "endMs": 14383,
        "method": "silence",
        "absoluteStartMs": 65762
      }
    ],
