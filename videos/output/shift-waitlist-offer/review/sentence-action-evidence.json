[
  {
    "chapter": "welcome",
    "startMs": 1127,
    "endMs": 14170,
    "sentences": [
      {
        "text": "Une capacité protège l’organisation contre le sureffectif, mais un créneau complet ne doit pas faire perdre les personnes encore disponibles.",
        "startMs": 215,
        "endMs": 7007,
        "method": "silence",
        "absoluteStartMs": 1342
      },
      {
        "text": "La liste d’attente conserve leur intérêt dans un ordre clair et automatise la proposition lorsqu’une place se libère.",
        "startMs": 7480,
        "endMs": 12873,
        "method": "silence",
        "absoluteStartMs": 8607
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "setup",
    "startMs": 16289,
    "endMs": 29905,
    "sentences": [
      {
        "text": "La liste d’attente s’active sur le créneau.",
        "startMs": 234,
        "endMs": 2306,
        "method": "silence",
        "absoluteStartMs": 16523
      },
      {
        "text": "Tant que la capacité n’est pas atteinte, les inscriptions sont confirmées normalement.",
        "startMs": 3051,
        "endMs": 6542,
        "method": "silence",
        "absoluteStartMs": 19340
      },
      {
        "text": "Une fois le créneau complet, le prochain bénévole rejoint l’attente et voit sa position au lieu de recevoir une fausse confirmation.",
        "startMs": 7269,
        "endMs": 13371,
        "method": "silence",
        "absoluteStartMs": 23558
      }
    ],
