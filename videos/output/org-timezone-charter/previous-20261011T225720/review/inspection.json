  "chapters": [
    {
      "id": "welcome",
      "startMs": 1121,
      "endMs": 12323,
      "sentences": [
        {
          "text": "Deux réglages communs évitent beaucoup de malentendus :",
          "startMs": 276,
          "endMs": 2579,
          "method": "silence",
          "absoluteStartS": 1.397,
          "absoluteEndS": 3.7
        },
        {
          "text": "le fuseau horaire donne la bonne référence aux calculs automatiques, et la Convention des Bénévoles explique clairement le cadre accepté avant chaque inscription.",
          "startMs": 2906,
          "endMs": 10679,
          "method": "silence",
          "absoluteStartS": 4.027,
          "absoluteEndS": 11.8
        }
      ],
      "markers": []
    },
    {
      "id": "timezone",
      "startMs": 14486,
      "endMs": 28619,
      "sentences": [
        {
          "text": "Dans Paramètres, choisissez le fuseau du lieu où se déroulent vos événements.",
          "startMs": 525,
          "endMs": 3621,
          "method": "silence",
          "absoluteStartS": 15.011,
          "absoluteEndS": 18.107
        },
        {
          "text": "Europe Zurich tient compte de l’heure d’hiver et de l’heure d’été.",
          "startMs": 4262,
          "endMs": 6630,
          "method": "silence",
          "absoluteStartS": 18.748,
          "absoluteEndS": 21.116
        },
        {
          "text": "Ce réglage donne la bonne référence aux rappels, aux délais des offres de liste d’attente et aux dates affichées dans le journal et les documents.",
          "startMs": 7234,
          "endMs": 13639,
          "method": "silence",
          "absoluteStartS": 21.72,
          "absoluteEndS": 28.125
        }
      ],
      "markers": []
    },
    {
      "id": "timezone-result",
      "startMs": 29072,
      "endMs": 40985,
      "sentences": [
        {
          "text": "Enregistrer le fuseau ne décale pas les heures saisies dans le planning :",
          "startMs": 494,
          "endMs": 3272,
          "method": "silence",
          "absoluteStartS": 29.566,
          "absoluteEndS": 32.344
        },
        {
          "text": "un créneau prévu à neuf heures reste affiché à neuf heures.",
          "startMs": 3426,
          "endMs": 5515,
          "method": "silence",
          "absoluteStartS": 32.498,
          "absoluteEndS": 34.587
        },
        {
          "text": "Le réglage permet au système de convertir correctement cette heure locale en instant réel, y compris le dimanche d’un changement d’heure.",
          "startMs": 5941,
          "endMs": 11455,
          "method": "silence",
          "absoluteStartS": 35.013,
          "absoluteEndS": 40.527
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 29540
        }
      ]
    },
    {
      "id": "charter",
      "startMs": 43158,
      "endMs": 66113,
      "sentences": [
        {
          "text": "La Convention des Bénévoles présente le cadre de l’engagement.",
          "startMs": 463,
          "endMs": 2825,
          "method": "silence",
          "absoluteStartS": 43.621,
          "absoluteEndS": 45.983
        },
        {
          "text": "Le réglage Assurance RC fournie par l’organisation change la clause correspondante et remplit de nouveau le texte proposé :",
          "startMs": 3704,
          "endMs": 9764,
          "method": "silence",
          "absoluteStartS": 46.862,
          "absoluteEndS": 52.922
        },
        {
          "text": "choisissez-le selon la situation réelle de votre association.",
          "startMs": 9898,
          "endMs": 12934,
          "method": "silence",
          "absoluteStartS": 53.056,
          "absoluteEndS": 56.092
        },
        {
          "text": "Ici, nous conservons le texte complet, notamment la consigne de prévenir dès que possible.",
          "startMs": 13130,
          "endMs": 17216,
          "method": "silence",
          "absoluteStartS": 56.288,
          "absoluteEndS": 60.374
        },
        {
          "text": "Réinitialiser la convention par défaut remplit le champ, mais il faut ensuite cliquer sur Enregistrer.",
          "startMs": 17858,
          "endMs": 22512,
          "method": "silence",
          "absoluteStartS": 61.016,
          "absoluteEndS": 65.67
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 47360
        },
        {
          "kind": "click",
          "atMs": 48909
        },
        {
          "kind": "click",
          "atMs": 61493
        },
        {
          "kind": "click",
          "atMs": 62292
        },
        {
          "kind": "click",
          "atMs": 63141
        }
      ]
    },
    {
      "id": "public-setup",
      "startMs": 68280,
      "endMs": 81444,
      "sentences": [
        {
          "text": "Vérifions le résultat côté bénévole.",
          "startMs": 441,
          "endMs": 1821,
          "method": "silence",
          "absoluteStartS": 68.721,
          "absoluteEndS": 70.101
        },
        {
          "text": "Ouvrez l’événement public, sélectionnez un créneau, puis cliquez sur Continuer.",
          "startMs": 2477,
          "endMs": 6478,
          "method": "silence",
          "absoluteStartS": 70.757,
          "absoluteEndS": 74.758
        },
        {
          "text": "Vous arrivez au formulaire, avec les informations demandées et les consentements, avant toute confirmation d’inscription.",
          "startMs": 7228,
          "endMs": 13162,
          "method": "silence",
          "absoluteStartS": 75.508,
          "absoluteEndS": 81.442
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 71649
        },
        {
          "kind": "click",
          "atMs": 75981
        }
      ]
    },
    {
      "id": "public-result",
      "startMs": 81897,
      "endMs": 95721,
      "sentences": [
        {
          "text": "Ouvrez la convention depuis le formulaire.",
          "startMs": 0,
          "endMs": 1598,
          "method": "silence",
          "absoluteStartS": 81.897,
          "absoluteEndS": 83.495
        },
        {
          "text": "Le texte enregistré est présenté au bénévole :",
          "startMs": 2131,
          "endMs": 3887,
          "method": "silence",
          "absoluteStartS": 84.028,
          "absoluteEndS": 85.784
        },
        {
          "text": "faisons-le défiler pour lire aussi les engagements de l’organisation et la clause d’assurance.",
          "startMs": 4489,
          "endMs": 8559,
          "method": "silence",
          "absoluteStartS": 86.386,
          "absoluteEndS": 90.456
        },
        {
          "text": "Le bouton J’ai lu et j’accepte ferme la fenêtre et coche l’acceptation dans le formulaire.",
          "startMs": 9466,
          "endMs": 13432,
          "method": "silence",
          "absoluteStartS": 91.363,
          "absoluteEndS": 95.329
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 84499
        },
        {
          "kind": "click",
          "atMs": 91831
        }
      ]
    },
    {
      "id": "attention",
      "startMs": 96175,
      "endMs": 113572,
      "sentences": [
        {
          "text": "Quand le bénévole confirme son inscription, la version exacte de la convention acceptée et la date sont conservées.",
          "startMs": 390,
          "endMs": 5481,
          "method": "silence",
          "absoluteStartS": 96.565,
          "absoluteEndS": 101.656
        },
        {
          "text": "Une modification de votre texte concerne les prochaines inscriptions ;",
          "startMs": 6107,
          "endMs": 9277,
          "method": "silence",
          "absoluteStartS": 102.282,
          "absoluteEndS": 105.452
        },
        {
          "text": "elle n’envoie pas automatiquement un message aux personnes déjà inscrites.",
          "startMs": 9550,
          "endMs": 12735,
          "method": "silence",
          "absoluteStartS": 105.725,
          "absoluteEndS": 108.91
        },
        {
          "text": "Pour une information urgente, utilisez les communications de l’événement.",
          "startMs": 13325,
          "endMs": 16804,
          "method": "silence",
          "absoluteStartS": 109.5,
          "absoluteEndS": 112.979
        }
      ],
      "markers": []
    },
    {
      "id": "result",
      "startMs": 114024,
      "endMs": 129492,
      "sentences": [
        {
          "text": "Le résultat est prévisible :",
          "startMs": 597,
          "endMs": 2051,
          "method": "silence",
          "absoluteStartS": 114.621,
          "absoluteEndS": 116.075
        },
        {
          "text": "les automatismes utilisent le bon temps local et chaque nouvelle inscription accepte le même cadre.",
          "startMs": 2652,
          "endMs": 7448,
          "method": "silence",
          "absoluteStartS": 116.676,
          "absoluteEndS": 121.472
        },
        {
          "text": "Ces deux réglages sont communs à l’organisation, tandis que les horaires et consignes détaillées restent configurés dans chaque événement et chaque créneau.",
          "startMs": 8252,
          "endMs": 15160,
          "method": "silence",
          "absoluteStartS": 122.276,
          "absoluteEndS": 129.184
        }
      ],
      "markers": []
    }
