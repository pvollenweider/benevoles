  "chapters": [
    {
      "id": "welcome",
      "startMs": 30,
      "endMs": 21679,
      "sentences": [
        {
          "text": "Ton lien personnel permet de retrouver les inscriptions d'un événement sans créer de compte.",
          "startMs": 291,
          "endMs": 4753,
          "method": "silence",
          "absoluteStartS": 0.321,
          "absoluteEndS": 4.783
        },
        {
          "text": "Ici, Camille a une place confirmée, une inscription en attente, une place proposée et une demande à valider.",
          "startMs": 5002,
          "endMs": 11628,
          "method": "silence",
          "absoluteStartS": 5.032,
          "absoluteEndS": 11.658
        },
        {
          "text": "Nous allons lire les informations utiles, puis montrer comment retirer chacun de ces engagements.",
          "startMs": 12074,
          "endMs": 17040,
          "method": "silence",
          "absoluteStartS": 12.104,
          "absoluteEndS": 17.07
        },
        {
          "text": "Ce lien reste confidentiel :",
          "startMs": 17424,
          "endMs": 19345,
          "method": "silence",
          "absoluteStartS": 17.454,
          "absoluteEndS": 19.375
        },
        {
          "text": "il permet d'agir sur tes inscriptions.",
          "startMs": 19520,
          "endMs": 21229,
          "method": "silence",
          "absoluteStartS": 19.55,
          "absoluteEndS": 21.259
        }
      ],
      "markers": []
    },
    {
      "id": "practical",
      "startMs": 22131,
      "endMs": 42819,
      "sentences": [
        {
          "text": "Commençons par l'Accueil confirmé.",
          "startMs": 421,
          "endMs": 2617,
          "method": "silence",
          "absoluteStartS": 22.552,
          "absoluteEndS": 24.748
        },
        {
          "text": "La carte indique le jour et les horaires.",
          "startMs": 2989,
          "endMs": 5462,
          "method": "silence",
          "absoluteStartS": 25.12,
          "absoluteEndS": 27.593
        },
        {
          "text": "Le rendez-vous et les consignes expliquent où aller et comment se préparer.",
          "startMs": 5964,
          "endMs": 9514,
          "method": "silence",
          "absoluteStartS": 28.095,
          "absoluteEndS": 31.645
        },
        {
          "text": "Le lien carte aide à retrouver le lieu.",
          "startMs": 10433,
          "endMs": 11321,
          "method": "silence",
          "absoluteStartS": 32.564,
          "absoluteEndS": 33.452
        },
        {
          "text": "La personne de contact et son téléphone sont réservés aux inscrits :",
          "startMs": 11476,
          "endMs": 16352,
          "method": "silence",
          "absoluteStartS": 33.607,
          "absoluteEndS": 38.483
        },
        {
          "text": "garde ces informations pour prévenir l'équipe ou demander de l'aide sur place.",
          "startMs": 16719,
          "endMs": 20357,
          "method": "silence",
          "absoluteStartS": 38.85,
          "absoluteEndS": 42.488
        }
      ],
      "markers": []
    },
    {
      "id": "states",
      "startMs": 43272,
      "endMs": 66637,
      "sentences": [
        {
          "text": "Les autres cartes ne signifient pas la même chose.",
          "startMs": 333,
          "endMs": 2746,
          "method": "silence",
          "absoluteStartS": 43.605,
          "absoluteEndS": 46.018
        },
        {
          "text": "Liste d'attente indique ta position, sans place confirmée.",
          "startMs": 3330,
          "endMs": 6424,
          "method": "silence",
          "absoluteStartS": 46.602,
          "absoluteEndS": 49.696
        },
        {
          "text": "Une place proposée affiche une échéance et un lien pour la prendre :",
          "startMs": 6774,
          "endMs": 10801,
          "method": "silence",
          "absoluteStartS": 50.046,
          "absoluteEndS": 54.073
        },
        {
          "text": "tant que tu n'as pas accepté, ne la considère pas comme acquise.",
          "startMs": 11102,
          "endMs": 13925,
          "method": "silence",
          "absoluteStartS": 54.374,
          "absoluteEndS": 57.197
        },
        {
          "text": "Une demande sur validation attend la décision de l'organisation, qui te prévient par email.",
          "startMs": 14446,
          "endMs": 19824,
          "method": "silence",
          "absoluteStartS": 57.718,
          "absoluteEndS": 63.096
        },
        {
          "text": "Lis toujours le statut avant de préparer ton planning.",
          "startMs": 20299,
          "endMs": 23001,
          "method": "silence",
          "absoluteStartS": 63.571,
          "absoluteEndS": 66.273
        }
      ],
      "markers": []
    },
    {
      "id": "cancel",
      "startMs": 67091,
      "endMs": 86947,
      "sentences": [
        {
          "text": "Pour l'Accueil, Annuler ouvre une confirmation.",
          "startMs": 406,
          "endMs": 3335,
          "method": "silence",
          "absoluteStartS": 67.497,
          "absoluteEndS": 70.426
        },
        {
          "text": "Tu peux encore choisir Non, garder :",
          "startMs": 3737,
          "endMs": 5538,
          "method": "silence",
          "absoluteStartS": 70.828,
          "absoluteEndS": 72.629
        },
        {
          "text": "rien n'est retiré.",
          "startMs": 5852,
          "endMs": 6584,
          "method": "silence",
          "absoluteStartS": 72.943,
          "absoluteEndS": 73.675
        },
        {
          "text": "Reprenons et confirmons cette fois.",
          "startMs": 7342,
          "endMs": 8177,
          "method": "silence",
          "absoluteStartS": 74.433,
          "absoluteEndS": 75.268
        },
        {
          "text": "La carte disparaît de la page personnelle.",
          "startMs": 8334,
          "endMs": 11858,
          "method": "silence",
          "absoluteStartS": 75.425,
          "absoluteEndS": 78.949
        },
        {
          "text": "Si tu changes de disponibilité près du début de la mission, préviens aussi le contact sur place :",
          "startMs": 12231,
          "endMs": 17045,
          "method": "silence",
          "absoluteStartS": 79.322,
          "absoluteEndS": 84.136
        },
        {
          "text": "cela aide l'équipe à réorganiser la relève.",
          "startMs": 17400,
          "endMs": 19487,
          "method": "silence",
          "absoluteStartS": 84.491,
          "absoluteEndS": 86.578
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 67559
        },
        {
          "kind": "click",
          "atMs": 73408
        },
        {
          "kind": "click",
          "atMs": 75890
        },
        {
          "kind": "click",
          "atMs": 79875
        }
      ]
    },
    {
      "id": "waiting",
      "startMs": 87403,
      "endMs": 106494,
      "sentences": [
        {
          "text": "Si tu n'es plus disponible pour la Buvette en attente, choisis Quitter la liste d'attente.",
          "startMs": 382,
          "endMs": 5513,
          "method": "silence",
          "absoluteStartS": 87.785,
          "absoluteEndS": 92.916
        },
        {
          "text": "La confirmation explique que tu ne seras plus prévenu si une place se libère pour ce créneau.",
          "startMs": 5895,
          "endMs": 10174,
          "method": "silence",
          "absoluteStartS": 93.298,
          "absoluteEndS": 97.577
        },
        {
          "text": "Confirme uniquement si c'est ce que tu souhaites.",
          "startMs": 10577,
          "endMs": 13096,
          "method": "silence",
          "absoluteStartS": 97.98,
          "absoluteEndS": 100.499
        },
        {
          "text": "La carte disparaît :",
          "startMs": 13697,
          "endMs": 14913,
          "method": "silence",
          "absoluteStartS": 101.1,
          "absoluteEndS": 102.316
        },
        {
          "text": "tu n'es plus dans cette file, mais tes autres inscriptions restent présentes.",
          "startMs": 15182,
          "endMs": 18704,
          "method": "silence",
          "absoluteStartS": 102.585,
          "absoluteEndS": 106.107
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 87873
        },
        {
          "kind": "click",
          "atMs": 97423
        }
      ]
    },
    {
      "id": "offer",
      "startMs": 106945,
      "endMs": 128924,
      "sentences": [
        {
          "text": "Pour une place proposée, le bouton est Refuser la place.",
          "startMs": 339,
          "endMs": 3870,
          "method": "silence",
          "absoluteStartS": 107.284,
          "absoluteEndS": 110.815
        },
        {
          "text": "Lis les conséquences :",
          "startMs": 4323,
          "endMs": 5510,
          "method": "silence",
          "absoluteStartS": 111.268,
          "absoluteEndS": 112.455
        },
        {
          "text": "la place passe à la personne suivante et tu quittes la liste d'attente.",
          "startMs": 5884,
          "endMs": 9134,
          "method": "silence",
          "absoluteStartS": 112.829,
          "absoluteEndS": 116.079
        },
        {
          "text": "Après confirmation, cette offre disparaît.",
          "startMs": 9808,
          "endMs": 12006,
          "method": "silence",
          "absoluteStartS": 116.753,
          "absoluteEndS": 118.951
        },
        {
          "text": "Si tu voulais participer, il fallait au contraire utiliser Prendre la place et suivre la confirmation d'acceptation avant l'échéance indiquée.",
          "startMs": 12330,
          "endMs": 21710,
          "method": "silence",
          "absoluteStartS": 119.275,
          "absoluteEndS": 128.655
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 107406
        },
        {
          "kind": "click",
          "atMs": 118407
        }
      ]
    },
    {
      "id": "request",
      "startMs": 129378,
      "endMs": 151351,
      "sentences": [
        {
          "text": "Il reste la demande pour la Navette du dimanche.",
          "startMs": 318,
          "endMs": 3102,
          "method": "silence",
          "absoluteStartS": 129.696,
          "absoluteEndS": 132.48
        },
        {
          "text": "Retirer ma demande ouvre sa confirmation :",
          "startMs": 3813,
          "endMs": 6043,
          "method": "silence",
          "absoluteStartS": 133.191,
          "absoluteEndS": 135.421
        },
        {
          "text": "la place qui t'était réservée est libérée.",
          "startMs": 6277,
          "endMs": 8759,
          "method": "silence",
          "absoluteStartS": 135.655,
          "absoluteEndS": 138.137
        },
        {
          "text": "En confirmant, tu retires cette candidature sans attendre une réponse de l'organisateur.",
          "startMs": 9370,
          "endMs": 13860,
          "method": "silence",
          "absoluteStartS": 138.748,
          "absoluteEndS": 143.238
        },
        {
          "text": "C'est ici le dernier engagement de Camille.",
          "startMs": 14312,
          "endMs": 17348,
          "method": "silence",
          "absoluteStartS": 143.69,
          "absoluteEndS": 146.726
        },
        {
          "text": "La page indique maintenant que toutes ses inscriptions ont été annulées.",
          "startMs": 17968,
          "endMs": 21573,
          "method": "silence",
          "absoluteStartS": 147.346,
          "absoluteEndS": 150.951
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 129839
        },
        {
          "kind": "click",
          "atMs": 140855
        }
      ]
    },
    {
      "id": "return",
      "startMs": 151804,
      "endMs": 172413,
      "sentences": [
        {
          "text": "Le lien Retour à l'accueil ramène à la page de l'événement.",
          "startMs": 432,
          "endMs": 3813,
          "method": "silence",
          "absoluteStartS": 152.236,
          "absoluteEndS": 155.617
        },
        {
          "text": "Tu peux regarder les places disponibles et choisir un autre créneau si ta disponibilité a changé.",
          "startMs": 4303,
