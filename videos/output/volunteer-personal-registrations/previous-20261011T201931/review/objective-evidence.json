          "endMs": 13925,
          "method": "silence",
          "globalStartMs": 54374,
          "globalEndMs": 57197
        },
        {
          "text": "Une demande sur validation attend la décision de l'organisation, qui te prévient par email.",
          "startMs": 14446,
          "endMs": 19824,
          "method": "silence",
          "globalStartMs": 57718,
          "globalEndMs": 63096
        },
        {
