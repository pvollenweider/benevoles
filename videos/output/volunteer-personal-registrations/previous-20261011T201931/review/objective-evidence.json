          "startMs": 5964,
          "endMs": 9514,
          "method": "silence",
          "globalStartMs": 28095,
          "globalEndMs": 31645
        },
        {
          "text": "Le lien carte aide à retrouver le lieu.",
          "startMs": 10433,
          "endMs": 11321,
          "method": "silence",
          "globalStartMs": 32564,
          "globalEndMs": 33452
        },
        {
          "text": "La personne de contact et son téléphone sont réservés aux inscrits :",
          "startMs": 11476,
          "endMs": 16352,
          "method": "silence",
          "globalStartMs": 33607,
          "globalEndMs": 38483
        },
        {
          "text": "garde ces informations pour prévenir l'équipe ou demander de l'aide sur place.",
          "startMs": 16719,
          "endMs": 20357,
          "method": "silence",
          "globalStartMs": 38850,
          "globalEndMs": 42488
        }
