    {
      "scene": "welcome",
      "startMs": 30,
      "endMs": 21679,
      "sentences": [
        {
          "text": "Ton lien personnel permet de retrouver les inscriptions d'un événement sans créer de compte.",
          "startMs": 291,
          "endMs": 4753,
          "method": "silence",
          "globalStartMs": 321,
          "globalEndMs": 4783
        },
        {
          "text": "Ici, Camille a une place confirmée, une inscription en attente, une place proposée et une demande à valider.",
          "startMs": 5002,
          "endMs": 11628,
          "method": "silence",
          "globalStartMs": 5032,
          "globalEndMs": 11658
        },
        {
          "text": "Nous allons lire les informations utiles, puis montrer comment retirer chacun de ces engagements.",
          "startMs": 12074,
          "endMs": 17040,
          "method": "silence",
          "globalStartMs": 12104,
          "globalEndMs": 17070
        },
        {
          "text": "Ce lien reste confidentiel :",
          "startMs": 17424,
          "endMs": 19345,
          "method": "silence",
          "globalStartMs": 17454,
          "globalEndMs": 19375
        },
        {
          "text": "il permet d'agir sur tes inscriptions.",
          "startMs": 19520,
          "endMs": 21229,
          "method": "silence",
          "globalStartMs": 19550,
          "globalEndMs": 21259
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
