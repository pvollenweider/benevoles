        "endMs": 3813,
        "method": "silence",
        "absoluteStartMs": 152238
      },
      {
        "text": "Tu peux regarder les places disponibles et choisir un autre créneau si ta disponibilité a changé.",
        "startMs": 4303,
        "endMs": 9034,
        "method": "silence",
        "absoluteStartMs": 156109
      },
      {
