  {
    "id": "offer",
    "startMs": 106949,
    "sentences": [
      {
        "text": "Pour une place proposée, le bouton est Refuser la place.",
        "startMs": 339,
        "endMs": 3870,
        "method": "silence",
        "absoluteStartMs": 107288
      },
      {
        "text": "Lis les conséquences :",
