        "endMs": 5538,
        "method": "silence",
        "absoluteStartMs": 70833
      },
      {
        "text": "rien n'est retiré.",
        "startMs": 5852,
        "endMs": 6584,
        "method": "silence",
        "absoluteStartMs": 72948
      },
      {
        "text": "Reprenons et confirmons cette fois.",
        "startMs": 7342,
        "endMs": 8177,
        "method": "silence",
        "absoluteStartMs": 74438
      },
      {
        "text": "La carte disparaît de la page personnelle.",
        "startMs": 8334,
        "endMs": 11858,
        "method": "silence",
        "absoluteStartMs": 75430
      },
      {
        "text": "Si tu changes de disponibilité près du début de la mission, préviens aussi le contact sur place :",
        "startMs": 12231,
        "endMs": 17045,
        "method": "silence",
        "absoluteStartMs": 79327
      },
      {
        "text": "cela aide l'équipe à réorganiser la relève.",
        "startMs": 17400,
        "endMs": 19487,
        "method": "silence",
        "absoluteStartMs": 84496
      }
    ],
