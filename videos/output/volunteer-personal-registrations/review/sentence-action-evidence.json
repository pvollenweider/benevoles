        "endMs": 6043,
        "method": "silence",
        "absoluteStartMs": 133195
      },
      {
        "text": "la place qui t'était réservée est libérée.",
        "startMs": 6277,
        "endMs": 8759,
        "method": "silence",
        "absoluteStartMs": 135659
      },
      {
        "text": "En confirmant, tu retires cette candidature sans attendre une réponse de l'organisateur.",
        "startMs": 9370,
        "endMs": 13860,
        "method": "silence",
        "absoluteStartMs": 138752
      },
      {
        "text": "C'est ici le dernier engagement de Camille.",
        "startMs": 14312,
        "endMs": 17348,
        "method": "silence",
        "absoluteStartMs": 143694
      },
      {
