  "chapters": [
    {
      "id": "welcome",
      "startMs": 38,
      "endMs": 21688,
      "sentences": [
        {
          "text": "Ton lien personnel permet de retrouver les inscriptions d'un événement sans créer de compte.",
          "startMs": 291,
          "endMs": 4753,
          "method": "silence",
          "absoluteStartS": 0.329,
          "absoluteEndS": 4.791
        },
        {
          "text": "Ici, Camille a une place confirmée, une inscription en attente, une place proposée et une demande à valider.",
          "startMs": 5002,
          "endMs": 11628,
          "method": "silence",
          "absoluteStartS": 5.04,
          "absoluteEndS": 11.666
        },
        {
          "text": "Nous allons lire les informations utiles, puis montrer comment retirer chacun de ces engagements.",
          "startMs": 12074,
          "endMs": 17040,
          "method": "silence",
          "absoluteStartS": 12.112,
          "absoluteEndS": 17.078
        },
        {
          "text": "Ce lien reste confidentiel :",
          "startMs": 17424,
          "endMs": 19345,
          "method": "silence",
          "absoluteStartS": 17.462,
          "absoluteEndS": 19.383
        },
        {
          "text": "il permet d'agir sur tes inscriptions.",
          "startMs": 19520,
          "endMs": 21229,
          "method": "silence",
          "absoluteStartS": 19.558,
          "absoluteEndS": 21.267
        }
      ],
      "markers": []
    },
    {
      "id": "practical",
      "startMs": 22139,
      "endMs": 42826,
      "sentences": [
        {
          "text": "Commençons par l'Accueil confirmé.",
          "startMs": 421,
          "endMs": 2617,
          "method": "silence",
          "absoluteStartS": 22.56,
          "absoluteEndS": 24.756
        },
        {
          "text": "La carte indique le jour et les horaires.",
          "startMs": 2989,
          "endMs": 5462,
          "method": "silence",
          "absoluteStartS": 25.128,
          "absoluteEndS": 27.601
        },
        {
          "text": "Le rendez-vous et les consignes expliquent où aller et comment se préparer.",
          "startMs": 5964,
          "endMs": 9514,
          "method": "silence",
          "absoluteStartS": 28.103,
          "absoluteEndS": 31.653
        },
        {
          "text": "Le lien carte aide à retrouver le lieu.",
          "startMs": 10433,
          "endMs": 11321,
          "method": "silence",
          "absoluteStartS": 32.572,
          "absoluteEndS": 33.46
        },
        {
          "text": "La personne de contact et son téléphone sont réservés aux inscrits :",
          "startMs": 11476,
          "endMs": 16352,
          "method": "silence",
          "absoluteStartS": 33.615,
          "absoluteEndS": 38.491
        },
        {
          "text": "garde ces informations pour prévenir l'équipe ou demander de l'aide sur place.",
          "startMs": 16719,
          "endMs": 20357,
          "method": "silence",
          "absoluteStartS": 38.858,
          "absoluteEndS": 42.496
        }
      ],
      "markers": []
    },
    {
      "id": "states",
      "startMs": 43279,
      "endMs": 66644,
      "sentences": [
        {
          "text": "Les autres cartes ne signifient pas la même chose.",
          "startMs": 333,
          "endMs": 2746,
          "method": "silence",
          "absoluteStartS": 43.612,
          "absoluteEndS": 46.025
        },
        {
          "text": "Liste d'attente indique ta position, sans place confirmée.",
          "startMs": 3330,
          "endMs": 6424,
          "method": "silence",
          "absoluteStartS": 46.609,
          "absoluteEndS": 49.703
        },
        {
          "text": "Une place proposée affiche une échéance et un lien pour la prendre :",
          "startMs": 6774,
          "endMs": 10801,
          "method": "silence",
          "absoluteStartS": 50.053,
          "absoluteEndS": 54.08
        },
        {
          "text": "tant que tu n'as pas accepté, ne la considère pas comme acquise.",
          "startMs": 11102,
          "endMs": 13925,
          "method": "silence",
          "absoluteStartS": 54.381,
          "absoluteEndS": 57.204
        },
        {
          "text": "Une demande sur validation attend la décision de l'organisation, qui te prévient par email.",
          "startMs": 14446,
          "endMs": 19824,
          "method": "silence",
          "absoluteStartS": 57.725,
          "absoluteEndS": 63.103
        },
        {
          "text": "Lis toujours le statut avant de préparer ton planning.",
          "startMs": 20299,
          "endMs": 23001,
          "method": "silence",
          "absoluteStartS": 63.578,
          "absoluteEndS": 66.28
        }
      ],
      "markers": []
    },
    {
      "id": "cancel",
      "startMs": 67096,
      "endMs": 86953,
      "sentences": [
        {
          "text": "Pour l'Accueil, Annuler ouvre une confirmation.",
          "startMs": 406,
          "endMs": 3335,
          "method": "silence",
          "absoluteStartS": 67.502,
          "absoluteEndS": 70.431
        },
        {
          "text": "Tu peux encore choisir Non, garder :",
          "startMs": 3737,
          "endMs": 5538,
          "method": "silence",
          "absoluteStartS": 70.833,
          "absoluteEndS": 72.634
        },
        {
          "text": "rien n'est retiré.",
          "startMs": 5852,
          "endMs": 6584,
          "method": "silence",
          "absoluteStartS": 72.948,
          "absoluteEndS": 73.68
        },
        {
          "text": "Reprenons et confirmons cette fois.",
          "startMs": 7342,
          "endMs": 8177,
          "method": "silence",
          "absoluteStartS": 74.438,
          "absoluteEndS": 75.273
        },
        {
          "text": "La carte disparaît de la page personnelle.",
          "startMs": 8334,
          "endMs": 11858,
          "method": "silence",
          "absoluteStartS": 75.43,
          "absoluteEndS": 78.954
        },
        {
          "text": "Si tu changes de disponibilité près du début de la mission, préviens aussi le contact sur place :",
          "startMs": 12231,
          "endMs": 17045,
          "method": "silence",
          "absoluteStartS": 79.327,
          "absoluteEndS": 84.141
        },
        {
          "text": "cela aide l'équipe à réorganiser la relève.",
          "startMs": 17400,
          "endMs": 19487,
          "method": "silence",
          "absoluteStartS": 84.496,
          "absoluteEndS": 86.583
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 67567
        },
        {
          "kind": "click",
          "atMs": 71299
        },
        {
          "kind": "click",
          "atMs": 74915
        },
        {
          "kind": "click",
          "atMs": 75701
        }
      ]
    },
    {
      "id": "waiting",
      "startMs": 87406,
      "endMs": 106496,
      "sentences": [
        {
          "text": "Si tu n'es plus disponible pour la Buvette en attente, choisis Quitter la liste d'attente.",
          "startMs": 382,
          "endMs": 5513,
          "method": "silence",
          "absoluteStartS": 87.788,
          "absoluteEndS": 92.919
        },
        {
          "text": "La confirmation explique que tu ne seras plus prévenu si une place se libère pour ce créneau.",
          "startMs": 5895,
          "endMs": 10174,
          "method": "silence",
          "absoluteStartS": 93.301,
          "absoluteEndS": 97.58
        },
        {
          "text": "Confirme uniquement si c'est ce que tu souhaites.",
          "startMs": 10577,
          "endMs": 13096,
          "method": "silence",
          "absoluteStartS": 97.983,
          "absoluteEndS": 100.502
        },
        {
          "text": "La carte disparaît :",
          "startMs": 13697,
          "endMs": 14913,
          "method": "silence",
          "absoluteStartS": 101.103,
          "absoluteEndS": 102.319
        },
        {
          "text": "tu n'es plus dans cette file, mais tes autres inscriptions restent présentes.",
          "startMs": 15182,
          "endMs": 18704,
          "method": "silence",
          "absoluteStartS": 102.588,
          "absoluteEndS": 106.11
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 87881
        },
        {
          "kind": "click",
          "atMs": 98449
        }
      ]
    },
    {
      "id": "offer",
      "startMs": 106949,
      "endMs": 128929,
      "sentences": [
        {
          "text": "Pour une place proposée, le bouton est Refuser la place.",
          "startMs": 339,
          "endMs": 3870,
          "method": "silence",
          "absoluteStartS": 107.288,
          "absoluteEndS": 110.819
        },
        {
          "text": "Lis les conséquences :",
          "startMs": 4323,
          "endMs": 5510,
          "method": "silence",
          "absoluteStartS": 111.272,
          "absoluteEndS": 112.459
        },
        {
          "text": "la place passe à la personne suivante et tu quittes la liste d'attente.",
          "startMs": 5884,
          "endMs": 9134,
          "method": "silence",
          "absoluteStartS": 112.833,
          "absoluteEndS": 116.083
        },
        {
          "text": "Après confirmation, cette offre disparaît.",
          "startMs": 9808,
          "endMs": 12006,
          "method": "silence",
          "absoluteStartS": 116.757,
          "absoluteEndS": 118.955
        },
        {
          "text": "Si tu voulais participer, il fallait au contraire utiliser Prendre la place et suivre la confirmation d'acceptation avant l'échéance indiquée.",
          "startMs": 12330,
          "endMs": 21710,
          "method": "silence",
          "absoluteStartS": 119.279,
          "absoluteEndS": 128.659
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 107416
        },
        {
          "kind": "click",
          "atMs": 117232
        }
      ]
    },
    {
      "id": "request",
      "startMs": 129382,
      "endMs": 151354,
      "sentences": [
        {
          "text": "Il reste la demande pour la Navette du dimanche.",
          "startMs": 318,
          "endMs": 3102,
          "method": "silence",
          "absoluteStartS": 129.7,
          "absoluteEndS": 132.484
        },
        {
          "text": "Retirer ma demande ouvre sa confirmation :",
          "startMs": 3813,
          "endMs": 6043,
          "method": "silence",
          "absoluteStartS": 133.195,
          "absoluteEndS": 135.425
        },
        {
          "text": "la place qui t'était réservée est libérée.",
          "startMs": 6277,
          "endMs": 8759,
          "method": "silence",
          "absoluteStartS": 135.659,
          "absoluteEndS": 138.141
        },
        {
          "text": "En confirmant, tu retires cette candidature sans attendre une réponse de l'organisateur.",
          "startMs": 9370,
          "endMs": 13860,
          "method": "silence",
          "absoluteStartS": 138.752,
          "absoluteEndS": 143.242
        },
        {
          "text": "C'est ici le dernier engagement de Camille.",
          "startMs": 14312,
          "endMs": 17348,
          "method": "silence",
          "absoluteStartS": 143.694,
          "absoluteEndS": 146.73
        },
        {
          "text": "La page indique maintenant que toutes ses inscriptions ont été annulées.",
          "startMs": 17968,
          "endMs": 21573,
          "method": "silence",
          "absoluteStartS": 147.35,
          "absoluteEndS": 150.955
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 133665
        },
        {
          "kind": "click",
          "atMs": 139247
        }
      ]
    },
    {
      "id": "return",
      "startMs": 151806,
      "endMs": 172415,
      "sentences": [
        {
          "text": "Le lien Retour à l'accueil ramène à la page de l'événement.",
          "startMs": 432,
          "endMs": 3813,
          "method": "silence",
          "absoluteStartS": 152.238,
          "absoluteEndS": 155.619
        },
        {
          "text": "Tu peux regarder les places disponibles et choisir un autre créneau si ta disponibilité a changé.",
          "startMs": 4303,
