          "endMs": 12640,
          "method": "silence",
          "globalStartMs": 41328,
          "globalEndMs": 46472
        },
        {
          "text": "Plus bas, les sections présentent les jalons, les communications et les besoins de cet événement.",
          "startMs": 13311,
          "endMs": 17948,
          "method": "silence",
          "globalStartMs": 47143,
          "globalEndMs": 51780
        },
        {
