    {
      "id": "event-navigation",
      "startMs": 33288,
      "endMs": 56203,
      "sentences": [
        {
          "text": "Ouvrez un événement.",
          "startMs": 333,
          "endMs": 1556,
          "method": "silence",
          "absoluteStartS": 33.621,
          "absoluteEndS": 34.844
        },
        {
          "text": "Sa page propose Gérer les créneaux, Voir les inscriptions et Inviter des membres.",
          "startMs": 2156,
          "endMs": 6666,
          "method": "silence",
          "absoluteStartS": 35.444,
          "absoluteEndS": 39.954
        },
        {
          "text": "Vous retrouvez aussi les liens vers le QR code, les rapports, le journal, les pages et les questions.",
          "startMs": 7078,
          "endMs": 13246,
          "method": "silence",
          "absoluteStartS": 40.366,
          "absoluteEndS": 46.534
        },
        {
          "text": "Plus bas, les sections présentent les jalons, les communications et les besoins de cet événement.",
          "startMs": 13991,
          "endMs": 18896,
          "method": "silence",
          "absoluteStartS": 47.279,
          "absoluteEndS": 52.184
        },
        {
          "text": "Le lien Événements vous ramène à la liste de l’association.",
          "startMs": 19359,
          "endMs": 22552,
          "method": "silence",
          "absoluteStartS": 52.647,
          "absoluteEndS": 55.84
        }
      ],
      "markers": [
