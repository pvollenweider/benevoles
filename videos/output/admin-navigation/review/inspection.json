      "startMs": 0,
      "endMs": 11475,
      "sentences": [
        {
          "text": "Bienvenue dans l’administration.",
          "startMs": 267,
          "endMs": 1712,
          "method": "silence",
          "absoluteStartS": 0.267,
          "absoluteEndS": 1.712
        },
        {
          "text": "Vous allez retrouver les principaux points d’entrée, distinguer les réglages de l’association du suivi d’un événement et chercher une information sans parcourir tous les écrans.",
          "startMs": 2003,
          "endMs": 10964,
          "method": "silence",
          "absoluteStartS": 2.003,
          "absoluteEndS": 10.964
        }
      ],
      "markers": []
    },
    {
      "id": "organization-navigation",
      "startMs": 13639,
      "endMs": 31128,
      "sentences": [
        {
          "text": "Le Tableau de bord rassemble les priorités de l’association.",
          "startMs": 512,
          "endMs": 3554,
          "method": "silence",
          "absoluteStartS": 14.151,
          "absoluteEndS": 17.193
        },
        {
          "text": "Événements ouvre la liste de vos événements.",
          "startMs": 3759,
          "endMs": 5794,
          "method": "silence",
          "absoluteStartS": 17.398,
          "absoluteEndS": 19.433
        },
        {
          "text": "Membres réunit les personnes connues de l’association.",
          "startMs": 6228,
          "endMs": 8965,
          "method": "silence",
          "absoluteStartS": 19.867,
          "absoluteEndS": 22.604
        },
        {
          "text": "Paramètres concerne les réglages communs.",
          "startMs": 9603,
          "endMs": 11568,
          "method": "silence",
          "absoluteStartS": 23.242,
          "absoluteEndS": 25.207
        },
        {
          "text": "Certaines modifications sont réservées au propriétaire :",
          "startMs": 11953,
          "endMs": 15089,
          "method": "silence",
          "absoluteStartS": 25.592,
          "absoluteEndS": 28.728
        },
        {
          "text": "votre rôle détermine les actions disponibles.",
          "startMs": 15252,
          "endMs": 17161,
          "method": "silence",
