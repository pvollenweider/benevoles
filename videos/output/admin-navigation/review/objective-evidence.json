    {
      "scene": "event-navigation",
      "startMs": 33288,
      "endMs": 56203,
      "sentences": [
        {
          "text": "Ouvrez un événement.",
          "startMs": 333,
          "endMs": 1556,
          "method": "silence",
          "globalStartMs": 33621,
          "globalEndMs": 34844
        },
        {
          "text": "Sa page propose Gérer les créneaux, Voir les inscriptions et Inviter des membres.",
          "startMs": 2156,
          "endMs": 6666,
          "method": "silence",
          "globalStartMs": 35444,
          "globalEndMs": 39954
        },
        {
          "text": "Vous retrouvez aussi les liens vers le QR code, les rapports, le journal, les pages et les questions.",
          "startMs": 7078,
          "endMs": 13246,
          "method": "silence",
          "globalStartMs": 40366,
          "globalEndMs": 46534
        },
        {
          "text": "Plus bas, les sections présentent les jalons, les communications et les besoins de cet événement.",
          "startMs": 13991,
          "endMs": 18896,
          "method": "silence",
          "globalStartMs": 47279,
          "globalEndMs": 52184
        },
        {
          "text": "Le lien Événements vous ramène à la liste de l’association.",
          "startMs": 19359,
          "endMs": 22552,
          "method": "silence",
          "globalStartMs": 52647,
          "globalEndMs": 55840
        }
      ],
