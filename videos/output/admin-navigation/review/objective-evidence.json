      "scene": "welcome",
      "startMs": 0,
      "endMs": 11475,
      "sentences": [
        {
          "text": "Bienvenue dans l’administration.",
          "startMs": 267,
          "endMs": 1712,
          "method": "silence",
          "globalStartMs": 267,
          "globalEndMs": 1712
        },
        {
          "text": "Vous allez retrouver les principaux points d’entrée, distinguer les réglages de l’association du suivi d’un événement et chercher une information sans parcourir tous les écrans.",
          "startMs": 2003,
          "endMs": 10964,
          "method": "silence",
          "globalStartMs": 2003,
          "globalEndMs": 10964
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "organization-navigation",
      "startMs": 13639,
      "endMs": 31128,
      "sentences": [
        {
          "text": "Le Tableau de bord rassemble les priorités de l’association.",
          "startMs": 512,
          "endMs": 3554,
          "method": "silence",
          "globalStartMs": 14151,
          "globalEndMs": 17193
        },
        {
