    {
      "scene": "event-navigation",
      "startMs": 33834,
      "endMs": 55676,
      "sentences": [
        {
          "text": "Ouvrez un événement.",
          "startMs": 394,
          "endMs": 1198,
          "method": "silence",
          "globalStartMs": 34228,
          "globalEndMs": 35032
        },
        {
          "text": "Sa page propose Gérer les créneaux, Voir les inscriptions et Inviter des membres.",
          "startMs": 2043,
          "endMs": 6764,
          "method": "silence",
          "globalStartMs": 35877,
          "globalEndMs": 40598
        },
        {
          "text": "Vous retrouvez aussi les liens vers le QR code, les rapports, le journal, les pages et les questions.",
          "startMs": 7496,
          "endMs": 12640,
          "method": "silence",
          "globalStartMs": 41330,
          "globalEndMs": 46474
        },
        {
          "text": "Plus bas, les sections présentent les jalons, les communications et les besoins de cet événement.",
          "startMs": 13311,
          "endMs": 17948,
          "method": "silence",
          "globalStartMs": 47145,
          "globalEndMs": 51782
        },
        {
          "text": "Le lien Événements vous ramène à la liste de l’association.",
          "startMs": 18927,
          "endMs": 21362,
          "method": "silence",
          "globalStartMs": 52761,
          "globalEndMs": 55196
        }
      ],
