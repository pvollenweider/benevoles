      "scene": "welcome",
      "startMs": 0,
      "endMs": 11583,
      "sentences": [
        {
          "text": "Bienvenue dans l’administration.",
          "startMs": 232,
          "endMs": 1653,
          "method": "silence",
          "globalStartMs": 232,
          "globalEndMs": 1653
        },
        {
          "text": "Vous allez retrouver les principaux points d’entrée, distinguer les réglages de l’association du suivi d’un événement et chercher une information sans parcourir tous les écrans.",
          "startMs": 2364,
          "endMs": 11037,
          "method": "silence",
          "globalStartMs": 2364,
          "globalEndMs": 11037
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "organization-navigation",
      "startMs": 13745,
      "endMs": 31673,
      "sentences": [
        {
          "text": "Le Tableau de bord rassemble les priorités de l’association.",
          "startMs": 544,
          "endMs": 3163,
          "method": "silence",
          "globalStartMs": 14289,
          "globalEndMs": 16908
        },
        {
          "text": "Événements ouvre la liste de vos événements, et Membres les personnes connues de l’association.",
          "startMs": 3789,
          "endMs": 9259,
          "method": "silence",
          "globalStartMs": 17534,
          "globalEndMs": 23004
        },
        {
          "text": "Paramètres concerne les réglages communs.",
          "startMs": 10243,
          "endMs": 11873,
          "method": "silence",
          "globalStartMs": 23988,
          "globalEndMs": 25618
        },
        {
