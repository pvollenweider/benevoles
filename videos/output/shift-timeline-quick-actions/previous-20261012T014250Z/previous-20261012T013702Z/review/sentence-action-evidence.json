  {
    "chapter": "copy",
    "startMs": 59782,
    "endMs": 83593,
    "sentences": [
      {
        "text": "Dupliquer reprend le poste, la durée, la capacité et les informations du créneau.",
        "startMs": 397,
        "endMs": 6050,
        "method": "silence",
        "absoluteStartMs": 60179
      },
      {
        "text": "La nouvelle plage commence juste après l’originale.",
        "startMs": 6614,
        "endMs": 8781,
        "method": "silence",
        "absoluteStartMs": 66396
      },
      {
        "text": "Ouvrez cette copie :",
        "startMs": 9563,
        "endMs": 10297,
        "method": "silence",
        "absoluteStartMs": 69345
      },
      {
        "text": "elle est indépendante.",
        "startMs": 10439,
        "endMs": 11636,
        "method": "silence",
        "absoluteStartMs": 70221
      },
      {
        "text": "Donne-lui le libellé Relève suivante, puis ajustez ses heures.",
        "startMs": 12335,
        "endMs": 16095,
        "method": "silence",
        "absoluteStartMs": 72117
      },
      {
        "text": "Ici, on la décale de quinze minutes avec le bouton Décaler.",
        "startMs": 16535,
        "endMs": 20018,
        "method": "silence",
        "absoluteStartMs": 76317
      },
      {
        "text": "Fermer et enregistrer conserve le nouveau libellé.",
        "startMs": 20594,
        "endMs": 23373,
        "method": "silence",
        "absoluteStartMs": 80376
      }
    ],
