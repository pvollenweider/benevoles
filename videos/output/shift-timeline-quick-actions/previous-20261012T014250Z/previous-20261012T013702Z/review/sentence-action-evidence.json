  {
    "chapter": "result",
    "startMs": 106708,
    "endMs": 121556,
    "sentences": [
      {
        "text": "De retour en Liste, les deux créneaux sont bien présents après rechargement.",
        "startMs": 346,
        "endMs": 4078,
        "method": "silence",
        "absoluteStartMs": 107054
      },
      {
        "text": "L’original conserve son libellé, et Relève suivante a ses propres horaires et trois places.",
        "startMs": 4758,
        "endMs": 9826,
        "method": "silence",
        "absoluteStartMs": 111466
      },
      {
        "text": "Cette relecture permet de contrôler le résultat réel des gestes de Frise avant publication.",
        "startMs": 10179,
        "endMs": 14450,
        "method": "silence",
        "absoluteStartMs": 116887
      }
    ],
