  {
    "chapter": "popover",
    "startMs": 47466,
    "endMs": 59329,
    "sentences": [
      {
        "text": "Un clic sur la barre ouvre ses actions rapides.",
        "startMs": 376,
        "endMs": 3239,
        "method": "silence",
        "absoluteStartMs": 47842
      },
      {
        "text": "On y retrouve les heures, l’état des inscriptions et les commandes utiles.",
        "startMs": 3693,
        "endMs": 7258,
        "method": "silence",
        "absoluteStartMs": 51159
      },
      {
        "text": "C’est le bon endroit pour une petite correction, sans parcourir tout le formulaire.",
        "startMs": 7777,
        "endMs": 11472,
        "method": "silence",
        "absoluteStartMs": 55243
      }
    ],
    "anchors": [
      {
        "segmentId": "popover",
