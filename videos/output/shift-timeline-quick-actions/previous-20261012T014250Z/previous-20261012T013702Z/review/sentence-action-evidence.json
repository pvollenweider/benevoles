[
  {
    "chapter": "welcome",
    "startMs": 1106,
    "endMs": 15059,
    "sentences": [
      {
        "text": "La Frise n’est pas seulement une vue de lecture.",
        "startMs": 224,
        "endMs": 2256,
        "method": "silence",
        "absoluteStartMs": 1330
      },
      {
        "text": "Elle permet aussi de construire rapidement un planning visuel :",
        "startMs": 2599,
        "endMs": 5820,
        "method": "silence",
        "absoluteStartMs": 3705
      },
      {
        "text": "dessiner une plage libre, ajuster sa durée, dupliquer une relève et ouvrir le détail sans quitter le contexte de la journée.",
        "startMs": 6503,
        "endMs": 13610,
        "method": "silence",
        "absoluteStartMs": 7609
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "draw",
    "startMs": 15511,
    "endMs": 31865,
    "sentences": [
      {
        "text": "Dans la ligne d’un poste, cliquez dans une zone vide puis faites glisser jusqu’à l’heure de fin souhaitée.",
        "startMs": 346,
        "endMs": 6126,
        "method": "silence",
        "absoluteStartMs": 15857
      },
      {
        "text": "Le créneau est créé, et ses actions rapides s’ouvrent avec les horaires calculés.",
        "startMs": 6273,
        "endMs": 11832,
        "method": "silence",
        "absoluteStartMs": 21784
      },
      {
        "text": "Donnez-lui un libellé, ajustez les places, puis fermez avec Fermer et enregistrer.",
        "startMs": 12368,
        "endMs": 15950,
        "method": "silence",
        "absoluteStartMs": 27879
      }
    ],
