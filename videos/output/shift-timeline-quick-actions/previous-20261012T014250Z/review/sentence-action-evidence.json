  {
    "chapter": "detail",
    "startMs": 84139,
    "endMs": 106347,
    "sentences": [
      {
        "text": "Pour ajouter une consigne à cette relève, passez en Liste, puis cliquez sur Modifier.",
        "startMs": 436,
        "endMs": 6026,
        "method": "silence",
        "absoluteStartMs": 84575
      },
      {
        "text": "L’éditeur détaillé contient aussi le lieu, le contact, l’âge minimum et les règles d’inscription.",
        "startMs": 6157,
        "endMs": 11969,
        "method": "silence",
        "absoluteStartMs": 90296
      },
      {
        "text": "Ici, saisissez Venir dix minutes avant dans Consigne pratique, puis enregistrez.",
        "startMs": 12742,
        "endMs": 18221,
        "method": "silence",
        "absoluteStartMs": 96881
      },
      {
        "text": "Ce conseil appartient à la copie, sans modifier l’original.",
        "startMs": 18814,
        "endMs": 21863,
        "method": "silence",
        "absoluteStartMs": 102953
