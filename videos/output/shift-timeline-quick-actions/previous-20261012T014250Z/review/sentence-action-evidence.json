  {
    "chapter": "resize",
    "startMs": 32412,
    "endMs": 47106,
    "sentences": [
      {
        "text": "Pour corriger une durée, attrape le bord droit du créneau et déplace-le.",
        "startMs": 412,
        "endMs": 4798,
        "method": "silence",
        "absoluteStartMs": 32824
      },
      {
        "text": "Ici, la barre s’allonge de quarante-cinq minutes, par pas de quinze minutes.",
        "startMs": 5310,
        "endMs": 8905,
        "method": "silence",
        "absoluteStartMs": 37722
      },
      {
        "text": "Rouvre ensuite les actions rapides :",
        "startMs": 9271,
        "endMs": 11050,
        "method": "silence",
        "absoluteStartMs": 41683
      },
      {
        "text": "l’heure de fin a bien changé.",
        "startMs": 11468,
        "endMs": 12828,
        "method": "silence",
        "absoluteStartMs": 43880
      },
      {
        "text": "Vérifie-la avant de fermer.",
        "startMs": 12977,
        "endMs": 14320,
        "method": "silence",
        "absoluteStartMs": 45389
      }
    ],
