  {
    "id": "personal",
    "startMs": 73803,
    "sentences": [
      {
        "text": "Sur la page personnelle, Jules retrouve son créneau et les actions prévues pour son inscription.",
        "startMs": 450,
        "endMs": 4573,
        "method": "silence",
        "absoluteStartMs": 74253
      },
      {
        "text": "Le panneau Ton lien personnel rappelle à quoi sert cet accès.",
        "startMs": 5324,
        "endMs": 8486,
        "method": "silence",
        "absoluteStartMs": 79127
      },
      {
        "text": "Gardons ce lien pour son destinataire :",
        "startMs": 9138,
        "endMs": 10934,
        "method": "silence",
        "absoluteStartMs": 82941
      },
      {
        "text": "une personne qui le reçoit peut accéder à la page correspondante.",
        "startMs": 11055,
        "endMs": 14152,
        "method": "silence",
        "absoluteStartMs": 84858
      },
      {
        "text": "Ce n'est pas le lien public de recrutement.",
        "startMs": 14279,
        "endMs": 15858,
        "method": "silence",
        "absoluteStartMs": 88082
      },
      {
        "text": "Utilisons Recevoir ce lien par email, puis ouvrons le nouveau message reçu.",
        "startMs": 16651,
        "endMs": 19410,
        "method": "silence",
        "absoluteStartMs": 90454
      },
      {
        "text": "Cette action renvoie l'accès ;",
        "startMs": 19545,
        "endMs": 20774,
        "method": "silence",
        "absoluteStartMs": 93348
      },
      {
        "text": "elle ne crée pas une deuxième inscription.",
        "startMs": 21450,
        "endMs": 24348,
        "method": "silence",
        "absoluteStartMs": 95253
      },
      {
        "text": "Pour inviter des amis à participer, partage plutôt la page publique de l'événement.",
        "startMs": 24980,
        "endMs": 28400,
        "method": "silence",
        "absoluteStartMs": 98783
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 90927
      }
    ]
  },
  {
    "id": "recovery",
    "startMs": 104924,
    "sentences": [
      {
        "text": "Le lien est perdu ?",
        "startMs": 427,
        "endMs": 1190,
        "method": "silence",
        "absoluteStartMs": 105351
      },
      {
        "text": "Depuis la page de récupération, saisissons l'adresse utilisée pour l'inscription.",
        "startMs": 1795,
        "endMs": 5151,
        "method": "silence",
        "absoluteStartMs": 106719
      },
      {
        "text": "La réponse indique quoi faire ensuite, sans afficher de coordonnées ni de lien personnel.",
        "startMs": 5818,
        "endMs": 10441,
        "method": "silence",
        "absoluteStartMs": 110742
      },
      {
        "text": "Vérifions le message reçu dans la boîte de Léa.",
        "startMs": 11463,
        "endMs": 14177,
        "method": "silence",
        "absoluteStartMs": 116387
      },
      {
        "text": "Recommençons avec une adresse fictive inconnue :",
        "startMs": 14624,
        "endMs": 16754,
        "method": "silence",
        "absoluteStartMs": 119548
      },
      {
        "text": "la réponse affichée reste la même.",
        "startMs": 17557,
        "endMs": 19675,
        "method": "silence",
        "absoluteStartMs": 122481
      },
      {
        "text": "Enfin, demandons depuis l'organisation A le lien d'une adresse appartenant seulement à B.",
        "startMs": 19878,
        "endMs": 24983,
        "method": "silence",
        "absoluteStartMs": 124802
      },
      {
        "text": "La réponse ne révèle pas cette autre fiche et aucun email de B n'est envoyé.",
        "startMs": 25478,
        "endMs": 29747,
        "method": "silence",
        "absoluteStartMs": 130402
      },
      {
        "text": "Si tu ne reçois rien, vérifie ton adresse et les courriers indésirables, puis contacte l'organisation au besoin.",
        "startMs": 30493,
        "endMs": 36596,
        "method": "silence",
        "absoluteStartMs": 135417
      }
    ],
