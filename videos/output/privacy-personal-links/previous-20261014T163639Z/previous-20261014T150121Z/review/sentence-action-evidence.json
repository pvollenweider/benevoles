  {
    "id": "invitation",
    "startMs": 144662,
    "sentences": [
      {
        "text": "Une invitation nominative est différente d'un lien public.",
        "startMs": 896,
        "endMs": 3607,
        "method": "silence",
        "absoluteStartMs": 145558
      },
      {
        "text": "L'organisation l'envoie à Zoé, puis nous ouvrons le vrai email reçu.",
        "startMs": 4360,
        "endMs": 8402,
        "method": "silence",
        "absoluteStartMs": 149022
      },
      {
        "text": "Son lien conduit au formulaire avec les informations prévues pour cette invitation.",
        "startMs": 8804,
        "endMs": 13298,
        "method": "silence",
        "absoluteStartMs": 153466
      },
      {
        "text": "Cela facilite l'inscription de la personne concernée ;",
        "startMs": 13763,
        "endMs": 15970,
        "method": "silence",
        "absoluteStartMs": 158425
      },
      {
        "text": "ce n'est pas une affiche à diffuser à tout le monde.",
        "startMs": 16287,
        "endMs": 18395,
        "method": "silence",
        "absoluteStartMs": 160949
      },
      {
        "text": "Vérifions le prénom, l'adresse et le créneau avant de continuer.",
        "startMs": 19280,
        "endMs": 23148,
        "method": "silence",
        "absoluteStartMs": 163942
      },
      {
        "text": "Si tu recrutes largement, utilise le lien public ou le QR code public, pas l'invitation adressée à une autre personne.",
        "startMs": 23479,
        "endMs": 30127,
        "method": "silence",
        "absoluteStartMs": 168141
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 149504
      },
      {
        "kind": "click",
        "atMs": 150285
      },
      {
        "kind": "click",
        "atMs": 151068
      },
      {
        "kind": "click",
        "atMs": 155401
      },
