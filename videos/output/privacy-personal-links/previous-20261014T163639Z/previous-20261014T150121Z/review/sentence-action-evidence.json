        "kind": "click",
        "atMs": 156183
      }
    ]
  },
  {
    "id": "leader",
    "startMs": 177667,
    "sentences": [
      {
        "text": "Le responsable a lui aussi un accès destiné à sa mission.",
        "startMs": 645,
        "endMs": 3717,
        "method": "silence",
        "absoluteStartMs": 178312
      },
      {
        "text": "Ouvrons le lien de Camille, responsable de l'accueil.",
        "startMs": 3998,
        "endMs": 6754,
        "method": "silence",
        "absoluteStartMs": 181665
      },
      {
        "text": "Il voit les bénévoles de ce poste, leurs horaires et les coordonnées utiles pour les contacter.",
        "startMs": 7259,
        "endMs": 12335,
        "method": "silence",
        "absoluteStartMs": 184926
      },
      {
        "text": "Les personnes de la logistique et de l'autre organisation ne sont pas dans cette équipe.",
        "startMs": 13105,
        "endMs": 17569,
        "method": "silence",
        "absoluteStartMs": 190772
      },
      {
        "text": "Ce lien donne accès à des informations opérationnelles :",
        "startMs": 17703,
        "endMs": 20173,
        "method": "silence",
        "absoluteStartMs": 195370
      },
      {
        "text": "ne le publie pas sur une affiche.",
        "startMs": 20832,
        "endMs": 22245,
        "method": "silence",
        "absoluteStartMs": 198499
      },
      {
        "text": "Revenons dans l'administration et retirons ce responsable.",
        "startMs": 23434,
        "endMs": 26415,
        "method": "silence",
        "absoluteStartMs": 201101
      },
      {
        "text": "En rouvrant son ancien lien, l'accès n'est plus disponible.",
        "startMs": 27135,
        "endMs": 30120,
        "method": "silence",
        "absoluteStartMs": 204802
      },
      {
        "text": "Cela permet de retirer cet accès quand la responsabilité prend fin.",
        "startMs": 30615,
        "endMs": 33993,
        "method": "silence",
        "absoluteStartMs": 208282
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 202726
      },
      {
        "kind": "click",
        "atMs": 205294
      }
    ]
  },
  {
    "id": "admin",
    "startMs": 214533,
    "sentences": [
      {
        "text": "L'organisateur travaille dans son administration, avec sa propre connexion.",
        "startMs": 610,
        "endMs": 4710,
        "method": "silence",
        "absoluteStartMs": 215143
      },
      {
        "text": "Dans les inscriptions, il retrouve les personnes et les réponses aux questions de l'événement.",
        "startMs": 5034,
        "endMs": 9209,
        "method": "silence",
        "absoluteStartMs": 219567
      },
      {
        "text": "Dans les membres, il peut consulter les disponibilités et les notes internes de préparation.",
        "startMs": 10215,
        "endMs": 15242,
        "method": "silence",
        "absoluteStartMs": 224748
      },
      {
        "text": "Regardons la fiche de Léa, puis comparons avec les deux vues précédentes.",
        "startMs": 15563,
        "endMs": 19126,
        "method": "silence",
        "absoluteStartMs": 230096
      },
      {
        "text": "Sa page personnelle ne montre pas les notes internes.",
        "startMs": 19601,
        "endMs": 21993,
        "method": "silence",
        "absoluteStartMs": 234134
      },
      {
        "text": "Le responsable reçoit les contacts de son équipe, pas la fiche membre complète.",
        "startMs": 22365,
        "endMs": 26518,
        "method": "silence",
        "absoluteStartMs": 236898
      },
      {
        "text": "Avant de transmettre une information, demande-toi qui en a besoin et pour quelle tâche.",
        "startMs": 27293,
        "endMs": 31731,
        "method": "silence",
        "absoluteStartMs": 241826
      },
      {
        "text": "Une note utile à l'organisation n'a pas forcément sa place dans un document distribué.",
        "startMs": 32301,
        "endMs": 36522,
        "method": "silence",
        "absoluteStartMs": 246834
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 230584
      },
      {
        "kind": "click",
        "atMs": 234601
      }
    ]
  },
  {
    "id": "legal",
    "startMs": 253603,
    "sentences": [
      {
        "text": "Les informations publiques se trouvent aussi dans le pied de page.",
        "startMs": 285,
        "endMs": 3059,
        "method": "silence",
        "absoluteStartMs": 253888
      },
      {
        "text": "Ouvrons Confidentialité.",
        "startMs": 3372,
        "endMs": 5146,
        "method": "silence",
        "absoluteStartMs": 256975
      },
      {
        "text": "Cette page décrit les usages annoncés et les destinataires des données.",
        "startMs": 6435,
        "endMs": 10038,
        "method": "silence",
        "absoluteStartMs": 260038
      },
      {
        "text": "Repérons aussi les indications de conservation et les moyens de contact.",
        "startMs": 10666,
        "endMs": 14477,
        "method": "silence",
        "absoluteStartMs": 264269
      },
      {
        "text": "Pour une question ou une demande concernant les données, appuie-toi sur ces informations et sur l'organisation concernée.",
        "startMs": 14985,
        "endMs": 21369,
        "method": "silence",
        "absoluteStartMs": 268588
      },
      {
        "text": "Ouvrons maintenant les conditions d'utilisation, qui complètent ce cadre.",
        "startMs": 21762,
        "endMs": 25421,
        "method": "silence",
        "absoluteStartMs": 275365
      },
      {
        "text": "Cette vidéo explique les gestes dans l'outil ;",
        "startMs": 26302,
        "endMs": 28231,
        "method": "silence",
        "absoluteStartMs": 279905
      },
      {
        "text": "elle ne remplace pas une lecture des textes actuels ni un avis juridique.",
        "startMs": 28541,
        "endMs": 32136,
        "method": "silence",
        "absoluteStartMs": 282144
      },
      {
        "text": "Il n'existe pas un délai de conservation unique à appliquer sans regarder le contexte.",
        "startMs": 32263,
        "endMs": 36795,
        "method": "silence",
        "absoluteStartMs": 285866
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 257480
      },
      {
        "kind": "click",
        "atMs": 277021
      }
    ]
  },
  {
    "id": "copies",
    "startMs": 292973,
    "sentences": [
      {
        "text": "Sur le terrain, une liste bien choisie peut suffire.",
        "startMs": 316,
        "endMs": 2891,
        "method": "silence",
        "absoluteStartMs": 293289
      },
      {
        "text": "Ouvrons le rapport prévu pour le stand et regardons les informations qu'il contient.",
        "startMs": 3498,
        "endMs": 7142,
        "method": "silence",
        "absoluteStartMs": 296471
      },
      {
        "text": "Comparons-le au CSV des membres :",
        "startMs": 7821,
        "endMs": 9519,
        "method": "silence",
        "absoluteStartMs": 300794
      },
      {
        "text": "ce fichier comporte notamment des coordonnées et des notes internes.",
        "startMs": 10172,
        "endMs": 13421,
        "method": "silence",
        "absoluteStartMs": 303145
      },
      {
        "text": "Il n'est donc pas à remettre indistinctement à toute l'équipe.",
        "startMs": 13628,
        "endMs": 16495,
        "method": "silence",
        "absoluteStartMs": 306601
      },
      {
        "text": "Choisis le document adapté à la personne qui en a besoin, range-le dans un espace protégé et limite les copies.",
        "startMs": 17107,
        "endMs": 22095,
        "method": "silence",
        "absoluteStartMs": 310080
      },
      {
        "text": "Un fichier téléchargé reste une photographie du moment :",
        "startMs": 22279,
        "endMs": 26325,
        "method": "silence",
        "absoluteStartMs": 315252
      },
      {
        "text": "il ne se met pas à jour quand le planning change.",
        "startMs": 26576,
        "endMs": 28717,
        "method": "silence",
        "absoluteStartMs": 319549
      },
      {
        "text": "Pense aussi aux anciennes copies devenues inutiles.",
        "startMs": 29119,
        "endMs": 31107,
        "method": "silence",
        "absoluteStartMs": 322092
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 296962
      },
      {
        "kind": "click",
        "atMs": 304818
      }
    ]
  },
  {
    "id": "result",
    "startMs": 328046,
    "sentences": [
      {
        "text": "Revenons à la page personnelle et à son avertissement.",
        "startMs": 580,
        "endMs": 3441,
        "method": "silence",
        "absoluteStartMs": 328626
      },
      {
        "text": "Pour recruter, partage la page publique.",
        "startMs": 3617,
        "endMs": 6001,
        "method": "silence",
        "absoluteStartMs": 331663
      },
      {
        "text": "Pour gérer une inscription, garde le lien personnel pour son destinataire.",
        "startMs": 6688,
        "endMs": 10317,
        "method": "silence",
        "absoluteStartMs": 334734
      },
      {
        "text": "Pour coordonner un poste, remets le lien du responsable à la personne désignée.",
        "startMs": 11077,
        "endMs": 14929,
        "method": "silence",
        "absoluteStartMs": 339123
      },
      {
        "text": "Si un accès a été diffusé par erreur, contacte l'organisation plutôt que de continuer à le faire circuler.",
        "startMs": 15527,
        "endMs": 20579,
        "method": "silence",
        "absoluteStartMs": 343573
      },
      {
        "text": "Et avant d'envoyer un document, vérifie son contenu et ses destinataires.",
        "startMs": 21245,
        "endMs": 24635,
        "method": "silence",
        "absoluteStartMs": 349291
      },
      {
        "text": "Quelques gestes simples permettent de rester accueillant, tout en prenant soin des informations confiées par les bénévoles.",
        "startMs": 24765,
        "endMs": 32236,
        "method": "silence",
        "absoluteStartMs": 352811
      }
    ],
    "inputs": []
  }
]