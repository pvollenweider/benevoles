[
  {
    "id": "welcome",
    "startMs": 4,
    "sentences": [
      {
        "text": "Un lien pour recruter, un lien pour gérer son inscription, un lien pour suivre une équipe :",
        "startMs": 228,
        "endMs": 5061,
        "method": "silence",
        "absoluteStartMs": 232
      },
      {
        "text": "ils ne servent pas à la même chose.",
        "startMs": 5525,
        "endMs": 6955,
        "method": "silence",
        "absoluteStartMs": 5529
      },
      {
        "text": "Voyons lesquels partager, lesquels garder pour soi, et comment retrouver un accès perdu.",
        "startMs": 7082,
        "endMs": 12064,
        "method": "silence",
        "absoluteStartMs": 7086
      },
      {
        "text": "Dans notre démonstration, deux organisations ont chacune une Léa Exemple et une fête portant le même identifiant.",
        "startMs": 12942,
        "endMs": 18865,
        "method": "silence",
        "absoluteStartMs": 12946
      },
      {
        "text": "Les noms se ressemblent, mais les fiches et les adresses sont différentes.",
        "startMs": 18990,
        "endMs": 23473,
        "method": "silence",
        "absoluteStartMs": 18994
      },
      {
        "text": "Chaque organisation retrouve son propre événement dans son administration.",
        "startMs": 23856,
        "endMs": 27487,
        "method": "silence",
        "absoluteStartMs": 23860
      },
      {
        "text": "Toutes les personnes et coordonnées utilisées ici sont fictives.",
        "startMs": 28279,
        "endMs": 31126,
        "method": "silence",
        "absoluteStartMs": 28283
      }
    ],
    "inputs": []
  },
  {
    "id": "signup",
    "startMs": 33792,
    "sentences": [
      {
        "text": "Le lien public, ou son QR code, sert à découvrir les missions et à s'inscrire.",
        "startMs": 388,
        "endMs": 4406,
        "method": "silence",
        "absoluteStartMs": 34180
      },
      {
        "text": "Jules choisit un créneau et renseigne ses coordonnées.",
        "startMs": 5068,
        "endMs": 7490,
        "method": "silence",
        "absoluteStartMs": 38860
      },
      {
        "text": "Prénom, nom, adresse email et téléphone :",
        "startMs": 8157,
        "endMs": 10904,
        "method": "silence",
        "absoluteStartMs": 41949
      },
      {
        "text": "ces informations permettent à l'organisation de retrouver Jules et de le contacter.",
        "startMs": 11133,
        "endMs": 14456,
        "method": "silence",
        "absoluteStartMs": 44925
      },
      {
        "text": "Il accepte ensuite les conditions du formulaire.",
        "startMs": 14991,
        "endMs": 16894,
        "method": "silence",
        "absoluteStartMs": 48783
      },
      {
        "text": "Après l'envoi, l'inscription est enregistrée et un email lui est adressé.",
        "startMs": 17322,
        "endMs": 20758,
        "method": "silence",
        "absoluteStartMs": 51114
      },
      {
        "text": "Le lien de gestion n'est pas révélé sur cet écran pour une inscription sans invitation.",
        "startMs": 21508,
        "endMs": 25339,
        "method": "silence",
        "absoluteStartMs": 55300
      },
      {
        "text": "Taper une adresse ne prouve pas qu'on peut lire sa boîte email.",
        "startMs": 26020,
        "endMs": 28932,
        "method": "silence",
        "absoluteStartMs": 59812
      },
      {
        "text": "Ouvrons donc le vrai message reçu par Jules, puis son lien personnel.",
        "startMs": 29210,
        "endMs": 32935,
        "method": "silence",
        "absoluteStartMs": 63002
      },
      {
        "text": "Nous arrivons sur sa propre inscription, pas sur la liste de toute l'équipe.",
        "startMs": 33831,
        "endMs": 37301,
        "method": "silence",
        "absoluteStartMs": 67623
      }
    ],
