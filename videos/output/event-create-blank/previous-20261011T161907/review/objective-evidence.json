    {
      "scene": "location",
      "startMs": 34640,
      "endMs": 53001,
      "sentences": [
        {
          "text": "Le lieu reste lisible comme une adresse.",
          "startMs": 404,
          "endMs": 2341,
          "method": "silence",
          "globalStartMs": 35044,
          "globalEndMs": 36981
        },
        {
          "text": "Juste dessous, collez une paire de coordonnées ou un lien de carte reconnu.",
          "startMs": 2951,
          "endMs": 6750,
          "method": "silence",
          "globalStartMs": 37591,
          "globalEndMs": 41390
        },
        {
          "text": "L’application extrait le point et prépare un lien Vérifier sur la carte.",
          "startMs": 7413,
          "endMs": 11344,
          "method": "silence",
          "globalStartMs": 42053,
          "globalEndMs": 45984
        },
        {
          "text": "Le bénévole trouvera Voir sur la carte sur la page publique.",
