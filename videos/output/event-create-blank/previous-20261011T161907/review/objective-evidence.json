  "sentences": [
    {
      "scene": "welcome",
      "startMs": 0,
      "endMs": 14277,
      "sentences": [
        {
          "text": "Quand aucun modèle ne correspond vraiment, partez d’une page blanche.",
          "startMs": 194,
          "endMs": 3528,
          "method": "silence",
          "globalStartMs": 194,
          "globalEndMs": 3528
        },
        {
          "text": "L’événement est d’abord créé comme brouillon :",
          "startMs": 4412,
          "endMs": 6057,
          "method": "silence",
          "globalStartMs": 4412,
          "globalEndMs": 6057
        },
        {
          "text": "vous pouvez préparer tranquillement les informations et le planning avant de les montrer aux bénévoles.",
          "startMs": 6433,
          "endMs": 10584,
          "method": "silence",
          "globalStartMs": 6433,
          "globalEndMs": 10584
        },
        {
          "text": "Créons ensemble une fête de quartier sur deux jours.",
          "startMs": 10906,
          "endMs": 13920,
          "method": "silence",
          "globalStartMs": 10906,
          "globalEndMs": 13920
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 3115
        },
        {
          "kind": "click",
          "atMs": 7347
        }
      ]
    },
    {
      "scene": "identity-dates",
      "startMs": 16436,
      "endMs": 34186,
      "sentences": [
        {
          "text": "Commençons par un titre parlant, une courte description, puis les dates réelles de la manifestation.",
          "startMs": 536,
          "endMs": 5933,
          "method": "silence",
          "globalStartMs": 16972,
          "globalEndMs": 22369
        },
        {
          "text": "La date de fin se cale d’abord sur la date de début ;",
          "startMs": 6402,
          "endMs": 9046,
          "method": "silence",
          "globalStartMs": 22838,
          "globalEndMs": 25482
        },
        {
          "text": "pour cette fête sur deux jours, nous la faisons terminer le dimanche.",
          "startMs": 9601,
          "endMs": 12680,
          "method": "silence",
          "globalStartMs": 26037,
          "globalEndMs": 29116
        },
        {
          "text": "Ces dates encadrent ensuite les créneaux et les éventuels spectacles.",
          "startMs": 13227,
          "endMs": 17345,
          "method": "silence",
          "globalStartMs": 29663,
          "globalEndMs": 33781
        }
