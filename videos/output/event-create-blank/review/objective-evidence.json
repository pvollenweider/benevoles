    {
      "scene": "location",
      "startMs": 34645,
      "endMs": 53007,
      "sentences": [
        {
          "text": "Le lieu reste lisible comme une adresse.",
          "startMs": 404,
          "endMs": 2341,
          "method": "silence",
          "globalStartMs": 35049,
          "globalEndMs": 36986
        },
        {
          "text": "Juste dessous, collez une paire de coordonnées ou un lien de carte reconnu.",
