    {
      "id": "public-content",
      "startMs": 55170,
      "endMs": 74365,
      "sentences": [
        {
          "text": "Les instructions publiques apparaissent avant l’inscription :",
          "startMs": 681,
          "endMs": 3646,
          "method": "silence",
          "absoluteStartS": 55.851,
          "absoluteEndS": 58.816
        },
        {
          "text": "indiquez ici l’entrée à utiliser et le moment d’arrivée.",
          "startMs": 3779,
          "endMs": 6349,
          "method": "silence",
          "absoluteStartS": 58.949,
          "absoluteEndS": 61.519
        },
        {
          "text": "Le message de confirmation est affiché juste après l’inscription et accepte du texte mis en forme ainsi que des variables.",
          "startMs": 7552,
          "endMs": 13368,
          "method": "silence",
          "absoluteStartS": 62.722,
          "absoluteEndS": 68.538
        },
        {
          "text": "Il doit rassurer et donner la prochaine étape, sans remplacer les consignes propres à chaque créneau.",
          "startMs": 13891,
          "endMs": 18494,
          "method": "silence",
          "absoluteStartS": 69.061,
          "absoluteEndS": 73.664
        }
      ],
