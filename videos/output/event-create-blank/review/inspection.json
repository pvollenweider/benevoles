  "chapters": [
    {
      "id": "welcome",
      "startMs": 0,
      "endMs": 14277,
      "sentences": [
        {
          "text": "Quand aucun modèle ne correspond vraiment, partez d’une page blanche.",
          "startMs": 194,
          "endMs": 3528,
          "method": "silence",
          "absoluteStartS": 0.194,
          "absoluteEndS": 3.528
        },
        {
          "text": "L’événement est d’abord créé comme brouillon :",
          "startMs": 4412,
          "endMs": 6057,
          "method": "silence",
          "absoluteStartS": 4.412,
          "absoluteEndS": 6.057
        },
        {
          "text": "vous pouvez préparer tranquillement les informations et le planning avant de les montrer aux bénévoles.",
          "startMs": 6433,
          "endMs": 10584,
          "method": "silence",
          "absoluteStartS": 6.433,
          "absoluteEndS": 10.584
        },
        {
          "text": "Créons ensemble une fête de quartier sur deux jours.",
          "startMs": 10906,
          "endMs": 13920,
          "method": "silence",
          "absoluteStartS": 10.906,
          "absoluteEndS": 13.92
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 3129
        },
        {
          "kind": "click",
          "atMs": 7327
        }
      ]
    },
    {
      "id": "identity-dates",
      "startMs": 16440,
      "endMs": 34191,
      "sentences": [
        {
          "text": "Commençons par un titre parlant, une courte description, puis les dates réelles de la manifestation.",
          "startMs": 536,
          "endMs": 5933,
          "method": "silence",
          "absoluteStartS": 16.976,
          "absoluteEndS": 22.373
        },
        {
          "text": "La date de fin se cale d’abord sur la date de début ;",
          "startMs": 6402,
          "endMs": 9046,
          "method": "silence",
          "absoluteStartS": 22.842,
          "absoluteEndS": 25.486
        },
        {
          "text": "pour cette fête sur deux jours, nous la faisons terminer le dimanche.",
          "startMs": 9601,
          "endMs": 12680,
          "method": "silence",
          "absoluteStartS": 26.041,
          "absoluteEndS": 29.12
        },
        {
          "text": "Ces dates encadrent ensuite les créneaux et les éventuels spectacles.",
          "startMs": 13227,
          "endMs": 17345,
          "method": "silence",
          "absoluteStartS": 29.667,
          "absoluteEndS": 33.785
        }
      ],
