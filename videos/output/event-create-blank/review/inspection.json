      "endMs": 146161,
      "sentences": [
        {
          "text": "Le résultat est un brouillon structuré, encore invisible au public :",
          "startMs": 477,
          "endMs": 3952,
          "method": "silence",
          "absoluteStartS": 129.711,
          "absoluteEndS": 133.186
        },
        {
          "text": "identité, dates, adresse, point sur la carte et messages sont prêts.",
          "startMs": 4297,
          "endMs": 8509,
          "method": "silence",
          "absoluteStartS": 133.531,
          "absoluteEndS": 137.743
        },
        {
          "text": "Retrouvons-le dans les événements.",
