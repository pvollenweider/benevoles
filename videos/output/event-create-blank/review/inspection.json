    {
      "id": "phone-color",
      "startMs": 74816,
      "endMs": 91771,
      "sentences": [
        {
          "text": "Rendez le téléphone obligatoire seulement si l’équipe doit joindre les bénévoles le jour même.",
          "startMs": 554,
          "endMs": 5758,
          "method": "silence",
          "absoluteStartS": 75.37,
          "absoluteEndS": 80.574
        },
        {
          "text": "La couleur personnalise l’en-tête public avec une palette prévue pour garder un texte lisible.",
          "startMs": 5915,
          "endMs": 10388,
          "method": "silence",
          "absoluteStartS": 80.731,
          "absoluteEndS": 85.204
        },
        {
          "text": "Choisissons Émeraude et regardons l’aperçu.",
          "startMs": 11104,
          "endMs": 13717,
          "method": "silence",
          "absoluteStartS": 85.92,
          "absoluteEndS": 88.533
        },
        {
          "text": "Ces deux réglages pourront être modifiés plus tard.",
          "startMs": 14688,
          "endMs": 16490,
          "method": "silence",
          "absoluteStartS": 89.504,
          "absoluteEndS": 91.306
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 75839
        },
        {
          "kind": "click",
          "atMs": 86390
        }
      ]
    },
    {
      "id": "create",
      "startMs": 92223,
      "endMs": 107936,
      "sentences": [
        {
          "text": "Le bouton Créer l’événement enregistre maintenant un brouillon, puis ouvre directement l’étape des créneaux.",
          "startMs": 485,
          "endMs": 5622,
          "method": "silence",
          "absoluteStartS": 92.708,
          "absoluteEndS": 97.845
        },
        {
          "text": "Rien n’est encore publié.",
          "startMs": 6064,
          "endMs": 7155,
          "method": "silence",
          "absoluteStartS": 98.287,
          "absoluteEndS": 99.378
        },
        {
          "text": "Le bandeau de progression montre clairement qu’il reste à construire le planning, vérifier le parcours bénévole et décider du moment de publication.",
          "startMs": 8112,
          "endMs": 15185,
          "method": "silence",
          "absoluteStartS": 100.335,
          "absoluteEndS": 107.408
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 94890
        }
      ]
    },
    {
      "id": "autosave",
      "startMs": 108388,
      "endMs": 128782,
      "sentences": [
        {
          "text": "Après la création, les modifications des réglages s’enregistrent automatiquement après une courte pause.",
          "startMs": 531,
          "endMs": 7268,
          "method": "silence",
          "absoluteStartS": 108.919,
          "absoluteEndS": 115.656
        },
        {
          "text": "Corrigeons la description, puis attendons Modifications enregistrées à, suivi de l’heure.",
          "startMs": 7409,
          "endMs": 12163,
          "method": "silence",
          "absoluteStartS": 115.797,
          "absoluteEndS": 120.551
        },
        {
          "text": "Ce témoin confirme la sauvegarde.",
          "startMs": 12317,
          "endMs": 14225,
          "method": "silence",
          "absoluteStartS": 120.705,
          "absoluteEndS": 122.613
        },
        {
          "text": "Si la page dit Modifications non enregistrées, restez sur place et réessayez avant de partir.",
          "startMs": 14735,
          "endMs": 20009,
          "method": "silence",
          "absoluteStartS": 123.123,
          "absoluteEndS": 128.397
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 116288
        }
      ]
    },
    {
