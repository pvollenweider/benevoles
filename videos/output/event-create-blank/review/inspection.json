    {
      "id": "location",
      "startMs": 34645,
      "endMs": 53007,
      "sentences": [
        {
          "text": "Le lieu reste lisible comme une adresse.",
          "startMs": 404,
          "endMs": 2341,
          "method": "silence",
          "absoluteStartS": 35.049,
          "absoluteEndS": 36.986
        },
        {
          "text": "Juste dessous, collez une paire de coordonnées ou un lien de carte reconnu.",
          "startMs": 2951,
          "endMs": 6750,
          "method": "silence",
          "absoluteStartS": 37.596,
          "absoluteEndS": 41.395
        },
        {
          "text": "L’application extrait le point et prépare un lien Vérifier sur la carte.",
          "startMs": 7413,
          "endMs": 11344,
          "method": "silence",
          "absoluteStartS": 42.058,
          "absoluteEndS": 45.989
        },
        {
          "text": "Le bénévole trouvera Voir sur la carte sur la page publique.",
          "startMs": 11781,
          "endMs": 14896,
          "method": "silence",
          "absoluteStartS": 46.426,
          "absoluteEndS": 49.541
        },
        {
          "text": "La carte externe ne s’ouvre que lorsqu’on suit ce lien.",
          "startMs": 15333,
          "endMs": 17682,
          "method": "silence",
          "absoluteStartS": 49.978,
          "absoluteEndS": 52.327
        }
      ],
