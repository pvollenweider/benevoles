  {
    "chapter": "archive",
    "startMs": 168666,
    "endMs": 197069,
    "sentences": [
      {
        "text": "Pour conserver un événement complet, ouvrez Rapports et descendez tout en bas, dans Archive.",
        "startMs": 0,
        "endMs": 5313,
        "method": "silence",
        "absoluteStartMs": 168666
      },
      {
        "text": "Le lien Archive de l’événement, JSON, télécharge le fichier.",
        "startMs": 5765,
        "endMs": 8406,
        "method": "silence",
        "absoluteStartMs": 174431
      },
      {
        "text": "Faites cette copie avant de quitter l’outil ou de supprimer l’événement.",
        "startMs": 8682,
        "endMs": 12016,
        "method": "silence",
        "absoluteStartMs": 177348
      },
      {
        "text": "Le JSON n’est pas une feuille à afficher au stand :",
        "startMs": 12170,
        "endMs": 16253,
        "method": "silence",
        "absoluteStartMs": 180836
      },
      {
        "text": "c’est un format structuré pour conserver ou traiter les données.",
        "startMs": 16497,
        "endMs": 19348,
        "method": "silence",
        "absoluteStartMs": 185163
      },
      {
        "text": "Il est limité à cet événement, sans inclure tous les autres événements ni tout l’annuaire de l’organisation.",
        "startMs": 19733,
        "endMs": 24769,
        "method": "silence",
        "absoluteStartMs": 188399
      },
      {
        "text": "Le téléchargement ne crée pas une nouvelle édition de la fête.",
        "startMs": 25314,
        "endMs": 28401,
        "method": "silence",
        "absoluteStartMs": 193980
      }
    ],
