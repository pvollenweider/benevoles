  {
    "chapter": "result",
    "startMs": 267303,
    "endMs": 296106,
    "sentences": [
      {
        "text": "Pour travailler sur les fiches, prenez le CSV des membres.",
        "startMs": 418,
        "endMs": 3558,
        "method": "silence",
        "absoluteStartMs": 267721
      },
      {
        "text": "Pour relire les actions de l'organisation, prenez le CSV du journal.",
        "startMs": 4346,
        "endMs": 7918,
        "method": "silence",
        "absoluteStartMs": 271649
      },
      {
        "text": "Pour conserver un événement et ses données liées, prenez son archive JSON.",
        "startMs": 8703,
        "endMs": 12235,
        "method": "silence",
        "absoluteStartMs": 276006
      },
      {
        "text": "Les plannings et les listes à remettre sur place se choisissent dans Rapports :",
        "startMs": 12972,
        "endMs": 16305,
        "method": "silence",
        "absoluteStartMs": 280275
      },
      {
        "text": "ils répondent à un autre besoin.",
        "startMs": 16726,
        "endMs": 17927,
        "method": "silence",
        "absoluteStartMs": 284029
      },
      {
        "text": "Nous avons téléchargé, ouvert et vérifié chaque type de fichier.",
        "startMs": 18466,
        "endMs": 22331,
        "method": "silence",
        "absoluteStartMs": 285769
      },
      {
        "text": "Le bon export, au bon endroit et pour les bonnes personnes :",
        "startMs": 22864,
        "endMs": 24610,
        "method": "silence",
        "absoluteStartMs": 290167
      },
      {
        "text": "c'est une manière simple de garder la maîtrise de vos données.",
        "startMs": 24915,
        "endMs": 28444,
        "method": "silence",
        "absoluteStartMs": 292218
      }
    ],
