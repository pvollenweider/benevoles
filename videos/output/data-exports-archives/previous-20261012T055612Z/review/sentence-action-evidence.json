  {
    "chapter": "contents",
    "startMs": 199330,
    "endMs": 228855,
    "sentences": [
      {
        "text": "Ouvrons les différentes parties du vrai fichier.",
        "startMs": 0,
        "endMs": 2254,
        "method": "silence",
        "absoluteStartMs": 199330
      },
      {
        "text": "On retrouve les réglages, les créneaux et les inscriptions avec les données des bénévoles concernés.",
        "startMs": 2980,
        "endMs": 7839,
        "method": "silence",
        "absoluteStartMs": 202310
      },
      {
        "text": "Les pages, les questions et leurs réponses, les responsables, les jalons et le journal sont également présents.",
        "startMs": 7964,
        "endMs": 13993,
        "method": "silence",
        "absoluteStartMs": 207294
      },
      {
        "text": "Des nombres récapitulent plusieurs de ces collections.",
        "startMs": 14569,
        "endMs": 16976,
        "method": "silence",
        "absoluteStartMs": 213899
      },
      {
        "text": "Vérifions un créneau et une réponse de notre exemple.",
        "startMs": 17781,
        "endMs": 19906,
        "method": "silence",
        "absoluteStartMs": 217111
      },
      {
        "text": "Les jetons d'accès et les liens personnels ne sont pas exportés.",
        "startMs": 20341,
        "endMs": 23064,
        "method": "silence",
        "absoluteStartMs": 219671
      },
      {
        "text": "Cela ne rend pas le fichier anonyme :",
        "startMs": 23555,
        "endMs": 25427,
        "method": "silence",
        "absoluteStartMs": 222885
      },
      {
        "text": "les coordonnées et d'autres informations personnelles restent dans les données.",
        "startMs": 25644,
        "endMs": 28887,
        "method": "silence",
        "absoluteStartMs": 224974
      }
    ],
