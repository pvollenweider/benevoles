[
  {
    "chapter": "welcome",
    "startMs": 1532,
    "endMs": 25101,
    "sentences": [
      {
        "text": "Besoin de garder une copie de vos données ou de les reprendre dans un autre outil ?",
        "startMs": 232,
        "endMs": 3602,
        "method": "silence",
        "absoluteStartMs": 1764
      },
      {
        "text": "Les exports permettent de les télécharger sans demander une intervention.",
        "startMs": 3941,
        "endMs": 7255,
        "method": "silence",
        "absoluteStartMs": 5473
      },
      {
        "text": "Nous allons récupérer les membres, le journal de l'organisation et l'archive d'un événement.",
        "startMs": 7802,
        "endMs": 11554,
        "method": "silence",
        "absoluteStartMs": 9334
      },
      {
        "text": "Chaque fichier a son usage.",
        "startMs": 12074,
        "endMs": 13099,
        "method": "silence",
        "absoluteStartMs": 13606
      },
      {
        "text": "Les personnes et les informations de cette démonstration sont fictives.",
        "startMs": 13849,
        "endMs": 16541,
        "method": "silence",
        "absoluteStartMs": 15381
      },
      {
        "text": "Nous ouvrirons les vrais fichiers téléchargés, dans un visualiseur de lecture, pour comprendre ce qu'ils contiennent et ce qu'ils ne font pas.",
        "startMs": 16958,
        "endMs": 23297,
        "method": "silence",
        "absoluteStartMs": 18490
      }
    ],
    "anchors": [
      {
        "segmentId": "welcome",
        "phrase": "Nous allons récupérer les membres",
        "startMs": 7802,
        "endMs": 11554,
        "cueMs": 9334
      }
    ],
    "interactions": []
  },
  {
    "chapter": "members",
    "startMs": 27361,
    "endMs": 52901,
    "sentences": [
      {
        "text": "Depuis Membres, Exporter les membres télécharge un fichier CSV.",
        "startMs": 250,
        "endMs": 4133,
        "method": "silence",
        "absoluteStartMs": 27611
      },
      {
        "text": "Il contient les membres de l'organisation, y compris les fiches désactivées.",
        "startMs": 4763,
        "endMs": 7972,
        "method": "silence",
        "absoluteStartMs": 32124
      },
      {
        "text": "Une recherche à l'écran ne transforme pas cet export en liste de quelques personnes.",
        "startMs": 8847,
        "endMs": 12172,
        "method": "silence",
        "absoluteStartMs": 36208
      },
      {
        "text": "Gardons un filtre visible, téléchargeons, puis comparons le fichier avec la liste complète.",
        "startMs": 12541,
        "endMs": 17393,
        "method": "silence",
        "absoluteStartMs": 39902
      },
      {
        "text": "On retrouve aussi une personne désactivée.",
        "startMs": 17859,
        "endMs": 19267,
        "method": "silence",
        "absoluteStartMs": 45220
      },
      {
        "text": "Le téléchargement ne réactive personne, ne change aucune inscription et ne remplace pas une procédure d'import.",
        "startMs": 20041,
        "endMs": 25128,
        "method": "silence",
        "absoluteStartMs": 47402
      }
    ],
    "anchors": [
      {
        "segmentId": "members",
        "phrase": "Il contient les membres de",
        "startMs": 4763,
        "endMs": 7972,
        "cueMs": 32127
      },
      {
