  {
    "chapter": "privacy",
    "startMs": 231129,
    "endMs": 263878,
    "sentences": [
      {
        "text": "Une fois téléchargée, cette copie ne se met pas à jour.",
        "startMs": 645,
        "endMs": 3346,
        "method": "silence",
        "absoluteStartMs": 231774
      },
      {
        "text": "Si une fiche change dans l'application, l'ancien fichier reste identique.",
        "startMs": 3780,
        "endMs": 7556,
        "method": "silence",
        "absoluteStartMs": 234909
      },
      {
        "text": "Rangez-le dans un espace protégé, limitez les destinataires et supprimez les copies devenues inutiles.",
        "startMs": 8428,
        "endMs": 13937,
        "method": "silence",
        "absoluteStartMs": 239557
      },
      {
        "text": "Archiver un événement dans l'application n'est pas le supprimer ;",
        "startMs": 14680,
        "endMs": 17047,
        "method": "silence",
        "absoluteStartMs": 245809
      },
      {
        "text": "une suppression efface ses données et son historique.",
        "startMs": 17301,
        "endMs": 19996,
        "method": "silence",
        "absoluteStartMs": 248430
      },
      {
        "text": "Consultez les durées de conservation dans le guide avant de décider.",
        "startMs": 20578,
        "endMs": 23624,
        "method": "silence",
        "absoluteStartMs": 251707
      },
      {
        "text": "Il n'y a pas de bouton pour restaurer un événement depuis ce JSON.",
        "startMs": 24353,
        "endMs": 27991,
        "method": "silence",
        "absoluteStartMs": 255482
      },
      {
        "text": "Ne le présentez pas comme une sauvegarde que l'application saurait réimporter automatiquement.",
        "startMs": 28302,
        "endMs": 32332,
        "method": "silence",
        "absoluteStartMs": 259431
      }
    ],
