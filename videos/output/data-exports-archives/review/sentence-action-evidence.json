  {
    "chapter": "csv",
    "startMs": 99708,
    "endMs": 130500,
    "sentences": [
      {
        "text": "Les accents sont conservés et les colonnes sont séparées par des points-virgules.",
        "startMs": 517,
        "endMs": 5517,
        "method": "silence",
        "absoluteStartMs": 100225
      },
      {
        "text": "Si votre tableur demande un choix, utilisez le texte en UTF huit et ce séparateur.",
        "startMs": 5682,
        "endMs": 8354,
        "method": "silence",
        "absoluteStartMs": 105390
      },
      {
        "text": "Regardez ce numéro qui commence par plus quarante et un :",
        "startMs": 8963,
        "endMs": 12961,
        "method": "silence",
        "absoluteStartMs": 108671
      },
      {
        "text": "une apostrophe le précède.",
        "startMs": 13483,
        "endMs": 14179,
        "method": "silence",
        "absoluteStartMs": 113191
      },
      {
        "text": "C'est volontaire.",
        "startMs": 14624,
        "endMs": 14841,
        "method": "silence",
        "absoluteStartMs": 114332
      },
      {
        "text": "Une valeur qui commence par égal, plus, moins ou arobase est protégée pour être lue comme du texte, pas exécutée comme une formule.",
        "startMs": 15038,
        "endMs": 22284,
        "method": "silence",
        "absoluteStartMs": 114746
      },
      {
        "text": "Notre exemple égal un plus un reste une valeur textuelle.",
        "startMs": 22803,
        "endMs": 26762,
        "method": "silence",
        "absoluteStartMs": 122511
      },
      {
        "text": "N'enlevez pas cette protection simplement pour rendre la colonne plus jolie.",
        "startMs": 27408,
        "endMs": 30397,
        "method": "silence",
        "absoluteStartMs": 127116
      }
    ],
    "anchors": [
      {
        "segmentId": "csv",
        "phrase": "Les accents sont conservés et",
        "startMs": 517,
        "endMs": 5517,
        "cueMs": 100227
      },
      {
        "segmentId": "csv",
        "phrase": "Regardez ce numéro qui commence",
        "startMs": 8963,
