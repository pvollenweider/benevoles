  {
    "chapter": "result",
    "startMs": 157861,
    "endMs": 184796,
    "sentences": [
      {
        "text": "Fusion effectuée :",
        "startMs": 132,
        "endMs": 1182,
        "method": "silence",
        "absoluteStartMs": 157993
      },
      {
        "text": "le résultat indique ce qui a été déplacé.",
        "startMs": 1736,
        "endMs": 4275,
        "method": "silence",
        "absoluteStartMs": 159597
      },
      {
        "text": "Retournez à la fiche conservée pour retrouver son activité et les inscriptions réunies.",
        "startMs": 4704,
        "endMs": 9199,
        "method": "silence",
        "absoluteStartMs": 162565
      },
      {
        "text": "Dans la liste des membres actifs, il ne reste qu’une fiche pour cette personne.",
        "startMs": 9633,
        "endMs": 13628,
        "method": "silence",
        "absoluteStartMs": 167494
      },
      {
        "text": "L’historique n’est pas réécrit :",
        "startMs": 14090,
        "endMs": 14092,
        "method": "silence",
        "absoluteStartMs": 171951
      },
      {
        "text": "les faits enregistrés sous l’ancienne fiche restent consultables depuis la fiche conservée.",
        "startMs": 14462,
        "endMs": 20597,
        "method": "silence",
        "absoluteStartMs": 172323
      },
      {
        "text": "Si un responsable de secteur utilisait l’adresse abandonnée, son adresse doit être vérifiée séparément.",
        "startMs": 21142,
        "endMs": 26568,
        "method": "silence",
        "absoluteStartMs": 179003
      }
    ],
    "anchors": [
