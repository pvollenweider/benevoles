  {
    "chapter": "fields",
    "startMs": 61329,
    "endMs": 91028,
    "sentences": [
      {
        "text": "Pour chaque information différente, vous choisissez la valeur à garder.",
        "startMs": 358,
        "endMs": 3952,
        "method": "silence",
        "absoluteStartMs": 61687
      },
      {
        "text": "Ici, on conserve la bonne adresse email et on prend le téléphone de l’autre fiche.",
        "startMs": 4203,
        "endMs": 8145,
        "method": "silence",
        "absoluteStartMs": 65532
      },
      {
        "text": "Les notes internes peuvent aussi être mises à la suite :",
        "startMs": 8480,
        "endMs": 11348,
        "method": "silence",
        "absoluteStartMs": 69809
      },
      {
        "text": "pratique pour ne rien oublier.",
        "startMs": 11629,
        "endMs": 12821,
        "method": "silence",
        "absoluteStartMs": 72958
      },
      {
        "text": "Les étiquettes et les disponibilités sont réunies automatiquement.",
        "startMs": 13218,
        "endMs": 16768,
        "method": "silence",
        "absoluteStartMs": 74547
      },
      {
        "text": "Le tableau récapitule les inscriptions, les invitations et les réponses concernées.",
        "startMs": 17131,
        "endMs": 22115,
        "method": "silence",
        "absoluteStartMs": 78460
      },
      {
        "text": "Attention :",
        "startMs": 22527,
        "endMs": 22712,
        "method": "silence",
        "absoluteStartMs": 83856
      },
      {
        "text": "les abonnements aux notifications du navigateur ne sont jamais déplacés.",
        "startMs": 22864,
        "endMs": 26994,
        "method": "silence",
        "absoluteStartMs": 84193
      },
      {
        "text": "La personne devra les réactiver elle-même.",
        "startMs": 27203,
        "endMs": 29407,
        "method": "silence",
        "absoluteStartMs": 88532
      }
    ],
    "anchors": [
