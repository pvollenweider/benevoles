  {
    "chapter": "confirm",
    "startMs": 124185,
    "endMs": 155517,
    "sentences": [
      {
        "text": "Cette case permet d’envoyer les nouveaux liens personnels à l’adresse conservée.",
        "startMs": 314,
        "endMs": 4770,
        "method": "silence",
        "absoluteStartMs": 124499
      },
      {
        "text": "Dans cette démonstration, on la décoche :",
        "startMs": 5039,
        "endMs": 6832,
        "method": "silence",
        "absoluteStartMs": 129224
      },
      {
        "text": "aucun email ne sera envoyé.",
        "startMs": 7254,
        "endMs": 9538,
        "method": "silence",
        "absoluteStartMs": 131439
      },
      {
        "text": "Lisez le résumé avant de confirmer.",
        "startMs": 9745,
        "endMs": 11561,
        "method": "silence",
        "absoluteStartMs": 133930
      },
      {
        "text": "La fusion est irréversible :",
        "startMs": 11959,
        "endMs": 11960,
        "method": "silence",
        "absoluteStartMs": 136144
      },
      {
        "text": "la fiche absorbée sera désactivée et vidée de ses informations personnelles.",
        "startMs": 12116,
        "endMs": 18667,
        "method": "silence",
        "absoluteStartMs": 136301
      },
      {
        "text": "Ses liens déplacés seront régénérés, et les anciens ne fonctionneront plus.",
        "startMs": 18868,
        "endMs": 22756,
        "method": "silence",
        "absoluteStartMs": 143053
      },
      {
        "text": "Fusionner les deux fiches ouvre une dernière confirmation.",
        "startMs": 23540,
        "endMs": 26599,
        "method": "silence",
        "absoluteStartMs": 147725
      },
      {
        "text": "Quand vous êtes vraiment sûr de votre choix, confirmez la fusion.",
        "startMs": 27106,
        "endMs": 31199,
        "method": "silence",
        "absoluteStartMs": 151291
      }
    ],
