  {
    "chapter": "conflicts",
    "startMs": 93291,
    "endMs": 121921,
    "sentences": [
      {
        "text": "Les points à vérifier évitent les surprises.",
        "startMs": 283,
        "endMs": 2430,
        "method": "silence",
        "absoluteStartMs": 93574
      },
      {
        "text": "Sur un même créneau, l’inscription la plus avancée est conservée ;",
        "startMs": 3110,
        "endMs": 6350,
        "method": "silence",
        "absoluteStartMs": 96401
      },
      {
        "text": "l’autre sera annulée avec une trace dans le journal.",
        "startMs": 6669,
        "endMs": 9113,
        "method": "silence",
        "absoluteStartMs": 99960
      },
      {
        "text": "Les chevauchements, limites, âges minimums et postes réservés sont signalés, mais ne bloquent pas la fusion.",
        "startMs": 9492,
        "endMs": 15310,
        "method": "silence",
        "absoluteStartMs": 102783
      },
      {
        "text": "En revanche, deux réponses différentes à la même question demandent un choix.",
        "startMs": 15660,
        "endMs": 19265,
        "method": "silence",
        "absoluteStartMs": 108951
      },
      {
        "text": "Ici, on garde la réponse de la fiche absorbée.",
        "startMs": 19606,
        "endMs": 21875,
        "method": "silence",
        "absoluteStartMs": 112897
      },
      {
        "text": "On choisit aussi son invitation.",
        "startMs": 22210,
        "endMs": 23773,
        "method": "silence",
        "absoluteStartMs": 115501
      },
      {
        "text": "Une fois ces choix résolus, la confirmation devient disponible.",
        "startMs": 24454,
        "endMs": 28269,
        "method": "silence",
        "absoluteStartMs": 117745
      }
    ],
    "anchors": [
      {
        "segmentId": "conflicts",
