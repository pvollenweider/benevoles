[
  {
    "chapter": "duplicates",
    "startMs": 2359,
    "endMs": 29886,
    "sentences": [
      {
        "text": "Deux fiches pour une seule personne ?",
        "startMs": 185,
        "endMs": 1893,
        "method": "silence",
        "absoluteStartMs": 2544
      },
      {
        "text": "Dans Membres, ouvrez Doublons possibles.",
        "startMs": 2227,
        "endMs": 4934,
        "method": "silence",
        "absoluteStartMs": 4586
      },
      {
        "text": "Les raisons du rapprochement sont expliquées, mais un nom identique ne suffit pas à décider :",
        "startMs": 5586,
        "endMs": 10048,
        "method": "silence",
        "absoluteStartMs": 7945
      },
      {
        "text": "deux personnes peuvent être homonymes.",
        "startMs": 10380,
        "endMs": 11993,
        "method": "silence",
        "absoluteStartMs": 12739
      },
      {
        "text": "Comparer et fusionner ouvre un aperçu, sans encore modifier les fiches.",
        "startMs": 12324,
        "endMs": 15045,
        "method": "silence",
        "absoluteStartMs": 14683
      },
      {
        "text": "Revenons aux suggestions.",
        "startMs": 15227,
        "endMs": 16769,
        "method": "silence",
        "absoluteStartMs": 17586
      },
      {
        "text": "Ignorer retire simplement la paire de cette liste.",
        "startMs": 17117,
        "endMs": 18881,
        "method": "silence",
        "absoluteStartMs": 19476
      },
      {
        "text": "Les deux fiches existent toujours, et une nouvelle raison de rapprochement pourrait faire revenir la suggestion plus tard.",
        "startMs": 19174,
        "endMs": 27344,
        "method": "silence",
        "absoluteStartMs": 21533
      }
    ],
    "anchors": [
      {
