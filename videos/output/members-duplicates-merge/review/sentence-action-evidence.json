[
  {
    "chapter": "duplicates",
    "startMs": 2331,
    "endMs": 30108,
    "sentences": [
      {
        "text": "Deux fiches pour une seule personne ?",
        "startMs": 201,
        "endMs": 1747,
        "method": "silence",
        "absoluteStartMs": 2532
      },
      {
        "text": "Dans Membres, ouvrez Doublons possibles.",
        "startMs": 2060,
        "endMs": 4811,
        "method": "silence",
        "absoluteStartMs": 4391
      },
      {
        "text": "Les raisons du rapprochement sont expliquées, mais un nom identique ne suffit pas à décider :",
        "startMs": 5226,
        "endMs": 10003,
        "method": "silence",
        "absoluteStartMs": 7557
      },
      {
        "text": "deux personnes peuvent être homonymes.",
        "startMs": 10153,
        "endMs": 11733,
        "method": "silence",
        "absoluteStartMs": 12484
      },
      {
        "text": "Comparer et fusionner ouvre un aperçu, sans encore modifier les fiches.",
        "startMs": 12183,
        "endMs": 16732,
        "method": "silence",
        "absoluteStartMs": 14514
      },
      {
        "text": "Revenons aux suggestions.",
        "startMs": 17418,
        "endMs": 17647,
        "method": "silence",
        "absoluteStartMs": 19749
      },
      {
        "text": "Ignorer retire simplement la paire de cette liste.",
        "startMs": 17812,
        "endMs": 20057,
        "method": "silence",
        "absoluteStartMs": 20143
      },
      {
        "text": "Les deux fiches existent toujours, et une nouvelle raison de rapprochement pourrait faire revenir la suggestion plus tard.",
        "startMs": 20341,
        "endMs": 27505,
        "method": "silence",
        "absoluteStartMs": 22672
      }
    ],
    "anchors": [
      {
