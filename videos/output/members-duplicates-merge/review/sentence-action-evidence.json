  {
    "chapter": "conflicts",
    "startMs": 93816,
    "endMs": 121963,
    "sentences": [
      {
        "text": "Les points à vérifier évitent les surprises.",
        "startMs": 265,
        "endMs": 2742,
        "method": "silence",
        "absoluteStartMs": 94081
      },
      {
        "text": "Sur un même créneau, l’inscription la plus avancée est conservée ;",
        "startMs": 3210,
        "endMs": 6383,
        "method": "silence",
        "absoluteStartMs": 97026
      },
      {
        "text": "l’autre sera annulée avec une trace dans le journal.",
        "startMs": 6668,
        "endMs": 9042,
        "method": "silence",
        "absoluteStartMs": 100484
      },
      {
        "text": "Les chevauchements, limites, âges minimums et postes réservés sont signalés, mais ne bloquent pas la fusion.",
        "startMs": 9567,
        "endMs": 15359,
        "method": "silence",
        "absoluteStartMs": 103383
      },
      {
        "text": "En revanche, deux réponses différentes à la même question demandent un choix.",
        "startMs": 16055,
        "endMs": 19602,
        "method": "silence",
        "absoluteStartMs": 109871
      },
      {
        "text": "Ici, on garde la réponse de la fiche absorbée.",
        "startMs": 20070,
        "endMs": 22322,
        "method": "silence",
        "absoluteStartMs": 113886
      },
      {
        "text": "On choisit aussi son invitation.",
        "startMs": 22854,
        "endMs": 24176,
        "method": "silence",
        "absoluteStartMs": 116670
      },
      {
        "text": "Une fois ces choix résolus, la confirmation devient disponible.",
        "startMs": 24782,
        "endMs": 27925,
        "method": "silence",
        "absoluteStartMs": 118598
      }
    ],
    "anchors": [
      {
