  {
    "chapter": "links",
    "startMs": 185158,
    "endMs": 211995,
    "sentences": [
      {
        "text": "Vérifions enfin les liens.",
        "startMs": 367,
        "endMs": 1545,
        "method": "silence",
        "absoluteStartMs": 185525
      },
      {
        "text": "L’ancien lien personnel de la fiche absorbée ne fonctionne plus :",
        "startMs": 1997,
        "endMs": 4875,
        "method": "silence",
        "absoluteStartMs": 187155
      },
      {
        "text": "c’est normal, il a été remplacé pour protéger la personne.",
        "startMs": 5093,
        "endMs": 8114,
        "method": "silence",
        "absoluteStartMs": 190251
      },
      {
        "text": "Le nouveau lien ouvre bien ses inscriptions sous la fiche conservée.",
        "startMs": 8416,
        "endMs": 11485,
        "method": "silence",
        "absoluteStartMs": 193574
      },
      {
        "text": "Une inscription annulée parce qu’elle faisait doublon ne redevient pas active.",
        "startMs": 11959,
        "endMs": 15908,
        "method": "silence",
        "absoluteStartMs": 197117
      },
      {
        "text": "Si vous cochez l’envoi des liens lors d’une vraie fusion, la personne reçoit ses nouveaux accès à l’adresse choisie.",
        "startMs": 16536,
        "endMs": 21292,
        "method": "silence",
        "absoluteStartMs": 201694
      },
      {
        "text": "Vous avez ainsi une seule fiche, des informations cohérentes, et des accès renouvelés.",
        "startMs": 21645,
        "endMs": 26497,
        "method": "silence",
        "absoluteStartMs": 206803
      }
    ],
