  {
    "chapter": "compare",
    "startMs": 32371,
    "endMs": 60413,
    "sentences": [
      {
        "text": "Si vous savez que ces deux fiches désignent bien la même personne, ouvrez l’activité de la fiche que vous voulez conserver.",
        "startMs": 289,
        "endMs": 6802,
        "method": "silence",
        "absoluteStartMs": 32660
      },
      {
        "text": "Fusionner avec un autre membre est réservé au propriétaire de l’organisation.",
        "startMs": 7482,
        "endMs": 11571,
        "method": "silence",
        "absoluteStartMs": 39853
      },
      {
        "text": "Recherchez précisément l’adresse de la seconde fiche, puis choisissez Fusionner avec cette fiche.",
        "startMs": 12092,
        "endMs": 17809,
        "method": "silence",
        "absoluteStartMs": 44463
      },
      {
        "text": "Celle-ci sera absorbée.",
        "startMs": 18163,
        "endMs": 19188,
        "method": "silence",
        "absoluteStartMs": 50534
      },
      {
        "text": "L’aperçu permet maintenant de comparer les informations, sans lancer la fusion.",
        "startMs": 19319,
        "endMs": 24438,
        "method": "silence",
        "absoluteStartMs": 51690
      },
      {
        "text": "Vérifiez bien quelle fiche vous gardez avant de continuer.",
        "startMs": 25085,
        "endMs": 27634,
        "method": "silence",
        "absoluteStartMs": 57456
      }
