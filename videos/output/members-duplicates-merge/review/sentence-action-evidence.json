  {
    "chapter": "fields",
    "startMs": 62673,
    "endMs": 91558,
    "sentences": [
      {
        "text": "Pour chaque information différente, vous choisissez la valeur à garder.",
        "startMs": 394,
        "endMs": 4006,
        "method": "silence",
        "absoluteStartMs": 63067
      },
      {
        "text": "Ici, on conserve la bonne adresse email et on prend le téléphone de l’autre fiche.",
        "startMs": 4466,
        "endMs": 8619,
        "method": "silence",
        "absoluteStartMs": 67139
      },
      {
        "text": "Les notes internes peuvent aussi être mises à la suite :",
        "startMs": 9224,
        "endMs": 11789,
        "method": "silence",
        "absoluteStartMs": 71897
      },
      {
        "text": "pratique pour ne rien oublier.",
        "startMs": 11922,
        "endMs": 13006,
        "method": "silence",
        "absoluteStartMs": 74595
      },
      {
        "text": "Les étiquettes et les disponibilités sont réunies automatiquement.",
        "startMs": 13720,
        "endMs": 16761,
        "method": "silence",
        "absoluteStartMs": 76393
      },
      {
        "text": "Le tableau récapitule les inscriptions, les invitations et les réponses concernées.",
        "startMs": 17230,
        "endMs": 21672,
        "method": "silence",
        "absoluteStartMs": 79903
      },
      {
        "text": "Attention :",
        "startMs": 22394,
        "endMs": 22868,
        "method": "silence",
        "absoluteStartMs": 85067
      },
      {
        "text": "les abonnements aux notifications du navigateur ne sont jamais déplacés.",
        "startMs": 23101,
        "endMs": 26430,
        "method": "silence",
        "absoluteStartMs": 85774
      },
      {
        "text": "La personne devra les réactiver elle-même.",
        "startMs": 26706,
        "endMs": 28627,
        "method": "silence",
        "absoluteStartMs": 89379
      }
    ],
    "anchors": [
