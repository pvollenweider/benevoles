  {
    "chapter": "confirm",
    "startMs": 124228,
    "endMs": 154769,
    "sentences": [
      {
        "text": "Cette case permet d’envoyer les nouveaux liens personnels à l’adresse conservée.",
        "startMs": 302,
        "endMs": 4664,
        "method": "silence",
        "absoluteStartMs": 124530
      },
      {
        "text": "Dans cette démonstration, on la décoche :",
        "startMs": 4797,
        "endMs": 8190,
        "method": "silence",
        "absoluteStartMs": 129025
      },
      {
        "text": "aucun email ne sera envoyé.",
        "startMs": 8711,
        "endMs": 8763,
        "method": "silence",
        "absoluteStartMs": 132939
      },
      {
        "text": "Lisez le résumé avant de confirmer.",
        "startMs": 9325,
        "endMs": 11171,
        "method": "silence",
        "absoluteStartMs": 133553
      },
      {
        "text": "La fusion est irréversible :",
        "startMs": 11629,
        "endMs": 13331,
        "method": "silence",
        "absoluteStartMs": 135857
      },
      {
        "text": "la fiche absorbée sera désactivée et vidée de ses informations personnelles.",
        "startMs": 13511,
        "endMs": 17573,
        "method": "silence",
        "absoluteStartMs": 137739
      },
      {
        "text": "Ses liens déplacés seront régénérés, et les anciens ne fonctionneront plus.",
        "startMs": 17857,
        "endMs": 22525,
        "method": "silence",
        "absoluteStartMs": 142085
      },
      {
        "text": "Fusionner les deux fiches ouvre une dernière confirmation.",
        "startMs": 23482,
        "endMs": 26354,
        "method": "silence",
        "absoluteStartMs": 147710
      },
      {
        "text": "Quand vous êtes vraiment sûr de votre choix, confirmez la fusion.",
        "startMs": 26705,
        "endMs": 30033,
        "method": "silence",
        "absoluteStartMs": 150933
      }
    ],
