    "sentences": [
      {
        "text": "Les flèches Monter et Descendre changent l’ordre des pages et l’enregistrent aussitôt.",
        "startMs": 356,
        "endMs": 5138,
        "method": "silence"
      },
      {
        "text": "Faisons monter Ce qu’il faut apporter.",
        "startMs": 5568,
        "endMs": 7819,
        "method": "silence"
      },
      {
        "text": "Ouvrons ensuite Modifier pour ajouter une gourde à sa liste, puis enregistrons.",
        "startMs": 8458,
        "endMs": 12794,
        "method": "silence"
      },
      {
        "text": "Pour supprimer une page, une confirmation permet encore d’annuler :",
        "startMs": 13155,
        "endMs": 16594,
        "method": "silence"
      },
      {
        "text": "vérifions-la sans perdre notre contenu.",
        "startMs": 16723,
