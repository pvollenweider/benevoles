    "sentences": [
      {
        "text": "Ouvrons maintenant la page publique.",
        "startMs": 291,
        "endMs": 2023,
        "method": "silence"
      },
      {
        "text": "Le concert apparaît en repère sur le planning.",
        "startMs": 2504,
        "endMs": 5365,
        "method": "silence"
      },
      {
        "text": "Les liens d’information reprennent l’ordre choisi.",
        "startMs": 5607,
        "endMs": 8488,
        "method": "silence"
      },
      {
        "text": "Ouvrons Ce qu’il faut apporter :",
        "startMs": 8693,
        "endMs": 10094,
        "method": "silence"
      },
      {
        "text": "le titre, le gras et la liste sont mis en forme, et la gourde est bien présente.",
        "startMs": 10698,
        "endMs": 15099,
        "method": "silence"
      },
      {
        "text": "Le bénévole peut préparer son arrivée sans chercher un ancien email.",
