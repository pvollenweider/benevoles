    "sentences": [
      {
        "text": "Vous pouvez corriger le programme sans le recréer.",
        "startMs": 0,
        "endMs": 3013,
        "method": "silence"
      },
      {
        "text": "Ouvrons le concert avec Modifier, puis avançons sa fin à treize heures et confirmons.",
        "startMs": 3220,
        "endMs": 8099,
        "method": "silence"
      },
      {
        "text": "Le concert garde son nom et sa date.",
        "startMs": 8422,
        "endMs": 10702,
        "method": "silence"
      },
      {
        "text": "Une entrée ajoutée par erreur peut être supprimée avec sa propre commande, indépendamment des créneaux des bénévoles.",
        "startMs": 11082,
        "endMs": 17320,
        "method": "silence"
      }
