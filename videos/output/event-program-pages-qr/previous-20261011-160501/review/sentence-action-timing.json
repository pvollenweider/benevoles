    "sentences": [
      {
        "text": "Créons une page Ce qu’il faut apporter, en complément des pages d’accès et des questions fréquentes.",
        "startMs": 332,
        "endMs": 5564,
        "method": "silence"
      },
      {
        "text": "Le titre devient son adresse.",
        "startMs": 5828,
        "endMs": 7639,
        "method": "silence"
      },
      {
        "text": "Dans le contenu, un dièse crée un titre, les tirets une liste et deux astérisques du gras.",
        "startMs": 7839,
        "endMs": 11956,
        "method": "silence"
      },
      {
        "text": "Saisissons une courte liste, puis enregistrons.",
        "startMs": 12135,
        "endMs": 16289,
        "method": "silence"
      },
      {
        "text": "Cette page doit donner des informations pratiques, pas demander une nouvelle inscription.",
        "startMs": 16823,
        "endMs": 20725,
        "method": "silence"
      }
