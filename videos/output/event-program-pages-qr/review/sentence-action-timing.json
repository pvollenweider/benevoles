    "sentences": [
      {
        "text": "Dans les réglages de l’événement, ajoutons un spectacle au programme.",
        "startMs": 195,
        "endMs": 3719,
        "method": "silence"
      },
      {
        "text": "Saisissons Concert du village, le quatorze novembre deux mille vingt-six, de onze heures à douze heures trente, puis cliquez sur Ajouter.",
        "startMs": 4146,
        "endMs": 11534,
        "method": "silence"
      },
      {
        "text": "Son horaire sert de repère dans le planning, sans réserver de bénévoles ni créer de créneau de travail.",
        "startMs": 11857,
        "endMs": 17150,
        "method": "silence"
      }
    ]
