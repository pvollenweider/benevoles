      }
    ],
    "sentences": [
      {
        "text": "Le QR code mène à la page publique de cet événement.",
        "startMs": 270,
        "endMs": 2638,
        "method": "silence"
      },
      {
        "text": "Téléchargez le PNG pour l’intégrer à un document, ou le SVG pour une impression nette.",
        "startMs": 3266,
        "endMs": 8402,
        "method": "silence"
      },
      {
        "text": "La commande Imprimer prépare une fiche à afficher sur un stand.",
        "startMs": 8914,
        "endMs": 12638,
        "method": "silence"
      },
      {
        "text": "Vérifiez le nom de l’événement et l’adresse avant de diffuser le support.",
        "startMs": 13310,
        "endMs": 16615,
        "method": "silence"
      }
    ]
  },
  {
    "id": "result",
    "cue": {
      "id": "result",
      "startMs": 128334,
      "endMs": 150434
    },
    "interactions": [],
    "sentences": [
      {
        "text": "Vous avez un programme corrigé, des pages pratiques lisibles et deux fichiers QR téléchargés.",
        "startMs": 308,
        "endMs": 6162,
        "method": "silence"
      },
      {
        "text": "Avant votre diffusion, scannez le code avec un vrai téléphone :",
        "startMs": 6850,
        "endMs": 9974,
        "method": "silence"
      },
      {
        "text": "ce contrôle reste à faire sur votre appareil.",
        "startMs": 10409,
        "endMs": 12500,
        "method": "silence"
      },
      {
        "text": "Vérifiez que la page attendue s’ouvre et que les inscriptions sont ouvertes au bon moment.",
        "startMs": 12934,
        "endMs": 17698,
        "method": "silence"
      },
      {
        "text": "Un QR code facilite l’accès ;",
        "startMs": 18176,
        "endMs": 19900,
        "method": "silence"
      },
      {
        "text": "il ne change pas les règles d’inscription.",
        "startMs": 20283,
        "endMs": 21590,
        "method": "silence"
      }
    ]
  }
