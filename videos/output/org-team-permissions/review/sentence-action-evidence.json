  {
    "chapter": "invite-result",
    "startMs": 54434,
    "endMs": 65849,
    "sentences": [
      {
        "text": "Après l’envoi, Léa apparaît avec le statut En attente.",
        "startMs": 301,
        "endMs": 2777,
        "method": "silence",
        "absoluteStartMs": 54735
      },
      {
        "text": "Un email contient son lien personnel, valable sept jours ;",
        "startMs": 3147,
        "endMs": 5498,
        "method": "silence",
        "absoluteStartMs": 57581
      },
      {
        "text": "on peut aussi copier ce lien pour le lui transmettre autrement.",
        "startMs": 5896,
        "endMs": 8109,
        "method": "silence",
        "absoluteStartMs": 60330
      },
      {
        "text": "Son accès ne devient actif qu’après la création de son mot de passe.",
        "startMs": 8758,
        "endMs": 11127,
        "method": "silence",
        "absoluteStartMs": 63192
      }
    ],
