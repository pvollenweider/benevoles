  {
    "chapter": "organizer-view",
    "startMs": 83965,
    "endMs": 97506,
    "sentences": [
      {
        "text": "Vérifions maintenant avec le compte de Samira, qui est organisatrice.",
        "startMs": 325,
        "endMs": 3062,
        "method": "silence",
        "absoluteStartMs": 84290
      },
      {
        "text": "Elle retrouve les événements et les outils opérationnels.",
        "startMs": 3586,
        "endMs": 5542,
        "method": "silence",
        "absoluteStartMs": 87551
      },
      {
        "text": "Sur la page de l’équipe, la liste reste visible pour comprendre qui administre l’espace, mais les commandes d’invitation, de retrait et de changement de rôle ont disparu.",
        "startMs": 6005,
        "endMs": 13262,
        "method": "silence",
        "absoluteStartMs": 89970
      }
    ],
    "anchors": [],
    "interactions": [
      {
        "kind": "click",
        "atMs": 85560
      }
    ]
  },
  {
    "chapter": "limits",
    "startMs": 97959,
    "endMs": 119714,
    "sentences": [
      {
        "text": "La suppression définitive d’un événement et les réglages de l’organisation restent réservés aux propriétaires.",
        "startMs": 308,
        "endMs": 6620,
        "method": "silence",
        "absoluteStartMs": 98267
      },
      {
        "text": "Attribuez les droits selon la responsabilité réelle, retirez les accès devenus inutiles et utilisez un compte nominatif par personne.",
        "startMs": 6751,
        "endMs": 14159,
        "method": "silence",
        "absoluteStartMs": 104710
      },
      {
        "text": "Changer un rôle s’applique aussitôt, y compris aux sessions déjà ouvertes :",
        "startMs": 14877,
        "endMs": 18388,
        "method": "silence",
        "absoluteStartMs": 112836
      },
      {
        "text": "vérifiez donc la personne avant d’appliquer.",
        "startMs": 18931,
        "endMs": 21754,
        "method": "silence",
        "absoluteStartMs": 116890
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "result",
    "startMs": 120167,
    "endMs": 131661,
    "sentences": [
      {
        "text": "Le résultat est une équipe autonome sans donner les pleins pouvoirs à tout le monde :",
        "startMs": 147,
        "endMs": 4431,
        "method": "silence",
        "absoluteStartMs": 120314
      },
      {
        "text": "les propriétaires protègent le cadre, les organisateurs font vivre les événements, et chaque action reste liée à la bonne personne.",
        "startMs": 4597,
        "endMs": 11056,
        "method": "silence",
        "absoluteStartMs": 124764
      }
    ],
    "anchors": [],
    "interactions": []
  }
