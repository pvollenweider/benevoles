  "chapters": [
    {
      "id": "welcome",
      "startMs": 1132,
      "endMs": 13913,
      "sentences": [
        {
          "text": "Une équipe bien réglée évite de partager un seul mot de passe et donne à chacun exactement les droits dont il a besoin.",
          "startMs": 228,
          "endMs": 5263,
          "method": "silence",
          "absoluteStartS": 1.36,
          "absoluteEndS": 6.395
        },
        {
          "text": "Ici, trois personnes sont déjà actives :",
          "startMs": 5867,
          "endMs": 7396,
          "method": "silence",
          "absoluteStartS": 6.999,
          "absoluteEndS": 8.528
        },
        {
          "text": "deux propriétaires et une organisatrice.",
          "startMs": 7801,
          "endMs": 9474,
          "method": "silence",
          "absoluteStartS": 8.933,
          "absoluteEndS": 10.606
        },
        {
          "text": "Le badge Vous repère le compte actuellement connecté.",
          "startMs": 10098,
          "endMs": 12358,
          "method": "silence",
          "absoluteStartS": 11.23,
          "absoluteEndS": 13.49
        }
      ],
      "markers": []
    },
    {
      "id": "roles",
      "startMs": 16076,
      "endMs": 36963,
      "sentences": [
        {
          "text": "Le propriétaire gère tout, y compris l’équipe et les réglages de l’organisation.",
          "startMs": 428,
          "endMs": 3721,
          "method": "silence",
          "absoluteStartS": 16.504,
          "absoluteEndS": 19.797
        },
        {
          "text": "L’organisateur prépare les événements, les créneaux, les inscriptions, les membres et les messages, mais ne change pas l’équipe ni ces réglages.",
          "startMs": 4432,
          "endMs": 10699,
          "method": "silence",
          "absoluteStartS": 20.508,
          "absoluteEndS": 26.775
        },
        {
          "text": "Gardez si possible deux propriétaires actifs.",
          "startMs": 11382,
          "endMs": 13312,
          "method": "silence",
          "absoluteStartS": 27.458,
          "absoluteEndS": 29.388
        },
        {
          "text": "Un responsable de secteur est différent :",
          "startMs": 14026,
          "endMs": 15384,
          "method": "silence",
          "absoluteStartS": 30.102,
          "absoluteEndS": 31.46
        },
        {
          "text": "désigné pour un événement, il reçoit un lien personnel, pas un rôle dans cette équipe d’administration.",
          "startMs": 15972,
          "endMs": 20575,
          "method": "silence",
          "absoluteStartS": 32.048,
          "absoluteEndS": 36.651
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 21007
        }
      ]
    },
    {
      "id": "invite",
      "startMs": 38568,
      "endMs": 53970,
      "sentences": [
        {
          "text": "Pour inviter Léa, ouvrez le formulaire, saisissez son nom et son adresse, puis choisissez son rôle avant l’envoi.",
          "startMs": 315,
          "endMs": 5112,
          "method": "silence",
          "absoluteStartS": 38.883,
          "absoluteEndS": 43.68
        },
        {
          "text": "Prenons Organisateur :",
          "startMs": 5867,
          "endMs": 6944,
          "method": "silence",
          "absoluteStartS": 44.435,
          "absoluteEndS": 45.512
        },
        {
          "text": "c’est le bon niveau pour aider sur les plannings et les bénévoles sans accéder aux paramètres sensibles.",
          "startMs": 7386,
          "endMs": 11306,
          "method": "silence",
          "absoluteStartS": 45.954,
          "absoluteEndS": 49.874
        },
        {
          "text": "Cliquez sur Envoyer l’invitation ;",
          "startMs": 11848,
          "endMs": 13249,
          "method": "silence",
          "absoluteStartS": 50.416,
          "absoluteEndS": 51.817
        },
        {
          "text": "le message confirme son adresse.",
          "startMs": 13953,
          "endMs": 15101,
          "method": "silence",
          "absoluteStartS": 52.521,
          "absoluteEndS": 53.669
        }
      ],
