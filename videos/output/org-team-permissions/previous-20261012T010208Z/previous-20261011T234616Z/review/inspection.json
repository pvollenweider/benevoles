    {
      "id": "invite-result",
      "startMs": 54422,
      "endMs": 65838,
      "sentences": [
        {
          "text": "Après l’envoi, Léa apparaît avec le statut En attente.",
          "startMs": 301,
          "endMs": 2777,
          "method": "silence",
          "absoluteStartS": 54.723,
          "absoluteEndS": 57.199
        },
        {
          "text": "Un email contient son lien personnel, valable sept jours ;",
          "startMs": 3147,
          "endMs": 5498,
          "method": "silence",
          "absoluteStartS": 57.569,
          "absoluteEndS": 59.92
        },
        {
          "text": "on peut aussi copier ce lien pour le lui transmettre autrement.",
          "startMs": 5896,
          "endMs": 8109,
          "method": "silence",
          "absoluteStartS": 60.318,
          "absoluteEndS": 62.531
        },
        {
          "text": "Son accès ne devient actif qu’après la création de son mot de passe.",
          "startMs": 8758,
          "endMs": 11127,
          "method": "silence",
          "absoluteStartS": 63.18,
          "absoluteEndS": 65.549
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 60783
        }
      ]
    },
    {
      "id": "change-role",
      "startMs": 68007,
      "endMs": 83505,
      "sentences": [
        {
          "text": "Le rôle peut évoluer.",
          "startMs": 292,
          "endMs": 1095,
          "method": "silence",
          "absoluteStartS": 68.299,
          "absoluteEndS": 69.102
        },
        {
          "text": "On choisit d’abord Propriétaire dans la liste, puis on confirme avec Appliquer :",
          "startMs": 1536,
          "endMs": 4649,
          "method": "silence",
          "absoluteStartS": 69.543,
          "absoluteEndS": 72.656
        },
        {
          "text": "parcourir simplement la liste au clavier ne change donc jamais les droits par accident.",
          "startMs": 4789,
          "endMs": 8727,
          "method": "silence",
          "absoluteStartS": 72.796,
          "absoluteEndS": 76.734
        },
        {
          "text": "La confirmation indique le nouveau rôle.",
          "startMs": 9276,
          "endMs": 10644,
          "method": "silence",
          "absoluteStartS": 77.283,
          "absoluteEndS": 78.651
        },
        {
          "text": "Retirer une personne coupe son accès, mais ne supprime pas l’historique des actions déjà réalisées.",
          "startMs": 11156,
          "endMs": 15179,
          "method": "silence",
          "absoluteStartS": 79.163,
          "absoluteEndS": 83.186
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 74365
        }
      ]
    },
    {
      "id": "organizer-view",
      "startMs": 83957,
      "endMs": 97498,
      "sentences": [
        {
          "text": "Vérifions maintenant avec le compte de Samira, qui est organisatrice.",
          "startMs": 325,
          "endMs": 3062,
          "method": "silence",
          "absoluteStartS": 84.282,
          "absoluteEndS": 87.019
        },
        {
          "text": "Elle retrouve les événements et les outils opérationnels.",
          "startMs": 3586,
          "endMs": 5542,
          "method": "silence",
          "absoluteStartS": 87.543,
          "absoluteEndS": 89.499
        },
        {
          "text": "Sur la page de l’équipe, la liste reste visible pour comprendre qui administre l’espace, mais les commandes d’invitation, de retrait et de changement de rôle ont disparu.",
          "startMs": 6005,
          "endMs": 13262,
          "method": "silence",
          "absoluteStartS": 89.962,
          "absoluteEndS": 97.219
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 85551
        }
      ]
    },
    {
      "id": "limits",
      "startMs": 97951,
      "endMs": 119708,
      "sentences": [
        {
          "text": "La suppression définitive d’un événement et les réglages de l’organisation restent réservés aux propriétaires.",
          "startMs": 308,
          "endMs": 6620,
          "method": "silence",
          "absoluteStartS": 98.259,
          "absoluteEndS": 104.571
        },
        {
          "text": "Attribuez les droits selon la responsabilité réelle, retirez les accès devenus inutiles et utilisez un compte nominatif par personne.",
          "startMs": 6751,
          "endMs": 14159,
          "method": "silence",
          "absoluteStartS": 104.702,
          "absoluteEndS": 112.11
        },
        {
          "text": "Changer un rôle s’applique aussitôt, y compris aux sessions déjà ouvertes :",
          "startMs": 14877,
          "endMs": 18388,
          "method": "silence",
          "absoluteStartS": 112.828,
          "absoluteEndS": 116.339
        },
        {
          "text": "vérifiez donc la personne avant d’appliquer.",
          "startMs": 18931,
          "endMs": 21754,
          "method": "silence",
          "absoluteStartS": 116.882,
          "absoluteEndS": 119.705
        }
      ],
      "markers": []
    },
    {
      "id": "result",
      "startMs": 120161,
      "endMs": 131656,
      "sentences": [
        {
          "text": "Le résultat est une équipe autonome sans donner les pleins pouvoirs à tout le monde :",
          "startMs": 147,
          "endMs": 4431,
          "method": "silence",
          "absoluteStartS": 120.308,
          "absoluteEndS": 124.592
        },
        {
          "text": "les propriétaires protègent le cadre, les organisateurs font vivre les événements, et chaque action reste liée à la bonne personne.",
          "startMs": 4597,
          "endMs": 11056,
          "method": "silence",
          "absoluteStartS": 124.758,
          "absoluteEndS": 131.217
        }
      ],
      "markers": []
    }
  ]
