[
  {
    "id": "welcome",
    "startMs": 1132,
    "sentences": [
      {
        "text": "Une équipe bien réglée évite de partager un seul mot de passe et donne à chacun exactement les droits dont il a besoin.",
        "startMs": 228,
        "endMs": 5263,
        "method": "silence",
        "absoluteStartMs": 1360
      },
      {
        "text": "Ici, trois personnes sont déjà actives :",
        "startMs": 5867,
        "endMs": 7396,
        "method": "silence",
        "absoluteStartMs": 6999
      },
      {
        "text": "deux propriétaires et une organisatrice.",
        "startMs": 7801,
        "endMs": 9474,
        "method": "silence",
        "absoluteStartMs": 8933
      },
      {
        "text": "Le badge Vous repère le compte actuellement connecté.",
        "startMs": 10098,
        "endMs": 12358,
        "method": "silence",
        "absoluteStartMs": 11230
      }
    ],
    "inputs": []
  },
  {
    "id": "roles",
    "startMs": 16076,
    "sentences": [
      {
        "text": "Le propriétaire gère tout, y compris l’équipe et les réglages de l’organisation.",
        "startMs": 428,
        "endMs": 3721,
        "method": "silence",
        "absoluteStartMs": 16504
      },
      {
        "text": "L’organisateur prépare les événements, les créneaux, les inscriptions, les membres et les messages, mais ne change pas l’équipe ni ces réglages.",
        "startMs": 4432,
        "endMs": 10699,
        "method": "silence",
        "absoluteStartMs": 20508
      },
      {
        "text": "Gardez si possible deux propriétaires actifs.",
        "startMs": 11382,
        "endMs": 13312,
        "method": "silence",
        "absoluteStartMs": 27458
      },
      {
        "text": "Un responsable de secteur est différent :",
        "startMs": 14026,
        "endMs": 15384,
        "method": "silence",
        "absoluteStartMs": 30102
      },
      {
        "text": "désigné pour un événement, il reçoit un lien personnel, pas un rôle dans cette équipe d’administration.",
        "startMs": 15972,
        "endMs": 20575,
        "method": "silence",
        "absoluteStartMs": 32048
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 21007
      }
    ]
  },
  {
    "id": "invite",
    "startMs": 38568,
    "sentences": [
      {
        "text": "Pour inviter Léa, ouvrez le formulaire, saisissez son nom et son adresse, puis choisissez son rôle avant l’envoi.",
        "startMs": 315,
        "endMs": 5112,
        "method": "silence",
        "absoluteStartMs": 38883
      },
      {
        "text": "Prenons Organisateur :",
        "startMs": 5867,
        "endMs": 6944,
        "method": "silence",
        "absoluteStartMs": 44435
      },
      {
        "text": "c’est le bon niveau pour aider sur les plannings et les bénévoles sans accéder aux paramètres sensibles.",
        "startMs": 7386,
        "endMs": 11306,
        "method": "silence",
        "absoluteStartMs": 45954
      },
      {
        "text": "Cliquez sur Envoyer l’invitation ;",
        "startMs": 11848,
        "endMs": 13249,
        "method": "silence",
        "absoluteStartMs": 50416
      },
      {
        "text": "le message confirme son adresse.",
        "startMs": 13953,
        "endMs": 15101,
        "method": "silence",
        "absoluteStartMs": 52521
      }
    ],
