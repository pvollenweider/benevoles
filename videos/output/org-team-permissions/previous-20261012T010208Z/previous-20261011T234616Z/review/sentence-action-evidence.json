  {
    "id": "invite-result",
    "startMs": 54422,
    "sentences": [
      {
        "text": "Après l’envoi, Léa apparaît avec le statut En attente.",
        "startMs": 301,
        "endMs": 2777,
        "method": "silence",
        "absoluteStartMs": 54723
      },
      {
        "text": "Un email contient son lien personnel, valable sept jours ;",
        "startMs": 3147,
        "endMs": 5498,
        "method": "silence",
        "absoluteStartMs": 57569
      },
      {
        "text": "on peut aussi copier ce lien pour le lui transmettre autrement.",
        "startMs": 5896,
        "endMs": 8109,
        "method": "silence",
        "absoluteStartMs": 60318
      },
      {
        "text": "Son accès ne devient actif qu’après la création de son mot de passe.",
        "startMs": 8758,
        "endMs": 11127,
        "method": "silence",
        "absoluteStartMs": 63180
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 60783
      }
    ]
  },
  {
    "id": "change-role",
    "startMs": 68007,
    "sentences": [
      {
        "text": "Le rôle peut évoluer.",
        "startMs": 292,
        "endMs": 1095,
        "method": "silence",
        "absoluteStartMs": 68299
      },
      {
        "text": "On choisit d’abord Propriétaire dans la liste, puis on confirme avec Appliquer :",
        "startMs": 1536,
        "endMs": 4649,
        "method": "silence",
        "absoluteStartMs": 69543
      },
      {
        "text": "parcourir simplement la liste au clavier ne change donc jamais les droits par accident.",
        "startMs": 4789,
        "endMs": 8727,
        "method": "silence",
        "absoluteStartMs": 72796
      },
      {
        "text": "La confirmation indique le nouveau rôle.",
        "startMs": 9276,
        "endMs": 10644,
        "method": "silence",
        "absoluteStartMs": 77283
      },
      {
        "text": "Retirer une personne coupe son accès, mais ne supprime pas l’historique des actions déjà réalisées.",
        "startMs": 11156,
        "endMs": 15179,
        "method": "silence",
        "absoluteStartMs": 79163
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 74365
      }
    ]
  },
  {
    "id": "organizer-view",
    "startMs": 83957,
    "sentences": [
      {
        "text": "Vérifions maintenant avec le compte de Samira, qui est organisatrice.",
        "startMs": 325,
        "endMs": 3062,
        "method": "silence",
        "absoluteStartMs": 84282
      },
      {
        "text": "Elle retrouve les événements et les outils opérationnels.",
        "startMs": 3586,
        "endMs": 5542,
        "method": "silence",
        "absoluteStartMs": 87543
      },
      {
        "text": "Sur la page de l’équipe, la liste reste visible pour comprendre qui administre l’espace, mais les commandes d’invitation, de retrait et de changement de rôle ont disparu.",
        "startMs": 6005,
        "endMs": 13262,
        "method": "silence",
        "absoluteStartMs": 89962
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 85551
      }
    ]
  },
  {
    "id": "limits",
    "startMs": 97951,
    "sentences": [
      {
        "text": "La suppression définitive d’un événement et les réglages de l’organisation restent réservés aux propriétaires.",
        "startMs": 308,
        "endMs": 6620,
        "method": "silence",
        "absoluteStartMs": 98259
      },
      {
        "text": "Attribuez les droits selon la responsabilité réelle, retirez les accès devenus inutiles et utilisez un compte nominatif par personne.",
        "startMs": 6751,
        "endMs": 14159,
        "method": "silence",
        "absoluteStartMs": 104702
      },
      {
        "text": "Changer un rôle s’applique aussitôt, y compris aux sessions déjà ouvertes :",
        "startMs": 14877,
        "endMs": 18388,
        "method": "silence",
        "absoluteStartMs": 112828
      },
      {
        "text": "vérifiez donc la personne avant d’appliquer.",
        "startMs": 18931,
        "endMs": 21754,
        "method": "silence",
        "absoluteStartMs": 116882
      }
    ],
    "inputs": []
  },
  {
    "id": "result",
    "startMs": 120161,
    "sentences": [
      {
        "text": "Le résultat est une équipe autonome sans donner les pleins pouvoirs à tout le monde :",
        "startMs": 147,
        "endMs": 4431,
        "method": "silence",
        "absoluteStartMs": 120308
      },
      {
        "text": "les propriétaires protègent le cadre, les organisateurs font vivre les événements, et chaque action reste liée à la bonne personne.",
        "startMs": 4597,
        "endMs": 11056,
        "method": "silence",
        "absoluteStartMs": 124758
      }
    ],
    "inputs": []
  }
]