  {
    "chapter": "change-role",
    "startMs": 68060,
    "endMs": 83558,
    "sentences": [
      {
        "text": "Le rôle peut évoluer.",
        "startMs": 292,
        "endMs": 1095,
        "method": "silence",
        "absoluteStartMs": 68352
      },
      {
        "text": "On choisit d’abord Propriétaire dans la liste, puis on confirme avec Appliquer :",
        "startMs": 1536,
        "endMs": 4649,
        "method": "silence",
        "absoluteStartMs": 69596
      },
      {
        "text": "parcourir simplement la liste au clavier ne change donc jamais les droits par accident.",
        "startMs": 4789,
        "endMs": 8727,
        "method": "silence",
        "absoluteStartMs": 72849
      },
      {
        "text": "La confirmation indique le nouveau rôle.",
        "startMs": 9276,
        "endMs": 10644,
        "method": "silence",
        "absoluteStartMs": 77336
      },
      {
        "text": "Retirer une personne coupe son accès, mais ne supprime pas l’historique des actions déjà réalisées.",
        "startMs": 11156,
        "endMs": 15179,
        "method": "silence",
        "absoluteStartMs": 79216
      }
    ],
    "anchors": [
