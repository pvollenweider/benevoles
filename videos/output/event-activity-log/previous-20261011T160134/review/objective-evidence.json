    {
      "scene": "story",
      "startMs": 141096,
      "endMs": 170042,
      "sentences": [
        {
          "text": "Le mode Récit répond à une autre question :",
          "startMs": 427,
          "endMs": 3579,
          "method": "silence",
          "globalStartMs": 141523,
          "globalEndMs": 144675
        },
        {
          "text": "quelle action en a provoqué une autre ?",
          "startMs": 3752,
          "endMs": 6236,
          "method": "silence",
          "globalStartMs": 144848,
          "globalEndMs": 147332
        },
        {
          "text": "Dans notre exemple, une annulation libère une place et déclenche une offre à la liste d'attente.",
          "startMs": 7044,
          "endMs": 11969,
          "method": "silence",
          "globalStartMs": 148140,
          "globalEndMs": 153065
        },
        {
          "text": "Ouvrons cet enchaînement et lisons le résultat.",
          "startMs": 12530,
          "endMs": 15224,
          "method": "silence",
          "globalStartMs": 153626,
          "globalEndMs": 156320
        },
        {
          "text": "Deux actions proches dans le temps ne forment pas automatiquement une chaîne.",
          "startMs": 16279,
          "endMs": 20174,
          "method": "silence",
          "globalStartMs": 157375,
          "globalEndMs": 161270
        },
        {
          "text": "Le récit utilise les liens de cause enregistrés par l'application ;",
          "startMs": 20617,
          "endMs": 24159,
          "method": "silence",
          "globalStartMs": 161713,
          "globalEndMs": 165255
        },
        {
          "text": "il n'invente pas une explication à partir de la seule chronologie.",
          "startMs": 24637,
          "endMs": 28821,
          "method": "silence",
          "globalStartMs": 165733,
          "globalEndMs": 169917
        }
      ],
      "anchors": [
        {
          "segmentId": "story",
          "phrase": "Le mode Récit répond à une autre question",
          "startMs": 427,
          "endMs": 3579,
          "cueMs": 141523
        },
        {
          "segmentId": "story",
          "phrase": "Ouvrons cet enchaînement",
          "startMs": 12530,
          "endMs": 15224,
          "cueMs": 153627
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 141993
        },
        {
          "kind": "click",
          "atMs": 154093
        },
        {
          "kind": "click",
          "atMs": 161842
        }
      ]
    },
    {
      "scene": "baseline",
      "startMs": 173453,
      "endMs": 200888,
      "sentences": [
        {
          "text": "Un ancien événement peut avoir des créneaux et des inscriptions sans historique enregistré.",
          "startMs": 188,
          "endMs": 4695,
          "method": "silence",
          "globalStartMs": 173641,
          "globalEndMs": 178148
        },
        {
          "text": "Générer l'état initial ajoute alors un point de départ pour ces éléments existants.",
          "startMs": 4913,
          "endMs": 9010,
          "method": "silence",
          "globalStartMs": 178366,
          "globalEndMs": 182463
        },
        {
          "text": "Faisons-le sur notre second exemple, puis lisons la mention grise :",
          "startMs": 9561,
          "endMs": 13988,
          "method": "silence",
          "globalStartMs": 183014,
          "globalEndMs": 187441
        },
        {
          "text": "Généré, pas une action réelle.",
          "startMs": 14395,
          "endMs": 15346,
          "method": "silence",
          "globalStartMs": 187848,
          "globalEndMs": 188799
        },
        {
          "text": "Ce bouton ne retrouve pas les anciennes manipulations oubliées.",
          "startMs": 15947,
          "endMs": 19524,
          "method": "silence",
          "globalStartMs": 189400,
          "globalEndMs": 192977
        },
        {
          "text": "Une nouvelle génération ne doit pas créer de doublons.",
          "startMs": 19736,
          "endMs": 21915,
          "method": "silence",
          "globalStartMs": 193189,
          "globalEndMs": 195368
        },
        {
          "text": "Elle sert à partir d'un état connu, pas à prétendre que l'on connaît tout le passé.",
          "startMs": 22435,
          "endMs": 27432,
          "method": "silence",
          "globalStartMs": 195888,
          "globalEndMs": 200885
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 183525
        }
      ]
    },
    {
      "scene": "privacy",
      "startMs": 204257,
      "endMs": 227446,
      "sentences": [
        {
          "text": "Le journal n'est pas un carnet d'adresses.",
          "startMs": 239,
          "endMs": 1942,
          "method": "silence",
          "globalStartMs": 204496,
          "globalEndMs": 206199
        },
        {
          "text": "Le contenu des pages personnalisées et les coordonnées des bénévoles n'y sont pas recopiés.",
          "startMs": 2327,
          "endMs": 6319,
          "method": "silence",
          "globalStartMs": 206584,
          "globalEndMs": 210576
        },
        {
          "text": "Il montre les champs modifiés et résout le nom de l'auteur lorsque ce compte existe encore.",
          "startMs": 6842,
          "endMs": 11517,
          "method": "silence",
          "globalStartMs": 211099,
          "globalEndMs": 215774
        },
        {
          "text": "Pour joindre une personne, retournez à la vue prévue pour les inscriptions ou les membres, avec les droits nécessaires.",
          "startMs": 11835,
          "endMs": 17039,
          "method": "silence",
          "globalStartMs": 216092,
          "globalEndMs": 221296
        },
        {
          "text": "Une capture d'historique peut tout de même contenir des noms :",
          "startMs": 17437,
          "endMs": 20013,
          "method": "silence",
          "globalStartMs": 221694,
          "globalEndMs": 224270
        },
        {
          "text": "partagez-la seulement avec les personnes qui en ont besoin.",
          "startMs": 20434,
          "endMs": 22886,
          "method": "silence",
          "globalStartMs": 224691,
          "globalEndMs": 227143
        }
      ],
      "anchors": [
        {
          "segmentId": "privacy",
          "phrase": "Pour joindre une personne",
          "startMs": 11835,
          "endMs": 17039,
          "cueMs": 216093
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 208202
        }
      ]
    },
    {
      "scene": "result",
      "startMs": 229710,
      "endMs": 259496,
      "sentences": [
        {
          "text": "Nous avons retrouvé une action, vu l'évolution d'un élément et lu un enchaînement sans modifier le planning.",
          "startMs": 311,
          "endMs": 6558,
          "method": "silence",
          "globalStartMs": 230021,
          "globalEndMs": 236268
        },
        {
          "text": "Pour agir, revenez ensuite aux inscriptions ou aux créneaux concernés.",
          "startMs": 7221,
          "endMs": 11051,
          "method": "silence",
          "globalStartMs": 236931,
          "globalEndMs": 240761
        },
        {
          "text": "Le bon réflexe, c'est de vérifier le type, la période et l'origine avant de conclure.",
          "startMs": 11501,
          "endMs": 16337,
          "method": "silence",
          "globalStartMs": 241211,
          "globalEndMs": 246047
        },
        {
          "text": "Le journal facilite la coordination quand plusieurs personnes organisent ensemble.",
          "startMs": 16607,
          "endMs": 22136,
          "method": "silence",
          "globalStartMs": 246317,
          "globalEndMs": 251846
        },
        {
          "text": "Il aide à poser une question précise et à corriger le bon problème, calmement, plutôt qu'à recommencer tout le planning.",
          "startMs": 22437,
          "endMs": 29390,
          "method": "silence",
          "globalStartMs": 252147,
          "globalEndMs": 259100
        }
      ],
      "anchors": [
        {
          "segmentId": "result",
          "phrase": "Pour agir, revenez ensuite",
          "startMs": 7221,
          "endMs": 11051,
          "cueMs": 236932
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 238553
        }
      ]
    }
  ]
