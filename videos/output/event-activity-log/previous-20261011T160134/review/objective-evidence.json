    "builtAt": "2026-10-11T14:44:49.543Z"
  },
  "sentences": [
    {
      "scene": "welcome",
      "startMs": 1322,
      "endMs": 25710,
      "sentences": [
        {
          "text": "Une inscription a disparu, un horaire a changé :",
          "startMs": 296,
          "endMs": 1712,
          "method": "silence",
          "globalStartMs": 1618,
          "globalEndMs": 3034
        },
        {
          "text": "avant de chercher un coupable, retrouvons ce qui s'est passé.",
          "startMs": 2258,
          "endMs": 5227,
          "method": "silence",
          "globalStartMs": 3580,
          "globalEndMs": 6549
        },
        {
          "text": "Depuis notre événement de démonstration, ouvrons le Journal.",
          "startMs": 5447,
          "endMs": 9063,
          "method": "silence",
          "globalStartMs": 6769,
          "globalEndMs": 10385
        },
        {
          "text": "Son historique contient des actions sur les créneaux, les inscriptions et les réglages de cet événement.",
          "startMs": 9334,
          "endMs": 15231,
          "method": "silence",
          "globalStartMs": 10656,
          "globalEndMs": 16553
        },
        {
          "text": "Nous allons lire une entrée, filtrer la liste et suivre un enchaînement.",
          "startMs": 15881,
          "endMs": 18179,
          "method": "silence",
          "globalStartMs": 17203,
          "globalEndMs": 19501
        },
        {
          "text": "Les personnes et l'histoire utilisées ici sont fictives, mais les écrans sont ceux de l'application.",
          "startMs": 18402,
          "endMs": 23887,
          "method": "silence",
          "globalStartMs": 19724,
          "globalEndMs": 25209
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 7889
        }
      ]
    },
    {
      "scene": "read",
      "startMs": 27972,
      "endMs": 52255,
      "sentences": [
        {
          "text": "Dans Explorer, chaque entrée indique le type d'élément, la date et la personne à l'origine de l'action.",
          "startMs": 514,
          "endMs": 5422,
          "method": "silence",
          "globalStartMs": 28486,
          "globalEndMs": 33394
        },
        {
          "text": "Une action automatique apparaît avec le système, pas avec le nom d'un organisateur.",
          "startMs": 6180,
          "endMs": 9851,
          "method": "silence",
          "globalStartMs": 34152,
          "globalEndMs": 37823
        },
        {
          "text": "Lisons une inscription, puis une modification de créneau.",
          "startMs": 10645,
          "endMs": 11543,
          "method": "silence",
          "globalStartMs": 38617,
          "globalEndMs": 39515
        },
        {
          "text": "Quand des valeurs ont changé, les lignes en dessous donnent les différences enregistrées.",
          "startMs": 12165,
          "endMs": 17786,
          "method": "silence",
          "globalStartMs": 40137,
          "globalEndMs": 45758
        },
        {
          "text": "Le journal aide à comprendre une modification ;",
          "startMs": 18516,
          "endMs": 20702,
          "method": "silence",
          "globalStartMs": 46488,
          "globalEndMs": 48674
        },
        {
          "text": "il ne faut pas confondre son auteur avec la personne concernée par l'inscription.",
          "startMs": 20887,
          "endMs": 23803,
          "method": "silence",
          "globalStartMs": 48859,
          "globalEndMs": 51775
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "filters",
      "startMs": 54514,
      "endMs": 79022,
      "sentences": [
        {
          "text": "Pour retrouver une désinscription, commençons par Type d'élément, puis choisissons Inscription.",
          "startMs": 499,
          "endMs": 5174,
          "method": "silence",
          "globalStartMs": 55013,
          "globalEndMs": 59688
        },
        {
          "text": "Le filtre Qui distingue les actions des bénévoles, des administrateurs et du système.",
          "startMs": 6071,
          "endMs": 10377,
          "method": "silence",
          "globalStartMs": 60585,
          "globalEndMs": 64891
        },
        {
          "text": "Il ne recherche pas un prénom.",
          "startMs": 10624,
          "endMs": 11537,
          "method": "silence",
          "globalStartMs": 65138,
          "globalEndMs": 66051
        },
        {
          "text": "Le filtre Action permet aussi de se concentrer sur les inscriptions, les créneaux ou les pages.",
          "startMs": 12246,
          "endMs": 16290,
          "method": "silence",
          "globalStartMs": 66760,
          "globalEndMs": 70804
        },
        {
          "text": "Regardons la liste changer, puis revenons à toutes les actions.",
          "startMs": 16952,
          "endMs": 19701,
          "method": "silence",
          "globalStartMs": 71466,
          "globalEndMs": 74215
        },
        {
          "text": "Les filtres limitent l'affichage ;",
          "startMs": 20645,
          "endMs": 21989,
          "method": "silence",
          "globalStartMs": 75159,
          "globalEndMs": 76503
        },
        {
          "text": "ils ne suppriment aucune entrée de l'historique.",
          "startMs": 22204,
          "endMs": 23979,
          "method": "silence",
          "globalStartMs": 76718,
          "globalEndMs": 78493
        }
      ],
      "anchors": [
        {
          "segmentId": "filters",
          "phrase": "Le filtre Qui distingue",
          "startMs": 6071,
          "endMs": 10377,
          "cueMs": 60586
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 57920
        },
        {
          "kind": "click",
          "atMs": 61069
        },
        {
          "kind": "click",
          "atMs": 67486
        }
      ]
    },
    {
      "scene": "period",
      "startMs": 81292,
      "endMs": 103894,
      "sentences": [
        {
          "text": "Vous savez quand le changement a eu lieu ?",
          "startMs": 529,
          "endMs": 2320,
          "method": "silence",
          "globalStartMs": 81821,
          "globalEndMs": 83612
        },
        {
          "text": "Renseignez Depuis et Jusqu'à pour limiter la période.",
          "startMs": 2471,
          "endMs": 4511,
          "method": "silence",
          "globalStartMs": 83763,
          "globalEndMs": 85803
        },
        {
          "text": "Choisissons quelques jours de notre exemple, puis élargissons à nouveau la recherche.",
          "startMs": 4744,
          "endMs": 9534,
          "method": "silence",
          "globalStartMs": 86036,
          "globalEndMs": 90826
        },
        {
          "text": "Une liste vide peut simplement venir des filtres :",
          "startMs": 10183,
          "endMs": 12370,
          "method": "silence",
          "globalStartMs": 91475,
          "globalEndMs": 93662
        },
        {
          "text": "ce n'est pas la preuve qu'aucune action n'a jamais eu lieu.",
          "startMs": 12516,
          "endMs": 14251,
          "method": "silence",
          "globalStartMs": 93808,
          "globalEndMs": 95543
        },
        {
          "text": "Quand il reste des entrées à lire, Charger plus complète la liste.",
          "startMs": 15136,
          "endMs": 18274,
          "method": "silence",
          "globalStartMs": 96428,
          "globalEndMs": 99566
        },
        {
          "text": "Le nombre affiché décrit ce qui a été chargé, pas forcément tout l'historique de l'événement.",
          "startMs": 18685,
          "endMs": 22081,
          "method": "silence",
          "globalStartMs": 99977,
          "globalEndMs": 103373
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 98263
        }
      ]
    },
    {
      "scene": "replay",
      "startMs": 106156,
      "endMs": 138835,
      "sentences": [
        {
          "text": "Pour comprendre l'évolution d'un même créneau, ouvrons Rejouer.",
          "startMs": 519,
          "endMs": 3735,
          "method": "silence",
          "globalStartMs": 106675,
          "globalEndMs": 109891
        },
        {
          "text": "Choisissons un élément qui possède plusieurs entrées, puis avançons étape par étape.",
          "startMs": 4265,
          "endMs": 10018,
          "method": "silence",
          "globalStartMs": 110421,
          "globalEndMs": 116174
        },
        {
          "text": "Les boutons précédent et suivant, comme le curseur, permettent de parcourir les changements enregistrés.",
          "startMs": 10145,
          "endMs": 16054,
          "method": "silence",
          "globalStartMs": 116301,
          "globalEndMs": 122210
        },
        {
          "text": "Regardons la capacité avant et après sa modification.",
          "startMs": 16617,
          "endMs": 20243,
          "method": "silence",
          "globalStartMs": 122773,
          "globalEndMs": 126399
        },
        {
          "text": "Rejouer ne remet pas l'événement dans un ancien état :",
          "startMs": 20827,
          "endMs": 24507,
          "method": "silence",
          "globalStartMs": 126983,
          "globalEndMs": 130663
        },
        {
          "text": "c'est une lecture de l'historique, pas une restauration.",
          "startMs": 25108,
          "endMs": 26655,
          "method": "silence",
          "globalStartMs": 131264,
          "globalEndMs": 132811
        },
        {
          "text": "Changer d'élément permet ensuite de suivre une inscription plutôt qu'un créneau.",
          "startMs": 26913,
          "endMs": 32252,
          "method": "silence",
          "globalStartMs": 133069,
          "globalEndMs": 138408
        }
      ],
      "anchors": [
        {
          "segmentId": "replay",
          "phrase": "Pour comprendre l'évolution d'un même créneau",
          "startMs": 519,
          "endMs": 3735,
          "cueMs": 106677
        },
        {
          "segmentId": "replay",
          "phrase": "Choisissons un élément qui possède plusieurs entrées",
          "startMs": 4265,
          "endMs": 10018,
          "cueMs": 110422
        },
        {
          "segmentId": "replay",
          "phrase": "Changer d'élément permet ensuite",
          "startMs": 26913,
          "endMs": 32252,
          "cueMs": 133070
        }
      ],
