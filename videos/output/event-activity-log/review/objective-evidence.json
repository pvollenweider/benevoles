    {
      "scene": "story",
      "startMs": 141089,
      "endMs": 170037,
      "sentences": [
        {
          "text": "Le mode Récit répond à une autre question :",
          "startMs": 427,
          "endMs": 3579,
          "method": "silence",
          "globalStartMs": 141516,
          "globalEndMs": 144668
        },
        {
          "text": "quelle action en a provoqué une autre ?",
          "startMs": 3752,
          "endMs": 6236,
          "method": "silence",
          "globalStartMs": 144841,
          "globalEndMs": 147325
        },
        {
          "text": "Dans notre exemple, une annulation libère une place et déclenche une offre à la liste d'attente.",
          "startMs": 7044,
          "endMs": 11969,
          "method": "silence",
          "globalStartMs": 148133,
          "globalEndMs": 153058
        },
        {
          "text": "Ouvrons cet enchaînement et lisons le résultat.",
          "startMs": 12530,
          "endMs": 15224,
          "method": "silence",
          "globalStartMs": 153619,
          "globalEndMs": 156313
        },
        {
          "text": "Deux actions proches dans le temps ne forment pas automatiquement une chaîne.",
          "startMs": 16279,
          "endMs": 20174,
          "method": "silence",
          "globalStartMs": 157368,
          "globalEndMs": 161263
        },
        {
          "text": "Le récit utilise les liens de cause enregistrés par l'application ;",
          "startMs": 20617,
          "endMs": 24159,
          "method": "silence",
          "globalStartMs": 161706,
          "globalEndMs": 165248
        },
        {
          "text": "il n'invente pas une explication à partir de la seule chronologie.",
          "startMs": 24637,
          "endMs": 28821,
          "method": "silence",
          "globalStartMs": 165726,
          "globalEndMs": 169910
        }
      ],
      "anchors": [
        {
          "segmentId": "story",
          "phrase": "Le mode Récit répond à une autre question",
          "startMs": 427,
          "endMs": 3579,
          "cueMs": 141518
        },
        {
          "segmentId": "story",
          "phrase": "Ouvrons cet enchaînement",
          "startMs": 12530,
          "endMs": 15224,
          "cueMs": 153620
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 141987
        },
        {
          "kind": "click",
          "atMs": 154104
        },
        {
          "kind": "click",
          "atMs": 161820
        }
      ]
    },
    {
      "scene": "baseline",
      "startMs": 173441,
      "endMs": 200874,
      "sentences": [
        {
          "text": "Un ancien événement peut avoir des créneaux et des inscriptions sans historique enregistré.",
          "startMs": 188,
          "endMs": 4695,
          "method": "silence",
          "globalStartMs": 173629,
          "globalEndMs": 178136
        },
        {
          "text": "Générer l'état initial ajoute alors un point de départ pour ces éléments existants.",
          "startMs": 4913,
          "endMs": 9010,
          "method": "silence",
          "globalStartMs": 178354,
          "globalEndMs": 182451
        },
        {
          "text": "Faisons-le sur notre second exemple, puis lisons la mention grise :",
          "startMs": 9561,
          "endMs": 13988,
          "method": "silence",
          "globalStartMs": 183002,
          "globalEndMs": 187429
        },
        {
          "text": "Généré, pas une action réelle.",
          "startMs": 14395,
          "endMs": 15346,
          "method": "silence",
          "globalStartMs": 187836,
          "globalEndMs": 188787
        },
        {
          "text": "Ce bouton ne retrouve pas les anciennes manipulations oubliées.",
          "startMs": 15947,
          "endMs": 19524,
          "method": "silence",
          "globalStartMs": 189388,
          "globalEndMs": 192965
        },
        {
          "text": "Une nouvelle génération ne doit pas créer de doublons.",
          "startMs": 19736,
          "endMs": 21915,
          "method": "silence",
          "globalStartMs": 193177,
          "globalEndMs": 195356
        },
        {
          "text": "Elle sert à partir d'un état connu, pas à prétendre que l'on connaît tout le passé.",
          "startMs": 22435,
          "endMs": 27432,
          "method": "silence",
          "globalStartMs": 195876,
          "globalEndMs": 200873
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 183517
        }
      ]
    },
    {
      "scene": "privacy",
      "startMs": 204270,
      "endMs": 227460,
      "sentences": [
        {
          "text": "Le journal n'est pas un carnet d'adresses.",
          "startMs": 239,
          "endMs": 1942,
          "method": "silence",
          "globalStartMs": 204509,
          "globalEndMs": 206212
        },
        {
          "text": "Le contenu des pages personnalisées et les coordonnées des bénévoles n'y sont pas recopiés.",
          "startMs": 2327,
          "endMs": 6319,
          "method": "silence",
          "globalStartMs": 206597,
          "globalEndMs": 210589
        },
        {
          "text": "Il montre les champs modifiés et résout le nom de l'auteur lorsque ce compte existe encore.",
          "startMs": 6842,
          "endMs": 11517,
          "method": "silence",
          "globalStartMs": 211112,
          "globalEndMs": 215787
        },
        {
          "text": "Pour joindre une personne, retournez à la vue prévue pour les inscriptions ou les membres, avec les droits nécessaires.",
          "startMs": 11835,
          "endMs": 17039,
          "method": "silence",
          "globalStartMs": 216105,
          "globalEndMs": 221309
        },
        {
          "text": "Une capture d'historique peut tout de même contenir des noms :",
          "startMs": 17437,
          "endMs": 20013,
          "method": "silence",
          "globalStartMs": 221707,
          "globalEndMs": 224283
        },
        {
          "text": "partagez-la seulement avec les personnes qui en ont besoin.",
          "startMs": 20434,
          "endMs": 22886,
          "method": "silence",
          "globalStartMs": 224704,
          "globalEndMs": 227156
        }
      ],
      "anchors": [
        {
          "segmentId": "privacy",
          "phrase": "Pour joindre une personne",
          "startMs": 11835,
          "endMs": 17039,
          "cueMs": 216108
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 208222
        }
      ]
    },
    {
      "scene": "result",
      "startMs": 229723,
      "endMs": 259510,
      "sentences": [
        {
          "text": "Nous avons retrouvé une action, vu l'évolution d'un élément et lu un enchaînement sans modifier le planning.",
          "startMs": 311,
          "endMs": 6558,
          "method": "silence",
          "globalStartMs": 230034,
          "globalEndMs": 236281
        },
        {
          "text": "Pour agir, revenez ensuite aux inscriptions ou aux créneaux concernés.",
          "startMs": 7221,
          "endMs": 11051,
          "method": "silence",
          "globalStartMs": 236944,
          "globalEndMs": 240774
        },
        {
          "text": "Le bon réflexe, c'est de vérifier le type, la période et l'origine avant de conclure.",
          "startMs": 11501,
          "endMs": 16337,
          "method": "silence",
          "globalStartMs": 241224,
          "globalEndMs": 246060
        },
        {
          "text": "Le journal facilite la coordination quand plusieurs personnes organisent ensemble.",
          "startMs": 16607,
          "endMs": 22136,
          "method": "silence",
          "globalStartMs": 246330,
          "globalEndMs": 251859
        },
        {
          "text": "Il aide à poser une question précise et à corriger le bon problème, calmement, plutôt qu'à recommencer tout le planning.",
          "startMs": 22437,
          "endMs": 29390,
          "method": "silence",
          "globalStartMs": 252160,
          "globalEndMs": 259113
        }
      ],
      "anchors": [
        {
          "segmentId": "result",
          "phrase": "Pour agir, revenez ensuite",
          "startMs": 7221,
          "endMs": 11051,
          "cueMs": 236946
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 238565
        }
      ]
    }
  ]
