    "builtAt": "2026-10-11T16:01:24.202Z"
  },
  "sentences": [
    {
      "scene": "welcome",
      "startMs": 1306,
      "endMs": 25694,
      "sentences": [
        {
          "text": "Une inscription a disparu, un horaire a changé :",
          "startMs": 296,
          "endMs": 1712,
          "method": "silence",
          "globalStartMs": 1602,
          "globalEndMs": 3018
        },
        {
          "text": "avant de chercher un coupable, retrouvons ce qui s'est passé.",
          "startMs": 2258,
          "endMs": 5227,
          "method": "silence",
          "globalStartMs": 3564,
          "globalEndMs": 6533
        },
        {
          "text": "Depuis notre événement de démonstration, ouvrons le Journal.",
          "startMs": 5447,
          "endMs": 9063,
          "method": "silence",
          "globalStartMs": 6753,
          "globalEndMs": 10369
        },
        {
          "text": "Son historique contient des actions sur les créneaux, les inscriptions et les réglages de cet événement.",
          "startMs": 9334,
          "endMs": 15231,
          "method": "silence",
          "globalStartMs": 10640,
          "globalEndMs": 16537
        },
        {
          "text": "Nous allons lire une entrée, filtrer la liste et suivre un enchaînement.",
          "startMs": 15881,
          "endMs": 18179,
          "method": "silence",
          "globalStartMs": 17187,
          "globalEndMs": 19485
        },
        {
          "text": "Les personnes et l'histoire utilisées ici sont fictives, mais les écrans sont ceux de l'application.",
          "startMs": 18402,
          "endMs": 23887,
          "method": "silence",
          "globalStartMs": 19708,
          "globalEndMs": 25193
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 7887
        }
      ]
    },
    {
      "scene": "read",
      "startMs": 27953,
      "endMs": 52236,
      "sentences": [
        {
          "text": "Dans Explorer, chaque entrée indique le type d'élément, la date et la personne à l'origine de l'action.",
          "startMs": 514,
          "endMs": 5422,
          "method": "silence",
          "globalStartMs": 28467,
          "globalEndMs": 33375
        },
        {
          "text": "Une action automatique apparaît avec le système, pas avec le nom d'un organisateur.",
          "startMs": 6180,
          "endMs": 9851,
          "method": "silence",
          "globalStartMs": 34133,
          "globalEndMs": 37804
        },
        {
          "text": "Lisons une inscription, puis une modification de créneau.",
          "startMs": 10645,
          "endMs": 11543,
          "method": "silence",
          "globalStartMs": 38598,
          "globalEndMs": 39496
        },
        {
          "text": "Quand des valeurs ont changé, les lignes en dessous donnent les différences enregistrées.",
          "startMs": 12165,
          "endMs": 17786,
          "method": "silence",
          "globalStartMs": 40118,
          "globalEndMs": 45739
        },
        {
          "text": "Le journal aide à comprendre une modification ;",
          "startMs": 18516,
          "endMs": 20702,
          "method": "silence",
          "globalStartMs": 46469,
          "globalEndMs": 48655
        },
        {
          "text": "il ne faut pas confondre son auteur avec la personne concernée par l'inscription.",
          "startMs": 20887,
          "endMs": 23803,
          "method": "silence",
          "globalStartMs": 48840,
          "globalEndMs": 51756
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "filters",
      "startMs": 54499,
      "endMs": 79008,
      "sentences": [
        {
          "text": "Pour retrouver une désinscription, commençons par Type d'élément, puis choisissons Inscription.",
          "startMs": 499,
          "endMs": 5174,
          "method": "silence",
          "globalStartMs": 54998,
          "globalEndMs": 59673
        },
        {
          "text": "Le filtre Qui distingue les actions des bénévoles, des administrateurs et du système.",
          "startMs": 6071,
          "endMs": 10377,
          "method": "silence",
          "globalStartMs": 60570,
          "globalEndMs": 64876
        },
        {
          "text": "Il ne recherche pas un prénom.",
          "startMs": 10624,
          "endMs": 11537,
          "method": "silence",
          "globalStartMs": 65123,
          "globalEndMs": 66036
        },
        {
          "text": "Le filtre Action permet aussi de se concentrer sur les inscriptions, les créneaux ou les pages.",
          "startMs": 12246,
          "endMs": 16290,
          "method": "silence",
          "globalStartMs": 66745,
          "globalEndMs": 70789
        },
        {
          "text": "Regardons la liste changer, puis revenons à toutes les actions.",
          "startMs": 16952,
          "endMs": 19701,
          "method": "silence",
          "globalStartMs": 71451,
          "globalEndMs": 74200
        },
        {
          "text": "Les filtres limitent l'affichage ;",
          "startMs": 20645,
          "endMs": 21989,
          "method": "silence",
          "globalStartMs": 75144,
          "globalEndMs": 76488
        },
        {
          "text": "ils ne suppriment aucune entrée de l'historique.",
          "startMs": 22204,
          "endMs": 23979,
          "method": "silence",
          "globalStartMs": 76703,
          "globalEndMs": 78478
        }
      ],
      "anchors": [
        {
          "segmentId": "filters",
          "phrase": "Le filtre Qui distingue",
          "startMs": 6071,
          "endMs": 10377,
          "cueMs": 60570
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 57917
        },
        {
          "kind": "click",
          "atMs": 61050
        },
        {
          "kind": "click",
          "atMs": 67467
        }
      ]
    },
    {
      "scene": "period",
      "startMs": 81281,
      "endMs": 103883,
      "sentences": [
        {
          "text": "Vous savez quand le changement a eu lieu ?",
          "startMs": 529,
          "endMs": 2320,
          "method": "silence",
          "globalStartMs": 81810,
          "globalEndMs": 83601
        },
        {
          "text": "Renseignez Depuis et Jusqu'à pour limiter la période.",
          "startMs": 2471,
          "endMs": 4511,
          "method": "silence",
          "globalStartMs": 83752,
          "globalEndMs": 85792
        },
        {
          "text": "Choisissons quelques jours de notre exemple, puis élargissons à nouveau la recherche.",
          "startMs": 4744,
          "endMs": 9534,
          "method": "silence",
          "globalStartMs": 86025,
          "globalEndMs": 90815
        },
        {
          "text": "Une liste vide peut simplement venir des filtres :",
          "startMs": 10183,
          "endMs": 12370,
          "method": "silence",
          "globalStartMs": 91464,
          "globalEndMs": 93651
        },
        {
          "text": "ce n'est pas la preuve qu'aucune action n'a jamais eu lieu.",
          "startMs": 12516,
          "endMs": 14251,
          "method": "silence",
          "globalStartMs": 93797,
          "globalEndMs": 95532
        },
        {
          "text": "Quand il reste des entrées à lire, Charger plus complète la liste.",
          "startMs": 15136,
          "endMs": 18274,
          "method": "silence",
          "globalStartMs": 96417,
          "globalEndMs": 99555
        },
        {
          "text": "Le nombre affiché décrit ce qui a été chargé, pas forcément tout l'historique de l'événement.",
          "startMs": 18685,
          "endMs": 22081,
          "method": "silence",
          "globalStartMs": 99966,
          "globalEndMs": 103362
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 98273
        }
      ]
    },
    {
      "scene": "replay",
      "startMs": 106148,
      "endMs": 138827,
      "sentences": [
        {
          "text": "Pour comprendre l'évolution d'un même créneau, ouvrons Rejouer.",
          "startMs": 519,
          "endMs": 3735,
          "method": "silence",
          "globalStartMs": 106667,
          "globalEndMs": 109883
        },
        {
          "text": "Choisissons un élément qui possède plusieurs entrées, puis avançons étape par étape.",
          "startMs": 4265,
          "endMs": 10018,
          "method": "silence",
          "globalStartMs": 110413,
          "globalEndMs": 116166
        },
        {
          "text": "Les boutons précédent et suivant, comme le curseur, permettent de parcourir les changements enregistrés.",
          "startMs": 10145,
          "endMs": 16054,
          "method": "silence",
          "globalStartMs": 116293,
          "globalEndMs": 122202
        },
        {
          "text": "Regardons la capacité avant et après sa modification.",
          "startMs": 16617,
          "endMs": 20243,
          "method": "silence",
          "globalStartMs": 122765,
          "globalEndMs": 126391
        },
        {
          "text": "Rejouer ne remet pas l'événement dans un ancien état :",
          "startMs": 20827,
          "endMs": 24507,
          "method": "silence",
          "globalStartMs": 126975,
          "globalEndMs": 130655
        },
        {
          "text": "c'est une lecture de l'historique, pas une restauration.",
          "startMs": 25108,
          "endMs": 26655,
          "method": "silence",
          "globalStartMs": 131256,
          "globalEndMs": 132803
        },
        {
          "text": "Changer d'élément permet ensuite de suivre une inscription plutôt qu'un créneau.",
          "startMs": 26913,
          "endMs": 32252,
          "method": "silence",
          "globalStartMs": 133061,
          "globalEndMs": 138400
        }
      ],
      "anchors": [
        {
          "segmentId": "replay",
          "phrase": "Pour comprendre l'évolution d'un même créneau",
          "startMs": 519,
          "endMs": 3735,
          "cueMs": 106668
        },
        {
          "segmentId": "replay",
          "phrase": "Choisissons un élément qui possède plusieurs entrées",
          "startMs": 4265,
          "endMs": 10018,
          "cueMs": 110415
        },
        {
          "segmentId": "replay",
          "phrase": "Changer d'élément permet ensuite",
          "startMs": 26913,
          "endMs": 32252,
          "cueMs": 133062
        }
      ],
