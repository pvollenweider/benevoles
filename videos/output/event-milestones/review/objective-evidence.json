      "scene": "welcome",
      "startMs": 1208,
      "endMs": 12757,
      "sentences": [
        {
          "text": "Les jalons servent à garder sous les yeux les quelques échéances qui font avancer l’événement.",
          "startMs": 290,
          "endMs": 4157,
          "method": "silence",
          "globalStartMs": 1498,
          "globalEndMs": 5365
        },
        {
          "text": "Ils ne remplacent pas un outil de gestion de projet :",
          "startMs": 4578,
          "endMs": 6771,
          "method": "silence",
          "globalStartMs": 5786,
          "globalEndMs": 7979
        },
        {
          "text": "ils donnent à l’équipe un rappel commun, directement à côté des inscriptions et du planning.",
          "startMs": 7035,
          "endMs": 11142,
          "method": "silence",
          "globalStartMs": 8243,
          "globalEndMs": 12350
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "create",
      "startMs": 13212,
      "endMs": 29508,
      "sentences": [
        {
          "text": "Ajoutons Fermer les inscriptions avec une date d’échéance.",
          "startMs": 405,
          "endMs": 3825,
          "method": "silence",
          "globalStartMs": 13617,
          "globalEndMs": 17037
        },
        {
          "text": "Un bon jalon décrit un résultat vérifiable :",
          "startMs": 4403,
          "endMs": 6694,
          "method": "silence",
          "globalStartMs": 17615,
          "globalEndMs": 19906
        },
        {
          "text": "valider le plan de sécurité, envoyer les consignes, imprimer les badges ou remercier les bénévoles.",
          "startMs": 7156,
          "endMs": 12061,
          "method": "silence",
          "globalStartMs": 20368,
          "globalEndMs": 25273
        },
        {
          "text": "Évitez les formulations vagues comme penser à la communication.",
          "startMs": 12444,
          "endMs": 15863,
          "method": "silence",
          "globalStartMs": 25656,
          "globalEndMs": 29075
        }
      ],
      "anchors": [
