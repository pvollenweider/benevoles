    {
      "scene": "states",
      "startMs": 29961,
      "endMs": 44043,
      "sentences": [
        {
          "text": "La liste est triée par date.",
          "startMs": 529,
          "endMs": 1798,
          "method": "silence",
          "globalStartMs": 30490,
          "globalEndMs": 31759
        },
        {
          "text": "Une échéance passée et non terminée est signalée comme dépassée ;",
          "startMs": 2257,
          "endMs": 5706,
          "method": "silence",
          "globalStartMs": 32218,
          "globalEndMs": 35667
        },
        {
          "text": "une étape faite est barrée mais reste visible.",
          "startMs": 6003,
          "endMs": 8587,
          "method": "silence",
          "globalStartMs": 35964,
          "globalEndMs": 38548
        },
        {
          "text": "On comprend donc en un regard ce qui est en retard, ce qui arrive et ce qui a déjà été sécurisé.",
          "startMs": 8982,
          "endMs": 13683,
          "method": "silence",
          "globalStartMs": 38943,
          "globalEndMs": 43644
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "toggle",
      "startMs": 44495,
      "endMs": 57308,
      "sentences": [
        {
          "text": "Quand une étape est terminée, cochez-la.",
          "startMs": 469,
          "endMs": 2348,
          "method": "silence",
          "globalStartMs": 44964,
          "globalEndMs": 46843
        },
        {
          "text": "Le titre devient barré.",
          "startMs": 2832,
          "endMs": 3825,
          "method": "silence",
          "globalStartMs": 47327,
          "globalEndMs": 48320
        },
        {
          "text": "Si la situation change, décochez-la pour la remettre à faire :",
          "startMs": 4268,
          "endMs": 7203,
          "method": "silence",
          "globalStartMs": 48763,
          "globalEndMs": 51698
        },
        {
          "text": "la date et le titre sont conservés, et toute l’équipe retrouve le même état lors du prochain passage.",
          "startMs": 7328,
          "endMs": 12316,
          "method": "silence",
          "globalStartMs": 51823,
          "globalEndMs": 56811
        }
