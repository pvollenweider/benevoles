  {
    "chapter": "personal-link",
    "startMs": 112231,
    "endMs": 136641,
    "sentences": [
      {
        "text": "Ouvrons le lien reçu par Aline.",
        "startMs": 303,
        "endMs": 1884,
        "method": "silence",
        "absoluteStartMs": 112534
      },
      {
        "text": "Il mène à la fête avec ses coordonnées préremplies.",
        "startMs": 2306,
        "endMs": 5340,
        "method": "silence",
        "absoluteStartMs": 114537
      },
      {
        "text": "Elle peut regarder les horaires, choisir un créneau disponible et compléter les informations demandées.",
        "startMs": 5881,
        "endMs": 11905,
        "method": "silence",
        "absoluteStartMs": 118112
      },
      {
        "text": "Nous faisons une vraie inscription de démonstration, jusqu'à la confirmation.",
        "startMs": 12838,
        "endMs": 16961,
        "method": "silence",
        "absoluteStartMs": 125069
      },
      {
        "text": "Le lien est personnel :",
        "startMs": 17586,
        "endMs": 19879,
        "method": "silence",
        "absoluteStartMs": 129817
      },
      {
        "text": "il ne faut pas le partager comme si c'était l'adresse publique de la fête.",
        "startMs": 20048,
        "endMs": 24202,
        "method": "silence",
        "absoluteStartMs": 132279
      }
    ],
