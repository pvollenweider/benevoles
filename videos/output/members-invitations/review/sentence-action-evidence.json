  {
    "chapter": "group",
    "startMs": 68807,
    "endMs": 90948,
    "sentences": [
      {
        "text": "Pour un groupe, utilisez le filtre de tags.",
        "startMs": 500,
        "endMs": 2566,
        "method": "silence",
        "absoluteStartMs": 69307
      },
      {
        "text": "Il permet par exemple de retrouver les personnes de l'accueil.",
        "startMs": 3242,
        "endMs": 5626,
        "method": "silence",
        "absoluteStartMs": 72049
      },
      {
        "text": "Tout sélectionner ajoute les membres visibles à votre sélection.",
        "startMs": 6399,
        "endMs": 9005,
        "method": "silence",
        "absoluteStartMs": 75206
      },
      {
        "text": "Attention :",
        "startMs": 9733,
        "endMs": 10171,
        "method": "silence",
        "absoluteStartMs": 78540
      },
      {
        "text": "une personne déjà cochée peut rester sélectionnée après un changement de filtre.",
        "startMs": 10467,
        "endMs": 13569,
        "method": "silence",
        "absoluteStartMs": 79274
      },
      {
        "text": "Le compteur reste votre repère.",
        "startMs": 14146,
        "endMs": 15609,
        "method": "silence",
        "absoluteStartMs": 82953
      },
      {
        "text": "Avec Effacer, repartez d'une sélection vide, puis choisissez précisément les personnes que vous voulez inviter.",
        "startMs": 16493,
        "endMs": 21721,
        "method": "silence",
        "absoluteStartMs": 85300
      }
    ],
    "anchors": [
      {
        "segmentId": "group",
