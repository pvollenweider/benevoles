  {
    "chapter": "status",
    "startMs": 162392,
    "endMs": 183941,
    "sentences": [
      {
        "text": "De retour dans Invitations, Aline a maintenant une participation confirmée.",
        "startMs": 748,
        "endMs": 5226,
        "method": "silence",
        "absoluteStartMs": 163140
      },
      {
        "text": "D'autres personnes restent sans créneau confirmé.",
        "startMs": 6019,
        "endMs": 8441,
        "method": "silence",
        "absoluteStartMs": 168411
      },
      {
        "text": "Ce statut ne dit pas si elles ont ouvert leur email.",
        "startMs": 9248,
        "endMs": 11850,
        "method": "silence",
        "absoluteStartMs": 171640
      },
      {
        "text": "Il peut aussi concerner une personne en liste d'attente ou une demande encore à valider.",
        "startMs": 11993,
        "endMs": 15977,
        "method": "silence",
        "absoluteStartMs": 174385
      },
      {
        "text": "Le tableau sert à suivre la participation, pas à surveiller la lecture des messages.",
        "startMs": 16721,
        "endMs": 21009,
        "method": "silence",
