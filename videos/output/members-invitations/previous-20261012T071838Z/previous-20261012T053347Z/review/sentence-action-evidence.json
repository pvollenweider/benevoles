[
  {
    "chapter": "welcome",
    "startMs": 0,
    "endMs": 24217,
    "sentences": [
      {
        "text": "Votre fête est prête, et vous souhaitez proposer des créneaux aux membres de votre association ?",
        "startMs": 317,
        "endMs": 5581,
        "method": "silence",
        "absoluteStartMs": 317
      },
      {
        "text": "Dans Invitations, vous pouvez contacter une personne ou un groupe.",
        "startMs": 5716,
        "endMs": 9106,
        "method": "silence",
        "absoluteStartMs": 5716
      },
      {
        "text": "Une invitation n'est pas une inscription :",
        "startMs": 9916,
        "endMs": 12087,
        "method": "silence",
        "absoluteStartMs": 9916
      },
      {
        "text": "chacun choisit ensuite sa participation.",
        "startMs": 12233,
        "endMs": 14160,
        "method": "silence",
        "absoluteStartMs": 12233
      },
      {
        "text": "Les compteurs distinguent les personnes invitées et celles qui ont un créneau confirmé.",
        "startMs": 15365,
        "endMs": 19326,
        "method": "silence",
        "absoluteStartMs": 15365
      },
      {
        "text": "Voyons tout le parcours, de l'envoi au choix du bénévole.",
        "startMs": 20356,
        "endMs": 23556,
        "method": "silence",
        "absoluteStartMs": 20356
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "test",
    "startMs": 24671,
    "endMs": 45224,
    "sentences": [
      {
        "text": "Avant de contacter l'équipe, vous pouvez tester l'envoi d'email.",
        "startMs": 664,
        "endMs": 3616,
        "method": "silence",
        "absoluteStartMs": 25335
      },
      {
        "text": "Indiquez une adresse que vous utilisez pour vérifier les messages, puis envoyez le test.",
        "startMs": 4584,
        "endMs": 8822,
        "method": "silence",
        "absoluteStartMs": 29255
      },
      {
        "text": "Nous ouvrons ici le message reçu dans notre boîte de démonstration.",
        "startMs": 9838,
        "endMs": 12528,
        "method": "silence",
        "absoluteStartMs": 34509
      },
      {
        "text": "Cela permet de regarder la présentation.",
        "startMs": 13310,
        "endMs": 15035,
        "method": "silence",
        "absoluteStartMs": 37981
      },
      {
        "text": "Un email de test n'inscrit personne et ne remplace pas une vraie invitation à un membre.",
        "startMs": 16050,
        "endMs": 20151,
        "method": "silence",
        "absoluteStartMs": 40721
      }
    ],
