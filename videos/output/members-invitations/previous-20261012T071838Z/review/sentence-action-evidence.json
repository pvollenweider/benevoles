  {
    "chapter": "individual",
    "startMs": 45677,
    "endMs": 68356,
    "sentences": [
      {
        "text": "Cliquez sur Inviter des membres.",
        "startMs": 399,
        "endMs": 2012,
        "method": "silence",
        "absoluteStartMs": 46076
      },
      {
        "text": "Pour une invitation individuelle, recherchez Aline, puis cochez seulement sa fiche.",
        "startMs": 2896,
        "endMs": 6852,
        "method": "silence",
        "absoluteStartMs": 48573
      },
      {
        "text": "Le compteur indique une personne sélectionnée.",
        "startMs": 7581,
        "endMs": 9551,
        "method": "silence",
        "absoluteStartMs": 53258
      },
      {
        "text": "Vous pouvez ajouter un court mot d'accompagnement :",
        "startMs": 10571,
        "endMs": 12362,
        "method": "silence",
        "absoluteStartMs": 56248
      },
      {
        "text": "Bonjour Aline, nous serions ravis de te retrouver à l'accueil.",
        "startMs": 13143,
        "endMs": 15740,
        "method": "silence",
        "absoluteStartMs": 58820
      },
      {
        "text": "Vérifiez le destinataire, puis envoyez cette invitation.",
        "startMs": 16414,
        "endMs": 19105,
        "method": "silence",
        "absoluteStartMs": 62091
      },
      {
        "text": "La personne apparaît ensuite dans le tableau de l'événement.",
        "startMs": 19976,
        "endMs": 22184,
        "method": "silence",
        "absoluteStartMs": 65653
      }
    ],
    "anchors": [
      {
