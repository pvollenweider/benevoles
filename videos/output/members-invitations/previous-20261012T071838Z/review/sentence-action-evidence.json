  {
    "chapter": "reserved",
    "startMs": 137094,
    "endMs": 161933,
    "sentences": [
      {
        "text": "Une invitation peut aussi donner accès à un poste réservé aux membres portant un certain tag.",
        "startMs": 207,
        "endMs": 6305,
        "method": "silence",
        "absoluteStartMs": 137301
      },
      {
        "text": "Ici, Nicolas a le tag sécurité.",
        "startMs": 6427,
        "endMs": 8098,
        "method": "silence",
        "absoluteStartMs": 143521
      },
      {
        "text": "Avec son invitation valide, il peut choisir le poste réservé correspondant.",
        "startMs": 8936,
        "endMs": 12546,
        "method": "silence",
        "absoluteStartMs": 146030
      },
      {
        "text": "Ce n'est pas une autorisation générale :",
        "startMs": 13421,
        "endMs": 15037,
        "method": "silence",
        "absoluteStartMs": 150515
      },
      {
        "text": "les tags actuels sont revérifiés à l'inscription.",
        "startMs": 15170,
        "endMs": 17788,
        "method": "silence",
        "absoluteStartMs": 152264
      },
      {
        "text": "Et un poste réservé est différent d'une demande que l'organisateur doit accepter avant confirmation.",
        "startMs": 18553,
        "endMs": 24101,
        "method": "silence",
        "absoluteStartMs": 155647
      }
    ],
    "anchors": [
      {
        "segmentId": "reserved",
        "phrase": "Avec son invitation valide, il",
        "startMs": 8936,
        "endMs": 12546,
        "cueMs": 146032
      },
      {
        "segmentId": "reserved",
        "phrase": "les tags actuels sont revérifiés",
        "startMs": 15170,
        "endMs": 17788,
        "cueMs": 152266
      }
    ],
