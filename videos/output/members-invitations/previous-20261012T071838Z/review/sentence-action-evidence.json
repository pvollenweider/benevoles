  {
    "chapter": "send",
    "startMs": 91404,
    "endMs": 111780,
    "sentences": [
      {
        "text": "Nous sélectionnons maintenant deux personnes et ajoutons un message commun.",
        "startMs": 421,
        "endMs": 3649,
        "method": "silence",
        "absoluteStartMs": 91825
      },
      {
        "text": "Envoyer deux invitations déclenche des messages individuels.",
        "startMs": 4450,
        "endMs": 6972,
        "method": "silence",
        "absoluteStartMs": 95854
      },
      {
        "text": "Dans la boîte de démonstration, chaque personne reçoit son propre email et son propre lien.",
        "startMs": 7641,
        "endMs": 11656,
        "method": "silence",
        "absoluteStartMs": 99045
      },
      {
        "text": "Les coordonnées des autres invités ne sont pas affichées dans son message.",
        "startMs": 12582,
        "endMs": 15323,
        "method": "silence",
        "absoluteStartMs": 103986
      },
      {
        "text": "La remise à cette boîte de test ne prouve évidemment pas qu'un bénévole a lu son email.",
        "startMs": 16198,
        "endMs": 20072,
        "method": "silence",
        "absoluteStartMs": 107602
      }
    ],
