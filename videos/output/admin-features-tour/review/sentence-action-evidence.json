    {
      "chapter": "organization",
      "startSeconds": 15.941,
      "endSeconds": 31.414,
      "sentences": [
        {
          "text": "Tout commence avec l’identité de l’organisation.",
          "startMs": 285,
          "endMs": 2593,
          "method": "silence",
          "videoSeconds": 16.226
