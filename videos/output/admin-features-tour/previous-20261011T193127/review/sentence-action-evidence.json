  {
    "id": "shift-fields",
    "startMs": 124570,
    "sentences": [
      {
        "text": "Chaque créneau peut préciser le poste, le libellé, la date, les horaires et la capacité, mais aussi une description, un lieu de rendez-vous, une carte, un contact, une consigne, des notes internes et un âge minimum.",
        "startMs": 842,
        "endMs": 13125,
        "method": "silence",
        "absoluteStartMs": 125412
      },
      {
        "text": "La liste d’attente et l’inscription sur validation s’activent ici.",
        "startMs": 13253,
        "endMs": 17638,
        "method": "silence",
        "absoluteStartMs": 137823
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 125043
      }
    ]
  },
  {
    "id": "registrations",
    "startMs": 145953,
    "sentences": [
      {
        "text": "La vue des inscriptions montre qui est inscrit, sur quel créneau et par quel moyen.",
        "startMs": 345,
        "endMs": 4929,
        "method": "silence",
        "absoluteStartMs": 146298
      },
      {
        "text": "Tu peux filtrer, ajouter quelqu’un manuellement, accepter une demande, renvoyer son lien, désigner un responsable, retirer une inscription et noter les présences.",
        "startMs": 5274,
        "endMs": 15246,
        "method": "silence",
        "absoluteStartMs": 151227
      }
    ],
    "inputs": []
  },
  {
    "id": "members",
    "startMs": 163302,
    "sentences": [
      {
        "text": "La liste des membres rassemble inscrits et personnes importées, avec coordonnées, étiquettes, notes, disponibilités, heures planifiées et activité.",
        "startMs": 409,
        "endMs": 8799,
        "method": "silence",
        "absoluteStartMs": 163711
      },
      {
        "text": "La fiche d’une personne retrace ses invitations, inscriptions et présences d’un événement à l’autre.",
        "startMs": 8998,
        "endMs": 15031,
        "method": "silence",
        "absoluteStartMs": 172300
      }
    ],
    "inputs": []
  },
  {
    "id": "questions",
    "startMs": 180302,
    "sentences": [
      {
        "text": "Le formulaire peut poser quelques questions utiles :",
        "startMs": 393,
        "endMs": 2480,
        "method": "silence",
        "absoluteStartMs": 180695
      },
      {
        "text": "taille de t-shirt, régime alimentaire ou permis de conduire, sous forme de texte, de choix unique ou de cases à cocher.",
        "startMs": 2826,
        "endMs": 9284,
        "method": "silence",
        "absoluteStartMs": 183128
      },
      {
        "text": "Tu décides si la réponse est obligatoire, en évitant les données sensibles inutiles.",
        "startMs": 9726,
        "endMs": 13885,
        "method": "silence",
        "absoluteStartMs": 190028
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 183601
      },
      {
        "kind": "click",
        "atMs": 185100
      }
    ]
  },
  {
    "id": "pages",
    "startMs": 196129,
    "sentences": [
      {
        "text": "Tu peux aussi créer des pages publiques pour l’accès, le parking, la foire aux questions ou le règlement.",
        "startMs": 370,
        "endMs": 6053,
        "method": "silence",
        "absoluteStartMs": 196499
      },
      {
        "text": "Donne un titre, rédige le contenu, puis organise leur ordre :",
        "startMs": 6635,
        "endMs": 10226,
        "method": "silence",
        "absoluteStartMs": 202764
      },
      {
        "text": "elles apparaissent directement avec la page d’inscription.",
        "startMs": 10617,
        "endMs": 13604,
        "method": "silence",
        "absoluteStartMs": 206746
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 199356
      },
      {
        "kind": "click",
        "atMs": 201305
      },
      {
        "kind": "click",
        "atMs": 203804
      }
    ]
  },
  {
    "id": "messages",
    "startMs": 213217,
    "sentences": [
      {
        "text": "Les messages ciblent tous les inscrits, un poste, un créneau, la liste d’attente ou les invités sans créneau.",
        "startMs": 290,
        "endMs": 6665,
        "method": "silence",
        "absoluteStartMs": 213507
      },
      {
        "text": "Les modèles réutilisables acceptent des variables comme le prénom, l’événement, les créneaux ou le lien personnel.",
        "startMs": 7101,
        "endMs": 13671,
        "method": "silence",
        "absoluteStartMs": 220318
      },
      {
        "text": "Tu prévisualises toujours le résultat avant l’envoi.",
        "startMs": 14380,
        "endMs": 17511,
        "method": "silence",
        "absoluteStartMs": 227597
      }
    ],
    "inputs": []
  },
  {
    "id": "reminders",
    "startMs": 232486,
    "sentences": [
      {
        "text": "Les rappels automatiques peuvent partir deux jours avant, la veille et le jour même.",
        "startMs": 180,
        "endMs": 4074,
        "method": "silence",
        "absoluteStartMs": 232666
      },
      {
        "text": "L’organisation choisit lesquels activer, où arrivent les réponses, et si ses admins doivent être prévenus à chaque nouvelle inscription.",
        "startMs": 4840,
        "endMs": 11331,
        "method": "silence",
        "absoluteStartMs": 237326
      }
    ],
    "inputs": []
  },
  {
    "id": "reports",
    "startMs": 247479,
    "sentences": [
      {
        "text": "Pour le terrain, les rapports proposent le planning complet, une vue par poste, une vue par bénévole, la feuille de présence et la liste avec téléphones réservée aux organisateurs.",
        "startMs": 337,
        "endMs": 10896,
        "method": "silence",
        "absoluteStartMs": 247816
      },
      {
        "text": "Les badges se génèrent en PDF, par poste ou par créneau, prêts à imprimer et découper.",
        "startMs": 11496,
        "endMs": 16744,
        "method": "silence",
        "absoluteStartMs": 258975
      }
    ],
    "inputs": []
  },
  {
    "id": "activity",
    "startMs": 267828,
    "sentences": [
      {
        "text": "Enfin, le journal d’activité garde la chronologie :",
        "startMs": 292,
        "endMs": 3317,
        "method": "silence",
        "absoluteStartMs": 268120
      },
      {
        "text": "création et modification des créneaux, inscriptions, désinscriptions, invitations et actions des organisateurs.",
        "startMs": 3993,
        "endMs": 11046,
        "method": "silence",
        "absoluteStartMs": 271821
      },
      {
        "text": "On sait ce qui s’est passé, qui l’a fait et quand.",
        "startMs": 11636,
        "endMs": 13388,
        "method": "silence",
        "absoluteStartMs": 279464
      },
      {
        "text": "La recherche globale permet ensuite de tout retrouver rapidement.",
        "startMs": 13748,
        "endMs": 17700,
        "method": "silence",
        "absoluteStartMs": 281576
      }
    ],
