[
  {
    "id": "intro",
    "startMs": 0,
    "sentences": [
      {
        "text": "Voici une visite complète de l’administration, dans l’ordre où tu l’utiliseras vraiment :",
        "startMs": 303,
        "endMs": 6460,
        "method": "silence",
        "absoluteStartMs": 303
      },
      {
        "text": "préparer ton organisation, construire un événement, accueillir les bénévoles, communiquer, puis préparer le jour J.",
        "startMs": 7015,
        "endMs": 13092,
        "method": "silence",
        "absoluteStartMs": 7015
      }
    ],
    "inputs": []
  },
  {
    "id": "organization",
    "startMs": 16591,
    "sentences": [
      {
        "text": "Tout commence avec l’identité de l’organisation.",
        "startMs": 285,
        "endMs": 2593,
        "method": "silence",
        "absoluteStartMs": 16876
      },
      {
        "text": "Son identifiant public forme une adresse comme fetes-de-montvert point benevol point app.",
        "startMs": 3191,
        "endMs": 8604,
        "method": "silence",
        "absoluteStartMs": 19782
      },
      {
        "text": "Tu choisis aussi le nom affiché, le fuseau horaire et la Convention des Bénévoles que chacun devra accepter.",
        "startMs": 9249,
        "endMs": 15073,
        "method": "silence",
        "absoluteStartMs": 25840
      }
    ],
    "inputs": []
  },
  {
    "id": "team",
    "startMs": 32506,
    "sentences": [
      {
        "text": "Côté équipe, le propriétaire administre l’organisation et ses accès.",
        "startMs": 407,
        "endMs": 4419,
        "method": "silence",
        "absoluteStartMs": 32913
      },
      {
        "text": "Les organisateurs préparent les événements, les membres et les communications.",
        "startMs": 5197,
        "endMs": 8882,
        "method": "silence",
        "absoluteStartMs": 37703
      },
      {
        "text": "Les responsables de secteur reçoivent un lien personnel limité à leur poste, avec les noms et coordonnées des inscrits, sans accès au reste de l’administration.",
        "startMs": 9329,
        "endMs": 18457,
        "method": "silence",
        "absoluteStartMs": 41835
      }
    ],
    "inputs": []
  },
  {
    "id": "lifecycle",
    "startMs": 55158,
    "sentences": [
      {
        "text": "Un événement suit un cycle clair :",
        "startMs": 821,
        "endMs": 2753,
        "method": "silence",
        "absoluteStartMs": 55979
      },
      {
        "text": "brouillon pendant la préparation, publié quand la page est prête, puis archivé une fois terminé.",
        "startMs": 2876,
        "endMs": 8398,
        "method": "silence",
        "absoluteStartMs": 58034
      },
      {
        "text": "Même publié, il peut rester non répertorié et accessible seulement par son lien.",
        "startMs": 9221,
        "endMs": 13380,
        "method": "silence",
        "absoluteStartMs": 64379
      },
      {
        "text": "Les inscriptions peuvent être immédiates, fermées, ou programmées à une date précise.",
        "startMs": 13811,
        "endMs": 18777,
        "method": "silence",
        "absoluteStartMs": 68969
      }
    ],
    "inputs": []
  },
  {
    "id": "appearance",
    "startMs": 74771,
    "sentences": [
      {
        "text": "Dans ses paramètres, tu règles le titre, les dates, les messages et une couleur d’en-tête accessible.",
        "startMs": 237,
        "endMs": 7038,
        "method": "silence",
        "absoluteStartMs": 75008
      },
      {
        "text": "Le lieu peut recevoir des coordonnées :",
        "startMs": 7869,
        "endMs": 9393,
        "method": "silence",
        "absoluteStartMs": 82640
      },
      {
        "text": "les bénévoles obtiennent alors un lien OpenStreetMap dans la page, les emails et leur espace personnel.",
        "startMs": 9953,
        "endMs": 15175,
        "method": "silence",
        "absoluteStartMs": 84724
      }
    ],
    "inputs": []
  },
  {
    "id": "duplicate",
    "startMs": 91825,
    "sentences": [
      {
        "text": "Pour repartir d’une édition précédente, duplique l’événement et décale toutes les dates.",
        "startMs": 293,
        "endMs": 5233,
        "method": "silence",
        "absoluteStartMs": 92118
      },
      {
        "text": "Tu choisis ce qui est repris :",
        "startMs": 5695,
        "endMs": 6995,
        "method": "silence",
        "absoluteStartMs": 97520
      },
      {
        "text": "les créneaux, les réglages, les pages d’information et les responsables.",
        "startMs": 7202,
        "endMs": 11067,
        "method": "silence",
        "absoluteStartMs": 99027
      }
    ],
    "inputs": []
  },
  {
    "id": "shift-methods",
    "startMs": 106929,
    "sentences": [
      {
        "text": "Pour construire le planning, trois méthodes se complètent :",
        "startMs": 779,
        "endMs": 3239,
        "method": "silence",
        "absoluteStartMs": 107708
      },
      {
        "text": "ajouter un créneau depuis la liste, copier un créneau existant, ou dessiner directement sa plage sur la frise puis l’élargir.",
        "startMs": 3908,
        "endMs": 11381,
        "method": "silence",
        "absoluteStartMs": 110837
      },
      {
        "text": "Pour des horaires répétitifs, la création en série prépare plusieurs créneaux d’un coup.",
        "startMs": 11846,
        "endMs": 17186,
        "method": "silence",
        "absoluteStartMs": 118775
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 109143
      },
