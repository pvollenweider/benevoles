[
  {
    "chapter": "welcome",
    "startMs": 1158,
    "endMs": 11639,
    "sentences": [
      {
        "text": "Avant de publier, l’écran de vérification rassemble ce qui compte vraiment.",
        "startMs": 214,
        "endMs": 3899,
        "method": "silence",
        "absoluteStartMs": 1372
      },
      {
        "text": "Il évite d’ouvrir une page vide ou incohérente et rappelle que tout restera modifiable après la publication.",
        "startMs": 4438,
        "endMs": 10145,
        "method": "silence",
        "absoluteStartMs": 5596
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "checks",
    "startMs": 12092,
    "endMs": 31854,
    "sentences": [
      {
        "text": "Les lignes marquées comme faites couvrent le titre, les dates et le planning.",
        "startMs": 334,
        "endMs": 5034,
        "method": "silence",
        "absoluteStartMs": 12426
      },
      {
        "text": "Un point obligatoire manquant bloque le bouton Publier, notamment l’absence totale de créneau actif.",
        "startMs": 5385,
        "endMs": 10571,
        "method": "silence",
        "absoluteStartMs": 17477
      },
      {
        "text": "Les lignes facultatives, comme le lieu, les instructions ou un responsable de secteur, améliorent le parcours mais n’empêchent pas l’ouverture.",
        "startMs": 11067,
        "endMs": 19448,
        "method": "silence",
        "absoluteStartMs": 23159
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "preview-start",
    "startMs": 34015,
    "endMs": 50459,
    "sentences": [
      {
        "text": "Prévisualiser comme un bénévole ouvre la vraie page d’inscription dans un mode sans conséquence.",
        "startMs": 329,
        "endMs": 5825,
        "method": "silence",
        "absoluteStartMs": 34344
      },
      {
        "text": "On vérifie d’abord l’en-tête, le lieu, les instructions, le programme et les créneaux, exactement comme ils seront présentés sur téléphone ou ordinateur.",
        "startMs": 6560,
        "endMs": 16104,
        "method": "silence",
        "absoluteStartMs": 40575
      }
    ],
    "anchors": [
      {
        "segmentId": "preview-start",
