  {
    "chapter": "publish",
    "startMs": 98702,
    "endMs": 114143,
    "sentences": [
      {
        "text": "Revenons à la vérification et publions.",
        "startMs": 197,
        "endMs": 2187,
        "method": "silence",
        "absoluteStartMs": 98899
      },
      {
        "text": "La page devient accessible à toute personne qui possède le lien, mais aucun email n’est envoyé automatiquement aux membres.",
        "startMs": 2858,
        "endMs": 9280,
        "method": "silence",
        "absoluteStartMs": 101560
      },
      {
        "text": "Pour les prévenir, il faudra partager le QR code, envoyer des invitations ou utiliser un message ciblé.",
        "startMs": 9438,
        "endMs": 15221,
        "method": "silence",
        "absoluteStartMs": 108140
      }
    ],
