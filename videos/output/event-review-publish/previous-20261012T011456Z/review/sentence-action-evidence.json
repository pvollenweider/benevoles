[
  {
    "chapter": "welcome",
    "startMs": 1155,
    "endMs": 11636,
    "sentences": [
      {
        "text": "Avant de publier, l’écran de vérification rassemble ce qui compte vraiment.",
        "startMs": 214,
        "endMs": 3899,
        "method": "silence",
        "absoluteStartMs": 1369
      },
      {
        "text": "Il évite d’ouvrir une page vide ou incohérente et rappelle que tout restera modifiable après la publication.",
        "startMs": 4438,
        "endMs": 10145,
        "method": "silence",
        "absoluteStartMs": 5593
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "checks",
    "startMs": 12088,
    "endMs": 31852,
    "sentences": [
      {
        "text": "Les lignes marquées comme faites couvrent le titre, les dates et le planning.",
        "startMs": 334,
        "endMs": 5034,
        "method": "silence",
        "absoluteStartMs": 12422
      },
      {
        "text": "Un point obligatoire manquant bloque le bouton Publier, notamment l’absence totale de créneau actif.",
        "startMs": 5385,
        "endMs": 10571,
        "method": "silence",
        "absoluteStartMs": 17473
      },
      {
        "text": "Les lignes facultatives, comme le lieu, les instructions ou un responsable de secteur, améliorent le parcours mais n’empêchent pas l’ouverture.",
        "startMs": 11067,
        "endMs": 19448,
        "method": "silence",
        "absoluteStartMs": 23155
      }
    ],
    "anchors": [],
    "interactions": []
  },
