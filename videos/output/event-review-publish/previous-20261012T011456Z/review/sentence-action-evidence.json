  {
    "chapter": "preview-form",
    "startMs": 50913,
    "endMs": 83049,
    "sentences": [
      {
        "text": "Sélectionnons un créneau et poursuivons jusqu’au formulaire.",
        "startMs": 345,
        "endMs": 3928,
        "method": "silence",
        "absoluteStartMs": 51258
      },
      {
        "text": "Pour ce test, renseignons une identité fictive :",
        "startMs": 4415,
        "endMs": 5506,
        "method": "silence",
        "absoluteStartMs": 55328
      },
      {
        "text": "Alex Martin.",
        "startMs": 5770,
        "endMs": 7295,
        "method": "silence",
        "absoluteStartMs": 56683
      },
      {
        "text": "Ajoutons son adresse email de démonstration et son téléphone fictif.",
        "startMs": 7688,
        "endMs": 11360,
        "method": "silence",
        "absoluteStartMs": 58601
      },
      {
        "text": "Choisissons aussi une taille de t-shirt :",
        "startMs": 11642,
        "endMs": 13614,
        "method": "silence",
        "absoluteStartMs": 62555
      },
      {
        "text": "cette question est obligatoire pour notre événement.",
        "startMs": 13789,
        "endMs": 17600,
        "method": "silence",
        "absoluteStartMs": 64702
      },
      {
        "text": "Le formulaire permet de relire les informations demandées et la Convention des Bénévoles.",
        "startMs": 18125,
        "endMs": 22752,
        "method": "silence",
        "absoluteStartMs": 69038
      },
      {
        "text": "Acceptons cette convention, puis l’utilisation des données par l’association pour gérer ses bénévoles.",
        "startMs": 23436,
        "endMs": 28312,
        "method": "silence",
        "absoluteStartMs": 74349
      },
      {
        "text": "Nous testons le parcours sans créer d’inscription réelle.",
        "startMs": 28900,
        "endMs": 31726,
        "method": "silence",
        "absoluteStartMs": 79813
      }
    ],
