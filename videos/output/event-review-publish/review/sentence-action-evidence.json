  {
    "chapter": "preview-form",
    "startMs": 50914,
    "endMs": 83048,
    "sentences": [
      {
        "text": "Sélectionnons un créneau et poursuivons jusqu’au formulaire.",
        "startMs": 345,
        "endMs": 3928,
        "method": "silence",
        "absoluteStartMs": 51259
      },
      {
        "text": "Pour ce test, renseignons une identité fictive :",
        "startMs": 4415,
        "endMs": 5506,
        "method": "silence",
        "absoluteStartMs": 55329
      },
      {
        "text": "Alex Martin.",
        "startMs": 5770,
        "endMs": 7295,
        "method": "silence",
        "absoluteStartMs": 56684
      },
      {
        "text": "Ajoutons son adresse email de démonstration et son téléphone fictif.",
