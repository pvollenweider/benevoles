  {
    "id": "publish",
    "startMs": 115853,
    "sentences": [
      {
        "text": "La page de vérification rappelle ce qui est obligatoire et ce qui pourrait encore être amélioré.",
        "startMs": 162,
        "endMs": 4923,
        "method": "silence",
        "absoluteStartMs": 116015
      },
      {
        "text": "Un événement sans créneau ne peut pas être publié.",
        "startMs": 5828,
        "endMs": 7799,
        "method": "silence",
        "absoluteStartMs": 121681
      },
      {
        "text": "Ici, le minimum est prêt :",
        "startMs": 8748,
        "endMs": 9043,
        "method": "silence",
        "absoluteStartMs": 124601
      },
      {
        "text": "on publie.",
        "startMs": 9309,
        "endMs": 10029,
        "method": "silence",
        "absoluteStartMs": 125162
      },
      {
        "text": "La page d’inscription devient accessible, mais aucun email collectif ne part automatiquement.",
        "startMs": 10403,
        "endMs": 15674,
        "method": "silence",
        "absoluteStartMs": 126256
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 117937
