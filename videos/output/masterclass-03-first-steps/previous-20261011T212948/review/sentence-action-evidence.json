  {
    "id": "help",
    "startMs": 156109,
    "sentences": [
      {
        "text": "Besoin d’aide ?",
        "startMs": 458,
        "endMs": 998,
        "method": "silence",
        "absoluteStartMs": 156567
      },
      {
        "text": "Aide ouvre le guide organisateur dans un nouvel onglet.",
        "startMs": 1606,
        "endMs": 4038,
        "method": "silence",
        "absoluteStartMs": 157715
      },
      {
        "text": "Retrouvons Premiers pas.",
        "startMs": 4620,
        "endMs": 5612,
        "method": "silence",
        "absoluteStartMs": 160729
      },
      {
        "text": "Quand une vidéo est disponible, Voir la vidéo ouvre le lecteur directement dans la documentation et lance la lecture grâce à votre clic.",
        "startMs": 6311,
        "endMs": 12948,
        "method": "silence",
        "absoluteStartMs": 162420
      },
      {
        "text": "Les commandes du lecteur permettent ensuite de mettre en pause et d’activer les sous-titres.",
        "startMs": 13742,
        "endMs": 17099,
        "method": "silence",
        "absoluteStartMs": 169851
      },
      {
        "text": "La transcription reste consultable juste dessous.",
        "startMs": 17768,
        "endMs": 19802,
        "method": "silence",
        "absoluteStartMs": 173877
      },
      {
        "text": "Vous pouvez aussi ouvrir la bibliothèque, ou replier le lecteur pour continuer votre lecture.",
        "startMs": 20379,
        "endMs": 24266,
        "method": "silence",
        "absoluteStartMs": 176488
      }
    ],
