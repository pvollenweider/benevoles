  "chapters": [
    {
      "id": "welcome",
      "startMs": 1112,
      "endMs": 14581,
      "sentences": [
        {
          "text": "Quand une association découvre benevol point app, la liste Premiers pas lui donne un ordre simple.",
          "startMs": 282,
          "endMs": 5032,
          "method": "silence",
          "absoluteStartS": 1.394,
          "absoluteEndS": 6.144
        },
        {
          "text": "Elle ne fait rien à votre place :",
          "startMs": 5572,
          "endMs": 6867,
          "method": "silence",
          "absoluteStartS": 6.684,
          "absoluteEndS": 7.979
        },
        {
          "text": "elle indique ce qui est déjà prêt, la prochaine action utile, et le résultat à vérifier avant d’inviter de vrais bénévoles.",
          "startMs": 7248,
          "endMs": 13035,
          "method": "silence",
          "absoluteStartS": 8.36,
          "absoluteEndS": 14.147
        }
      ],
      "markers": []
    },
    {
      "id": "checklist",
      "startMs": 15034,
      "endMs": 32578,
      "sentences": [
        {
          "text": "Les quatre étapes obligatoires sont de créer l’événement, définir ses créneaux, le publier, puis faire une inscription de test.",
          "startMs": 446,
          "endMs": 7005,
          "method": "silence",
          "absoluteStartS": 15.48,
          "absoluteEndS": 22.039
        },
        {
          "text": "Le titre public, la charte et le fuseau horaire sont facultatifs, car des valeurs par défaut existent.",
          "startMs": 7825,
          "endMs": 12838,
          "method": "silence",
          "absoluteStartS": 22.859,
          "absoluteEndS": 27.872
        },
        {
          "text": "Les coches sont calculées à partir des données :",
          "startMs": 12961,
          "endMs": 15533,
          "method": "silence",
          "absoluteStartS": 27.995,
          "absoluteEndS": 30.567
        },
        {
          "text": "pas besoin de les remplir manuellement.",
          "startMs": 15839,
          "endMs": 17044,
          "method": "silence",
          "absoluteStartS": 30.873,
          "absoluteEndS": 32.078
        }
      ],
      "markers": []
    },
    {
      "id": "identity",
      "startMs": 34188,
      "endMs": 58371,
      "sentences": [
        {
          "text": "Commençons par ce que verront les bénévoles.",
          "startMs": 503,
          "endMs": 2308,
          "method": "silence",
          "absoluteStartS": 34.691,
          "absoluteEndS": 36.496
        },
        {
          "text": "Dans les paramètres, donnez à la page publique un titre accueillant, puis lisez la Convention des Bénévoles complète.",
          "startMs": 3017,
          "endMs": 9150,
          "method": "silence",
          "absoluteStartS": 37.205,
          "absoluteEndS": 43.338
        },
        {
          "text": "Ce texte explique le cadre de l’engagement et devra être accepté dans le formulaire.",
          "startMs": 9835,
          "endMs": 13519,
          "method": "silence",
          "absoluteStartS": 44.023,
          "absoluteEndS": 47.707
        },
        {
          "text": "Gardons toutes ses clauses :",
          "startMs": 14268,
          "endMs": 14349,
          "method": "silence",
          "absoluteStartS": 48.456,
          "absoluteEndS": 48.537
        },
        {
          "text": "dans cette démonstration, nous ne remplaçons pas la convention par une phrase raccourcie.",
          "startMs": 14486,
          "endMs": 19408,
          "method": "silence",
          "absoluteStartS": 48.674,
          "absoluteEndS": 53.596
        },
        {
          "text": "Enregistrons le texte entier, que vous pouvez relire avant de le personnaliser.",
          "startMs": 20256,
          "endMs": 23742,
          "method": "silence",
          "absoluteStartS": 54.444,
          "absoluteEndS": 57.93
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 34696
        },
        {
          "kind": "click",
          "atMs": 36330
        },
        {
          "kind": "click",
          "atMs": 48978
        },
        {
          "kind": "key",
          "atMs": 49287
        },
        {
          "kind": "key",
          "atMs": 49288
        },
        {
          "kind": "click",
          "atMs": 52062
        }
      ]
    },
    {
      "id": "timezone",
      "startMs": 58824,
      "endMs": 75503,
      "sentences": [
        {
          "text": "Vérifiez ensuite le fuseau horaire.",
          "startMs": 441,
          "endMs": 2450,
          "method": "silence",
          "absoluteStartS": 59.265,
          "absoluteEndS": 61.274
        },
        {
          "text": "Il sert à calculer les rappels, l’expiration des offres de liste d’attente, le journal et les documents.",
          "startMs": 2582,
          "endMs": 8371,
          "method": "silence",
          "absoluteStartS": 61.406,
          "absoluteEndS": 67.195
        },
        {
          "text": "Ici, l’association travaille en Europe Zurich.",
          "startMs": 9019,
          "endMs": 11298,
          "method": "silence",
          "absoluteStartS": 67.843,
          "absoluteEndS": 70.122
        },
        {
          "text": "Changer ce réglage adapte les instants d’envoi sans déplacer les heures affichées sur les créneaux.",
          "startMs": 11909,
          "endMs": 16167,
          "method": "silence",
          "absoluteStartS": 70.733,
          "absoluteEndS": 74.991
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 71210
        }
      ]
    },
    {
      "id": "event",
      "startMs": 77089,
      "endMs": 96919,
      "sentences": [
        {
          "text": "De retour aux Premiers pas, les réglages facultatifs sont maintenant cochés.",
          "startMs": 530,
          "endMs": 5120,
          "method": "silence",
          "absoluteStartS": 77.619,
          "absoluteEndS": 82.209
        },
        {
          "text": "Créons la Fête du parc depuis une page blanche.",
          "startMs": 5259,
          "endMs": 7225,
          "method": "silence",
          "absoluteStartS": 82.348,
          "absoluteEndS": 84.314
        },
        {
          "text": "Saisissez un titre clair, le lieu, puis les dates de début et de fin.",
          "startMs": 7831,
          "endMs": 10796,
          "method": "silence",
          "absoluteStartS": 84.92,
          "absoluteEndS": 87.885
        },
        {
          "text": "À la validation, l’événement naît en brouillon :",
          "startMs": 10934,
          "endMs": 14225,
          "method": "silence",
          "absoluteStartS": 88.023,
          "absoluteEndS": 91.314
        },
        {
          "text": "les informations sont enregistrées, mais personne ne peut encore voir la page publiquement.",
          "startMs": 14380,
          "endMs": 19354,
          "method": "silence",
          "absoluteStartS": 91.469,
          "absoluteEndS": 96.443
        }
      ],
