      "startMs": 115847,
      "endMs": 131910,
      "sentences": [
        {
          "text": "La page de vérification rappelle ce qui est obligatoire et ce qui pourrait encore être amélioré.",
          "startMs": 162,
          "endMs": 4923,
          "method": "silence",
          "absoluteStartS": 116.009,
          "absoluteEndS": 120.77
        },
        {
          "text": "Un événement sans créneau ne peut pas être publié.",
          "startMs": 5828,
          "endMs": 7799,
          "method": "silence",
          "absoluteStartS": 121.675,
          "absoluteEndS": 123.646
        },
        {
          "text": "Ici, le minimum est prêt :",
          "startMs": 8748,
          "endMs": 9043,
          "method": "silence",
          "absoluteStartS": 124.595,
          "absoluteEndS": 124.89
        },
        {
          "text": "on publie.",
          "startMs": 9309,
          "endMs": 10029,
          "method": "silence",
          "absoluteStartS": 125.156,
          "absoluteEndS": 125.876
        },
        {
          "text": "La page d’inscription devient accessible, mais aucun email collectif ne part automatiquement.",
          "startMs": 10403,
          "endMs": 15674,
          "method": "silence",
