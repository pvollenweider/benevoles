    {
      "id": "help",
      "startMs": 156030,
      "endMs": 180639,
      "sentences": [
        {
          "text": "Besoin d’aide ?",
          "startMs": 458,
          "endMs": 998,
          "method": "silence",
          "absoluteStartS": 156.488,
          "absoluteEndS": 157.028
        },
        {
          "text": "Aide ouvre le guide organisateur dans un nouvel onglet.",
          "startMs": 1606,
          "endMs": 4038,
          "method": "silence",
          "absoluteStartS": 157.636,
          "absoluteEndS": 160.068
        },
        {
          "text": "Retrouvons Premiers pas.",
          "startMs": 4620,
          "endMs": 5612,
          "method": "silence",
          "absoluteStartS": 160.65,
          "absoluteEndS": 161.642
        },
        {
          "text": "Quand une vidéo est disponible, Voir la vidéo ouvre le lecteur directement dans la documentation et lance la lecture grâce à votre clic.",
          "startMs": 6311,
          "endMs": 12948,
          "method": "silence",
          "absoluteStartS": 162.341,
          "absoluteEndS": 168.978
        },
        {
          "text": "Les commandes du lecteur permettent ensuite de mettre en pause et d’activer les sous-titres.",
          "startMs": 13742,
          "endMs": 17099,
          "method": "silence",
          "absoluteStartS": 169.772,
          "absoluteEndS": 173.129
        },
        {
          "text": "La transcription reste consultable juste dessous.",
          "startMs": 17768,
          "endMs": 19802,
          "method": "silence",
          "absoluteStartS": 173.798,
          "absoluteEndS": 175.832
        },
        {
          "text": "Vous pouvez aussi ouvrir la bibliothèque, ou replier le lecteur pour continuer votre lecture.",
          "startMs": 20379,
          "endMs": 24266,
          "method": "silence",
          "absoluteStartS": 176.409,
          "absoluteEndS": 180.296
        }
      ],
