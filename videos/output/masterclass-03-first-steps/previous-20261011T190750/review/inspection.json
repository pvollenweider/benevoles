      "endMs": 200523,
      "sentences": [
        {
          "text": "En revenant dans l’administration, les étapes obligatoires sont terminées et la checklist disparaît.",
          "startMs": 346,
          "endMs": 4694,
          "method": "silence",
          "absoluteStartS": 182.607,
          "absoluteEndS": 186.955
        },
        {
          "text": "L’association possède maintenant une identité publique, le bon fuseau, un événement publié et un parcours testé de bout en bout.",
          "startMs": 5275,
          "endMs": 11538,
          "method": "silence",
          "absoluteStartS": 187.536,
          "absoluteEndS": 193.799
        },
        {
          "text": "Si vous préférez retirer la liste plus tôt, un propriétaire peut la masquer pour toute l’équipe, sans pour autant réaliser les étapes manquantes.",
          "startMs": 12056,
