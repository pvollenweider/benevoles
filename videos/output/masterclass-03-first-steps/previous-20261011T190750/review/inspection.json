    {
      "id": "test",
      "startMs": 133549,
      "endMs": 154380,
      "sentences": [
        {
          "text": "Dernière étape :",
          "startMs": 394,
          "endMs": 1089,
          "method": "silence",
          "absoluteStartS": 133.943,
          "absoluteEndS": 134.638
        },
        {
          "text": "vivre le parcours comme un bénévole.",
          "startMs": 1330,
          "endMs": 2940,
          "method": "silence",
          "absoluteStartS": 134.879,
          "absoluteEndS": 136.489
        },
        {
          "text": "Sélectionnez Accueil, complétez les coordonnées fictives, acceptez la convention et confirmez.",
          "startMs": 3370,
          "endMs": 8562,
          "method": "silence",
          "absoluteStartS": 136.919,
          "absoluteEndS": 142.111
        },
        {
          "text": "Cette vraie inscription vérifie en même temps le formulaire, le message de succès et l’email contenant le lien personnel.",
