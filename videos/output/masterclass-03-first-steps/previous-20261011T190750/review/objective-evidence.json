    {
      "scene": "help",
      "startMs": 156030,
      "endMs": 180639,
      "sentences": [
        {
          "text": "Besoin d’aide ?",
          "startMs": 458,
          "endMs": 998,
          "method": "silence",
          "globalStartMs": 156488,
          "globalEndMs": 157028
        },
        {
          "text": "Aide ouvre le guide organisateur dans un nouvel onglet.",
          "startMs": 1606,
          "endMs": 4038,
          "method": "silence",
          "globalStartMs": 157636,
          "globalEndMs": 160068
        },
        {
          "text": "Retrouvons Premiers pas.",
          "startMs": 4620,
          "endMs": 5612,
          "method": "silence",
          "globalStartMs": 160650,
          "globalEndMs": 161642
        },
        {
          "text": "Quand une vidéo est disponible, Voir la vidéo ouvre le lecteur directement dans la documentation et lance la lecture grâce à votre clic.",
          "startMs": 6311,
          "endMs": 12948,
          "method": "silence",
          "globalStartMs": 162341,
          "globalEndMs": 168978
        },
        {
          "text": "Les commandes du lecteur permettent ensuite de mettre en pause et d’activer les sous-titres.",
          "startMs": 13742,
          "endMs": 17099,
          "method": "silence",
          "globalStartMs": 169772,
          "globalEndMs": 173129
        },
        {
          "text": "La transcription reste consultable juste dessous.",
          "startMs": 17768,
          "endMs": 19802,
          "method": "silence",
          "globalStartMs": 173798,
          "globalEndMs": 175832
        },
        {
          "text": "Vous pouvez aussi ouvrir la bibliothèque, ou replier le lecteur pour continuer votre lecture.",
          "startMs": 20379,
          "endMs": 24266,
          "method": "silence",
          "globalStartMs": 176409,
          "globalEndMs": 180296
        }
      ],
      "anchors": [],
