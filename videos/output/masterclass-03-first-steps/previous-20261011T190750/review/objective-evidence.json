    {
      "scene": "test",
      "startMs": 133549,
      "endMs": 154380,
      "sentences": [
        {
          "text": "Dernière étape :",
          "startMs": 394,
          "endMs": 1089,
          "method": "silence",
          "globalStartMs": 133943,
          "globalEndMs": 134638
        },
        {
          "text": "vivre le parcours comme un bénévole.",
          "startMs": 1330,
          "endMs": 2940,
          "method": "silence",
          "globalStartMs": 134879,
          "globalEndMs": 136489
        },
        {
          "text": "Sélectionnez Accueil, complétez les coordonnées fictives, acceptez la convention et confirmez.",
          "startMs": 3370,
          "endMs": 8562,
          "method": "silence",
          "globalStartMs": 136919,
          "globalEndMs": 142111
        },
        {
          "text": "Cette vraie inscription vérifie en même temps le formulaire, le message de succès et l’email contenant le lien personnel.",
          "startMs": 8932,
          "endMs": 15711,
          "method": "silence",
          "globalStartMs": 142481,
          "globalEndMs": 149260
        },
        {
          "text": "Dans un événement réel, vous annuleriez ensuite cette inscription de test pour libérer la place.",
          "startMs": 16491,
          "endMs": 20374,
          "method": "silence",
          "globalStartMs": 150040,
          "globalEndMs": 153923
        }
      ],
