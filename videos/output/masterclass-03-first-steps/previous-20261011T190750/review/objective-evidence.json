  "sentences": [
    {
      "scene": "welcome",
      "startMs": 1112,
      "endMs": 14581,
      "sentences": [
        {
          "text": "Quand une association découvre benevol point app, la liste Premiers pas lui donne un ordre simple.",
          "startMs": 282,
          "endMs": 5032,
          "method": "silence",
          "globalStartMs": 1394,
          "globalEndMs": 6144
        },
        {
          "text": "Elle ne fait rien à votre place :",
          "startMs": 5572,
          "endMs": 6867,
          "method": "silence",
          "globalStartMs": 6684,
          "globalEndMs": 7979
        },
        {
          "text": "elle indique ce qui est déjà prêt, la prochaine action utile, et le résultat à vérifier avant d’inviter de vrais bénévoles.",
          "startMs": 7248,
          "endMs": 13035,
          "method": "silence",
          "globalStartMs": 8360,
          "globalEndMs": 14147
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "checklist",
      "startMs": 15034,
      "endMs": 32578,
      "sentences": [
        {
          "text": "Les quatre étapes obligatoires sont de créer l’événement, définir ses créneaux, le publier, puis faire une inscription de test.",
          "startMs": 446,
          "endMs": 7005,
          "method": "silence",
          "globalStartMs": 15480,
          "globalEndMs": 22039
        },
        {
          "text": "Le titre public, la charte et le fuseau horaire sont facultatifs, car des valeurs par défaut existent.",
          "startMs": 7825,
          "endMs": 12838,
          "method": "silence",
          "globalStartMs": 22859,
          "globalEndMs": 27872
        },
        {
          "text": "Les coches sont calculées à partir des données :",
          "startMs": 12961,
          "endMs": 15533,
          "method": "silence",
          "globalStartMs": 27995,
          "globalEndMs": 30567
        },
        {
          "text": "pas besoin de les remplir manuellement.",
          "startMs": 15839,
          "endMs": 17044,
          "method": "silence",
          "globalStartMs": 30873,
          "globalEndMs": 32078
        }
      ],
      "anchors": [
        {
          "segmentId": "checklist",
          "phrase": "Les coches sont calculées à",
          "startMs": 12961,
          "endMs": 15533,
          "cueMs": 27997
        }
      ],
      "inputs": []
    },
    {
      "scene": "identity",
      "startMs": 34188,
      "endMs": 58371,
      "sentences": [
        {
          "text": "Commençons par ce que verront les bénévoles.",
          "startMs": 503,
          "endMs": 2308,
          "method": "silence",
          "globalStartMs": 34691,
          "globalEndMs": 36496
        },
        {
          "text": "Dans les paramètres, donnez à la page publique un titre accueillant, puis lisez la Convention des Bénévoles complète.",
          "startMs": 3017,
          "endMs": 9150,
          "method": "silence",
          "globalStartMs": 37205,
          "globalEndMs": 43338
        },
        {
          "text": "Ce texte explique le cadre de l’engagement et devra être accepté dans le formulaire.",
          "startMs": 9835,
          "endMs": 13519,
          "method": "silence",
          "globalStartMs": 44023,
          "globalEndMs": 47707
        },
        {
          "text": "Gardons toutes ses clauses :",
          "startMs": 14268,
          "endMs": 14349,
          "method": "silence",
          "globalStartMs": 48456,
          "globalEndMs": 48537
        },
        {
          "text": "dans cette démonstration, nous ne remplaçons pas la convention par une phrase raccourcie.",
          "startMs": 14486,
          "endMs": 19408,
          "method": "silence",
          "globalStartMs": 48674,
          "globalEndMs": 53596
        },
        {
          "text": "Enregistrons le texte entier, que vous pouvez relire avant de le personnaliser.",
          "startMs": 20256,
          "endMs": 23742,
          "method": "silence",
          "globalStartMs": 54444,
          "globalEndMs": 57930
        }
      ],
      "anchors": [
        {
          "segmentId": "identity",
          "phrase": "Gardons toutes ses clauses ",
          "startMs": 14268,
          "endMs": 14349,
          "cueMs": 48458
        }
      ],
