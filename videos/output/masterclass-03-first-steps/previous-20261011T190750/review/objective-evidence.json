    {
      "scene": "timezone",
      "startMs": 58824,
      "endMs": 75503,
      "sentences": [
        {
          "text": "Vérifiez ensuite le fuseau horaire.",
          "startMs": 441,
          "endMs": 2450,
          "method": "silence",
          "globalStartMs": 59265,
          "globalEndMs": 61274
        },
        {
          "text": "Il sert à calculer les rappels, l’expiration des offres de liste d’attente, le journal et les documents.",
          "startMs": 2582,
          "endMs": 8371,
          "method": "silence",
          "globalStartMs": 61406,
          "globalEndMs": 67195
        },
        {
          "text": "Ici, l’association travaille en Europe Zurich.",
          "startMs": 9019,
          "endMs": 11298,
          "method": "silence",
          "globalStartMs": 67843,
          "globalEndMs": 70122
        },
        {
          "text": "Changer ce réglage adapte les instants d’envoi sans déplacer les heures affichées sur les créneaux.",
          "startMs": 11909,
          "endMs": 16167,
          "method": "silence",
          "globalStartMs": 70733,
          "globalEndMs": 74991
        }
      ],
      "anchors": [
        {
          "segmentId": "timezone",
          "phrase": "Changer ce réglage adapte les",
          "startMs": 11909,
          "endMs": 16167,
          "cueMs": 70735
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 71210
        }
      ]
    },
    {
      "scene": "event",
      "startMs": 77089,
      "endMs": 96919,
      "sentences": [
        {
          "text": "De retour aux Premiers pas, les réglages facultatifs sont maintenant cochés.",
          "startMs": 530,
          "endMs": 5120,
          "method": "silence",
          "globalStartMs": 77619,
          "globalEndMs": 82209
        },
        {
          "text": "Créons la Fête du parc depuis une page blanche.",
          "startMs": 5259,
          "endMs": 7225,
          "method": "silence",
          "globalStartMs": 82348,
          "globalEndMs": 84314
        },
        {
          "text": "Saisissez un titre clair, le lieu, puis les dates de début et de fin.",
          "startMs": 7831,
          "endMs": 10796,
          "method": "silence",
          "globalStartMs": 84920,
          "globalEndMs": 87885
        },
        {
          "text": "À la validation, l’événement naît en brouillon :",
          "startMs": 10934,
          "endMs": 14225,
          "method": "silence",
          "globalStartMs": 88023,
          "globalEndMs": 91314
        },
        {
          "text": "les informations sont enregistrées, mais personne ne peut encore voir la page publiquement.",
          "startMs": 14380,
          "endMs": 19354,
          "method": "silence",
          "globalStartMs": 91469,
          "globalEndMs": 96443
        }
      ],
      "anchors": [
