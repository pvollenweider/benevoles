    {
      "scene": "publish",
      "startMs": 115847,
      "endMs": 131910,
      "sentences": [
        {
          "text": "La page de vérification rappelle ce qui est obligatoire et ce qui pourrait encore être amélioré.",
          "startMs": 162,
          "endMs": 4923,
          "method": "silence",
          "globalStartMs": 116009,
          "globalEndMs": 120770
        },
        {
          "text": "Un événement sans créneau ne peut pas être publié.",
          "startMs": 5828,
          "endMs": 7799,
          "method": "silence",
          "globalStartMs": 121675,
          "globalEndMs": 123646
        },
        {
          "text": "Ici, le minimum est prêt :",
          "startMs": 8748,
          "endMs": 9043,
          "method": "silence",
          "globalStartMs": 124595,
          "globalEndMs": 124890
        },
        {
          "text": "on publie.",
          "startMs": 9309,
          "endMs": 10029,
          "method": "silence",
          "globalStartMs": 125156,
          "globalEndMs": 125876
        },
        {
          "text": "La page d’inscription devient accessible, mais aucun email collectif ne part automatiquement.",
          "startMs": 10403,
          "endMs": 15674,
          "method": "silence",
          "globalStartMs": 126250,
          "globalEndMs": 131521
        }
      ],
      "anchors": [
        {
