    {
      "scene": "shift",
      "startMs": 97371,
      "endMs": 115393,
      "sentences": [
        {
          "text": "La prochaine étape consiste à rendre le planning concret.",
          "startMs": 475,
          "endMs": 2910,
          "method": "silence",
          "globalStartMs": 97846,
          "globalEndMs": 100281
        },
        {
          "text": "Ajoutez un créneau, choisissez le poste Accueil, puis indiquez neuf heures, midi et trois places.",
          "startMs": 3298,
          "endMs": 8595,
          "method": "silence",
          "globalStartMs": 100669,
          "globalEndMs": 105966
        },
        {
          "text": "Après validation, le créneau apparaît réellement dans le planning, regroupé sous son poste.",
          "startMs": 8804,
          "endMs": 13899,
          "method": "silence",
          "globalStartMs": 106175,
          "globalEndMs": 111270
        },
        {
          "text": "Vous pouvez encore le modifier ou l’annuler avant toute publication.",
          "startMs": 14513,
          "endMs": 17839,
          "method": "silence",
          "globalStartMs": 111884,
