  "chapters": [
    {
      "id": "welcome",
      "startMs": 1095,
      "endMs": 14563,
      "sentences": [
        {
          "text": "Quand une association découvre benevol point app, la liste Premiers pas lui donne un ordre simple.",
          "startMs": 282,
          "endMs": 5032,
          "method": "silence",
          "absoluteStartS": 1.377,
          "absoluteEndS": 6.127
        },
        {
          "text": "Elle ne fait rien à votre place :",
          "startMs": 5572,
          "endMs": 6867,
          "method": "silence",
          "absoluteStartS": 6.667,
          "absoluteEndS": 7.962
        },
        {
          "text": "elle indique ce qui est déjà prêt, la prochaine action utile, et le résultat à vérifier avant d’inviter de vrais bénévoles.",
          "startMs": 7248,
          "endMs": 13035,
          "method": "silence",
          "absoluteStartS": 8.343,
          "absoluteEndS": 14.13
        }
      ],
      "markers": []
    },
    {
      "id": "checklist",
      "startMs": 15016,
      "endMs": 32560,
      "sentences": [
        {
          "text": "Les quatre étapes obligatoires sont de créer l’événement, définir ses créneaux, le publier, puis faire une inscription de test.",
          "startMs": 446,
          "endMs": 7005,
          "method": "silence",
          "absoluteStartS": 15.462,
          "absoluteEndS": 22.021
        },
        {
          "text": "Le titre public, la charte et le fuseau horaire sont facultatifs, car des valeurs par défaut existent.",
          "startMs": 7825,
          "endMs": 12838,
          "method": "silence",
          "absoluteStartS": 22.841,
          "absoluteEndS": 27.854
        },
        {
          "text": "Les coches sont calculées à partir des données :",
          "startMs": 12961,
          "endMs": 15533,
          "method": "silence",
          "absoluteStartS": 27.977,
          "absoluteEndS": 30.549
        },
        {
          "text": "pas besoin de les remplir manuellement.",
          "startMs": 15839,
          "endMs": 17044,
          "method": "silence",
          "absoluteStartS": 30.855,
          "absoluteEndS": 32.06
        }
      ],
      "markers": []
    },
    {
      "id": "identity",
      "startMs": 34206,
      "endMs": 58390,
      "sentences": [
        {
          "text": "Commençons par ce que verront les bénévoles.",
          "startMs": 503,
          "endMs": 2308,
          "method": "silence",
          "absoluteStartS": 34.709,
          "absoluteEndS": 36.514
        },
        {
          "text": "Dans les paramètres, donnez à la page publique un titre accueillant, puis lisez la Convention des Bénévoles complète.",
          "startMs": 3017,
          "endMs": 9150,
          "method": "silence",
          "absoluteStartS": 37.223,
          "absoluteEndS": 43.356
        },
        {
          "text": "Ce texte explique le cadre de l’engagement et devra être accepté dans le formulaire.",
          "startMs": 9835,
          "endMs": 13519,
          "method": "silence",
          "absoluteStartS": 44.041,
          "absoluteEndS": 47.725
        },
        {
          "text": "Gardons toutes ses clauses :",
          "startMs": 14268,
          "endMs": 14349,
          "method": "silence",
          "absoluteStartS": 48.474,
          "absoluteEndS": 48.555
        },
        {
          "text": "dans cette démonstration, nous ne remplaçons pas la convention par une phrase raccourcie.",
          "startMs": 14486,
          "endMs": 19408,
          "method": "silence",
          "absoluteStartS": 48.692,
          "absoluteEndS": 53.614
        },
        {
          "text": "Enregistrons le texte entier, que vous pouvez relire avant de le personnaliser.",
          "startMs": 20256,
          "endMs": 23742,
          "method": "silence",
          "absoluteStartS": 54.462,
          "absoluteEndS": 57.948
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 37742
        },
        {
          "kind": "click",
          "atMs": 39375
        },
        {
          "kind": "click",
          "atMs": 48941
        },
        {
          "kind": "key",
          "atMs": 49250
        },
        {
          "kind": "key",
          "atMs": 49251
        },
        {
          "kind": "click",
          "atMs": 54923
        }
      ]
    },
    {
      "id": "timezone",
      "startMs": 58843,
      "endMs": 75523,
      "sentences": [
        {
          "text": "Vérifiez ensuite le fuseau horaire.",
          "startMs": 441,
          "endMs": 2450,
          "method": "silence",
          "absoluteStartS": 59.284,
          "absoluteEndS": 61.293
        },
        {
          "text": "Il sert à calculer les rappels, l’expiration des offres de liste d’attente, le journal et les documents.",
          "startMs": 2582,
          "endMs": 8371,
          "method": "silence",
          "absoluteStartS": 61.425,
          "absoluteEndS": 67.214
        },
        {
          "text": "Ici, l’association travaille en Europe Zurich.",
          "startMs": 9019,
          "endMs": 11298,
          "method": "silence",
          "absoluteStartS": 67.862,
          "absoluteEndS": 70.141
        },
        {
          "text": "Changer ce réglage adapte les instants d’envoi sans déplacer les heures affichées sur les créneaux.",
          "startMs": 11909,
          "endMs": 16167,
          "method": "silence",
          "absoluteStartS": 70.752,
          "absoluteEndS": 75.01
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 71223
        }
      ]
    },
    {
      "id": "event",
      "startMs": 77139,
      "endMs": 96970,
      "sentences": [
        {
          "text": "De retour aux Premiers pas, les réglages facultatifs sont maintenant cochés.",
          "startMs": 530,
          "endMs": 5120,
          "method": "silence",
          "absoluteStartS": 77.669,
          "absoluteEndS": 82.259
        },
        {
          "text": "Créons la Fête du parc depuis une page blanche.",
          "startMs": 5259,
          "endMs": 7225,
          "method": "silence",
          "absoluteStartS": 82.398,
          "absoluteEndS": 84.364
        },
        {
          "text": "Saisissez un titre clair, le lieu, puis les dates de début et de fin.",
          "startMs": 7831,
          "endMs": 10796,
          "method": "silence",
          "absoluteStartS": 84.97,
          "absoluteEndS": 87.935
        },
        {
          "text": "À la validation, l’événement naît en brouillon :",
          "startMs": 10934,
          "endMs": 14225,
          "method": "silence",
          "absoluteStartS": 88.073,
          "absoluteEndS": 91.364
        },
        {
          "text": "les informations sont enregistrées, mais personne ne peut encore voir la page publiquement.",
          "startMs": 14380,
          "endMs": 19354,
          "method": "silence",
          "absoluteStartS": 91.519,
          "absoluteEndS": 96.493
        }
      ],
