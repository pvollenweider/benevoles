          "endMs": 12948,
          "method": "silence",
          "absoluteStartS": 162.426,
          "absoluteEndS": 169.063
        },
        {
          "text": "Les commandes du lecteur permettent ensuite de mettre en pause et d’activer les sous-titres.",
          "startMs": 13742,
          "endMs": 17099,
          "method": "silence",
          "absoluteStartS": 169.857,
          "absoluteEndS": 173.214
        },
        {
          "text": "La transcription reste consultable juste dessous.",
          "startMs": 17768,
          "endMs": 19802,
          "method": "silence",
          "absoluteStartS": 173.883,
          "absoluteEndS": 175.917
        },
        {
