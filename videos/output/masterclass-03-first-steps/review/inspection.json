      "startMs": 156115,
      "endMs": 180723,
      "sentences": [
        {
          "text": "Besoin d’aide ?",
          "startMs": 458,
          "endMs": 998,
          "method": "silence",
          "absoluteStartS": 156.573,
          "absoluteEndS": 157.113
        },
        {
          "text": "Aide ouvre le guide organisateur dans un nouvel onglet.",
          "startMs": 1606,
          "endMs": 4038,
          "method": "silence",
          "absoluteStartS": 157.721,
          "absoluteEndS": 160.153
        },
        {
          "text": "Retrouvons Premiers pas.",
          "startMs": 4620,
          "endMs": 5612,
          "method": "silence",
          "absoluteStartS": 160.735,
          "absoluteEndS": 161.727
        },
        {
          "text": "Quand une vidéo est disponible, Voir la vidéo ouvre le lecteur directement dans la documentation et lance la lecture grâce à votre clic.",
