    {
      "chapter": "certificate-presence",
      "startSeconds": 176.357,
      "endSeconds": 204.822,
      "sentences": [
        {
          "text": "Par défaut, l'attestation met en avant les heures attestées.",
          "startMs": 312,
          "endMs": 3603,
          "method": "silence",
          "videoSeconds": 176.669
        },
        {
          "text": "Regardons cette colonne, puis cochons Inclure les heures planifiées sans présence saisie.",
          "startMs": 3774,
          "endMs": 8326,
          "method": "silence",
          "videoSeconds": 180.131
        },
        {
          "text": "Attention à la lecture :",
          "startMs": 8753,
          "endMs": 10244,
          "method": "silence",
          "videoSeconds": 185.11
        },
        {
          "text": "cette nouvelle colonne est le complément, pas le total des heures planifiées de la liste des membres.",
          "startMs": 10495,
          "endMs": 15886,
          "method": "silence",
          "videoSeconds": 186.852
        },
        {
          "text": "Pour Aline, nous retrouvons six heures attestées et deux heures planifiées sans présence.",
          "startMs": 16076,
          "endMs": 20595,
          "method": "silence",
          "videoSeconds": 192.433
        },
        {
          "text": "Ce document ne prétend pas mesurer un temps de travail chronométré.",
          "startMs": 20963,
          "endMs": 24606,
          "method": "silence",
          "videoSeconds": 197.32
        },
        {
          "text": "Une présence non saisie n'est pas non plus une preuve d'absence.",
          "startMs": 24816,
          "endMs": 28129,
          "method": "silence",
          "videoSeconds": 201.173
        }
      ],
      "anchors": [
        {
