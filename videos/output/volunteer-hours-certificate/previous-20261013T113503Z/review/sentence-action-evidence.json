    {
      "chapter": "certificate-settings",
      "startSeconds": 133.746,
      "endSeconds": 174.091,
      "sentences": [
        {
          "text": "Préparons maintenant une attestation pour Aline.",
          "startMs": 314,
          "endMs": 3416,
          "method": "silence",
          "videoSeconds": 134.06
        },
        {
          "text": "Depuis son activité, ouvrons Attestation de bénévolat.",
          "startMs": 3620,
          "endMs": 6845,
          "method": "silence",
          "videoSeconds": 137.366
        },
        {
          "text": "Choisissons une période du premier mai au trente septembre.",
          "startMs": 7483,
          "endMs": 11046,
          "method": "silence",
          "videoSeconds": 141.229
        },
        {
          "text": "Vous pouvez ajouter une remarque facultative :",
          "startMs": 11461,
          "endMs": 13899,
          "method": "silence",
          "videoSeconds": 145.207
        },
        {
          "text": "écrivons Accueil du public et rangement du matériel.",
          "startMs": 14165,
          "endMs": 17818,
          "method": "silence",
          "videoSeconds": 147.911
        },
        {
          "text": "L'aperçu reprend le nom du bénévole, celui de l'organisation, les dates et le détail par événement.",
          "startMs": 18383,
          "endMs": 23428,
          "method": "silence",
          "videoSeconds": 152.129
        },
        {
          "text": "Le logo enregistré dans les réglages de l'organisation apparaît aussi.",
          "startMs": 23782,
          "endMs": 29127,
          "method": "silence",
          "videoSeconds": 157.528
        },
        {
          "text": "Il est imprimé en gris pour garder un document adapté au noir et blanc.",
          "startMs": 29309,
          "endMs": 32867,
          "method": "silence",
          "videoSeconds": 163.055
        },
        {
          "text": "Prenez le temps de vérifier que cette période et ce commentaire correspondent bien au document que vous voulez remettre.",
          "startMs": 33318,
          "endMs": 40344,
          "method": "silence",
          "videoSeconds": 167.064
        }
      ],
      "anchors": [
        {
          "segmentId": "certificate-settings",
