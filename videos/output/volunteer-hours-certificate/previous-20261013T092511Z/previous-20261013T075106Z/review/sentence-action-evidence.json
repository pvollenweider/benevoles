    {
      "chapter": "certificate-pdf",
      "startSeconds": 207.078,
      "endSeconds": 241.177,
      "sentences": [
        {
          "text": "Quand le contenu vous convient, cliquons sur Générer et imprimer l'attestation.",
          "startMs": 336,
          "endMs": 5204,
          "method": "silence",
          "videoSeconds": 207.414
        },
        {
          "text": "L'application lance l'impression du navigateur :",
          "startMs": 5774,
          "endMs": 8471,
          "method": "silence",
          "videoSeconds": 212.852
        },
        {
          "text": "vous pouvez l'enregistrer en PDF.",
          "startMs": 8816,
          "endMs": 11060,
          "method": "silence",
          "videoSeconds": 215.894
        },
        {
          "text": "Pour cette démonstration, nous ouvrons le vrai PDF produit par le moteur d'impression local du navigateur, pas un téléchargement proposé par le serveur.",
          "startMs": 11216,
          "endMs": 21172,
          "method": "silence",
          "videoSeconds": 218.294
        },
        {
          "text": "Relisons le nom, la période, les deux colonnes et la remarque.",
          "startMs": 21596,
          "endMs": 24851,
          "method": "silence",
          "videoSeconds": 228.674
        },
        {
          "text": "Les zones Signature et Nom du signataire restent à compléter.",
          "startMs": 24998,
          "endMs": 29093,
          "method": "silence",
          "videoSeconds": 232.076
        },
        {
          "text": "Vérifiez le document avant de le signer et de le remettre à la personne.",
          "startMs": 29537,
          "endMs": 34095,
          "method": "silence",
          "videoSeconds": 236.615
        }
