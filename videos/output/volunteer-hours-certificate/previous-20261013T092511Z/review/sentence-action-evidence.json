    {
      "chapter": "event-summary",
      "startSeconds": 243.466,
      "endSeconds": 277.16,
      "sentences": [
        {
          "text": "Enfin, ouvrons les rapports de la Fête de septembre.",
          "startMs": 147,
          "endMs": 2661,
          "method": "silence",
          "videoSeconds": 243.613
        },
        {
          "text": "Le résumé distingue les personnes et les inscriptions.",
          "startMs": 3159,
          "endMs": 6145,
          "method": "silence",
          "videoSeconds": 246.625
        },
        {
          "text": "Ici, deux bénévoles occupent trois créneaux confirmés :",
          "startMs": 6604,
          "endMs": 9866,
          "method": "silence",
          "videoSeconds": 250.07
        },
        {
          "text": "une personne participe pour la première fois, l'autre est de retour.",
          "startMs": 10107,
          "endMs": 13520,
          "method": "silence",
          "videoSeconds": 253.573
        },
        {
          "text": "Les présences n'ont été saisies que pour un créneau.",
          "startMs": 13761,
          "endMs": 16933,
          "method": "silence",
          "videoSeconds": 257.227
        },
        {
          "text": "Le bilan le signale :",
          "startMs": 17102,
          "endMs": 18357,
          "method": "silence",
          "videoSeconds": 260.568
        },
        {
          "text": "les autres ne sont pas déclarés absents.",
          "startMs": 18491,
          "endMs": 20949,
          "method": "silence",
          "videoSeconds": 261.957
        },
        {
          "text": "Nous retrouvons six heures planifiées, dont deux attestées, puis le remplissage par poste.",
          "startMs": 21107,
          "endMs": 26693,
          "method": "silence",
          "videoSeconds": 264.573
        },
        {
          "text": "Ces repères vous aident à préparer la prochaine édition, sans confondre inscription, présence et durée prévue.",
          "startMs": 26851,
          "endMs": 33382,
          "method": "silence",
          "videoSeconds": 270.317
        }
      ],
