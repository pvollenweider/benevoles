    {
      "chapter": "activity",
      "startSeconds": 68.801,
      "endSeconds": 92.834,
      "sentences": [
        {
          "text": "Ouvrons l'activité d'Aline.",
          "startMs": 496,
          "endMs": 1766,
          "method": "silence",
          "videoSeconds": 69.297
        },
        {
          "text": "Vous retrouvez les faits enregistrés, leur date et l'événement concerné.",
          "startMs": 2598,
          "endMs": 6525,
          "method": "silence",
          "videoSeconds": 71.399
        },
        {
          "text": "C'est utile pour comprendre son parcours et vérifier ce qui s'est passé.",
          "startMs": 7132,
          "endMs": 10608,
          "method": "silence",
          "videoSeconds": 75.933
        },
        {
          "text": "Ce journal ne mesure pas le temps réellement travaillé :",
          "startMs": 11319,
          "endMs": 13857,
          "method": "silence",
          "videoSeconds": 80.12
        },
        {
          "text": "les heures attestées reposent sur une présence saisie et sur la durée du créneau.",
          "startMs": 14139,
          "endMs": 18248,
          "method": "silence",
          "videoSeconds": 82.94
        },
        {
          "text": "L'absence de présence saisie ne permet pas, à elle seule, de conclure qu'une personne était absente.",
          "startMs": 18999,
          "endMs": 23575,
          "method": "silence",
          "videoSeconds": 87.8
        }
      ],
      "anchors": [],
      "interactions": [
        {
          "kind": "click",
          "atMs": 69288,
          "relativeSeconds": 0.487
        }
      ],
