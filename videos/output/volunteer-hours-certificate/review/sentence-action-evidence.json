    {
      "chapter": "period-export",
      "startSeconds": 95.156,
      "endSeconds": 131.547,
      "sentences": [
        {
          "text": "Pour préparer un bilan, revenons aux membres et ouvrons Heures par bénévole, pour une période.",
          "startMs": 470,
          "endMs": 4621,
          "method": "silence",
          "videoSeconds": 95.626
        },
        {
          "text": "Choisissons le premier et le trente septembre.",
          "startMs": 5252,
          "endMs": 8231,
          "method": "silence",
          "videoSeconds": 100.408
        },
        {
          "text": "Téléchargeons le CSV.",
          "startMs": 8939,
          "endMs": 10014,
          "method": "silence",
          "videoSeconds": 104.095
        },
        {
          "text": "Il compte les créneaux confirmés non annulés de cette période, avec les heures planifiées et attestées séparées.",
          "startMs": 10468,
          "endMs": 16443,
          "method": "silence",
          "videoSeconds": 105.624
        },
        {
          "text": "Cochons maintenant l'option pour inclure les membres sans créneau confirmé, puis téléchargeons à nouveau.",
          "startMs": 17017,
          "endMs": 22189,
          "method": "silence",
          "videoSeconds": 112.173
        },
        {
          "text": "Dans ce vrai fichier, Clara apparaît avec des zéros.",
          "startMs": 22783,
          "endMs": 25231,
          "method": "silence",
          "videoSeconds": 117.939
        },
        {
          "text": "Le total indique six heures planifiées, dont deux attestées.",
          "startMs": 25861,
          "endMs": 29137,
          "method": "silence",
          "videoSeconds": 121.017
        },
        {
          "text": "La période choisie détermine le bilan :",
          "startMs": 29572,
          "endMs": 32141,
          "method": "silence",
          "videoSeconds": 124.728
        },
        {
          "text": "si elle contient des dates futures, ces créneaux peuvent aussi y figurer.",
          "startMs": 32395,
          "endMs": 36083,
          "method": "silence",
          "videoSeconds": 127.551
        }
      ],
      "anchors": [
        {
          "segmentId": "period-export",
