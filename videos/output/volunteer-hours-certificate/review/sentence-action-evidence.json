    {
      "chapter": "activity",
      "startSeconds": 68.862,
      "endSeconds": 92.895,
      "sentences": [
        {
          "text": "Ouvrons l'activité d'Aline.",
          "startMs": 496,
          "endMs": 1766,
          "method": "silence",
          "videoSeconds": 69.358
        },
        {
          "text": "Vous retrouvez les faits enregistrés, leur date et l'événement concerné.",
          "startMs": 2598,
          "endMs": 6525,
          "method": "silence",
          "videoSeconds": 71.46
        },
        {
          "text": "C'est utile pour comprendre son parcours et vérifier ce qui s'est passé.",
          "startMs": 7132,
          "endMs": 10608,
          "method": "silence",
          "videoSeconds": 75.994
        },
        {
          "text": "Ce journal ne mesure pas le temps réellement travaillé :",
          "startMs": 11319,
          "endMs": 13857,
          "method": "silence",
          "videoSeconds": 80.181
        },
        {
          "text": "les heures attestées reposent sur une présence saisie et sur la durée du créneau.",
          "startMs": 14139,
          "endMs": 18248,
          "method": "silence",
          "videoSeconds": 83.001
        },
        {
          "text": "L'absence de présence saisie ne permet pas, à elle seule, de conclure qu'une personne était absente.",
          "startMs": 18999,
          "endMs": 23575,
          "method": "silence",
          "videoSeconds": 87.861
        }
      ],
      "anchors": [],
      "interactions": [
        {
          "kind": "click",
          "atMs": 69367
        }
      ],
