{
  "mp4Sha256": "c8c50d5ecbb68de5885580bfa9c891694a0c2e7762a817dc55621eb9ad835241",
  "chapters": [
    {
      "chapter": "hours-list",
      "startSeconds": 3.522,
      "endSeconds": 31.787,
      "sentences": [
        {
          "text": "Reconnaître l'engagement, c'est aussi disposer d'un bilan clair.",
          "startMs": 270,
          "endMs": 3882,
          "method": "silence",
          "videoSeconds": 3.792
        },
        {
          "text": "Dans la liste des membres, regardons les heures planifiées et les heures attestées.",
          "startMs": 4184,
          "endMs": 8675,
          "method": "silence",
          "videoSeconds": 7.706
        },
        {
          "text": "Pour Aline, huit heures étaient prévues sur ses créneaux confirmés passés, et six correspondent à une présence saisie.",
          "startMs": 9029,
          "endMs": 14997,
          "method": "silence",
          "videoSeconds": 12.551
        },
        {
          "text": "Ces six heures font partie des huit :",
          "startMs": 15370,
          "endMs": 17036,
          "method": "silence",
          "videoSeconds": 18.892
        },
        {
          "text": "elles ne s'ajoutent pas.",
          "startMs": 17216,
          "endMs": 18283,
          "method": "silence",
          "videoSeconds": 20.738
        },
        {
          "text": "Les créneaux à venir, les inscriptions annulées et les créneaux annulés ne gonflent pas ce bilan.",
          "startMs": 18882,
          "endMs": 23856,
          "method": "silence",
          "videoSeconds": 22.404
        },
        {
          "text": "Toutes les personnes et les données de cette démonstration sont fictives.",
          "startMs": 24422,
          "endMs": 27901,
          "method": "silence",
          "videoSeconds": 27.944
        }
      ],
      "anchors": [],
      "interactions": [],
      "frames": [
        {
