    {
      "chapter": "last-participation",
      "startSeconds": 34.044,
      "endSeconds": 66.6,
      "sentences": [
        {
          "text": "La dernière participation apporte un autre repère.",
          "startMs": 316,
          "endMs": 3184,
          "method": "silence",
          "videoSeconds": 34.36
        },
        {
          "text": "Pour Aline, la date du dernier créneau confirmé apparaît au-dessus de celle de sa dernière présence enregistrée.",
          "startMs": 3486,
          "endMs": 9283,
          "method": "silence",
          "videoSeconds": 37.53
        },
        {
          "text": "Pour Benoît, aucune présence n'a été saisie :",
          "startMs": 9940,
          "endMs": 12066,
          "method": "silence",
          "videoSeconds": 43.984
        },
        {
          "text": "ce n'est pas une preuve d'absence.",
          "startMs": 12373,
          "endMs": 14193,
          "method": "silence",
          "videoSeconds": 46.417
        },
        {
          "text": "Vous pouvez aussi trier les heures attestées.",
          "startMs": 14391,
          "endMs": 16253,
          "method": "silence",
          "videoSeconds": 48.435
        },
        {
          "text": "Un clic les classe par ordre croissant, un deuxième inverse cet ordre, et le troisième rétablit la liste initiale.",
          "startMs": 16760,
          "endMs": 22961,
          "method": "silence",
          "videoSeconds": 50.804
        },
        {
          "text": "Cliquons enfin sur Dernière participation pour trier cette date.",
          "startMs": 23464,
          "endMs": 26569,
          "method": "silence",
          "videoSeconds": 57.508
        },
        {
          "text": "Aucun de ces repères ne désactive automatiquement un membre :",
          "startMs": 27176,
          "endMs": 30778,
          "method": "silence",
          "videoSeconds": 61.22
        },
        {
          "text": "vous gardez la décision.",
          "startMs": 31050,
          "endMs": 32251,
          "method": "silence",
          "videoSeconds": 65.094
        }
      ],
      "anchors": [
        {
          "segmentId": "last-participation",
          "phrase": "Pour Benoît, aucune présence n'a",
          "startMs": 9940,
          "endMs": 12066,
          "cueMs": 43986
        },
        {
          "segmentId": "last-participation",
          "phrase": "Un clic les classe par",
