[
  {
    "id": "welcome",
    "startMs": 1,
    "sentences": [
      {
        "text": "Le formulaire sert à transmettre les bonnes informations à l’association et à vérifier ton engagement avant de confirmer.",
        "startMs": 309,
        "endMs": 6239,
        "method": "silence",
        "absoluteStartMs": 310
      },
      {
        "text": "Nous allons remplir un exemple complet, lire les questions et la convention, puis corriger un planning volontairement trop chargé.",
        "startMs": 7176,
        "endMs": 13629,
        "method": "silence",
        "absoluteStartMs": 7177
      },
      {
        "text": "Prends ton temps :",
        "startMs": 14364,
        "endMs": 14811,
        "method": "silence",
        "absoluteStartMs": 14365
      },
      {
        "text": "aucune inscription ne part pendant la saisie.",
        "startMs": 15351,
        "endMs": 17321,
        "method": "silence",
        "absoluteStartMs": 15352
      }
    ],
    "inputs": []
  },
  {
    "id": "selection",
    "startMs": 18578,
    "sentences": [
      {
        "text": "Voici quatre missions :",
        "startMs": 804,
        "endMs": 1833,
        "method": "silence",
        "absoluteStartMs": 19382
      },
      {
        "text": "Accueil le matin, Logistique juste après, Rangement en soirée jusqu’à deux heures du matin, puis Buvette le dimanche.",
        "startMs": 2506,
        "endMs": 9399,
        "method": "silence",
        "absoluteStartMs": 21084
      },
      {
        "text": "Le bouton Continuer ouvre le formulaire avec ce choix.",
        "startMs": 10705,
        "endMs": 11783,
        "method": "silence",
        "absoluteStartMs": 29283
      },
      {
        "text": "Le récapitulatif les classe dans l’ordre chronologique, même si tu les as sélectionnées autrement.",
        "startMs": 12008,
        "endMs": 18550,
        "method": "silence",
        "absoluteStartMs": 30586
