  {
    "id": "agreement",
    "startMs": 76912,
    "sentences": [
      {
        "text": "Ouvre la Convention des Bénévoles pour lire le cadre de l’engagement, puis accepte-la si elle te convient.",
        "startMs": 605,
        "endMs": 5611,
        "method": "silence",
        "absoluteStartMs": 77517
      },
      {
        "text": "Le consentement sur les données est une case distincte :",
        "startMs": 6735,
        "endMs": 8910,
        "method": "silence",
        "absoluteStartMs": 83647
      },
      {
        "text": "il concerne leur utilisation pour cet événement.",
        "startMs": 9385,
        "endMs": 11409,
        "method": "silence",
        "absoluteStartMs": 86297
      },
      {
        "text": "Lire puis cocher ces deux éléments évite de confirmer un cadre qu’on n’a pas compris.",
        "startMs": 12540,
        "endMs": 16343,
        "method": "silence",
        "absoluteStartMs": 89452
      }
    ],
