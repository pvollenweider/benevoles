        "endMs": 7758,
        "method": "silence",
        "absoluteStartMs": 59710
      },
      {
        "text": "Réponds seulement avec des informations utiles à l’organisation.",
        "startMs": 8718,
        "endMs": 11474,
        "method": "silence",
        "absoluteStartMs": 65329
