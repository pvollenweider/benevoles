  {
    "id": "recap",
    "startMs": 94259,
    "sentences": [
      {
        "text": "Relis maintenant les jours et les heures.",
        "startMs": 548,
        "endMs": 2276,
        "method": "silence",
        "absoluteStartMs": 94807
      },
      {
        "text": "Le créneau de nuit dit explicitement fin le lendemain.",
        "startMs": 3096,
        "endMs": 5693,
        "method": "silence",
        "absoluteStartMs": 97355
      },
      {
        "text": "Les intervalles montrent où se trouvent les pauses.",
        "startMs": 6726,
        "endMs": 8580,
        "method": "silence",
        "absoluteStartMs": 100985
      },
      {
        "text": "Les lieux, consignes et liens de carte restent accessibles, mais les coordonnées personnelles du contact ne sont fournies qu’après inscription.",
        "startMs": 9591,
        "endMs": 15809,
        "method": "silence",
        "absoluteStartMs": 103850
      },
      {
        "text": "En bas, Transmis à l’organisation énumère les données et les questions auxquelles tu as répondu.",
        "startMs": 16438,
        "endMs": 21670,
        "method": "silence",
        "absoluteStartMs": 110697
      }
    ],
    "inputs": []
  },
  {
    "id": "workload",
    "startMs": 116843,
    "sentences": [
      {
        "text": "Ce planning affiche Journée chargée :",
        "startMs": 492,
        "endMs": 2890,
        "method": "silence",
        "absoluteStartMs": 117335
      },
      {
        "text": "Accueil et Logistique font neuf heures d’affilée, sans une pause de trente minutes, et la nuit ajoute encore quatre heures.",
        "startMs": 3420,
        "endMs": 9680,
        "method": "silence",
        "absoluteStartMs": 120263
      },
      {
        "text": "L’avertissement conseille de revoir l’engagement, mais ne bloque pas la confirmation.",
        "startMs": 10897,
        "endMs": 16290,
        "method": "silence",
        "absoluteStartMs": 127740
      },
      {
        "text": "Pour alléger, reviens au planning et retire Logistique :",
        "startMs": 16690,
        "endMs": 19535,
        "method": "silence",
        "absoluteStartMs": 133533
      },
      {
        "text": "les horaires sont recalculés immédiatement.",
        "startMs": 20209,
        "endMs": 23096,
        "method": "silence",
        "absoluteStartMs": 137052
      }
    ],
