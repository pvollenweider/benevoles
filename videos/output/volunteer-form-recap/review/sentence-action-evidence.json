  {
    "id": "questions",
    "startMs": 56611,
    "sentences": [
      {
        "text": "L’association a ajouté ses questions.",
        "startMs": 564,
        "endMs": 2149,
        "method": "silence",
        "absoluteStartMs": 57175
      },
      {
        "text": "La taille de t-shirt est obligatoire, tandis que le régime alimentaire et le permis sont facultatifs.",
