  "chapters": [
    {
      "id": "welcome",
      "startMs": 1,
      "endMs": 18126,
      "sentences": [
        {
          "text": "Le formulaire sert à transmettre les bonnes informations à l’association et à vérifier ton engagement avant de confirmer.",
          "startMs": 309,
          "endMs": 6239,
          "method": "silence",
          "absoluteStartS": 0.31,
          "absoluteEndS": 6.24
        },
        {
          "text": "Nous allons remplir un exemple complet, lire les questions et la convention, puis corriger un planning volontairement trop chargé.",
          "startMs": 7176,
          "endMs": 13629,
          "method": "silence",
          "absoluteStartS": 7.177,
          "absoluteEndS": 13.63
        },
        {
          "text": "Prends ton temps :",
          "startMs": 14364,
          "endMs": 14811,
          "method": "silence",
          "absoluteStartS": 14.365,
          "absoluteEndS": 14.812
        },
        {
          "text": "aucune inscription ne part pendant la saisie.",
          "startMs": 15351,
          "endMs": 17321,
          "method": "silence",
          "absoluteStartS": 15.352,
          "absoluteEndS": 17.322
        }
      ],
      "markers": []
    },
    {
      "id": "selection",
      "startMs": 18579,
      "endMs": 37836,
      "sentences": [
        {
          "text": "Voici quatre missions :",
          "startMs": 804,
          "endMs": 1833,
          "method": "silence",
          "absoluteStartS": 19.383,
          "absoluteEndS": 20.412
        },
        {
          "text": "Accueil le matin, Logistique juste après, Rangement en soirée jusqu’à deux heures du matin, puis Buvette le dimanche.",
          "startMs": 2506,
          "endMs": 9399,
          "method": "silence",
          "absoluteStartS": 21.085,
          "absoluteEndS": 27.978
        },
        {
          "text": "Le bouton Continuer ouvre le formulaire avec ce choix.",
          "startMs": 10705,
          "endMs": 11783,
          "method": "silence",
          "absoluteStartS": 29.284,
          "absoluteEndS": 30.362
        },
        {
          "text": "Le récapitulatif les classe dans l’ordre chronologique, même si tu les as sélectionnées autrement.",
          "startMs": 12008,
          "endMs": 18550,
          "method": "silence",
          "absoluteStartS": 30.587,
          "absoluteEndS": 37.129
        }
      ],
