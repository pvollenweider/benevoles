    {
      "id": "identity",
      "startMs": 38289,
      "endMs": 56159,
      "sentences": [
        {
          "text": "Indique ton prénom et ton nom, puis vérifie soigneusement l’adresse email :",
          "startMs": 708,
          "endMs": 4518,
          "method": "silence",
          "absoluteStartS": 38.997,
          "absoluteEndS": 42.807
        },
        {
          "text": "la confirmation et le lien personnel arriveront là.",
          "startMs": 4884,
          "endMs": 7138,
          "method": "silence",
          "absoluteStartS": 43.173,
          "absoluteEndS": 45.427
        },
        {
          "text": "Le téléphone est obligatoire pour cet événement.",
          "startMs": 8125,
          "endMs": 9916,
          "method": "silence",
          "absoluteStartS": 46.414,
          "absoluteEndS": 48.205
        },
        {
          "text": "La date de naissance apparaît parce que le Rangement demande dix-huit ans minimum ;",
