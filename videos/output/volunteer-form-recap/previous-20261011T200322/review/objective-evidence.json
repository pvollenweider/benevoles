    {
      "scene": "identity",
      "startMs": 38282,
      "endMs": 56152,
      "sentences": [
        {
          "text": "Indique ton prénom et ton nom, puis vérifie soigneusement l’adresse email :",
          "startMs": 708,
          "endMs": 4518,
          "method": "silence",
          "globalStartMs": 38990,
          "globalEndMs": 42800
        },
        {
          "text": "la confirmation et le lien personnel arriveront là.",
          "startMs": 4884,
          "endMs": 7138,
          "method": "silence",
          "globalStartMs": 43166,
          "globalEndMs": 45420
        },
        {
          "text": "Le téléphone est obligatoire pour cet événement.",
          "startMs": 8125,
          "endMs": 9916,
          "method": "silence",
          "globalStartMs": 46407,
          "globalEndMs": 48198
        },
        {
          "text": "La date de naissance apparaît parce que le Rangement demande dix-huit ans minimum ;",
          "startMs": 11123,
          "endMs": 14545,
          "method": "silence",
          "globalStartMs": 49405,
          "globalEndMs": 52827
        },
        {
          "text": "elle permet de vérifier l’âge à la date de la mission.",
          "startMs": 15236,
          "endMs": 17306,
          "method": "silence",
          "globalStartMs": 53518,
          "globalEndMs": 55588
        }
      ],
