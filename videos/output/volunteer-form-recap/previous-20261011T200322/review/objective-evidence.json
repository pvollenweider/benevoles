    {
      "scene": "questions",
      "startMs": 56604,
      "endMs": 76450,
      "sentences": [
        {
          "text": "L’association a ajouté ses questions.",
          "startMs": 564,
          "endMs": 2149,
          "method": "silence",
          "globalStartMs": 57168,
          "globalEndMs": 58753
        },
        {
          "text": "La taille de t-shirt est obligatoire, tandis que le régime alimentaire et le permis sont facultatifs.",
          "startMs": 3099,
          "endMs": 7758,
          "method": "silence",
          "globalStartMs": 59703,
          "globalEndMs": 64362
        },
        {
          "text": "Réponds seulement avec des informations utiles à l’organisation.",
          "startMs": 8718,
          "endMs": 11474,
          "method": "silence",
          "globalStartMs": 65322,
          "globalEndMs": 68078
        },
        {
          "text": "Le commentaire permet de préciser un point pratique, par exemple un besoin de pause ;",
          "startMs": 12533,
          "endMs": 16123,
          "method": "silence",
          "globalStartMs": 69137,
          "globalEndMs": 72727
        },
        {
          "text": "il ne remplace pas une discussion urgente avec l’équipe.",
          "startMs": 16905,
          "endMs": 19159,
          "method": "silence",
          "globalStartMs": 73509,
          "globalEndMs": 75763
        }
      ],
