    {
      "scene": "recap",
      "startMs": 94247,
      "endMs": 116379,
      "sentences": [
        {
          "text": "Relis maintenant les jours et les heures.",
          "startMs": 548,
          "endMs": 2276,
          "method": "silence",
          "globalStartMs": 94795,
          "globalEndMs": 96523
        },
        {
          "text": "Le créneau de nuit dit explicitement fin le lendemain.",
          "startMs": 3096,
          "endMs": 5693,
          "method": "silence",
          "globalStartMs": 97343,
          "globalEndMs": 99940
        },
        {
          "text": "Les intervalles montrent où se trouvent les pauses.",
          "startMs": 6726,
          "endMs": 8580,
          "method": "silence",
          "globalStartMs": 100973,
          "globalEndMs": 102827
        },
        {
          "text": "Les lieux, consignes et liens de carte restent accessibles, mais les coordonnées personnelles du contact ne sont fournies qu’après inscription.",
          "startMs": 9591,
          "endMs": 15809,
          "method": "silence",
          "globalStartMs": 103838,
          "globalEndMs": 110056
        },
        {
          "text": "En bas, Transmis à l’organisation énumère les données et les questions auxquelles tu as répondu.",
          "startMs": 16438,
          "endMs": 21670,
          "method": "silence",
          "globalStartMs": 110685,
          "globalEndMs": 115917
        }
      ],
      "anchors": [
        {
          "segmentId": "recap",
          "phrase": "Les lieux, consignes et liens",
          "startMs": 9591,
          "endMs": 15809,
          "cueMs": 103838
        },
        {
          "segmentId": "recap",
          "phrase": "En bas, Transmis à l’organisation",
          "startMs": 16438,
          "endMs": 21670,
          "cueMs": 110686
        }
      ],
      "inputs": []
    },
    {
      "scene": "workload",
      "startMs": 116831,
      "endMs": 139927,
      "sentences": [
        {
          "text": "Ce planning affiche Journée chargée :",
          "startMs": 492,
          "endMs": 2890,
          "method": "silence",
          "globalStartMs": 117323,
          "globalEndMs": 119721
        },
        {
          "text": "Accueil et Logistique font neuf heures d’affilée, sans une pause de trente minutes, et la nuit ajoute encore quatre heures.",
          "startMs": 3420,
          "endMs": 9680,
          "method": "silence",
          "globalStartMs": 120251,
          "globalEndMs": 126511
        },
        {
          "text": "L’avertissement conseille de revoir l’engagement, mais ne bloque pas la confirmation.",
          "startMs": 10897,
          "endMs": 16290,
          "method": "silence",
          "globalStartMs": 127728,
          "globalEndMs": 133121
        },
        {
          "text": "Pour alléger, reviens au planning et retire Logistique :",
          "startMs": 16690,
          "endMs": 19535,
          "method": "silence",
          "globalStartMs": 133521,
          "globalEndMs": 136366
        },
        {
          "text": "les horaires sont recalculés immédiatement.",
          "startMs": 20209,
          "endMs": 23096,
          "method": "silence",
          "globalStartMs": 137040,
          "globalEndMs": 139927
        }
      ],
      "anchors": [
        {
