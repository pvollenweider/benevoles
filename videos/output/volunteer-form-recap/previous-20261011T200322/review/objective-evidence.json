    {
      "scene": "result",
      "startMs": 140379,
      "endMs": 159540,
      "sentences": [
        {
          "text": "Le nouveau récapitulatif garde trois missions et une vraie pause entre le matin et la nuit.",
          "startMs": 0,
          "endMs": 4715,
          "method": "silence",
          "globalStartMs": 140379,
          "globalEndMs": 145094
        },
        {
          "text": "Les informations saisies sont conservées.",
          "startMs": 5747,
          "endMs": 7308,
          "method": "silence",
          "globalStartMs": 146126,
          "globalEndMs": 147687
        },
        {
          "text": "Vérifie une dernière fois ton email, tes réponses et les horaires avant Confirmer mon inscription.",
          "startMs": 8369,
          "endMs": 13890,
          "method": "silence",
          "globalStartMs": 148748,
          "globalEndMs": 154269
        },
        {
          "text": "Dans cette démonstration, nous restons juste avant ce bouton :",
          "startMs": 14509,
          "endMs": 17479,
          "method": "silence",
          "globalStartMs": 154888,
          "globalEndMs": 157858
        },
        {
          "text": "rien n’a été envoyé.",
