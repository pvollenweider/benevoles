  "sentences": [
    {
      "scene": "welcome",
      "startMs": 0,
      "endMs": 18125,
      "sentences": [
        {
          "text": "Le formulaire sert à transmettre les bonnes informations à l’association et à vérifier ton engagement avant de confirmer.",
          "startMs": 309,
          "endMs": 6239,
          "method": "silence",
          "globalStartMs": 309,
          "globalEndMs": 6239
        },
        {
          "text": "Nous allons remplir un exemple complet, lire les questions et la convention, puis corriger un planning volontairement trop chargé.",
          "startMs": 7176,
          "endMs": 13629,
          "method": "silence",
          "globalStartMs": 7176,
          "globalEndMs": 13629
        },
        {
          "text": "Prends ton temps :",
          "startMs": 14364,
          "endMs": 14811,
          "method": "silence",
          "globalStartMs": 14364,
          "globalEndMs": 14811
        },
        {
          "text": "aucune inscription ne part pendant la saisie.",
          "startMs": 15351,
          "endMs": 17321,
          "method": "silence",
          "globalStartMs": 15351,
          "globalEndMs": 17321
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "selection",
      "startMs": 18577,
      "endMs": 37829,
      "sentences": [
        {
          "text": "Voici quatre missions :",
          "startMs": 804,
          "endMs": 1833,
          "method": "silence",
          "globalStartMs": 19381,
          "globalEndMs": 20410
        },
        {
          "text": "Accueil le matin, Logistique juste après, Rangement en soirée jusqu’à deux heures du matin, puis Buvette le dimanche.",
          "startMs": 2506,
          "endMs": 9399,
          "method": "silence",
          "globalStartMs": 21083,
          "globalEndMs": 27976
        },
        {
          "text": "Le bouton Continuer ouvre le formulaire avec ce choix.",
          "startMs": 10705,
          "endMs": 11783,
          "method": "silence",
          "globalStartMs": 29282,
          "globalEndMs": 30360
        },
        {
          "text": "Le récapitulatif les classe dans l’ordre chronologique, même si tu les as sélectionnées autrement.",
          "startMs": 12008,
          "endMs": 18550,
          "method": "silence",
          "globalStartMs": 30585,
          "globalEndMs": 37127
        }
      ],
      "anchors": [
        {
