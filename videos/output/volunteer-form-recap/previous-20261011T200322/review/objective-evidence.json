    {
      "scene": "agreement",
      "startMs": 76901,
      "endMs": 93795,
      "sentences": [
        {
          "text": "Ouvre la Convention des Bénévoles pour lire le cadre de l’engagement, puis accepte-la si elle te convient.",
          "startMs": 605,
          "endMs": 5611,
          "method": "silence",
          "globalStartMs": 77506,
          "globalEndMs": 82512
        },
        {
          "text": "Le consentement sur les données est une case distincte :",
          "startMs": 6735,
          "endMs": 8910,
          "method": "silence",
          "globalStartMs": 83636,
          "globalEndMs": 85811
        },
        {
          "text": "il concerne leur utilisation pour cet événement.",
          "startMs": 9385,
          "endMs": 11409,
          "method": "silence",
          "globalStartMs": 86286,
          "globalEndMs": 88310
        },
        {
          "text": "Lire puis cocher ces deux éléments évite de confirmer un cadre qu’on n’a pas compris.",
          "startMs": 12540,
          "endMs": 16343,
          "method": "silence",
          "globalStartMs": 89441,
          "globalEndMs": 93244
        }
      ],
      "anchors": [
        {
          "segmentId": "agreement",
          "phrase": "Lire puis cocher ces deux",
          "startMs": 12540,
          "endMs": 16343,
          "cueMs": 89442
        }
      ],
