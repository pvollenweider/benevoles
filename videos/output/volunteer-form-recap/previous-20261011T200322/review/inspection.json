  "chapters": [
    {
      "id": "welcome",
      "startMs": 0,
      "endMs": 18125,
      "sentences": [
        {
          "text": "Le formulaire sert à transmettre les bonnes informations à l’association et à vérifier ton engagement avant de confirmer.",
          "startMs": 309,
          "endMs": 6239,
          "method": "silence",
          "absoluteStartS": 0.309,
          "absoluteEndS": 6.239
        },
        {
          "text": "Nous allons remplir un exemple complet, lire les questions et la convention, puis corriger un planning volontairement trop chargé.",
          "startMs": 7176,
          "endMs": 13629,
          "method": "silence",
          "absoluteStartS": 7.176,
          "absoluteEndS": 13.629
        },
        {
          "text": "Prends ton temps :",
          "startMs": 14364,
          "endMs": 14811,
          "method": "silence",
          "absoluteStartS": 14.364,
          "absoluteEndS": 14.811
        },
        {
          "text": "aucune inscription ne part pendant la saisie.",
          "startMs": 15351,
          "endMs": 17321,
          "method": "silence",
          "absoluteStartS": 15.351,
          "absoluteEndS": 17.321
        }
      ],
      "markers": []
    },
    {
      "id": "selection",
      "startMs": 18577,
      "endMs": 37829,
      "sentences": [
        {
          "text": "Voici quatre missions :",
          "startMs": 804,
          "endMs": 1833,
          "method": "silence",
          "absoluteStartS": 19.381,
          "absoluteEndS": 20.41
        },
        {
          "text": "Accueil le matin, Logistique juste après, Rangement en soirée jusqu’à deux heures du matin, puis Buvette le dimanche.",
          "startMs": 2506,
          "endMs": 9399,
          "method": "silence",
          "absoluteStartS": 21.083,
          "absoluteEndS": 27.976
        },
        {
          "text": "Le bouton Continuer ouvre le formulaire avec ce choix.",
          "startMs": 10705,
          "endMs": 11783,
          "method": "silence",
          "absoluteStartS": 29.282,
          "absoluteEndS": 30.36
        },
        {
          "text": "Le récapitulatif les classe dans l’ordre chronologique, même si tu les as sélectionnées autrement.",
          "startMs": 12008,
          "endMs": 18550,
          "method": "silence",
          "absoluteStartS": 30.585,
          "absoluteEndS": 37.127
        }
      ],
