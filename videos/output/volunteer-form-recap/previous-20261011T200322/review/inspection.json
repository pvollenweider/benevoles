      "startMs": 38282,
      "endMs": 56152,
      "sentences": [
        {
          "text": "Indique ton prénom et ton nom, puis vérifie soigneusement l’adresse email :",
          "startMs": 708,
          "endMs": 4518,
          "method": "silence",
          "absoluteStartS": 38.99,
          "absoluteEndS": 42.8
        },
        {
          "text": "la confirmation et le lien personnel arriveront là.",
          "startMs": 4884,
          "endMs": 7138,
          "method": "silence",
          "absoluteStartS": 43.166,
          "absoluteEndS": 45.42
        },
        {
          "text": "Le téléphone est obligatoire pour cet événement.",
          "startMs": 8125,
          "endMs": 9916,
          "method": "silence",
          "absoluteStartS": 46.407,
          "absoluteEndS": 48.198
        },
        {
