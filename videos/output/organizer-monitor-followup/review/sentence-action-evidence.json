    {
      "chapter": "requests",
      "startSeconds": 49.673,
      "endSeconds": 63.908,
      "sentences": [
        {
          "text": "Les postes sur validation sont clairement signalés.",
          "startMs": 127,
          "endMs": 3008,
          "method": "silence",
          "videoSeconds": 49.8
        },
        {
          "text": "Ouvre une demande pour vérifier la personne, le créneau et ses réponses, puis accepte-la ou refuse-la.",
