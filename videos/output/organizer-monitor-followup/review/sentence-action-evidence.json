    {
      "chapter": "registrations",
      "startSeconds": 31.69,
      "endSeconds": 48.053,
      "sentences": [
        {
          "text": "Dans les inscriptions, chaque ligne rassemble la personne, son créneau, son statut et les informations utiles.",
          "startMs": 340,
          "endMs": 6767,
          "method": "silence",
          "videoSeconds": 32.03
