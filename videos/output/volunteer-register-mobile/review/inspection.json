          "method": "silence",
          "absoluteStartS": 6.121,
          "absoluteEndS": 9.147
        }
      ],
      "markers": []
    },
    {
      "id": "discover",
      "startMs": 9987,
      "endMs": 16489,
      "sentences": [
        {
          "text": "Sur la page de l’événement, tu retrouves les horaires, les postes et le nombre de places encore disponibles.",
