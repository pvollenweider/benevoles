  "chapters": [
    {
      "id": "welcome",
      "startMs": 0,
      "endMs": 9533,
      "sentences": [
        {
          "text": "Envie de donner un coup de main ?",
          "startMs": 281,
          "endMs": 1413,
          "method": "silence",
          "absoluteStartS": 0.281,
          "absoluteEndS": 1.413
        },
        {
          "text": "Ouvre le lien reçu, ou scanne le QR code affiché par l’association.",
          "startMs": 1991,
          "endMs": 5745,
          "method": "silence",
          "absoluteStartS": 1.991,
          "absoluteEndS": 5.745
        },
        {
          "text": "Tu peux choisir ton créneau directement depuis ton téléphone.",
