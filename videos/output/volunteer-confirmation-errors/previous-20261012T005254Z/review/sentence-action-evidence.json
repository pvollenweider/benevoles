  {
    "chapter": "validation",
    "startMs": 43224,
    "endMs": 62998,
    "sentences": [
      {
        "text": "La taille du t-shirt n’a pas été renseignée.",
        "startMs": 551,
        "endMs": 2380,
        "method": "silence",
        "absoluteStartMs": 43775
      },
      {
        "text": "Confirmer affiche la question à corriger et conserve toutes les autres réponses.",
        "startMs": 3089,
        "endMs": 7377,
        "method": "silence",
        "absoluteStartMs": 46313
      },
      {
        "text": "Le champ obligatoire est signalé ;",
        "startMs": 8250,
        "endMs": 9664,
        "method": "silence",
        "absoluteStartMs": 51474
      },
      {
        "text": "choisis une taille, puis tu peux reprendre.",
        "startMs": 10187,
        "endMs": 12176,
        "method": "silence",
        "absoluteStartMs": 53411
      },
      {
        "text": "Une adresse email au mauvais format est également refusée par le navigateur, mais il ne sait pas vérifier qu’une boîte existe vraiment.",
        "startMs": 12904,
        "endMs": 19327,
        "method": "silence",
        "absoluteStartMs": 56128
      }
    ],
    "anchors": [
      {
        "segmentId": "validation",
        "phrase": "Confirmer affiche la question à",
        "startMs": 3089,
        "endMs": 7377,
        "cueMs": 46313
      },
      {
        "segmentId": "validation",
        "phrase": "choisis une taille, puis tu",
        "startMs": 10187,
        "endMs": 12176,
        "cueMs": 53410
      }
    ],
