  {
    "chapter": "result",
    "startMs": 278864,
    "endMs": 308081,
    "sentences": [
      {
        "text": "Revenons côté organisation pour vérifier les inscriptions réellement présentes.",
        "startMs": 292,
        "endMs": 4781,
        "method": "silence",
        "absoluteStartMs": 279156
      },
      {
        "text": "Une erreur de champ se corrige sur place.",
        "startMs": 5037,
        "endMs": 7106,
        "method": "silence",
        "absoluteStartMs": 283901
      },
      {
        "text": "Une sélection indisponible se revoit dans le planning.",
        "startMs": 7585,
        "endMs": 10313,
        "method": "silence",
        "absoluteStartMs": 286449
      },
      {
        "text": "Une interruption réseau se retente après vérification de la connexion, sans inventer une deuxième inscription.",
        "startMs": 10450,
        "endMs": 16481,
        "method": "silence",
        "absoluteStartMs": 289314
      },
      {
        "text": "Lis le message jusqu'au bout et conserve ton email personnel pour retrouver tes créneaux.",
        "startMs": 17368,
        "endMs": 21473,
        "method": "silence",
        "absoluteStartMs": 296232
      },
      {
        "text": "Dans cette démonstration, les personnes sont fictives, mais les refus, les confirmations et les résultats sont bien ceux de l'application.",
        "startMs": 21920,
        "endMs": 28937,
        "method": "silence",
        "absoluteStartMs": 300784
      }
    ],
    "anchors": [],
    "interactions": []
  }
