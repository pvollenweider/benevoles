  {
    "chapter": "response-loss",
    "startMs": 190181,
    "endMs": 228535,
    "sentences": [
      {
        "text": "Une coupure peut arriver après l'enregistrement.",
        "startMs": 427,
        "endMs": 2717,
        "method": "silence",
        "absoluteStartMs": 190608
      },
      {
        "text": "Nicolas choisit la logistique.",
        "startMs": 3229,
        "endMs": 5996,
        "method": "silence",
        "absoluteStartMs": 193410
      },
      {
        "text": "Cette fois, la requête arrive réellement au serveur, qui crée son inscription ;",
        "startMs": 6120,
        "endMs": 9871,
        "method": "silence",
        "absoluteStartMs": 196301
      },
      {
        "text": "nous interrompons volontairement seulement la réponse au navigateur.",
        "startMs": 10224,
        "endMs": 15280,
        "method": "silence",
        "absoluteStartMs": 200405
      },
      {
        "text": "Le formulaire affiche Connexion interrompue parce qu'il ne sait pas si l'envoi a abouti.",
        "startMs": 15585,
        "endMs": 20970,
        "method": "silence",
        "absoluteStartMs": 205766
      },
      {
        "text": "Rétablissons la connexion et confirmons à nouveau.",
        "startMs": 21126,
        "endMs": 22696,
        "method": "silence",
        "absoluteStartMs": 211307
      },
      {
        "text": "Le message indique qu'il est déjà inscrit et que son lien lui a été envoyé par email.",
        "startMs": 23308,
        "endMs": 28483,
        "method": "silence",
        "absoluteStartMs": 213489
      },
      {
        "text": "Vérifions côté organisation :",
        "startMs": 28916,
        "endMs": 31203,
        "method": "silence",
        "absoluteStartMs": 219097
      },
      {
        "text": "une seule ligne de Nicolas apparaît sur ce créneau.",
        "startMs": 31423,
        "endMs": 33717,
        "method": "silence",
        "absoluteStartMs": 221604
      },
      {
        "text": "Le nouvel essai n'a pas créé une deuxième inscription.",
        "startMs": 34300,
        "endMs": 38217,
        "method": "silence",
        "absoluteStartMs": 224481
      }
    ],
    "anchors": [
      {
        "segmentId": "response-loss",
        "phrase": "Le formulaire affiche Connexion interrompue",
        "startMs": 15585,
        "endMs": 20970,
