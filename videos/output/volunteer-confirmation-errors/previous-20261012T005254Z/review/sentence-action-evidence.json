  {
    "chapter": "capacity",
    "startMs": 65255,
    "endMs": 88538,
    "sentences": [
      {
        "text": "Une place peut être prise pendant que tu remplis le formulaire.",
        "startMs": 446,
        "endMs": 3566,
        "method": "silence",
        "absoluteStartMs": 65701
      },
      {
        "text": "Nous rendons ici le créneau complet par une modification réelle de sa capacité dans la démonstration.",
        "startMs": 3822,
        "endMs": 8754,
        "method": "silence",
        "absoluteStartMs": 69077
      },
      {
        "text": "La confirmation répond Ta sélection n'est plus disponible.",
        "startMs": 9424,
        "endMs": 12424,
        "method": "silence",
        "absoluteStartMs": 74679
      },
      {
        "text": "Reviens au planning pour ajuster ton choix ;",
        "startMs": 12857,
        "endMs": 14681,
        "method": "silence",
        "absoluteStartMs": 78112
      },
      {
        "text": "les informations saisies restent conservées.",
        "startMs": 15220,
        "endMs": 16960,
        "method": "silence",
        "absoluteStartMs": 80475
      },
      {
        "text": "Une place visible quelques minutes plus tôt n'est pas une réservation tant que l'inscription n'a pas été confirmée.",
        "startMs": 17265,
        "endMs": 22861,
        "method": "silence",
        "absoluteStartMs": 82520
      }
    ],
    "anchors": [
      {
        "segmentId": "capacity",
        "phrase": "La confirmation répond Ta sélection",
        "startMs": 9424,
        "endMs": 12424,
        "cueMs": 74681
      },
      {
        "segmentId": "capacity",
        "phrase": "Une place visible quelques minutes",
        "startMs": 17265,
        "endMs": 22861,
        "cueMs": 82522
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 75155
      }
    ]
  },
  {
    "chapter": "network",
    "startMs": 90799,
    "endMs": 109856,
    "sentences": [
      {
        "text": "Nous rétablissons maintenant la place, puis coupons volontairement la requête d’envoi pour montrer une interruption réseau.",
        "startMs": 421,
        "endMs": 5774,
        "method": "silence",
        "absoluteStartMs": 91220
      },
      {
        "text": "Le message dit que l’inscription n’a peut-être pas été reçue.",
        "startMs": 6585,
        "endMs": 9187,
        "method": "silence",
        "absoluteStartMs": 97384
      },
      {
        "text": "Tes champs sont toujours là.",
        "startMs": 9870,
        "endMs": 10916,
        "method": "silence",
        "absoluteStartMs": 100669
      },
      {
        "text": "Après retour de la connexion, clique à nouveau sur Confirmer mon inscription :",
        "startMs": 11663,
        "endMs": 15589,
        "method": "silence",
        "absoluteStartMs": 102462
      },
      {
        "text": "le système évite de créer deux engagements identiques.",
        "startMs": 16308,
        "endMs": 18650,
        "method": "silence",
        "absoluteStartMs": 107107
      }
    ],
    "anchors": [
      {
        "segmentId": "network",
        "phrase": "Après retour de la connexion,",
        "startMs": 11663,
        "endMs": 15589,
        "cueMs": 102464
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 91336
      },
      {
        "kind": "click",
        "atMs": 102936
      }
    ]
  },
  {
    "chapter": "success",
    "startMs": 112117,
    "endMs": 131638,
    "sentences": [
      {
        "text": "La connexion est rétablie et l’inscription réussit.",
        "startMs": 410,
        "endMs": 2819,
        "method": "silence",
        "absoluteStartMs": 112527
      },
      {
        "text": "La page confirme le résultat et indique l’envoi de l’email.",
        "startMs": 3506,
        "endMs": 6080,
        "method": "silence",
        "absoluteStartMs": 115623
      },
      {
        "text": "Avec un formulaire public ordinaire, le lien de gestion reste dans cet email :",
        "startMs": 6689,
        "endMs": 11316,
        "method": "silence",
        "absoluteStartMs": 118806
      },
      {
        "text": "il n’est pas affiché simplement parce qu’une adresse a été saisie.",
        "startMs": 11779,
        "endMs": 14734,
        "method": "silence",
        "absoluteStartMs": 123896
      },
      {
        "text": "Garde le message pour retrouver ton planning ou annuler plus tard.",
        "startMs": 15480,
        "endMs": 19293,
        "method": "silence",
        "absoluteStartMs": 127597
      }
    ],
    "anchors": [
      {
        "segmentId": "success",
        "phrase": "il n’est pas affiché simplement",
        "startMs": 11779,
        "endMs": 14734,
        "cueMs": 123896
      }
    ],
    "interactions": []
  },
  {
    "chapter": "email",
    "startMs": 133901,
    "endMs": 155269,
    "sentences": [
      {
        "text": "Voici le message réellement reçu dans la boîte de démonstration.",
        "startMs": 256,
        "endMs": 3307,
        "method": "silence",
        "absoluteStartMs": 134157
      },
      {
        "text": "Il contient le créneau et le lien personnel.",
        "startMs": 3885,
        "endMs": 6684,
        "method": "silence",
        "absoluteStartMs": 137786
      },
      {
        "text": "Si tu ne le trouves pas, regarde les indésirables et vérifie l’adresse donnée.",
        "startMs": 7338,
        "endMs": 11781,
        "method": "silence",
        "absoluteStartMs": 141239
      },
      {
        "text": "Une page de succès ne prouve pas qu’un fournisseur email a accepté le message ;",
        "startMs": 11905,
        "endMs": 16464,
        "method": "silence",
        "absoluteStartMs": 145806
      },
      {
        "text": "contacte l’association si la boîte n’existe pas ou si tu as fait une faute.",
        "startMs": 16861,
        "endMs": 21206,
        "method": "silence",
        "absoluteStartMs": 150762
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "overlap",
    "startMs": 157541,
    "endMs": 187918,
    "sentences": [
      {
        "text": "Le serveur revérifie aussi tes horaires.",
        "startMs": 336,
        "endMs": 2720,
        "method": "silence",
        "absoluteStartMs": 157877
      },
      {
        "text": "Aline est déjà inscrite à l'accueil de dix heures à midi.",
        "startMs": 3067,
        "endMs": 5896,
        "method": "silence",
        "absoluteStartMs": 160608
      },
      {
        "text": "Essayons le vestiaire de onze à treize heures avec sa même adresse.",
        "startMs": 6580,
        "endMs": 10095,
        "method": "silence",
        "absoluteStartMs": 164121
      },
      {
        "text": "Remplissons le formulaire et confirmons.",
        "startMs": 10509,
        "endMs": 12594,
        "method": "silence",
        "absoluteStartMs": 168050
      },
      {
        "text": "Le refus nomme le créneau qui chevauche cette demande.",
        "startMs": 13049,
        "endMs": 16812,
        "method": "silence",
        "absoluteStartMs": 170590
      },
      {
        "text": "Les informations restent remplies et aucune nouvelle inscription n'a été ajoutée.",
        "startMs": 17420,
        "endMs": 21454,
        "method": "silence",
        "absoluteStartMs": 174961
      },
      {
        "text": "Ce contrôle évite de compter une personne sur deux postes en même temps.",
        "startMs": 21791,
        "endMs": 25150,
        "method": "silence",
        "absoluteStartMs": 179332
      },
      {
        "text": "Pour continuer, reviens au planning et choisis un horaire compatible.",
        "startMs": 25579,
        "endMs": 29950,
        "method": "silence",
        "absoluteStartMs": 183120
      }
    ],
    "anchors": [
      {
