  {
    "chapter": "invitation-success",
    "startMs": 230797,
    "endMs": 276601,
    "sentences": [
      {
        "text": "Comparons maintenant deux confirmations réussies.",
        "startMs": 188,
        "endMs": 3037,
        "method": "silence",
        "absoluteStartMs": 230985
      },
      {
        "text": "Zoé choisit le vestiaire dans le formulaire public ordinaire.",
        "startMs": 3413,
        "endMs": 6211,
        "method": "silence",
        "absoluteStartMs": 234210
      },
      {
        "text": "Après ses informations et les consentements, confirmons.",
        "startMs": 6646,
        "endMs": 10509,
        "method": "silence",
        "absoluteStartMs": 237443
      },
      {
        "text": "La page annonce le succès mais ne montre pas son lien personnel :",
        "startMs": 10969,
        "endMs": 14615,
        "method": "silence",
        "absoluteStartMs": 241766
      },
      {
        "text": "saisir une adresse ne prouve pas que l'on possède cette boîte.",
        "startMs": 14858,
        "endMs": 18008,
        "method": "silence",
        "absoluteStartMs": 245655
      },
      {
        "text": "Aline a ensuite reçu une invitation personnelle envoyée par l'organisation.",
        "startMs": 18194,
        "endMs": 22094,
        "method": "silence",
        "absoluteStartMs": 248991
      },
      {
        "text": "Ouvrons ce lien pour choisir la logistique.",
        "startMs": 22452,
        "endMs": 24727,
        "method": "silence",
        "absoluteStartMs": 253249
      },
      {
        "text": "Ses informations sont préremplies ;",
        "startMs": 25138,
        "endMs": 26979,
        "method": "silence",
        "absoluteStartMs": 255935
      },
      {
        "text": "vérifions-les, choisissons sa taille de t-shirt et confirmons les consentements.",
        "startMs": 27292,
        "endMs": 31681,
        "method": "silence",
        "absoluteStartMs": 258089
      },
      {
        "text": "Cette confirmation peut afficher Accéder à mon inscription, car l'invitation apporte la preuve d'adresse.",
        "startMs": 32213,
        "endMs": 38253,
        "method": "silence",
        "absoluteStartMs": 263010
      },
      {
        "text": "Ouvrons ce lien :",
        "startMs": 38798,
        "endMs": 39568,
        "method": "silence",
        "absoluteStartMs": 269595
      },
      {
        "text": "Aline retrouve ses deux créneaux.",
        "startMs": 39932,
        "endMs": 41632,
        "method": "silence",
        "absoluteStartMs": 270729
      },
      {
        "text": "Ce lien reste privé et permet aussi d'annuler ses inscriptions.",
        "startMs": 42153,
        "endMs": 45292,
        "method": "silence",
        "absoluteStartMs": 272950
      }
    ],
