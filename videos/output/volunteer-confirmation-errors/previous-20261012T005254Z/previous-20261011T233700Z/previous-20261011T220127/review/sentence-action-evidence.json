  {
    "id": "validation",
    "startMs": 41493,
    "sentences": [
      {
        "text": "La taille du t-shirt n’a pas été renseignée.",
        "startMs": 313,
        "endMs": 2215,
        "method": "silence",
        "absoluteStartMs": 41806
      },
      {
        "text": "Confirmer affiche la question à corriger et conserve toutes les autres réponses.",
        "startMs": 2859,
        "endMs": 6947,
        "method": "silence",
        "absoluteStartMs": 44352
      },
      {
        "text": "Le champ obligatoire est signalé ;",
        "startMs": 7318,
        "endMs": 9151,
        "method": "silence",
        "absoluteStartMs": 48811
      },
      {
        "text": "choisis une taille, puis tu peux reprendre.",
        "startMs": 9589,
        "endMs": 11366,
        "method": "silence",
        "absoluteStartMs": 51082
      },
      {
        "text": "Une adresse email au mauvais format est également refusée par le navigateur, mais il ne sait pas vérifier qu’une boîte existe vraiment.",
        "startMs": 11969,
        "endMs": 18583,
        "method": "silence",
        "absoluteStartMs": 53462
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 41973
      },
      {
        "kind": "click",
        "atMs": 51556
      }
    ]
  },
  {
    "id": "capacity",
    "startMs": 62755,
    "sentences": [
      {
        "text": "Une place peut être prise pendant que tu remplis le formulaire.",
        "startMs": 404,
        "endMs": 3509,
        "method": "silence",
        "absoluteStartMs": 63159
      },
      {
        "text": "Nous rendons ici le créneau complet par une modification réelle de sa capacité dans la démonstration.",
        "startMs": 4082,
        "endMs": 9201,
        "method": "silence",
        "absoluteStartMs": 66837
      },
      {
        "text": "La confirmation répond Votre sélection n'est plus disponible.",
        "startMs": 9533,
        "endMs": 12637,
        "method": "silence",
        "absoluteStartMs": 72288
      },
      {
        "text": "Reviens au planning pour ajuster ton choix ;",
        "startMs": 13336,
        "endMs": 15011,
        "method": "silence",
        "absoluteStartMs": 76091
      },
      {
        "text": "les informations saisies restent conservées.",
        "startMs": 15131,
        "endMs": 17224,
        "method": "silence",
        "absoluteStartMs": 77886
      },
      {
        "text": "Une place visible quelques minutes plus tôt n'est pas une réservation tant que l'inscription n'a pas été confirmée.",
        "startMs": 17885,
        "endMs": 23760,
        "method": "silence",
        "absoluteStartMs": 80640
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 63289
      }
    ]
  },
  {
    "id": "network",
    "startMs": 89227,
    "sentences": [
      {
        "text": "Nous rétablissons maintenant la place, puis coupons volontairement la requête d’envoi pour montrer une interruption réseau.",
        "startMs": 454,
        "endMs": 6374,
        "method": "silence",
        "absoluteStartMs": 89681
      },
      {
        "text": "Le message dit que l’inscription n’a peut-être pas été reçue.",
        "startMs": 7155,
        "endMs": 9811,
        "method": "silence",
        "absoluteStartMs": 96382
      },
      {
        "text": "Tes champs sont toujours là.",
        "startMs": 10035,
        "endMs": 11289,
        "method": "silence",
        "absoluteStartMs": 99262
      },
      {
        "text": "Après retour de la connexion, clique à nouveau sur Confirmer mon inscription :",
        "startMs": 11638,
        "endMs": 15670,
        "method": "silence",
        "absoluteStartMs": 100865
      },
      {
        "text": "le système évite de créer deux engagements identiques.",
        "startMs": 16199,
        "endMs": 18452,
        "method": "silence",
        "absoluteStartMs": 105426
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 89753
      }
    ]
  },
  {
    "id": "success",
    "startMs": 110350,
    "sentences": [
      {
        "text": "La connexion est rétablie et l’inscription réussit.",
        "startMs": 412,
        "endMs": 3388,
        "method": "silence",
        "absoluteStartMs": 110762
      },
      {
        "text": "La page confirme le résultat et indique l’envoi de l’email.",
        "startMs": 3867,
        "endMs": 7053,
        "method": "silence",
        "absoluteStartMs": 114217
      },
      {
        "text": "Avec un formulaire public ordinaire, le lien de gestion reste dans cet email :",
        "startMs": 7662,
        "endMs": 12136,
        "method": "silence",
        "absoluteStartMs": 118012
      },
      {
        "text": "il n’est pas affiché simplement parce qu’une adresse a été saisie.",
        "startMs": 12630,
        "endMs": 15619,
        "method": "silence",
        "absoluteStartMs": 122980
      },
      {
        "text": "Garde le message pour retrouver ton planning ou annuler plus tard.",
        "startMs": 16470,
        "endMs": 20101,
        "method": "silence",
        "absoluteStartMs": 126820
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 110836
      }
    ]
  },
  {
    "id": "email",
    "startMs": 133432,
    "sentences": [
      {
        "text": "Voici le message réellement reçu dans la boîte de démonstration.",
        "startMs": 869,
        "endMs": 3753,
        "method": "silence",
        "absoluteStartMs": 134301
      },
      {
        "text": "Il contient le créneau et le lien personnel.",
        "startMs": 4115,
        "endMs": 7004,
        "method": "silence",
        "absoluteStartMs": 137547
      },
      {
        "text": "Si tu ne le trouves pas, regarde les indésirables et vérifie l’adresse donnée.",
        "startMs": 7296,
        "endMs": 11182,
        "method": "silence",
        "absoluteStartMs": 140728
      },
      {
        "text": "Une page de succès ne prouve pas qu’un fournisseur email a accepté le message ;",
        "startMs": 11941,
        "endMs": 15977,
        "method": "silence",
        "absoluteStartMs": 145373
      },
      {
        "text": "contacte l’association si la boîte n’existe pas ou si tu as fait une faute.",
        "startMs": 16313,
        "endMs": 20227,
        "method": "silence",
        "absoluteStartMs": 149745
      }
    ],
    "inputs": []
  },
  {
    "id": "overlap",
    "startMs": 156619,
    "sentences": [
      {
        "text": "Le serveur revérifie aussi tes horaires.",
        "startMs": 686,
        "endMs": 3133,
        "method": "silence",
        "absoluteStartMs": 157305
      },
      {
        "text": "Aline est déjà inscrite à l'accueil de dix heures à midi.",
        "startMs": 3551,
        "endMs": 6558,
        "method": "silence",
        "absoluteStartMs": 160170
      },
      {
        "text": "Essayons le vestiaire de onze à treize heures avec sa même adresse.",
        "startMs": 7364,
        "endMs": 10518,
        "method": "silence",
        "absoluteStartMs": 163983
      },
      {
        "text": "Remplissons le formulaire et confirmons.",
        "startMs": 11258,
        "endMs": 12437,
        "method": "silence",
        "absoluteStartMs": 167877
      },
      {
        "text": "Le refus nomme le créneau qui chevauche cette demande.",
        "startMs": 12658,
        "endMs": 16914,
        "method": "silence",
        "absoluteStartMs": 169277
      },
      {
        "text": "Les informations restent remplies et aucune nouvelle inscription n'a été ajoutée.",
        "startMs": 17508,
        "endMs": 21221,
        "method": "silence",
        "absoluteStartMs": 174127
      },
      {
        "text": "Ce contrôle évite de compter une personne sur deux postes en même temps.",
        "startMs": 21873,
        "endMs": 24896,
        "method": "silence",
        "absoluteStartMs": 178492
      },
      {
        "text": "Pour continuer, reviens au planning et choisis un horaire compatible.",
        "startMs": 25546,
        "endMs": 29144,
        "method": "silence",
        "absoluteStartMs": 182165
      }
    ],
