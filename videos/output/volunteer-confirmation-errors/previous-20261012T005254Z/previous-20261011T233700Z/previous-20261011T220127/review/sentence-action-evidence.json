  {
    "id": "invitation-success",
    "startMs": 225568,
    "sentences": [
      {
        "text": "Comparons maintenant deux confirmations réussies.",
        "startMs": 442,
        "endMs": 2741,
        "method": "silence",
        "absoluteStartMs": 226010
      },
      {
        "text": "Zoé choisit le vestiaire dans le formulaire public ordinaire.",
        "startMs": 3468,
        "endMs": 6947,
        "method": "silence",
        "absoluteStartMs": 229036
      },
      {
        "text": "Après ses informations et les consentements, confirmons.",
        "startMs": 7191,
        "endMs": 12494,
        "method": "silence",
        "absoluteStartMs": 232759
      },
      {
        "text": "La page annonce le succès mais ne montre pas son lien personnel :",
        "startMs": 12749,
        "endMs": 16314,
        "method": "silence",
        "absoluteStartMs": 238317
      },
      {
        "text": "saisir une adresse ne prouve pas que l'on possède cette boîte.",
        "startMs": 16448,
        "endMs": 19139,
        "method": "silence",
        "absoluteStartMs": 242016
      },
      {
        "text": "Aline a ensuite reçu une invitation personnelle envoyée par l'organisation.",
        "startMs": 19504,
        "endMs": 24470,
        "method": "silence",
        "absoluteStartMs": 245072
      },
      {
        "text": "Ouvrons ce lien pour choisir la logistique.",
        "startMs": 24725,
        "endMs": 27704,
        "method": "silence",
        "absoluteStartMs": 250293
      },
      {
        "text": "Ses informations sont préremplies ;",
        "startMs": 27955,
        "endMs": 29694,
        "method": "silence",
        "absoluteStartMs": 253523
      },
      {
        "text": "vérifions-les, choisissons sa taille de t-shirt et confirmons les consentements.",
        "startMs": 30195,
        "endMs": 35203,
        "method": "silence",
        "absoluteStartMs": 255763
      },
      {
        "text": "Cette confirmation peut afficher Accéder à mon inscription, car l'invitation apporte la preuve d'adresse.",
        "startMs": 35668,
        "endMs": 42366,
        "method": "silence",
        "absoluteStartMs": 261236
      },
      {
        "text": "Ouvrons ce lien :",
        "startMs": 42873,
        "endMs": 43021,
        "method": "silence",
        "absoluteStartMs": 268441
      },
      {
        "text": "Aline retrouve ses deux créneaux.",
        "startMs": 43242,
        "endMs": 46040,
        "method": "silence",
        "absoluteStartMs": 268810
      },
      {
        "text": "Ce lien reste privé et permet aussi d'annuler ses inscriptions.",
        "startMs": 46563,
        "endMs": 49839,
        "method": "silence",
        "absoluteStartMs": 272131
      }
