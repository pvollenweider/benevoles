  {
    "id": "response-loss",
    "startMs": 188518,
    "sentences": [
      {
        "text": "Une coupure peut arriver après l'enregistrement.",
        "startMs": 491,
        "endMs": 2587,
        "method": "silence",
        "absoluteStartMs": 189009
      },
      {
        "text": "Nicolas choisit la logistique.",
        "startMs": 3128,
        "endMs": 5145,
        "method": "silence",
        "absoluteStartMs": 191646
      },
      {
        "text": "Cette fois, la requête arrive réellement au serveur, qui crée son inscription ;",
        "startMs": 5319,
        "endMs": 9413,
        "method": "silence",
        "absoluteStartMs": 193837
      },
      {
        "text": "nous interrompons volontairement seulement la réponse au navigateur.",
        "startMs": 9588,
        "endMs": 12887,
        "method": "silence",
        "absoluteStartMs": 198106
      },
      {
        "text": "Le formulaire affiche Connexion interrompue parce qu'il ne sait pas si l'envoi a abouti.",
        "startMs": 13444,
        "endMs": 17862,
        "method": "silence",
        "absoluteStartMs": 201962
      },
      {
        "text": "Rétablissons la connexion et confirmons à nouveau.",
        "startMs": 18422,
        "endMs": 21013,
        "method": "silence",
        "absoluteStartMs": 206940
      },
      {
        "text": "Le message indique qu'il est déjà inscrit et que son lien lui a été envoyé par email.",
        "startMs": 21910,
        "endMs": 26168,
        "method": "silence",
        "absoluteStartMs": 210428
      },
      {
        "text": "Vérifions côté organisation :",
        "startMs": 27142,
        "endMs": 28581,
        "method": "silence",
        "absoluteStartMs": 215660
      },
      {
        "text": "une seule ligne de Nicolas apparaît sur ce créneau.",
        "startMs": 29353,
        "endMs": 31604,
        "method": "silence",
        "absoluteStartMs": 217871
      },
      {
        "text": "Le nouvel essai n'a pas créé une deuxième inscription.",
        "startMs": 32244,
        "endMs": 34365,
        "method": "silence",
        "absoluteStartMs": 220762
      }
    ],
