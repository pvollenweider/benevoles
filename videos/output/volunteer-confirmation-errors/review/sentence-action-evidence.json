  {
    "chapter": "invitation-success",
    "startMs": 230808,
    "endMs": 276612,
    "sentences": [
      {
        "text": "Comparons maintenant deux confirmations réussies.",
        "startMs": 188,
        "endMs": 3037,
        "method": "silence",
        "absoluteStartMs": 230996
      },
      {
        "text": "Zoé choisit le vestiaire dans le formulaire public ordinaire.",
        "startMs": 3413,
        "endMs": 6211,
        "method": "silence",
        "absoluteStartMs": 234221
      },
      {
        "text": "Après ses informations et les consentements, confirmons.",
        "startMs": 6646,
        "endMs": 10509,
        "method": "silence",
        "absoluteStartMs": 237454
      },
      {
        "text": "La page annonce le succès mais ne montre pas son lien personnel :",
        "startMs": 10969,
        "endMs": 14615,
        "method": "silence",
        "absoluteStartMs": 241777
      },
      {
        "text": "saisir une adresse ne prouve pas que l'on possède cette boîte.",
        "startMs": 14858,
        "endMs": 18008,
        "method": "silence",
        "absoluteStartMs": 245666
      },
      {
        "text": "Aline a ensuite reçu une invitation personnelle envoyée par l'organisation.",
        "startMs": 18194,
        "endMs": 22094,
        "method": "silence",
        "absoluteStartMs": 249002
      },
      {
        "text": "Ouvrons ce lien pour choisir la logistique.",
        "startMs": 22452,
        "endMs": 24727,
        "method": "silence",
        "absoluteStartMs": 253260
      },
      {
        "text": "Ses informations sont préremplies ;",
