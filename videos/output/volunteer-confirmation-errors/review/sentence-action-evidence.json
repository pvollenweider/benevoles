  {
    "chapter": "capacity",
    "startMs": 65268,
    "endMs": 88553,
    "sentences": [
      {
        "text": "Une place peut être prise pendant que tu remplis le formulaire.",
        "startMs": 446,
        "endMs": 3566,
        "method": "silence",
        "absoluteStartMs": 65714
      },
      {
        "text": "Nous rendons ici le créneau complet par une modification réelle de sa capacité dans la démonstration.",
        "startMs": 3822,
        "endMs": 8754,
        "method": "silence",
        "absoluteStartMs": 69090
      },
      {
        "text": "La confirmation répond Ta sélection n'est plus disponible.",
        "startMs": 9424,
        "endMs": 12424,
        "method": "silence",
        "absoluteStartMs": 74692
      },
      {
        "text": "Reviens au planning pour ajuster ton choix ;",
        "startMs": 12857,
        "endMs": 14681,
        "method": "silence",
        "absoluteStartMs": 78125
      },
      {
        "text": "les informations saisies restent conservées.",
        "startMs": 15220,
        "endMs": 16960,
        "method": "silence",
        "absoluteStartMs": 80488
      },
      {
        "text": "Une place visible quelques minutes plus tôt n'est pas une réservation tant que l'inscription n'a pas été confirmée.",
        "startMs": 17265,
        "endMs": 22861,
        "method": "silence",
        "absoluteStartMs": 82533
      }
    ],
    "anchors": [
      {
        "segmentId": "capacity",
        "phrase": "La confirmation répond Ta sélection",
        "startMs": 9424,
        "endMs": 12424,
        "cueMs": 74695
      },
      {
        "segmentId": "capacity",
        "phrase": "Une place visible quelques minutes",
        "startMs": 17265,
        "endMs": 22861,
        "cueMs": 82535
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 75170
      }
    ]
  },
  {
    "chapter": "network",
    "startMs": 90815,
    "endMs": 109875,
    "sentences": [
      {
        "text": "Nous rétablissons maintenant la place, puis coupons volontairement la requête d’envoi pour montrer une interruption réseau.",
        "startMs": 421,
        "endMs": 5774,
        "method": "silence",
        "absoluteStartMs": 91236
      },
      {
        "text": "Le message dit que l’inscription n’a peut-être pas été reçue.",
        "startMs": 6585,
        "endMs": 9187,
        "method": "silence",
        "absoluteStartMs": 97400
      },
      {
        "text": "Tes champs sont toujours là.",
        "startMs": 9870,
        "endMs": 10916,
        "method": "silence",
        "absoluteStartMs": 100685
      },
      {
        "text": "Après retour de la connexion, clique à nouveau sur Confirmer mon inscription :",
        "startMs": 11663,
        "endMs": 15589,
        "method": "silence",
        "absoluteStartMs": 102478
      },
      {
        "text": "le système évite de créer deux engagements identiques.",
        "startMs": 16308,
        "endMs": 18650,
        "method": "silence",
        "absoluteStartMs": 107123
      }
    ],
    "anchors": [
      {
        "segmentId": "network",
        "phrase": "Après retour de la connexion,",
        "startMs": 11663,
        "endMs": 15589,
        "cueMs": 102480
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 91352
