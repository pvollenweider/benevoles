[
  {
    "chapter": "welcome",
    "startMs": 42,
    "endMs": 19515,
    "sentences": [
      {
        "text": "Une inscription doit rester compréhensible même quand quelque chose se passe mal.",
        "startMs": 294,
        "endMs": 4356,
        "method": "silence",
        "absoluteStartMs": 336
      },
      {
        "text": "Nous allons corriger une réponse manquante, voir une place devenue indisponible et simuler une coupure réseau.",
        "startMs": 5037,
        "endMs": 11655,
        "method": "silence",
        "absoluteStartMs": 5079
      },
      {
        "text": "Les exemples utilisent un événement de démonstration :",
        "startMs": 12390,
        "endMs": 14786,
        "method": "silence",
        "absoluteStartMs": 12432
      },
      {
        "text": "tu verras les vrais messages du formulaire, puis une confirmation réelle.",
        "startMs": 15307,
        "endMs": 18933,
        "method": "silence",
        "absoluteStartMs": 15349
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "form",
    "startMs": 21776,
    "endMs": 40968,
    "sentences": [
      {
        "text": "Choisis Accueil et continue.",
        "startMs": 540,
        "endMs": 2150,
        "method": "silence",
        "absoluteStartMs": 22316
      },
      {
        "text": "Nous remplissons le prénom, le nom, l’email et le téléphone, puis acceptons la convention et l’utilisation des données.",
        "startMs": 3062,
        "endMs": 10206,
        "method": "silence",
        "absoluteStartMs": 24838
      },
      {
        "text": "Avant d’envoyer, relis toujours l’adresse email :",
        "startMs": 11121,
        "endMs": 13738,
        "method": "silence",
        "absoluteStartMs": 32897
      },
      {
        "text": "une faute peut empêcher le message d’arriver même si l’inscription est enregistrée correctement.",
        "startMs": 14076,
        "endMs": 18641,
        "method": "silence",
        "absoluteStartMs": 35852
      }
    ],
