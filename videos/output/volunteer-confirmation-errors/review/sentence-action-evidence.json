      }
    ]
  },
  {
    "chapter": "success",
    "startMs": 112138,
    "endMs": 131656,
    "sentences": [
      {
        "text": "La connexion est rétablie et l’inscription réussit.",
        "startMs": 410,
        "endMs": 2819,
        "method": "silence",
        "absoluteStartMs": 112548
      },
      {
        "text": "La page confirme le résultat et indique l’envoi de l’email.",
        "startMs": 3506,
        "endMs": 6080,
        "method": "silence",
        "absoluteStartMs": 115644
      },
      {
        "text": "Avec un formulaire public ordinaire, le lien de gestion reste dans cet email :",
        "startMs": 6689,
        "endMs": 11316,
        "method": "silence",
        "absoluteStartMs": 118827
      },
      {
        "text": "il n’est pas affiché simplement parce qu’une adresse a été saisie.",
        "startMs": 11779,
        "endMs": 14734,
        "method": "silence",
        "absoluteStartMs": 123917
      },
      {
        "text": "Garde le message pour retrouver ton planning ou annuler plus tard.",
        "startMs": 15480,
        "endMs": 19293,
        "method": "silence",
        "absoluteStartMs": 127618
      }
    ],
    "anchors": [
      {
        "segmentId": "success",
        "phrase": "il n’est pas affiché simplement",
        "startMs": 11779,
        "endMs": 14734,
        "cueMs": 123917
      }
    ],
    "interactions": []
  },
  {
    "chapter": "email",
    "startMs": 133916,
    "endMs": 155283,
    "sentences": [
      {
        "text": "Voici le message réellement reçu dans la boîte de démonstration.",
        "startMs": 256,
        "endMs": 3307,
        "method": "silence",
        "absoluteStartMs": 134172
      },
      {
        "text": "Il contient le créneau et le lien personnel.",
        "startMs": 3885,
        "endMs": 6684,
        "method": "silence",
        "absoluteStartMs": 137801
      },
      {
        "text": "Si tu ne le trouves pas, regarde les indésirables et vérifie l’adresse donnée.",
        "startMs": 7338,
        "endMs": 11781,
        "method": "silence",
        "absoluteStartMs": 141254
      },
      {
        "text": "Une page de succès ne prouve pas qu’un fournisseur email a accepté le message ;",
        "startMs": 11905,
        "endMs": 16464,
        "method": "silence",
        "absoluteStartMs": 145821
      },
      {
        "text": "contacte l’association si la boîte n’existe pas ou si tu as fait une faute.",
        "startMs": 16861,
        "endMs": 21206,
        "method": "silence",
        "absoluteStartMs": 150777
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "overlap",
    "startMs": 157548,
    "endMs": 187926,
    "sentences": [
      {
        "text": "Le serveur revérifie aussi tes horaires.",
        "startMs": 336,
        "endMs": 2720,
        "method": "silence",
        "absoluteStartMs": 157884
      },
      {
        "text": "Aline est déjà inscrite à l'accueil de dix heures à midi.",
        "startMs": 3067,
        "endMs": 5896,
        "method": "silence",
        "absoluteStartMs": 160615
      },
      {
        "text": "Essayons le vestiaire de onze à treize heures avec sa même adresse.",
        "startMs": 6580,
        "endMs": 10095,
        "method": "silence",
        "absoluteStartMs": 164128
      },
      {
        "text": "Remplissons le formulaire et confirmons.",
        "startMs": 10509,
        "endMs": 12594,
        "method": "silence",
        "absoluteStartMs": 168057
      },
      {
        "text": "Le refus nomme le créneau qui chevauche cette demande.",
        "startMs": 13049,
        "endMs": 16812,
        "method": "silence",
        "absoluteStartMs": 170597
      },
      {
        "text": "Les informations restent remplies et aucune nouvelle inscription n'a été ajoutée.",
        "startMs": 17420,
        "endMs": 21454,
        "method": "silence",
        "absoluteStartMs": 174968
      },
      {
        "text": "Ce contrôle évite de compter une personne sur deux postes en même temps.",
        "startMs": 21791,
        "endMs": 25150,
        "method": "silence",
        "absoluteStartMs": 179339
      },
      {
        "text": "Pour continuer, reviens au planning et choisis un horaire compatible.",
        "startMs": 25579,
        "endMs": 29950,
        "method": "silence",
        "absoluteStartMs": 183127
      }
    ],
    "anchors": [
