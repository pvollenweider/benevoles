  {
    "chapter": "link",
    "startMs": 76766,
    "endMs": 98419,
    "sentences": [
      {
        "text": "Ouvrons l'email reçu dans la boîte de démonstration.",
        "startMs": 380,
        "endMs": 2818,
        "method": "silence",
        "absoluteStartMs": 77146
      },
      {
        "text": "Il propose à nouveau le lien d'invitation.",
        "startMs": 3356,
        "endMs": 5462,
        "method": "silence",
        "absoluteStartMs": 80122
      },
      {
        "text": "Ce lien est conservé :",
        "startMs": 6099,
        "endMs": 7116,
        "method": "silence",
        "absoluteStartMs": 82865
      },
      {
        "text": "la relance ne crée pas une deuxième invitation ni une inscription automatique.",
        "startMs": 7531,
        "endMs": 11718,
        "method": "silence",
        "absoluteStartMs": 84297
      },
      {
        "text": "Une personne en attente peut aussi être dans ce groupe si elle n'a aucun créneau confirmé.",
        "startMs": 12076,
        "endMs": 17211,
        "method": "silence",
        "absoluteStartMs": 88842
      },
      {
        "text": "C'est pourquoi il est important de comprendre les statuts avant d'envoyer.",
        "startMs": 17892,
        "endMs": 21229,
        "method": "silence",
        "absoluteStartMs": 94658
      }
    ],
    "anchors": [
      {
        "segmentId": "link",
        "phrase": "Ouvrons l'email reçu dans",
        "startMs": 380,
        "endMs": 2818,
        "cueMs": 77149
      }
    ],
    "interactions": []
  },
  {
    "chapter": "message",
    "startMs": 98872,
    "endMs": 121768,
    "sentences": [
      {
        "text": "Pour expliquer davantage, utilisez Écrire un message aux personnes sans créneau.",
        "startMs": 429,
        "endMs": 5006,
        "method": "silence",
        "absoluteStartMs": 99301
      },
      {
        "text": "Le groupe est déjà choisi dans la page de message.",
        "startMs": 5672,
        "endMs": 7851,
        "method": "silence",
        "absoluteStartMs": 104544
      },
      {
        "text": "Nous saisissons un objet clair et quelques mots bienveillants :",
        "startMs": 8616,
        "endMs": 11864,
        "method": "silence",
        "absoluteStartMs": 107488
      },
      {
        "text": "vous pouvez encore choisir un horaire si vous le souhaitez.",
        "startMs": 12436,
        "endMs": 14612,
        "method": "silence",
        "absoluteStartMs": 111308
      },
      {
        "text": "Avant d'envoyer, prévisualisez les destinataires et le contenu.",
        "startMs": 15341,
        "endMs": 18671,
        "method": "silence",
        "absoluteStartMs": 114213
      },
      {
        "text": "L'aperçu permet de vérifier à qui vous écrivez réellement.",
        "startMs": 19431,
        "endMs": 22535,
        "method": "silence",
        "absoluteStartMs": 118303
      }
    ],
    "anchors": [
      {
