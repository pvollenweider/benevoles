  {
    "chapter": "send",
    "startMs": 145196,
    "endMs": 166400,
    "sentences": [
      {
        "text": "Une fois le groupe et le texte vérifiés, confirme l'envoi.",
        "startMs": 324,
        "endMs": 4035,
        "method": "silence",
        "absoluteStartMs": 145520
      },
      {
        "text": "Nous ouvrons le vrai message reçu, puis l'historique disponible dans l'administration.",
        "startMs": 4822,
        "endMs": 10058,
        "method": "silence",
        "absoluteStartMs": 150018
      },
      {
        "text": "Un email remis au serveur n'est pas une preuve de lecture par la personne.",
        "startMs": 10722,
        "endMs": 14818,
        "method": "silence",
        "absoluteStartMs": 155918
      },
      {
        "text": "L'historique aide à savoir ce qui a été envoyé, sans transformer le suivi des bénévoles en surveillance.",
        "startMs": 15302,
        "endMs": 20940,
        "method": "silence",
        "absoluteStartMs": 160498
      }
    ],
    "anchors": [
      {
        "segmentId": "send",
        "phrase": "Une fois le groupe et",
        "startMs": 324,
        "endMs": 4035,
        "cueMs": 145522
      },
      {
        "segmentId": "send",
        "phrase": "Nous ouvrons le vrai message",
        "startMs": 4822,
        "endMs": 10058,
        "cueMs": 150020
      },
      {
        "segmentId": "send",
        "phrase": "Un email remis au serveur",
        "startMs": 10722,
        "endMs": 14818,
        "cueMs": 155919
      }
    ],
