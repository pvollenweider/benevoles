  {
    "chapter": "result",
    "startMs": 166853,
    "endMs": 187562,
    "sentences": [
      {
        "text": "De retour dans Invitations, les participations n'ont pas changé simplement parce qu'un message est parti.",
        "startMs": 269,
        "endMs": 6411,
        "method": "silence",
        "absoluteStartMs": 167122
      },
      {
        "text": "La prochaine étape appartient aux bénévoles.",
        "startMs": 6675,
        "endMs": 8830,
        "method": "silence",
        "absoluteStartMs": 173528
      },
      {
        "text": "Une relance courte, au bon moment, avec un lien facile à retrouver :",
        "startMs": 9243,
        "endMs": 9492,
        "method": "silence",
        "absoluteStartMs": 176096
      },
      {
        "text": "c'est souvent suffisant.",
        "startMs": 9693,
        "endMs": 14353,
        "method": "silence",
        "absoluteStartMs": 176546
      },
      {
        "text": "Et si vous savez qu'une personne ne peut pas venir, respectez sa réponse plutôt que de multiplier les messages.",
        "startMs": 14968,
        "endMs": 20432,
        "method": "silence",
        "absoluteStartMs": 181821
      }
    ],
    "anchors": [],
    "interactions": []
  }
]