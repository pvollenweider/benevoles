  {
    "chapter": "link",
    "startMs": 76770,
    "endMs": 98423,
    "sentences": [
      {
        "text": "Ouvrons l'email reçu dans la boîte de démonstration.",
        "startMs": 380,
        "endMs": 2818,
        "method": "silence",
        "absoluteStartMs": 77150
      },
      {
        "text": "Il propose à nouveau le lien d'invitation.",
        "startMs": 3356,
        "endMs": 5462,
        "method": "silence",
        "absoluteStartMs": 80126
      },
      {
        "text": "Ce lien est conservé :",
        "startMs": 6099,
        "endMs": 7116,
        "method": "silence",
        "absoluteStartMs": 82869
      },
      {
        "text": "la relance ne crée pas une deuxième invitation ni une inscription automatique.",
        "startMs": 7531,
        "endMs": 11718,
        "method": "silence",
        "absoluteStartMs": 84301
      },
      {
        "text": "Une personne en attente peut aussi être dans ce groupe si elle n'a aucun créneau confirmé.",
        "startMs": 12076,
        "endMs": 17211,
        "method": "silence",
        "absoluteStartMs": 88846
      },
      {
        "text": "C'est pourquoi il est important de comprendre les statuts avant d'envoyer.",
        "startMs": 17892,
        "endMs": 21229,
        "method": "silence",
        "absoluteStartMs": 94662
      }
    ],
    "anchors": [
      {
        "segmentId": "link",
        "phrase": "Il propose à nouveau le",
        "startMs": 3356,
        "endMs": 5462,
        "cueMs": 80128
      }
    ],
    "interactions": []
  },
  {
    "chapter": "message",
    "startMs": 98876,
    "endMs": 121773,
    "sentences": [
      {
        "text": "Pour expliquer davantage, utilisez Écrire un message aux personnes sans créneau.",
        "startMs": 429,
        "endMs": 5006,
        "method": "silence",
        "absoluteStartMs": 99305
      },
      {
        "text": "Le groupe est déjà choisi dans la page de message.",
        "startMs": 5672,
        "endMs": 7851,
        "method": "silence",
        "absoluteStartMs": 104548
      },
      {
        "text": "Nous saisissons un objet clair et quelques mots bienveillants :",
        "startMs": 8616,
        "endMs": 11864,
        "method": "silence",
        "absoluteStartMs": 107492
      },
      {
        "text": "vous pouvez encore choisir un horaire si vous le souhaitez.",
        "startMs": 12436,
        "endMs": 14612,
        "method": "silence",
        "absoluteStartMs": 111312
      },
      {
        "text": "Avant d'envoyer, prévisualisez les destinataires et le contenu.",
        "startMs": 15341,
        "endMs": 18671,
        "method": "silence",
        "absoluteStartMs": 114217
      },
      {
        "text": "L'aperçu permet de vérifier à qui vous écrivez réellement.",
        "startMs": 19431,
        "endMs": 22535,
        "method": "silence",
        "absoluteStartMs": 118307
      }
    ],
    "anchors": [
