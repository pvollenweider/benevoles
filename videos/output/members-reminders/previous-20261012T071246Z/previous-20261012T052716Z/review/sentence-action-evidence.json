    "startMs": 145204,
    "endMs": 166407,
    "sentences": [
      {
        "text": "Une fois le groupe et le texte vérifiés, confirme l'envoi.",
        "startMs": 324,
        "endMs": 4035,
        "method": "silence",
        "absoluteStartMs": 145528
      },
      {
        "text": "Nous ouvrons le vrai message reçu, puis l'historique disponible dans l'administration.",
        "startMs": 4822,
        "endMs": 10058,
        "method": "silence",
        "absoluteStartMs": 150026
      },
      {
        "text": "Un email remis au serveur n'est pas une preuve de lecture par la personne.",
        "startMs": 10722,
        "endMs": 14818,
        "method": "silence",
        "absoluteStartMs": 155926
      },
      {
        "text": "L'historique aide à savoir ce qui a été envoyé, sans transformer le suivi des bénévoles en surveillance.",
        "startMs": 15302,
