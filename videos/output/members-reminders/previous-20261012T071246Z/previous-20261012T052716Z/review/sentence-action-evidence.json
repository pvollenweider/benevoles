[
  {
    "chapter": "welcome",
    "startMs": 181,
    "endMs": 24018,
    "sentences": [
      {
        "text": "Quelques membres ont été invités, mais n'ont pas encore de créneau confirmé.",
        "startMs": 258,
        "endMs": 4517,
        "method": "silence",
        "absoluteStartMs": 439
      },
      {
        "text": "Une relance peut les aider à retrouver leur lien, sans leur mettre la pression.",
        "startMs": 4984,
        "endMs": 9593,
        "method": "silence",
        "absoluteStartMs": 5165
      },
      {
        "text": "Dans Invitations, regarde d'abord la date d'envoi et les statuts.",
        "startMs": 10383,
        "endMs": 13669,
        "method": "silence",
        "absoluteStartMs": 10564
      },
      {
        "text": "Une ancienne invitation ne prouve pas que la personne a oublié de répondre.",
        "startMs": 13895,
        "endMs": 19114,
        "method": "silence",
        "absoluteStartMs": 14076
      },
      {
        "text": "Peut-être attend-elle simplement de connaître ses disponibilités.",
        "startMs": 19446,
        "endMs": 23458,
        "method": "silence",
        "absoluteStartMs": 19627
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "statuses",
    "startMs": 24471,
    "endMs": 50562,
    "sentences": [
      {
        "text": "Sans créneau confirmé ne signifie pas forcément aucune démarche.",
        "startMs": 383,
        "endMs": 4785,
        "method": "silence",
        "absoluteStartMs": 24854
      },
      {
        "text": "Dans les inscriptions, une personne peut être en liste d'attente, recevoir une offre ou attendre la validation de l'organisateur.",
        "startMs": 5388,
        "endMs": 12643,
        "method": "silence",
        "absoluteStartMs": 29859
      },
      {
        "text": "Une autre a déjà une participation confirmée.",
        "startMs": 13085,
        "endMs": 16010,
        "method": "silence",
        "absoluteStartMs": 37556
      },
      {
        "text": "Vérifiez ces situations avant de relancer.",
        "startMs": 16627,
        "endMs": 18159,
        "method": "silence",
        "absoluteStartMs": 41098
      },
      {
        "text": "Un message adapté sera plus utile qu'une demande générale de s'inscrire adressée à quelqu'un qui l'a déjà fait.",
        "startMs": 18309,
        "endMs": 25680,
        "method": "silence",
        "absoluteStartMs": 42780
      }
    ],
    "anchors": [
      {
        "segmentId": "statuses",
        "phrase": "Une autre a déjà une",
        "startMs": 13085,
        "endMs": 16010,
        "cueMs": 37558
      },
      {
        "segmentId": "statuses",
        "phrase": "Une autre a déjà une",
        "startMs": 13085,
        "endMs": 16010,
        "cueMs": 39240
