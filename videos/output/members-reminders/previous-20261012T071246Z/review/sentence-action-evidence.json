  {
    "chapter": "link",
    "startMs": 76754,
    "endMs": 98407,
    "sentences": [
      {
        "text": "Ouvrons l'email reçu dans la boîte de démonstration.",
        "startMs": 380,
        "endMs": 2818,
        "method": "silence",
        "absoluteStartMs": 77134
      },
      {
        "text": "Il propose à nouveau le lien d'invitation.",
        "startMs": 3356,
        "endMs": 5462,
        "method": "silence",
        "absoluteStartMs": 80110
      },
      {
        "text": "Ce lien est conservé :",
        "startMs": 6099,
        "endMs": 7116,
        "method": "silence",
        "absoluteStartMs": 82853
      },
      {
        "text": "la relance ne crée pas une deuxième invitation ni une inscription automatique.",
        "startMs": 7531,
        "endMs": 11718,
        "method": "silence",
        "absoluteStartMs": 84285
      },
      {
        "text": "Une personne en attente peut aussi être dans ce groupe si elle n'a aucun créneau confirmé.",
        "startMs": 12076,
        "endMs": 17211,
        "method": "silence",
        "absoluteStartMs": 88830
      },
      {
        "text": "C'est pourquoi il est important de comprendre les statuts avant d'envoyer.",
        "startMs": 17892,
        "endMs": 21229,
        "method": "silence",
        "absoluteStartMs": 94646
      }
    ],
    "anchors": [
      {
        "segmentId": "link",
        "phrase": "Ouvrons l'email reçu dans",
        "startMs": 380,
        "endMs": 2818,
        "cueMs": 77136
      }
    ],
    "interactions": []
  },
  {
    "chapter": "message",
    "startMs": 98861,
    "endMs": 121756,
    "sentences": [
      {
        "text": "Pour expliquer davantage, utilisez Écrire un message aux personnes sans créneau.",
        "startMs": 429,
        "endMs": 5006,
        "method": "silence",
        "absoluteStartMs": 99290
      },
      {
        "text": "Le groupe est déjà choisi dans la page de message.",
        "startMs": 5672,
        "endMs": 7851,
        "method": "silence",
        "absoluteStartMs": 104533
      },
      {
        "text": "Nous saisissons un objet clair et quelques mots bienveillants :",
        "startMs": 8616,
        "endMs": 11864,
        "method": "silence",
        "absoluteStartMs": 107477
      },
      {
        "text": "vous pouvez encore choisir un horaire si vous le souhaitez.",
        "startMs": 12436,
        "endMs": 14612,
        "method": "silence",
        "absoluteStartMs": 111297
      },
      {
        "text": "Avant d'envoyer, prévisualisez les destinataires et le contenu.",
        "startMs": 15341,
        "endMs": 18671,
        "method": "silence",
        "absoluteStartMs": 114202
      },
      {
        "text": "L'aperçu permet de vérifier à qui vous écrivez réellement.",
        "startMs": 19431,
        "endMs": 22535,
        "method": "silence",
        "absoluteStartMs": 118292
      }
    ],
    "anchors": [
      {
        "segmentId": "message",
        "phrase": "Avant d'envoyer, prévisualisez",
        "startMs": 15341,
        "endMs": 18671,
        "cueMs": 114204
      }
    ],
