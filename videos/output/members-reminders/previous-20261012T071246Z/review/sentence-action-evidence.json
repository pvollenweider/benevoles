  {
    "chapter": "send",
    "startMs": 145185,
    "endMs": 166389,
    "sentences": [
      {
        "text": "Une fois le groupe et le texte vérifiés, confirme l'envoi.",
        "startMs": 324,
        "endMs": 4035,
        "method": "silence",
        "absoluteStartMs": 145509
      },
      {
        "text": "Nous ouvrons le vrai message reçu, puis l'historique disponible dans l'administration.",
        "startMs": 4822,
        "endMs": 10058,
        "method": "silence",
        "absoluteStartMs": 150007
      },
      {
        "text": "Un email remis au serveur n'est pas une preuve de lecture par la personne.",
        "startMs": 10722,
        "endMs": 14818,
        "method": "silence",
        "absoluteStartMs": 155907
      },
      {
        "text": "L'historique aide à savoir ce qui a été envoyé, sans transformer le suivi des bénévoles en surveillance.",
        "startMs": 15302,
        "endMs": 20940,
        "method": "silence",
        "absoluteStartMs": 160487
      }
    ],
    "anchors": [
      {
        "segmentId": "send",
        "phrase": "Une fois le groupe et",
        "startMs": 324,
        "endMs": 4035,
        "cueMs": 145510
      },
      {
        "segmentId": "send",
        "phrase": "L'historique aide à savoir ce",
        "startMs": 15302,
        "endMs": 20940,
        "cueMs": 160488
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 145974
      },
      {
        "kind": "click",
        "atMs": 146758
      }
    ]
  },
  {
    "chapter": "result",
    "startMs": 166841,
    "endMs": 187552,
    "sentences": [
      {
        "text": "De retour dans Invitations, les participations n'ont pas changé simplement parce qu'un message est parti.",
        "startMs": 269,
        "endMs": 6411,
        "method": "silence",
        "absoluteStartMs": 167110
      },
      {
        "text": "La prochaine étape appartient aux bénévoles.",
        "startMs": 6675,
        "endMs": 8830,
        "method": "silence",
        "absoluteStartMs": 173516
      },
      {
        "text": "Une relance courte, au bon moment, avec un lien facile à retrouver :",
        "startMs": 9243,
        "endMs": 9492,
        "method": "silence",
        "absoluteStartMs": 176084
      },
      {
        "text": "c'est souvent suffisant.",
        "startMs": 9693,
        "endMs": 14353,
        "method": "silence",
        "absoluteStartMs": 176534
      },
      {
        "text": "Et si vous savez qu'une personne ne peut pas venir, respectez sa réponse plutôt que de multiplier les messages.",
        "startMs": 14968,
        "endMs": 20432,
        "method": "silence",
        "absoluteStartMs": 181809
      }
    ],
    "anchors": [],
    "interactions": []
  }
]