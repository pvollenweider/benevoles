  {
    "chapter": "waitlist",
    "startMs": 122209,
    "endMs": 144731,
    "sentences": [
      {
        "text": "Dans cet aperçu, regardez aussi les personnes qui sont seulement en liste d'attente.",
        "startMs": 369,
        "endMs": 5042,
        "method": "silence",
        "absoluteStartMs": 122578
      },
      {
        "text": "Leur situation mérite une formulation différente.",
        "startMs": 5325,
        "endMs": 7801,
        "method": "silence",
        "absoluteStartMs": 127534
      },
      {
        "text": "Vous pouvez rappeler qu'elles n'ont pas à refaire leur demande et qu'une place leur sera proposée selon le fonctionnement de la liste d'attente.",
        "startMs": 8518,
        "endMs": 15998,
        "method": "silence",
        "absoluteStartMs": 130727
      },
      {
        "text": "La relance simple, elle, n'attend pas automatiquement trois jours :",
        "startMs": 16496,
        "endMs": 20073,
        "method": "silence",
        "absoluteStartMs": 138705
      },
      {
        "text": "c'est vous qui choisissez le bon moment.",
        "startMs": 20463,
        "endMs": 22197,
        "method": "silence",
        "absoluteStartMs": 142672
      }
    ],
    "anchors": [
      {
        "segmentId": "waitlist",
        "phrase": "Vous pouvez rappeler qu'elles n'ont",
        "startMs": 8518,
