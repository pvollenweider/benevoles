      }
    ]
  },
  {
    "chapter": "confirm",
    "startMs": 51001,
    "endMs": 76301,
    "sentences": [
      {
        "text": "Le bouton Relancer les personnes sans créneau ouvre un récapitulatif.",
        "startMs": 414,
        "endMs": 4913,
        "method": "silence",
        "absoluteStartMs": 51415
      },
      {
        "text": "Vous pouvez encore annuler.",
        "startMs": 5473,
        "endMs": 6486,
        "method": "silence",
        "absoluteStartMs": 56474
      },
      {
        "text": "Pour cette démonstration, nous confirmons l'envoi réel.",
        "startMs": 7204,
        "endMs": 10245,
        "method": "silence",
        "absoluteStartMs": 58205
      },
      {
        "text": "Les membres déjà inscrits ne sont pas relancés.",
        "startMs": 10941,
        "endMs": 13250,
        "method": "silence",
        "absoluteStartMs": 61942
      },
      {
        "text": "Les fiches inactives et celles sans email ne reçoivent pas ce message non plus.",
        "startMs": 13612,
        "endMs": 17660,
        "method": "silence",
        "absoluteStartMs": 64613
      },
      {
        "text": "Le résultat indique le nombre effectivement envoyé :",
        "startMs": 18239,
        "endMs": 21365,
        "method": "silence",
        "absoluteStartMs": 69240
      },
      {
        "text": "lisez-le, plutôt que de vous fier seulement au compteur initial.",
        "startMs": 21905,
        "endMs": 24924,
        "method": "silence",
        "absoluteStartMs": 72906
      }
    ],
    "anchors": [
      {
        "segmentId": "confirm",
        "phrase": "Vous pouvez encore annuler.",
        "startMs": 5473,
        "endMs": 6486,
        "cueMs": 56476
      },
      {
        "segmentId": "confirm",
        "phrase": "Pour cette démonstration, nous confirmons",
        "startMs": 7204,
        "endMs": 10245,
        "cueMs": 58209
      },
      {
        "segmentId": "confirm",
        "phrase": "Pour cette démonstration, nous confirmons",
        "startMs": 7204,
        "endMs": 10245,
        "cueMs": 58980
      }
    ],
