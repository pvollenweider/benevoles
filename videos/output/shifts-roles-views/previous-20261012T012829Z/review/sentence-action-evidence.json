[
  {
    "chapter": "welcome",
    "startMs": 1108,
    "endMs": 15362,
    "sentences": [
      {
        "text": "Un poste décrit une mission, par exemple Accueil ou Buvette.",
        "startMs": 230,
        "endMs": 3988,
        "method": "silence",
        "absoluteStartMs": 1338
      },
      {
        "text": "Un créneau est une plage précise de ce poste, avec une date, des heures et un nombre de places.",
        "startMs": 4183,
        "endMs": 9628,
        "method": "silence",
        "absoluteStartMs": 5291
      },
      {
        "text": "Le même poste peut donc contenir plusieurs créneaux, sur un ou plusieurs jours.",
        "startMs": 9795,
        "endMs": 14037,
        "method": "silence",
        "absoluteStartMs": 10903
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "timeline",
    "startMs": 15816,
    "endMs": 30384,
    "sentences": [
      {
        "text": "La vue Frise répond d’abord à une question visuelle :",
        "startMs": 219,
        "endMs": 2860,
        "method": "silence",
        "absoluteStartMs": 16035
      },
      {
        "text": "quelles missions faut-il assurer, et quand ?",
        "startMs": 3222,
        "endMs": 5088,
        "method": "silence",
        "absoluteStartMs": 19038
      },
      {
        "text": "Les barres montrent les horaires des créneaux.",
        "startMs": 5485,
        "endMs": 7403,
        "method": "silence",
        "absoluteStartMs": 21301
      },
      {
        "text": "Leur longueur permet de repérer les chevauchements, les trous et les périodes chargées.",
        "startMs": 7732,
        "endMs": 11839,
        "method": "silence",
        "absoluteStartMs": 23548
      },
      {
        "text": "Une couleur peut aider à reconnaître un poste.",
        "startMs": 12233,
        "endMs": 14352,
        "method": "silence",
        "absoluteStartMs": 28049
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "list",
    "startMs": 30837,
    "endMs": 42439,
    "sentences": [
      {
        "text": "La vue Liste présente les mêmes données sous une forme plus compacte.",
        "startMs": 215,
        "endMs": 3678,
        "method": "silence",
        "absoluteStartMs": 31052
      },
      {
        "text": "Elle est pratique pour relire les libellés, les capacités et les statuts, ou pour parcourir rapidement un grand nombre de créneaux sans suivre l’axe horaire.",
        "startMs": 3808,
        "endMs": 11379,
        "method": "silence",
        "absoluteStartMs": 34645
      }
    ],
