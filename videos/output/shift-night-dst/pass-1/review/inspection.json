  "chapters": [
    {
      "id": "welcome",
      "startMs": 1186,
      "endMs": 15328,
      "sentences": [
        {
          "text": "Les événements du soir posent deux questions différentes :",
          "startMs": 220,
          "endMs": 2635,
          "method": "silence",
          "absoluteStartS": 1.406,
          "absoluteEndS": 3.821
        },
        {
          "text": "comment afficher une fin après minuit, et combien d’heures se sont réellement écoulées quand l’horloge change.",
          "startMs": 3064,
          "endMs": 7930,
          "method": "silence",
          "absoluteStartS": 4.25,
          "absoluteEndS": 9.116
        },
        {
          "text": "Benevol conserve l’horaire local de l’événement et calcule les instants dans le fuseau de l’organisation.",
          "startMs": 8889,
          "endMs": 13684,
          "method": "silence",
          "absoluteStartS": 10.075,
          "absoluteEndS": 14.87
        }
      ],
      "markers": []
    },
    {
      "id": "ordinary",
      "startMs": 15779,
      "endMs": 33774,
      "sentences": [
        {
          "text": "Une nuit ordinaire de vingt-deux heures à deux heures appartient au jour où le créneau commence.",
          "startMs": 468,
          "endMs": 4174,
          "method": "silence",
          "absoluteStartS": 16.247,
          "absoluteEndS": 19.953
        },
        {
          "text": "La Frise continue après minuit, mais les heures affichées repartent bien de zéro :",
          "startMs": 4810,
          "endMs": 9372,
          "method": "silence",
          "absoluteStartS": 20.589,
          "absoluteEndS": 25.151
        },
        {
          "text": "minuit, une heure, deux heures.",
          "startMs": 9687,
          "endMs": 10771,
          "method": "silence",
          "absoluteStartS": 25.466,
          "absoluteEndS": 26.55
        },
        {
          "text": "Ouvrons maintenant le créneau.",
          "startMs": 11612,
          "endMs": 12582,
          "method": "silence",
          "absoluteStartS": 27.391,
          "absoluteEndS": 28.361
        },
        {
          "text": "Son récapitulatif précise que la fin se situe le lendemain :",
          "startMs": 13075,
          "endMs": 15951,
          "method": "silence",
          "absoluteStartS": 28.854,
          "absoluteEndS": 31.73
        },
