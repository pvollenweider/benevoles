    {
      "id": "ordinary",
      "startMs": 15803,
      "endMs": 36180,
      "sentences": [
        {
          "text": "Une nuit ordinaire de vingt-deux heures à deux heures appartient au jour où le créneau commence.",
          "startMs": 536,
          "endMs": 6136,
          "method": "silence",
          "absoluteStartS": 16.339,
          "absoluteEndS": 21.939
        },
        {
          "text": "La Frise continue après minuit, mais les heures affichées repartent bien de zéro :",
          "startMs": 6266,
          "endMs": 10185,
          "method": "silence",
          "absoluteStartS": 22.069,
          "absoluteEndS": 25.988
        },
        {
          "text": "minuit, une heure, deux heures.",
          "startMs": 10539,
          "endMs": 11321,
          "method": "silence",
          "absoluteStartS": 26.342,
          "absoluteEndS": 27.124
        },
        {
          "text": "Ouvrons maintenant le créneau.",
          "startMs": 11974,
          "endMs": 12854,
          "method": "silence",
          "absoluteStartS": 27.777,
          "absoluteEndS": 28.657
        },
        {
          "text": "Les heures affichées vont de vingt-deux heures à deux heures :",
          "startMs": 13578,
          "endMs": 16037,
          "method": "silence",
          "absoluteStartS": 29.381,
          "absoluteEndS": 31.84
        },
        {
          "text": "la fin se situe donc le lendemain.",
          "startMs": 16606,
          "endMs": 17864,
          "method": "silence",
          "absoluteStartS": 32.409,
          "absoluteEndS": 33.667
        },
        {
          "text": "Vérifions bien cet horaire.",
          "startMs": 18631,
          "endMs": 19727,
          "method": "silence",
          "absoluteStartS": 34.434,
          "absoluteEndS": 35.53
        }
      ],
