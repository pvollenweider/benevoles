        {
          "kind": "click",
          "atMs": 42412
        }
      ]
    },
    {
      "id": "autumn",
      "startMs": 51684,
      "endMs": 65751,
      "sentences": [
        {
          "text": "Le dernier dimanche d’octobre, l’heure entre deux et trois se répète.",
          "startMs": 639,
          "endMs": 4100,
          "method": "silence",
          "absoluteStartS": 52.323,
          "absoluteEndS": 55.784
        },
        {
          "text": "Le même créneau de une heure à cinq heures dure alors cinq heures réelles.",
          "startMs": 4767,
          "endMs": 7469,
          "method": "silence",
          "absoluteStartS": 56.451,
          "absoluteEndS": 59.153
        },
        {
          "text": "Cette différence compte pour les heures planifiées et évite de sous-estimer l’engagement d’une personne présente toute la nuit.",
          "startMs": 8272,
          "endMs": 13441,
