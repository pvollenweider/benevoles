          "atMs": 28246
        }
      ]
    },
    {
      "id": "spring",
      "startMs": 36633,
      "endMs": 51232,
      "sentences": [
        {
          "text": "Le dernier dimanche de mars, la Suisse passe directement de deux heures à trois heures.",
          "startMs": 656,
          "endMs": 4604,
          "method": "silence",
          "absoluteStartS": 37.289,
          "absoluteEndS": 41.237
        },
        {
          "text": "Un créneau affiché de une heure à cinq heures ne dure donc que trois heures réelles.",
          "startMs": 5305,
          "endMs": 8322,
          "method": "silence",
          "absoluteStartS": 41.938,
          "absoluteEndS": 44.955
        },
        {
          "text": "Les emails et calendriers gardent les heures locales, tandis que les totaux utilisent la durée réellement écoulée.",
          "startMs": 9182,
          "endMs": 13964,
          "method": "silence",
          "absoluteStartS": 45.815,
          "absoluteEndS": 50.597
        }
      ],
