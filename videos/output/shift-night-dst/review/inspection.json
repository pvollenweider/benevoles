    {
      "id": "spring",
      "startMs": 36599,
      "endMs": 51201,
      "sentences": [
        {
          "text": "Le dernier dimanche de mars, la Suisse passe directement de deux heures à trois heures.",
          "startMs": 656,
          "endMs": 4604,
          "method": "silence",
          "absoluteStartS": 37.255,
          "absoluteEndS": 41.203
        },
        {
          "text": "Un créneau affiché de une heure à cinq heures ne dure donc que trois heures réelles.",
