    {
      "id": "autumn",
      "startMs": 51695,
      "endMs": 65753,
      "sentences": [
        {
          "text": "Le dernier dimanche d’octobre, l’heure entre deux et trois se répète.",
          "startMs": 639,
          "endMs": 4100,
          "method": "silence",
          "absoluteStartS": 52.334,
          "absoluteEndS": 55.795
        },
        {
          "text": "Le même créneau de une heure à cinq heures dure alors cinq heures réelles.",
