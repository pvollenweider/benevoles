    {
      "scene": "manual-send",
      "startMs": 52087,
      "endMs": 76478,
      "sentences": [
        {
          "text": "Depuis la page de l'événement, Envoyer le rappel demande une confirmation.",
          "startMs": 346,
          "endMs": 4512,
          "method": "silence",
          "globalStartMs": 52433,
          "globalEndMs": 56599
        },
        {
          "text": "Nous annulons une première fois, puis reprenons et confirmons le véritable envoi.",
          "startMs": 5267,
          "endMs": 7539,
          "method": "silence",
          "globalStartMs": 57354,
          "globalEndMs": 59626
        },
        {
          "text": "Ouvrons l'email de Léa :",
          "startMs": 7801,
          "endMs": 9324,
          "method": "silence",
          "globalStartMs": 59888,
          "globalEndMs": 61411
        },
        {
          "text": "ses deux créneaux sont regroupés dans un seul message, avec notre consigne.",
          "startMs": 9939,
          "endMs": 15030,
          "method": "silence",
          "globalStartMs": 62026,
          "globalEndMs": 67117
        },
        {
          "text": "Les personnes qui ont seulement une demande ou une attente ne reçoivent pas ce rappel des inscriptions confirmées.",
          "startMs": 15541,
          "endMs": 20357,
          "method": "silence",
          "globalStartMs": 67628,
          "globalEndMs": 72444
        },
        {
          "text": "Regardez le résultat de l'envoi, pas seulement le nombre affiché avant.",
          "startMs": 20839,
          "endMs": 24037,
          "method": "silence",
          "globalStartMs": 72926,
          "globalEndMs": 76124
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 53890
        },
        {
          "kind": "click",
          "atMs": 56241
        },
        {
          "kind": "click",
          "atMs": 58674
        },
        {
          "kind": "click",
          "atMs": 60406
        }
      ]
    },
    {
      "scene": "organization",
      "startMs": 78772,
      "endMs": 102210,
      "sentences": [
        {
          "text": "Dans Paramètres, puis Emails, vous choisissez les rappels automatiques de toute l'organisation :",
          "startMs": 349,
          "endMs": 5288,
          "method": "silence",
          "globalStartMs": 79121,
          "globalEndMs": 84060
        },
        {
          "text": "J moins deux, J moins un et le rappel du jour.",
          "startMs": 5793,
          "endMs": 7394,
          "method": "silence",
          "globalStartMs": 84565,
          "globalEndMs": 86166
        },
        {
          "text": "Une case décochée ne suffit pas :",
          "startMs": 7831,
          "endMs": 8666,
          "method": "silence",
          "globalStartMs": 86603,
          "globalEndMs": 87438
        },
        {
          "text": "il faut enregistrer le changement.",
          "startMs": 9173,
          "endMs": 12244,
          "method": "silence",
          "globalStartMs": 87945,
          "globalEndMs": 91016
        },
        {
          "text": "Nous coupons celui de la veille, enregistrons, puis le réactivons.",
          "startMs": 12818,
          "endMs": 15328,
          "method": "silence",
          "globalStartMs": 91590,
          "globalEndMs": 94100
        },
        {
          "text": "Vous trouvez aussi l'adresse de réponse :",
          "startMs": 15754,
          "endMs": 16748,
          "method": "silence",
          "globalStartMs": 94526,
          "globalEndMs": 95520
        },
        {
          "text": "c'est là que les réponses des bénévoles arrivent, pas une adresse différente pour chaque rappel.",
          "startMs": 17264,
          "endMs": 23145,
          "method": "silence",
          "globalStartMs": 96036,
          "globalEndMs": 101917
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 90533
        },
        {
          "kind": "click",
          "atMs": 91341
        },
        {
          "kind": "click",
          "atMs": 95206
        },
        {
          "kind": "click",
          "atMs": 96010
        }
      ]
    },
    {
      "scene": "event-switch",
      "startMs": 104477,
      "endMs": 130286,
      "sentences": [
        {
          "text": "Les trois cases que nous venons de voir concernent toute l'organisation.",
          "startMs": 205,
          "endMs": 3584,
          "method": "silence",
          "globalStartMs": 104682,
          "globalEndMs": 108061
        },
        {
          "text": "Dans le formulaire de l'événement, vous pouvez aussi couper seulement ses rappels automatiques.",
          "startMs": 3907,
          "endMs": 9176,
          "method": "silence",
          "globalStartMs": 108384,
          "globalEndMs": 113653
        },
        {
          "text": "Décochons Rappels automatiques et attendons l'enregistrement.",
          "startMs": 9313,
          "endMs": 12120,
          "method": "silence",
          "globalStartMs": 113790,
          "globalEndMs": 116597
        },
        {
          "text": "Réactivons-les pour poursuivre notre exemple.",
          "startMs": 12922,
          "endMs": 15309,
          "method": "silence",
          "globalStartMs": 117399,
          "globalEndMs": 119786
        },
        {
          "text": "Ce réglage ne change pas le rappel manuel.",
          "startMs": 15607,
          "endMs": 17504,
          "method": "silence",
          "globalStartMs": 120084,
          "globalEndMs": 121981
        },
        {
          "text": "Regardons maintenant notre événement en brouillon.",
          "startMs": 18273,
          "endMs": 20656,
          "method": "silence",
          "globalStartMs": 122750,
          "globalEndMs": 125133
        },
        {
          "text": "Il ne reçoit pas les rappels automatiques réservés aux événements publiés.",
          "startMs": 21261,
          "endMs": 25808,
          "method": "silence",
          "globalStartMs": 125738,
          "globalEndMs": 130285
        }
      ],
      "anchors": [
        {
          "segmentId": "event-switch",
          "phrase": "Décochons Rappels automatiques",
          "startMs": 9313,
          "endMs": 12120,
          "cueMs": 113791
        },
        {
          "segmentId": "event-switch",
          "phrase": "Réactivons-les",
          "startMs": 12922,
          "endMs": 15309,
          "cueMs": 117401
        },
        {
          "segmentId": "event-switch",
          "phrase": "Regardons maintenant notre événement en brouillon",
          "startMs": 18273,
          "endMs": 20656,
          "cueMs": 122751
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 114278
        },
        {
          "kind": "click",
          "atMs": 117892
        }
      ]
    },
    {
      "scene": "timing",
      "startMs": 132552,
      "endMs": 156166,
      "sentences": [
        {
          "text": "Les rappels partent autour de deux jours avant, autour de la veille, puis entre deux et quatre heures avant le début du créneau.",
          "startMs": 188,
          "endMs": 7086,
          "method": "silence",
          "globalStartMs": 132740,
          "globalEndMs": 139638
        },
        {
          "text": "Ce n'est pas une promesse d'envoi à une minute fixe.",
          "startMs": 7617,
          "endMs": 9956,
          "method": "silence",
          "globalStartMs": 140169,
          "globalEndMs": 142508
        },
        {
          "text": "Les heures sont lues dans le fuseau de l'organisation, Europe Zurich ici.",
          "startMs": 10328,
          "endMs": 14159,
          "method": "silence",
          "globalStartMs": 142880,
          "globalEndMs": 146711
        },
        {
          "text": "Voici les trois emails réellement reçus pour nos trois échéances :",
          "startMs": 14791,
          "endMs": 18048,
          "method": "silence",
          "globalStartMs": 147343,
          "globalEndMs": 150600
        },
        {
          "text": "chacun retrouve son horaire local, le point de rendez-vous et les informations utiles à son poste.",
          "startMs": 18393,
          "endMs": 23271,
          "method": "silence",
          "globalStartMs": 150945,
          "globalEndMs": 155823
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "exclusions",
      "startMs": 158448,
      "endMs": 184207,
      "sentences": [
        {
          "text": "Une demande à valider ou une place en attente n'est pas une inscription confirmée :",
          "startMs": 348,
          "endMs": 5330,
          "method": "silence",
          "globalStartMs": 158796,
          "globalEndMs": 163778
        },
        {
          "text": "elle ne reçoit pas ces rappels.",
          "startMs": 5884,
          "endMs": 7153,
          "method": "silence",
          "globalStartMs": 164332,
          "globalEndMs": 165601
        },
        {
          "text": "Même chose pour notre brouillon et l'événement dont les rappels sont coupés.",
          "startMs": 7923,
          "endMs": 11039,
          "method": "silence",
          "globalStartMs": 166371,
          "globalEndMs": 169487
        },
        {
          "text": "En revanche, fermer un créneau aux nouvelles inscriptions ne l'annule pas.",
          "startMs": 11633,
          "endMs": 15895,
          "method": "silence",
          "globalStartMs": 170081,
          "globalEndMs": 174343
        },
        {
          "text": "Les personnes déjà confirmées peuvent encore recevoir leur rappel.",
          "startMs": 16270,
          "endMs": 19430,
          "method": "silence",
          "globalStartMs": 174718,
          "globalEndMs": 177878
        },
        {
          "text": "Un second passage du traitement ne renvoie pas les rappels déjà marqués comme envoyés dans notre démonstration.",
          "startMs": 20266,
          "endMs": 25356,
          "method": "silence",
          "globalStartMs": 178714,
          "globalEndMs": 183804
        }
      ],
