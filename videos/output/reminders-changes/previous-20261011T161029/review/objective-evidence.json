    {
      "scene": "cancelled",
      "startMs": 215733,
      "endMs": 246914,
      "sentences": [
        {
          "text": "Pour annuler un créneau entier, lisez bien le récapitulatif avant de confirmer.",
          "startMs": 384,
          "endMs": 4824,
          "method": "silence",
          "globalStartMs": 216117,
          "globalEndMs": 220557
        },
        {
          "text": "Ce n'est pas simplement retirer une personne de son horaire.",
          "startMs": 5368,
          "endMs": 9252,
          "method": "silence",
          "globalStartMs": 221101,
          "globalEndMs": 224985
        },
        {
          "text": "Dans notre exemple, une inscription confirmée et une demande sont annulées, et leurs personnes sont prévenues.",
          "startMs": 9675,
          "endMs": 15786,
          "method": "silence",
          "globalStartMs": 225408,
          "globalEndMs": 231519
        },
        {
          "text": "Ouvrons les messages reçus puis revenons au planning.",
          "startMs": 16129,
          "endMs": 19704,
          "method": "silence",
          "globalStartMs": 231862,
          "globalEndMs": 235437
        },
        {
          "text": "Rappeler, modifier, annuler :",
          "startMs": 20119,
          "endMs": 20527,
          "method": "silence",
          "globalStartMs": 235852,
          "globalEndMs": 236260
        },
        {
          "text": "ce sont trois situations différentes.",
          "startMs": 20990,
          "endMs": 23124,
          "method": "silence",
          "globalStartMs": 236723,
          "globalEndMs": 238857
        },
        {
          "text": "Et pour une consigne urgente, gardez aussi un contact direct avec votre équipe :",
          "startMs": 23431,
          "endMs": 28571,
          "method": "silence",
          "globalStartMs": 239164,
          "globalEndMs": 244304
        },
        {
          "text": "envoyé ne veut pas dire lu.",
