    {
      "scene": "changed",
      "startMs": 186674,
      "endMs": 213471,
      "sentences": [
        {
          "text": "Si un horaire change, ouvrez le créneau concerné.",
          "startMs": 411,
          "endMs": 3292,
          "method": "silence",
          "globalStartMs": 187085,
          "globalEndMs": 189966
        },
        {
          "text": "Nous décalons son début et sa fin, puis enregistrons.",
          "startMs": 4010,
          "endMs": 5445,
          "method": "silence",
          "globalStartMs": 190684,
          "globalEndMs": 192119
        },
        {
          "text": "Le système prépare automatiquement le message de changement pour les confirmations de ce créneau.",
          "startMs": 5928,
          "endMs": 11679,
          "method": "silence",
          "globalStartMs": 192602,
          "globalEndMs": 198353
        },
        {
          "text": "Voici l'email réellement reçu avec le nouvel horaire.",
          "startMs": 12415,
          "endMs": 15090,
          "method": "silence",
          "globalStartMs": 199089,
          "globalEndMs": 201764
        },
        {
          "text": "La personne dont la demande attend encore une décision n'a pas reçu ce message.",
          "startMs": 15451,
          "endMs": 19863,
          "method": "silence",
          "globalStartMs": 202125,
          "globalEndMs": 206537
        },
        {
          "text": "Vérifions donc le résultat dans le planning et dans la boîte mail, plutôt que de supposer qu'un clic prouve la réception.",
          "startMs": 20798,
          "endMs": 26413,
          "method": "silence",
          "globalStartMs": 207472,
          "globalEndMs": 213087
        }
      ],
