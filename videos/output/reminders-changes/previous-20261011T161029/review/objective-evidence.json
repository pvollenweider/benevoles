  "sentences": [
    {
      "scene": "welcome",
      "startMs": 169,
      "endMs": 20860,
      "sentences": [
        {
          "text": "Un petit rappel aide les bénévoles à retrouver leur rendez-vous.",
          "startMs": 247,
          "endMs": 3516,
          "method": "silence",
          "globalStartMs": 416,
          "globalEndMs": 3685
        },
        {
          "text": "Et si l'horaire change, mieux vaut les prévenir clairement.",
          "startMs": 3666,
          "endMs": 6481,
          "method": "silence",
          "globalStartMs": 3835,
          "globalEndMs": 6650
        },
        {
          "text": "Ici, nous allons distinguer trois choses :",
          "startMs": 6699,
          "endMs": 8824,
          "method": "silence",
          "globalStartMs": 6868,
          "globalEndMs": 8993
        },
        {
          "text": "le rappel que vous envoyez vous-même, les rappels automatiques et les messages de changement.",
          "startMs": 9238,
          "endMs": 13872,
          "method": "silence",
          "globalStartMs": 9407,
          "globalEndMs": 14041
        },
        {
          "text": "Nous utiliserons un événement de démonstration et sa vraie boîte mail de test pour regarder ce que les personnes reçoivent.",
          "startMs": 14428,
          "endMs": 20380,
          "method": "silence",
          "globalStartMs": 14597,
          "globalEndMs": 20549
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "manual-message",
      "startMs": 23242,
      "endMs": 49814,
      "sentences": [
        {
          "text": "Dans les réglages de l'événement, le Message de rappel complète le récapitulatif des créneaux.",
          "startMs": 356,
          "endMs": 5327,
          "method": "silence",
          "globalStartMs": 23598,
          "globalEndMs": 28569
        },
        {
          "text": "Écrivons une consigne simple :",
          "startMs": 5960,
          "endMs": 7540,
          "method": "silence",
          "globalStartMs": 29202,
          "globalEndMs": 30782
        },
        {
          "text": "retrouve-nous au stand quinze minutes avant ton horaire, et merci pour ton aide.",
          "startMs": 7759,
          "endMs": 11381,
          "method": "silence",
          "globalStartMs": 31001,
          "globalEndMs": 34623
        },
        {
          "text": "Le texte s'enregistre automatiquement :",
          "startMs": 11941,
          "endMs": 15382,
          "method": "silence",
          "globalStartMs": 35183,
          "globalEndMs": 38624
        },
        {
          "text": "attendez la confirmation Modifications enregistrées avant de quitter la page.",
          "startMs": 15518,
          "endMs": 18061,
          "method": "silence",
          "globalStartMs": 38760,
          "globalEndMs": 41303
        },
        {
          "text": "Ce message est propre à cet événement.",
          "startMs": 18580,
          "endMs": 20441,
          "method": "silence",
          "globalStartMs": 41822,
          "globalEndMs": 43683
        },
        {
          "text": "Ce n'est pas un modèle de campagne ni une nouvelle invitation :",
          "startMs": 20613,
          "endMs": 23255,
          "method": "silence",
          "globalStartMs": 43855,
          "globalEndMs": 46497
        },
        {
          "text": "il accompagne le planning des personnes déjà confirmées.",
          "startMs": 23414,
          "endMs": 26210,
          "method": "silence",
          "globalStartMs": 46656,
          "globalEndMs": 49452
        }
      ],
      "anchors": [
        {
          "segmentId": "manual-message",
          "phrase": "Le texte s'enregistre automatiquement",
          "startMs": 11941,
          "endMs": 15382,
          "cueMs": 38551
        }
      ],
