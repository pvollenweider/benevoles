    {
      "scene": "manual-send",
      "startMs": 51952,
      "endMs": 76337,
      "sentences": [
        {
          "text": "Depuis la page de l'événement, Envoyer le rappel demande une confirmation.",
          "startMs": 346,
          "endMs": 4512,
          "method": "silence",
          "globalStartMs": 52298,
          "globalEndMs": 56464
        },
        {
          "text": "Nous annulons une première fois, puis reprenons et confirmons le véritable envoi.",
          "startMs": 5267,
          "endMs": 7539,
          "method": "silence",
          "globalStartMs": 57219,
          "globalEndMs": 59491
        },
        {
          "text": "Ouvrons l'email de Léa :",
          "startMs": 7801,
          "endMs": 9324,
          "method": "silence",
          "globalStartMs": 59753,
          "globalEndMs": 61276
        },
        {
          "text": "ses deux créneaux sont regroupés dans un seul message, avec notre consigne.",
          "startMs": 9939,
          "endMs": 15030,
          "method": "silence",
          "globalStartMs": 61891,
          "globalEndMs": 66982
        },
        {
          "text": "Les personnes qui ont seulement une demande ou une attente ne reçoivent pas ce rappel des inscriptions confirmées.",
          "startMs": 15541,
          "endMs": 20357,
          "method": "silence",
          "globalStartMs": 67493,
          "globalEndMs": 72309
        },
        {
          "text": "Regardez le résultat de l'envoi, pas seulement le nombre affiché avant.",
          "startMs": 20839,
          "endMs": 24037,
          "method": "silence",
          "globalStartMs": 72791,
          "globalEndMs": 75989
        }
      ],
      "anchors": [],
      "inputs": [
        {
          "kind": "click",
          "atMs": 53671
        },
        {
          "kind": "click",
          "atMs": 56104
        },
        {
          "kind": "click",
          "atMs": 58520
        },
        {
          "kind": "click",
          "atMs": 60236
        }
      ]
    },
    {
      "scene": "organization",
      "startMs": 78600,
      "endMs": 102038,
      "sentences": [
        {
          "text": "Dans Paramètres, puis Emails, vous choisissez les rappels automatiques de toute l'organisation :",
          "startMs": 349,
          "endMs": 5288,
          "method": "silence",
          "globalStartMs": 78949,
          "globalEndMs": 83888
        },
        {
          "text": "J moins deux, J moins un et le rappel du jour.",
          "startMs": 5793,
          "endMs": 7394,
          "method": "silence",
          "globalStartMs": 84393,
          "globalEndMs": 85994
        },
        {
          "text": "Une case décochée ne suffit pas :",
          "startMs": 7831,
          "endMs": 8666,
          "method": "silence",
          "globalStartMs": 86431,
          "globalEndMs": 87266
        },
        {
          "text": "il faut enregistrer le changement.",
          "startMs": 9173,
          "endMs": 12244,
          "method": "silence",
          "globalStartMs": 87773,
          "globalEndMs": 90844
        },
        {
          "text": "Nous coupons celui de la veille, enregistrons, puis le réactivons.",
          "startMs": 12818,
          "endMs": 15328,
          "method": "silence",
          "globalStartMs": 91418,
          "globalEndMs": 93928
        },
        {
          "text": "Vous trouvez aussi l'adresse de réponse :",
          "startMs": 15754,
          "endMs": 16748,
          "method": "silence",
          "globalStartMs": 94354,
          "globalEndMs": 95348
        },
        {
          "text": "c'est là que les réponses des bénévoles arrivent, pas une adresse différente pour chaque rappel.",
          "startMs": 17264,
          "endMs": 23145,
          "method": "silence",
          "globalStartMs": 95864,
          "globalEndMs": 101745
        }
      ],
      "anchors": [
        {
          "segmentId": "organization",
          "phrase": "Nous coupons celui de la veille",
          "startMs": 12818,
          "endMs": 15328,
          "cueMs": 91420
        },
        {
          "segmentId": "organization",
          "phrase": "Vous trouvez aussi l'adresse de réponse",
          "startMs": 15754,
          "endMs": 16748,
          "cueMs": 94592
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 91917
        },
        {
          "kind": "click",
          "atMs": 92717
        },
        {
          "kind": "click",
          "atMs": 93501
        },
        {
          "kind": "click",
          "atMs": 94284
        }
      ]
    },
    {
      "scene": "event-switch",
      "startMs": 104303,
      "endMs": 130112,
      "sentences": [
        {
          "text": "Les trois cases que nous venons de voir concernent toute l'organisation.",
          "startMs": 205,
          "endMs": 3584,
          "method": "silence",
          "globalStartMs": 104508,
          "globalEndMs": 107887
        },
        {
          "text": "Dans le formulaire de l'événement, vous pouvez aussi couper seulement ses rappels automatiques.",
          "startMs": 3907,
          "endMs": 9176,
          "method": "silence",
          "globalStartMs": 108210,
          "globalEndMs": 113479
        },
        {
          "text": "Décochons Rappels automatiques et attendons l'enregistrement.",
          "startMs": 9313,
          "endMs": 12120,
          "method": "silence",
          "globalStartMs": 113616,
          "globalEndMs": 116423
        },
        {
          "text": "Réactivons-les pour poursuivre notre exemple.",
          "startMs": 12922,
          "endMs": 15309,
          "method": "silence",
          "globalStartMs": 117225,
          "globalEndMs": 119612
        },
        {
          "text": "Ce réglage ne change pas le rappel manuel.",
          "startMs": 15607,
          "endMs": 17504,
          "method": "silence",
          "globalStartMs": 119910,
          "globalEndMs": 121807
        },
        {
          "text": "Regardons maintenant notre événement en brouillon.",
          "startMs": 18273,
          "endMs": 20656,
          "method": "silence",
          "globalStartMs": 122576,
          "globalEndMs": 124959
        },
        {
          "text": "Il ne reçoit pas les rappels automatiques réservés aux événements publiés.",
          "startMs": 21261,
          "endMs": 25808,
          "method": "silence",
          "globalStartMs": 125564,
          "globalEndMs": 130111
        }
      ],
      "anchors": [
        {
          "segmentId": "event-switch",
          "phrase": "Décochons Rappels automatiques",
          "startMs": 9313,
          "endMs": 12120,
          "cueMs": 113617
        },
        {
          "segmentId": "event-switch",
          "phrase": "Réactivons-les",
          "startMs": 12922,
          "endMs": 15309,
          "cueMs": 117226
        },
        {
          "segmentId": "event-switch",
          "phrase": "Regardons maintenant notre événement en brouillon",
          "startMs": 18273,
          "endMs": 20656,
          "cueMs": 122576
        }
      ],
      "inputs": [
        {
          "kind": "click",
          "atMs": 114084
        },
        {
          "kind": "click",
          "atMs": 117699
        }
      ]
    },
    {
      "scene": "timing",
      "startMs": 132378,
      "endMs": 155992,
      "sentences": [
        {
          "text": "Les rappels partent autour de deux jours avant, autour de la veille, puis entre deux et quatre heures avant le début du créneau.",
          "startMs": 188,
          "endMs": 7086,
          "method": "silence",
          "globalStartMs": 132566,
          "globalEndMs": 139464
        },
        {
          "text": "Ce n'est pas une promesse d'envoi à une minute fixe.",
          "startMs": 7617,
          "endMs": 9956,
          "method": "silence",
          "globalStartMs": 139995,
          "globalEndMs": 142334
        },
        {
          "text": "Les heures sont lues dans le fuseau de l'organisation, Europe Zurich ici.",
          "startMs": 10328,
          "endMs": 14159,
          "method": "silence",
          "globalStartMs": 142706,
          "globalEndMs": 146537
        },
        {
          "text": "Voici les trois emails réellement reçus pour nos trois échéances :",
          "startMs": 14791,
          "endMs": 18048,
          "method": "silence",
          "globalStartMs": 147169,
          "globalEndMs": 150426
        },
        {
          "text": "chacun retrouve son horaire local, le point de rendez-vous et les informations utiles à son poste.",
          "startMs": 18393,
          "endMs": 23271,
          "method": "silence",
          "globalStartMs": 150771,
          "globalEndMs": 155649
        }
      ],
      "anchors": [],
      "inputs": []
    },
    {
      "scene": "exclusions",
      "startMs": 158262,
      "endMs": 184019,
      "sentences": [
        {
          "text": "Une demande à valider ou une place en attente n'est pas une inscription confirmée :",
          "startMs": 348,
          "endMs": 5330,
          "method": "silence",
          "globalStartMs": 158610,
          "globalEndMs": 163592
        },
        {
          "text": "elle ne reçoit pas ces rappels.",
          "startMs": 5884,
          "endMs": 7153,
          "method": "silence",
          "globalStartMs": 164146,
          "globalEndMs": 165415
        },
        {
          "text": "Même chose pour notre brouillon et l'événement dont les rappels sont coupés.",
          "startMs": 7923,
          "endMs": 11039,
          "method": "silence",
          "globalStartMs": 166185,
          "globalEndMs": 169301
        },
        {
          "text": "En revanche, fermer un créneau aux nouvelles inscriptions ne l'annule pas.",
          "startMs": 11633,
          "endMs": 15895,
          "method": "silence",
          "globalStartMs": 169895,
          "globalEndMs": 174157
        },
        {
          "text": "Les personnes déjà confirmées peuvent encore recevoir leur rappel.",
          "startMs": 16270,
          "endMs": 19430,
          "method": "silence",
          "globalStartMs": 174532,
          "globalEndMs": 177692
        },
        {
          "text": "Un second passage du traitement ne renvoie pas les rappels déjà marqués comme envoyés dans notre démonstration.",
          "startMs": 20266,
          "endMs": 25356,
          "method": "silence",
          "globalStartMs": 178528,
          "globalEndMs": 183618
        }
      ],
