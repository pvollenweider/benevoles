    {
      "scene": "changed",
      "startMs": 186283,
      "endMs": 213082,
      "sentences": [
        {
          "text": "Si un horaire change, ouvrez le créneau concerné.",
          "startMs": 411,
          "endMs": 3292,
          "method": "silence",
          "globalStartMs": 186694,
          "globalEndMs": 189575
        },
        {
          "text": "Nous décalons son début et sa fin, puis enregistrons.",
          "startMs": 4010,
          "endMs": 5445,
          "method": "silence",
          "globalStartMs": 190293,
          "globalEndMs": 191728
        },
        {
          "text": "Le système prépare automatiquement le message de changement pour les confirmations de ce créneau.",
          "startMs": 5928,
          "endMs": 11679,
          "method": "silence",
          "globalStartMs": 192211,
          "globalEndMs": 197962
        },
        {
          "text": "Voici l'email réellement reçu avec le nouvel horaire.",
          "startMs": 12415,
          "endMs": 15090,
          "method": "silence",
          "globalStartMs": 198698,
          "globalEndMs": 201373
        },
        {
          "text": "La personne dont la demande attend encore une décision n'a pas reçu ce message.",
          "startMs": 15451,
          "endMs": 19863,
          "method": "silence",
          "globalStartMs": 201734,
          "globalEndMs": 206146
        },
        {
          "text": "Vérifions donc le résultat dans le planning et dans la boîte mail, plutôt que de supposer qu'un clic prouve la réception.",
          "startMs": 20798,
          "endMs": 26413,
          "method": "silence",
          "globalStartMs": 207081,
          "globalEndMs": 212696
        }
      ],
