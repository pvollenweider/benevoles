    {
      "scene": "cancelled",
      "startMs": 215343,
      "endMs": 246498,
      "sentences": [
        {
          "text": "Pour annuler un créneau entier, lisez bien le récapitulatif avant de confirmer.",
          "startMs": 384,
          "endMs": 4824,
          "method": "silence",
          "globalStartMs": 215727,
          "globalEndMs": 220167
        },
        {
          "text": "Ce n'est pas simplement retirer une personne de son horaire.",
          "startMs": 5368,
          "endMs": 9252,
          "method": "silence",
          "globalStartMs": 220711,
          "globalEndMs": 224595
        },
        {
          "text": "Dans notre exemple, une inscription confirmée et une demande sont annulées, et leurs personnes sont prévenues.",
          "startMs": 9675,
          "endMs": 15786,
          "method": "silence",
          "globalStartMs": 225018,
          "globalEndMs": 231129
        },
        {
          "text": "Ouvrons les messages reçus puis revenons au planning.",
          "startMs": 16129,
          "endMs": 19704,
          "method": "silence",
          "globalStartMs": 231472,
          "globalEndMs": 235047
        },
        {
          "text": "Rappeler, modifier, annuler :",
          "startMs": 20119,
          "endMs": 20527,
          "method": "silence",
          "globalStartMs": 235462,
          "globalEndMs": 235870
        },
        {
          "text": "ce sont trois situations différentes.",
          "startMs": 20990,
          "endMs": 23124,
          "method": "silence",
          "globalStartMs": 236333,
          "globalEndMs": 238467
        },
        {
          "text": "Et pour une consigne urgente, gardez aussi un contact direct avec votre équipe :",
          "startMs": 23431,
          "endMs": 28571,
          "method": "silence",
          "globalStartMs": 238774,
          "globalEndMs": 243914
        },
        {
          "text": "envoyé ne veut pas dire lu.",
          "startMs": 28976,
