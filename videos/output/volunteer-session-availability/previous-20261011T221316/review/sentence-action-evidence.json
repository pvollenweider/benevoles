[
  {
    "id": "welcome",
    "startMs": 2,
    "sentences": [
      {
        "text": "Pour retrouver tes inscriptions, tu n'as pas besoin de créer un compte.",
        "startMs": 230,
        "endMs": 3887,
        "method": "silence",
        "absoluteStartMs": 232
      },
      {
        "text": "Ton email contient un lien personnel qui ouvre directement ta page.",
        "startMs": 4118,
        "endMs": 7450,
        "method": "silence",
        "absoluteStartMs": 4120
      },
      {
        "text": "Ce lien donne accès à tes informations et permet d'annuler tes créneaux :",
        "startMs": 7836,
        "endMs": 11134,
        "method": "silence",
        "absoluteStartMs": 7838
      },
      {
        "text": "garde-le pour toi.",
        "startMs": 11620,
        "endMs": 12383,
        "method": "silence",
        "absoluteStartMs": 11622
      },
      {
        "text": "Nous allons aussi voir comment indiquer tes disponibilités et utiliser le site sur un appareil partagé.",
        "startMs": 12909,
        "endMs": 18043,
        "method": "silence",
        "absoluteStartMs": 12911
      }
    ],
    "inputs": []
  },
  {
    "id": "session",
    "startMs": 18896,
    "sentences": [
      {
        "text": "Après avoir ouvert ta page personnelle, le navigateur peut te reconnaître quand tu reviens sur l'événement.",
        "startMs": 377,
        "endMs": 5831,
        "method": "silence",
        "absoluteStartMs": 19273
      },
      {
        "text": "Ici, Camille retrouve son nom et ses inscriptions.",
        "startMs": 6344,
        "endMs": 9207,
        "method": "silence",
        "absoluteStartMs": 25240
      },
      {
        "text": "Cela aide à choisir un autre créneau sans repartir de zéro.",
        "startMs": 9895,
        "endMs": 12586,
        "method": "silence",
        "absoluteStartMs": 28791
      },
      {
        "text": "Sur un ordinateur ou un téléphone partagé, pense à cliquer sur Quitter la session quand tu as terminé.",
        "startMs": 13097,
        "endMs": 18309,
        "method": "silence",
        "absoluteStartMs": 31993
      },
      {
        "text": "La page redevient anonyme, mais tes inscriptions ne sont pas annulées.",
        "startMs": 18608,
        "endMs": 22074,
        "method": "silence",
        "absoluteStartMs": 37504
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 32964
      }
    ]
  },
  {
    "id": "resend",
    "startMs": 42016,
    "sentences": [
      {
        "text": "Sur ta page personnelle, la rubrique Ton lien personnel rappelle à quoi il sert et quand il a été envoyé.",
        "startMs": 589,
        "endMs": 6424,
        "method": "silence",
        "absoluteStartMs": 42605
      },
      {
        "text": "Avec Recevoir ce lien par email, tu peux le retrouver dans ta boîte.",
        "startMs": 6829,
        "endMs": 9413,
        "method": "silence",
        "absoluteStartMs": 48845
      },
      {
        "text": "Attendons le résultat, puis ouvrons le message réellement reçu.",
        "startMs": 9602,
        "endMs": 14472,
        "method": "silence",
        "absoluteStartMs": 51618
      },
      {
        "text": "Pense aussi à vérifier les courriers indésirables et l'adresse utilisée lors de ton inscription.",
        "startMs": 14998,
        "endMs": 19304,
        "method": "silence",
        "absoluteStartMs": 57014
      }
    ],
    "inputs": [
      {
        "kind": "click",
        "atMs": 43604
      },
      {
        "kind": "click",
        "atMs": 56076
      }
    ]
  },
  {
    "id": "recover",
    "startMs": 62369,
    "sentences": [
      {
        "text": "Si un ancien lien ne fonctionne plus, la page propose Recevoir un nouveau lien.",
        "startMs": 593,
        "endMs": 4573,
        "method": "silence",
        "absoluteStartMs": 62962
      },
      {
        "text": "Saisis l'adresse email utilisée pour t'inscrire.",
        "startMs": 5153,
        "endMs": 7541,
        "method": "silence",
        "absoluteStartMs": 67522
      },
      {
        "text": "La réponse reste volontairement la même, que cette adresse soit connue ou non :",
        "startMs": 8072,
        "endMs": 11909,
        "method": "silence",
        "absoluteStartMs": 70441
      },
      {
        "text": "elle ne révèle pas les inscriptions d'une autre personne.",
        "startMs": 12391,
        "endMs": 14418,
        "method": "silence",
        "absoluteStartMs": 74760
      },
      {
        "text": "Si des inscriptions peuvent être retrouvées pour cette adresse, tu recevras leur lien par email.",
        "startMs": 14860,
        "endMs": 20377,
        "method": "silence",
        "absoluteStartMs": 77229
      }
    ],
