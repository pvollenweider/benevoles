    {
      "id": "limit",
      "startMs": 83454,
      "endMs": 101692,
      "sentences": [
        {
          "text": "Les demandes de renvoi sont limitées pour éviter les abus.",
          "startMs": 379,
          "endMs": 3028,
          "method": "silence",
          "absoluteStartS": 83.833,
          "absoluteEndS": 86.482
        },
        {
          "text": "Si tu demandes plusieurs liens trop vite, un message t'invite à patienter.",
          "startMs": 3168,
          "endMs": 6368,
          "method": "silence",
          "absoluteStartS": 86.622,
          "absoluteEndS": 89.822
        },
        {
          "text": "Inutile de multiplier les clics.",
          "startMs": 6990,
          "endMs": 8558,
          "method": "silence",
          "absoluteStartS": 90.444,
          "absoluteEndS": 92.012
        },
        {
          "text": "Vérifie ta boîte email, puis réessaie plus tard si nécessaire.",
          "startMs": 8967,
          "endMs": 11617,
          "method": "silence",
          "absoluteStartS": 92.421,
          "absoluteEndS": 95.071
        },
        {
          "text": "Si ton adresse est erronée ou que tu ne retrouves toujours rien, contacte l'organisation pour qu'elle vérifie avec toi.",
          "startMs": 12053,
          "endMs": 17952,
          "method": "silence",
          "absoluteStartS": 95.507,
          "absoluteEndS": 101.406
        }
      ],
      "markers": [
        {
          "kind": "click",
