        }
      ]
    },
    {
      "id": "availability",
      "startMs": 102145,
      "endMs": 126138,
      "sentences": [
        {
          "text": "La rubrique Mes disponibilités permet d'indiquer les moments où tu es généralement disponible.",
          "startMs": 286,
          "endMs": 6128,
          "method": "silence",
          "absoluteStartS": 102.431,
          "absoluteEndS": 108.273
        },
        {
          "text": "Camille coche Matin et Soir, puis ajoute une exception :",
          "startMs": 6803,
          "endMs": 10429,
          "method": "silence",
          "absoluteStartS": 108.948,
          "absoluteEndS": 112.574
        },
        {
          "text": "pas le dimanche matin.",
          "startMs": 11012,
          "endMs": 11871,
          "method": "silence",
          "absoluteStartS": 113.157,
          "absoluteEndS": 114.016
        },
        {
          "text": "Ces informations sont facultatives.",
          "startMs": 12264,
          "endMs": 14239,
          "method": "silence",
          "absoluteStartS": 114.409,
          "absoluteEndS": 116.384
        },
        {
          "text": "Après Enregistrer mes disponibilités, le message confirme le résultat.",
          "startMs": 14558,
          "endMs": 18957,
          "method": "silence",
          "absoluteStartS": 116.703,
          "absoluteEndS": 121.102
        },
        {
          "text": "Rechargeons la page :",
          "startMs": 19647,
          "endMs": 20826,
          "method": "silence",
          "absoluteStartS": 121.792,
          "absoluteEndS": 122.971
        },
        {
          "text": "les choix et la note sont bien conservés.",
          "startMs": 21520,
          "endMs": 23640,
          "method": "silence",
          "absoluteStartS": 123.665,
          "absoluteEndS": 125.785
        }
      ],
