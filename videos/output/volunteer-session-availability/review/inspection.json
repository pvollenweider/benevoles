  "chapters": [
    {
      "id": "welcome",
      "startMs": 0,
      "endMs": 18441,
      "sentences": [
        {
          "text": "Pour retrouver tes inscriptions, tu n'as pas besoin de créer un compte.",
          "startMs": 230,
          "endMs": 3887,
          "method": "silence",
          "absoluteStartS": 0.23,
          "absoluteEndS": 3.887
        },
        {
          "text": "Ton email contient un lien personnel qui ouvre directement ta page.",
          "startMs": 4118,
          "endMs": 7450,
          "method": "silence",
          "absoluteStartS": 4.118,
          "absoluteEndS": 7.45
        },
        {
          "text": "Ce lien donne accès à tes informations et permet d'annuler tes créneaux :",
          "startMs": 7836,
          "endMs": 11134,
          "method": "silence",
          "absoluteStartS": 7.836,
          "absoluteEndS": 11.134
        },
        {
          "text": "garde-le pour toi.",
          "startMs": 11620,
          "endMs": 12383,
          "method": "silence",
          "absoluteStartS": 11.62,
          "absoluteEndS": 12.383
        },
        {
          "text": "Nous allons aussi voir comment indiquer tes disponibilités et utiliser le site sur un appareil partagé.",
          "startMs": 12909,
          "endMs": 18043,
          "method": "silence",
          "absoluteStartS": 12.909,
          "absoluteEndS": 18.043
        }
      ],
      "markers": []
    },
    {
      "id": "session",
      "startMs": 18893,
      "endMs": 41560,
      "sentences": [
        {
          "text": "Après avoir ouvert ta page personnelle, le navigateur peut te reconnaître quand tu reviens sur l'événement.",
          "startMs": 377,
          "endMs": 5831,
          "method": "silence",
          "absoluteStartS": 19.27,
          "absoluteEndS": 24.724
        },
        {
          "text": "Ici, Camille retrouve son nom et ses inscriptions.",
          "startMs": 6344,
          "endMs": 9207,
          "method": "silence",
          "absoluteStartS": 25.237,
          "absoluteEndS": 28.1
        },
        {
          "text": "Cela aide à choisir un autre créneau sans repartir de zéro.",
          "startMs": 9895,
          "endMs": 12586,
          "method": "silence",
          "absoluteStartS": 28.788,
          "absoluteEndS": 31.479
        },
        {
          "text": "Sur un ordinateur ou un téléphone partagé, pense à cliquer sur Quitter la session quand tu as terminé.",
          "startMs": 13097,
          "endMs": 18309,
          "method": "silence",
          "absoluteStartS": 31.99,
          "absoluteEndS": 37.202
        },
        {
          "text": "La page redevient anonyme, mais tes inscriptions ne sont pas annulées.",
          "startMs": 18608,
          "endMs": 22074,
          "method": "silence",
          "absoluteStartS": 37.501,
          "absoluteEndS": 40.967
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 32960
        }
      ]
    },
    {
      "id": "resend",
      "startMs": 42011,
      "endMs": 61912,
      "sentences": [
        {
          "text": "Sur ta page personnelle, la rubrique Ton lien personnel rappelle à quoi il sert et quand il a été envoyé.",
          "startMs": 589,
          "endMs": 6424,
          "method": "silence",
          "absoluteStartS": 42.6,
          "absoluteEndS": 48.435
        },
        {
          "text": "Avec Recevoir ce lien par email, tu peux le retrouver dans ta boîte.",
          "startMs": 6829,
          "endMs": 9413,
          "method": "silence",
          "absoluteStartS": 48.84,
          "absoluteEndS": 51.424
        },
        {
          "text": "Attendons le résultat, puis ouvrons le message réellement reçu.",
          "startMs": 9602,
          "endMs": 14472,
          "method": "silence",
          "absoluteStartS": 51.613,
          "absoluteEndS": 56.483
        },
        {
          "text": "Pense aussi à vérifier les courriers indésirables et l'adresse utilisée lors de ton inscription.",
          "startMs": 14998,
          "endMs": 19304,
          "method": "silence",
          "absoluteStartS": 57.009,
          "absoluteEndS": 61.315
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 49336
        },
        {
          "kind": "click",
          "atMs": 53736
        }
      ]
    },
    {
      "id": "recover",
      "startMs": 62366,
      "endMs": 83001,
      "sentences": [
        {
          "text": "Si un ancien lien ne fonctionne plus, la page propose Recevoir un nouveau lien.",
          "startMs": 593,
          "endMs": 4573,
          "method": "silence",
          "absoluteStartS": 62.959,
          "absoluteEndS": 66.939
        },
        {
          "text": "Saisis l'adresse email utilisée pour t'inscrire.",
          "startMs": 5153,
          "endMs": 7541,
          "method": "silence",
          "absoluteStartS": 67.519,
          "absoluteEndS": 69.907
        },
        {
          "text": "La réponse reste volontairement la même, que cette adresse soit connue ou non :",
          "startMs": 8072,
          "endMs": 11909,
          "method": "silence",
          "absoluteStartS": 70.438,
          "absoluteEndS": 74.275
        },
        {
          "text": "elle ne révèle pas les inscriptions d'une autre personne.",
          "startMs": 12391,
          "endMs": 14418,
          "method": "silence",
          "absoluteStartS": 74.757,
          "absoluteEndS": 76.784
        },
        {
          "text": "Si des inscriptions peuvent être retrouvées pour cette adresse, tu recevras leur lien par email.",
          "startMs": 14860,
          "endMs": 20377,
          "method": "silence",
          "absoluteStartS": 77.226,
          "absoluteEndS": 82.743
        }
      ],
