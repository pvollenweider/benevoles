  {
    "id": "availability",
    "startMs": 102145,
    "sentences": [
      {
        "text": "La rubrique Mes disponibilités permet d'indiquer les moments où tu es généralement disponible.",
        "startMs": 286,
        "endMs": 6128,
        "method": "silence",
        "absoluteStartMs": 102431
      },
      {
        "text": "Camille coche Matin et Soir, puis ajoute une exception :",
        "startMs": 6803,
        "endMs": 10429,
        "method": "silence",
        "absoluteStartMs": 108948
      },
      {
        "text": "pas le dimanche matin.",
        "startMs": 11012,
        "endMs": 11871,
        "method": "silence",
        "absoluteStartMs": 113157
      },
      {
        "text": "Ces informations sont facultatives.",
        "startMs": 12264,
        "endMs": 14239,
        "method": "silence",
        "absoluteStartMs": 114409
      },
      {
        "text": "Après Enregistrer mes disponibilités, le message confirme le résultat.",
        "startMs": 14558,
        "endMs": 18957,
        "method": "silence",
        "absoluteStartMs": 116703
      },
      {
        "text": "Rechargeons la page :",
        "startMs": 19647,
        "endMs": 20826,
        "method": "silence",
        "absoluteStartMs": 121792
      },
      {
        "text": "les choix et la note sont bien conservés.",
        "startMs": 21520,
        "endMs": 23640,
        "method": "silence",
        "absoluteStartMs": 123665
      }
    ],
