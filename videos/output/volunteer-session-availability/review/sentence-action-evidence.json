  {
    "id": "organizer",
    "startMs": 126590,
    "sentences": [
      {
        "text": "L'organisation retrouve cette indication dans ta fiche.",
        "startMs": 369,
        "endMs": 3371,
        "method": "silence",
        "absoluteStartMs": 126959
      },
      {
        "text": "Elle peut s'en servir si elle doit te proposer un autre créneau.",
        "startMs": 3637,
        "endMs": 6500,
        "method": "silence",
        "absoluteStartMs": 130227
      },
      {
        "text": "Ce n'est ni une inscription automatique, ni un filtre qui masque les autres horaires.",
        "startMs": 6883,
        "endMs": 11866,
        "method": "silence",
        "absoluteStartMs": 133473
      },
      {
        "text": "Tu choisis toujours tes créneaux toi-même.",
        "startMs": 12103,
        "endMs": 14037,
        "method": "silence",
        "absoluteStartMs": 138693
      },
      {
        "text": "Une disponibilité générale ne garantit pas non plus qu'une place sera libre sur le poste qui t'intéresse.",
        "startMs": 14528,
        "endMs": 20561,
        "method": "silence",
        "absoluteStartMs": 141118
      }
    ],
    "inputs": []
  },
  {
    "id": "result",
    "startMs": 147869,
    "sentences": [
      {
        "text": "Tes habitudes changent ?",
        "startMs": 266,
        "endMs": 1100,
        "method": "silence",
        "absoluteStartMs": 148135
      },
      {
        "text": "Reviens sur ta page personnelle pour modifier la note ou décocher les périodes.",
        "startMs": 1523,
        "endMs": 6862,
        "method": "silence",
        "absoluteStartMs": 149392
      },
      {
        "text": "Enregistre à nouveau et vérifie le message.",
        "startMs": 7103,
        "endMs": 8665,
        "method": "silence",
        "absoluteStartMs": 154972
      },
      {
        "text": "Effacer tes disponibilités ne retire aucune inscription.",
        "startMs": 9032,
        "endMs": 11971,
        "method": "silence",
        "absoluteStartMs": 156901
      },
      {
        "text": "Le lien personnel reste ton point d'entrée, l'email t'aide à le retrouver, et Quitter la session protège ton accès quand tu utilises un appareil partagé.",
        "startMs": 12586,
        "endMs": 21456,
        "method": "silence",
        "absoluteStartMs": 160455
      }
    ],
