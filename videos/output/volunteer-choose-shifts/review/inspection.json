  "chapters": [
    {
      "id": "welcome",
      "startMs": 1094,
      "endMs": 14357,
      "sentences": [
        {
          "text": "Choisir ses créneaux, c’est construire un engagement réaliste avant de donner ses coordonnées.",
          "startMs": 267,
          "endMs": 4418,
          "method": "silence",
          "absoluteStartS": 1.361,
          "absoluteEndS": 5.512
        },
        {
          "text": "Tu peux essayer plusieurs combinaisons, retirer un choix et lire les contraintes sans rien enregistrer.",
          "startMs": 4642,
          "endMs": 9600,
          "method": "silence",
          "absoluteStartS": 5.736,
          "absoluteEndS": 10.694
        },
        {
          "text": "L’inscription ne partira qu’après le formulaire et sa confirmation.",
          "startMs": 9840,
          "endMs": 12801,
          "method": "silence",
          "absoluteStartS": 10.934,
          "absoluteEndS": 13.895
        }
      ],
      "markers": []
    },
    {
      "id": "select",
      "startMs": 16519,
      "endMs": 32799,
      "sentences": [
        {
          "text": "Clique sur une mission disponible pour la sélectionner.",
          "startMs": 388,
          "endMs": 2892,
          "method": "silence",
          "absoluteStartS": 16.907,
          "absoluteEndS": 19.411
        },
        {
          "text": "Elle change d’état et rejoint le récapitulatif à droite.",
          "startMs": 3286,
          "endMs": 5807,
          "method": "silence",
          "absoluteStartS": 19.805,
          "absoluteEndS": 22.326
        },
        {
          "text": "Tu peux en ajouter plusieurs, même sur deux journées.",
          "startMs": 6086,
          "endMs": 8550,
          "method": "silence",
          "absoluteStartS": 22.605,
          "absoluteEndS": 25.069
        },
        {
          "text": "Pour retirer un choix avant de continuer, reclique sur sa barre ou utilise la croix du récapitulatif :",
          "startMs": 9157,
          "endMs": 14035,
          "method": "silence",
          "absoluteStartS": 25.676,
          "absoluteEndS": 30.554
        },
        {
          "text": "aucune place n’a encore été réservée.",
          "startMs": 14388,
          "endMs": 15895,
          "method": "silence",
          "absoluteStartS": 30.907,
          "absoluteEndS": 32.414
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 17023
        },
        {
          "kind": "click",
          "atMs": 23106
        },
        {
          "kind": "click",
          "atMs": 28706
        }
      ]
    },
    {
      "id": "capacity",
      "startMs": 33251,
      "endMs": 48763,
      "sentences": [
        {
          "text": "Chaque barre indique les inscriptions sur la capacité totale.",
          "startMs": 384,
          "endMs": 3885,
          "method": "silence",
          "absoluteStartS": 33.635,
          "absoluteEndS": 37.136
        },
        {
          "text": "Deux sur trois signifie qu’il reste une place.",
          "startMs": 4335,
          "endMs": 6167,
          "method": "silence",
          "absoluteStartS": 37.586,
          "absoluteEndS": 39.418
        },
        {
          "text": "Un créneau complet sans liste d’attente ne peut plus être choisi.",
          "startMs": 6510,
          "endMs": 9699,
          "method": "silence",
          "absoluteStartS": 39.761,
          "absoluteEndS": 42.95
        },
        {
          "text": "S’il reste important pour toi, contacte l’association plutôt que de remplacer quelqu’un ou de partager une invitation.",
          "startMs": 10223,
          "endMs": 15041,
          "method": "silence",
          "absoluteStartS": 43.474,
          "absoluteEndS": 48.292
        }
      ],
      "markers": []
    },
    {
      "id": "waitlist",
      "startMs": 49216,
      "endMs": 65066,
      "sentences": [
        {
          "text": "Quand l’organisateur a activé une liste d’attente, un créneau complet reste cliquable.",
          "startMs": 466,
          "endMs": 4802,
          "method": "silence",
          "absoluteStartS": 49.682,
          "absoluteEndS": 54.018
        },
        {
          "text": "Le choix devient En attente et le récapitulatif le distingue d’une place confirmable.",
          "startMs": 5012,
          "endMs": 9484,
          "method": "silence",
          "absoluteStartS": 54.228,
          "absoluteEndS": 58.7
        },
        {
          "text": "Reclique pour le retirer.",
          "startMs": 10145,
          "endMs": 11182,
          "method": "silence",
          "absoluteStartS": 59.361,
          "absoluteEndS": 60.398
        },
        {
          "text": "La position et une éventuelle offre de place n’existeront qu’après l’envoi du formulaire.",
          "startMs": 11433,
          "endMs": 15461,
          "method": "silence",
          "absoluteStartS": 60.649,
          "absoluteEndS": 64.677
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 49738
        },
        {
          "kind": "click",
          "atMs": 59856
        }
      ]
    },
    {
      "id": "approval-reserved",
      "startMs": 66292,
      "endMs": 83218,
      "sentences": [
        {
          "text": "D’autres missions ont une règle particulière.",
          "startMs": 388,
          "endMs": 2713,
          "method": "silence",
          "absoluteStartS": 66.68,
          "absoluteEndS": 69.005
        },
        {
          "text": "Chauffeur navette affiche Sur validation :",
          "startMs": 3236,
          "endMs": 5095,
          "method": "silence",
          "absoluteStartS": 69.528,
          "absoluteEndS": 71.387
        },
        {
          "text": "tu peux la demander, puis l’organisateur décidera.",
          "startMs": 5533,
          "endMs": 7938,
          "method": "silence",
          "absoluteStartS": 71.825,
          "absoluteEndS": 74.23
        },
        {
          "text": "Sécurité est réservée à certains membres et reste bloquée sans leur invitation personnelle.",
          "startMs": 8453,
          "endMs": 12671,
          "method": "silence",
          "absoluteStartS": 74.745,
          "absoluteEndS": 78.963
        },
        {
          "text": "Ces deux états ne veulent donc pas dire complet, et ils ne produisent pas le même suivi.",
          "startMs": 12872,
          "endMs": 16455,
          "method": "silence",
          "absoluteStartS": 79.164,
          "absoluteEndS": 82.747
        }
      ],
      "markers": []
    },
    {
      "id": "conflict",
      "startMs": 85383,
      "endMs": 101504,
      "sentences": [
        {
          "text": "Dès qu’un créneau est choisi, les missions qui chevauchent le même horaire deviennent indisponibles.",
          "startMs": 469,
          "endMs": 4692,
          "method": "silence",
          "absoluteStartS": 85.852,
          "absoluteEndS": 90.075
        },
        {
          "text": "Ici, Accueil de quinze à dix-huit heures empêche la Navette de quatorze à dix-huit heures.",
          "startMs": 5287,
          "endMs": 9231,
          "method": "silence",
          "absoluteStartS": 90.67,
          "absoluteEndS": 94.614
        },
        {
          "text": "Retire le premier choix si la seconde mission te convient mieux.",
          "startMs": 9758,
          "endMs": 11989,
          "method": "silence",
          "absoluteStartS": 95.141,
          "absoluteEndS": 97.372
        },
        {
          "text": "Le serveur vérifiera encore ce conflit au moment de confirmer.",
          "startMs": 12287,
          "endMs": 15913,
          "method": "silence",
          "absoluteStartS": 97.67,
          "absoluteEndS": 101.296
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 85904
        },
        {
          "kind": "click",
          "atMs": 95635
        }
      ]
    },
    {
      "id": "known",
      "startMs": 101956,
      "endMs": 118674,
      "sentences": [
        {
          "text": "Depuis son lien personnel, Camille retrouve automatiquement les créneaux qu’elle possède déjà.",
          "startMs": 207,
          "endMs": 4016,
          "method": "silence",
          "absoluteStartS": 102.163,
          "absoluteEndS": 105.972
        },
        {
          "text": "Ils apparaissent dans son récapitulatif et ne seront pas créés une deuxième fois.",
          "startMs": 4606,
          "endMs": 8276,
          "method": "silence",
          "absoluteStartS": 106.562,
          "absoluteEndS": 110.232
        },
        {
          "text": "Elle peut ajouter une autre mission, mais l’annulation d’un engagement existant demande une confirmation séparée pour éviter un clic accidentel.",
          "startMs": 8632,
          "endMs": 16407,
          "method": "silence",
          "absoluteStartS": 110.588,
          "absoluteEndS": 118.363
        }
      ],
      "markers": []
    },
    {
      "id": "limit",
      "startMs": 119128,
      "endMs": 134698,
      "sentences": [
        {
          "text": "La Buvette est limitée à deux créneaux par personne.",
          "startMs": 307,
          "endMs": 3012,
          "method": "silence",
          "absoluteStartS": 119.435,
          "absoluteEndS": 122.14
        },
        {
          "text": "Camille a déjà atteint ce maximum :",
          "startMs": 3534,
          "endMs": 7105,
          "method": "silence",
          "absoluteStartS": 122.662,
          "absoluteEndS": 126.233
        },
        {
          "text": "les autres plages restent visibles, mais annoncent la limite et ne peuvent pas être ajoutées.",
          "startMs": 7316,
          "endMs": 9531,
          "method": "silence",
          "absoluteStartS": 126.444,
          "absoluteEndS": 128.659
        },
        {
          "text": "Elle doit d’abord annuler une Buvette existante, ou demander à l’organisateur de corriger son planning.",
          "startMs": 10157,
          "endMs": 15018,
          "method": "silence",
          "absoluteStartS": 129.285,
          "absoluteEndS": 134.146
        }
      ],
      "markers": []
    },
    {
      "id": "result",
      "startMs": 135151,
      "endMs": 154932,
      "sentences": [
        {
          "text": "Avant de continuer, relis le récapitulatif :",
          "startMs": 551,
          "endMs": 3331,
          "method": "silence",
          "absoluteStartS": 135.702,
          "absoluteEndS": 138.482
        },
        {
          "text": "jours, heures, missions, attente ou demande sur validation.",
          "startMs": 3931,
          "endMs": 7700,
          "method": "silence",
          "absoluteStartS": 139.082,
          "absoluteEndS": 142.851
        },
        {
          "text": "Tu peux encore tout ajuster sans envoyer de données.",
          "startMs": 7857,
          "endMs": 10854,
          "method": "silence",
          "absoluteStartS": 143.008,
          "absoluteEndS": 146.005
        },
        {
          "text": "Une fois la combinaison réaliste, le bouton Continuer ouvre le formulaire ;",
          "startMs": 11525,
          "endMs": 14548,
          "method": "silence",
          "absoluteStartS": 146.676,
          "absoluteEndS": 149.699
        },
        {
          "text": "il ne confirme toujours rien tant que tu n’as pas validé la dernière étape.",
          "startMs": 14740,
          "endMs": 19565,
          "method": "silence",
          "absoluteStartS": 149.891,
          "absoluteEndS": 154.716
        }
      ],
      "markers": [
        {
          "kind": "click",
          "atMs": 135663
        }
      ]
    }
  ]
}