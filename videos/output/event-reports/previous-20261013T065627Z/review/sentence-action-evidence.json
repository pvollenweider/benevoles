    {
      "chapter": "role",
      "startSeconds": 81.735,
      "endSeconds": 107.406,
      "sentences": [
        {
          "text": "Si vous coordonnez un poste, choisissez le planning par poste.",
          "startMs": 193,
          "endMs": 4239,
          "method": "silence",
          "videoSeconds": 81.928
        },
        {
          "text": "La buvette a sa propre page, avec ses horaires, ses bénévoles et son responsable.",
          "startMs": 4678,
          "endMs": 8296,
          "method": "silence",
          "videoSeconds": 86.413
        },
        {
          "text": "Regardons aussi les autres postes pour comprendre le découpage.",
          "startMs": 8641,
          "endMs": 12950,
          "method": "silence",
          "videoSeconds": 90.376
        },
        {
          "text": "Remettre cette feuille à un relais terrain l'aide à savoir qui arrive et quand.",
          "startMs": 13456,
          "endMs": 17195,
          "method": "silence",
          "videoSeconds": 95.191
        },
        {
          "text": "Cela ne crée pas un compte d'administration, ni un droit supplémentaire :",
          "startMs": 17344,
          "endMs": 23379,
          "method": "silence",
          "videoSeconds": 99.079
        },
        {
          "text": "c'est un document de coordination, à remettre à la personne qui en a besoin.",
          "startMs": 23770,
          "endMs": 25369,
          "method": "silence",
          "videoSeconds": 105.505
        }
      ],
      "anchors": [
        {
