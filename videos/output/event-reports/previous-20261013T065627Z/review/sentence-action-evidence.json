    {
      "chapter": "contacts",
      "startSeconds": 180.641,
      "endSeconds": 207.406,
      "sentences": [
        {
          "text": "La liste avec téléphones est réservée à l'organisation.",
          "startMs": 698,
          "endMs": 3694,
          "method": "silence",
          "videoSeconds": 181.339
        },
        {
          "text": "Elle permet de retrouver une personne, son email, son téléphone et ses créneaux.",
          "startMs": 4277,
          "endMs": 8096,
          "method": "silence",
          "videoSeconds": 184.918
        },
        {
          "text": "Pour notre exemple, le numéro donné dans l'inscription est différent du numéro de sa fiche :",
          "startMs": 8932,
          "endMs": 13580,
          "method": "silence",
          "videoSeconds": 189.573
        },
        {
          "text": "regardons celui retenu dans le document.",
          "startMs": 13869,
          "endMs": 15611,
          "method": "silence",
          "videoSeconds": 194.51
        },
        {
          "text": "Cette liste contient des coordonnées personnelles.",
          "startMs": 16606,
          "endMs": 18657,
          "method": "silence",
          "videoSeconds": 197.247
        },
        {
          "text": "Elle ne va pas sur le panneau public du stand et ne se distribue pas à tout le monde.",
          "startMs": 19191,
          "endMs": 22866,
          "method": "silence",
          "videoSeconds": 199.832
        },
        {
          "text": "Gardez-la pour les personnes qui doivent réellement contacter l'équipe.",
          "startMs": 23526,
          "endMs": 26226,
          "method": "silence",
          "videoSeconds": 204.167
        }
      ],
      "anchors": [
