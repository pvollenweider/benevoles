    {
      "chapter": "individual",
      "startSeconds": 113.769,
      "endSeconds": 143.975,
      "sentences": [
        {
          "text": "Pour Léa, le planning individuel regroupe ses cinq créneaux sur trois postes.",
          "startMs": 320,
          "endMs": 4796,
          "method": "silence",
          "videoSeconds": 114.089
        },
        {
          "text": "Sa frise montre aussi les prénoms des coéquipiers présents sur ces horaires.",
          "startMs": 5145,
          "endMs": 8747,
          "method": "silence",
          "videoSeconds": 118.914
        },
        {
          "text": "On retrouve ensuite le lieu, les consignes et le contact opérationnel lorsqu'ils sont renseignés.",
          "startMs": 9345,
          "endMs": 14661,
          "method": "silence",
          "videoSeconds": 123.114
        },
        {
          "text": "Ici, son planning tient sur deux pages :",
          "startMs": 15174,
          "endMs": 17698,
          "method": "silence",
          "videoSeconds": 128.943
        },
        {
          "text": "passons à la suivante pour lire le dernier poste.",
          "startMs": 18179,
          "endMs": 20399,
          "method": "silence",
          "videoSeconds": 131.948
        },
        {
          "text": "Remettez-lui les deux pages de son planning, pas toutes celles de l'équipe.",
          "startMs": 20541,
          "endMs": 24856,
          "method": "silence",
          "videoSeconds": 134.31
        },
        {
          "text": "Et pour les homonymes, vérifiez les créneaux avant de distribuer les documents.",
          "startMs": 25375,
          "endMs": 29421,
          "method": "silence",
          "videoSeconds": 139.144
        }
      ],
      "anchors": [
        {
