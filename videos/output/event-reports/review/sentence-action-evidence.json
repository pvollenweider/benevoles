    {
      "chapter": "attendance",
      "startSeconds": 150.223,
      "endSeconds": 178.508,
      "sentences": [
        {
          "text": "La feuille de présence sert au pointage sur papier.",
          "startMs": 785,
          "endMs": 3180,
          "method": "silence",
          "videoSeconds": 151.008
        },
        {
          "text": "Chaque personne a sa case, et des lignes supplémentaires permettent de noter les arrivées imprévues.",
          "startMs": 3769,
          "endMs": 8465,
          "method": "silence",
          "videoSeconds": 153.992
        },
        {
          "text": "Voici aussi une présence déjà enregistrée dans l'application, représentée sur la feuille.",
          "startMs": 9414,
          "endMs": 14048,
          "method": "silence",
          "videoSeconds": 159.637
        },
        {
          "text": "En revanche, cocher une case au stylo ne met pas le site à jour.",
          "startMs": 14487,
          "endMs": 18480,
          "method": "silence",
          "videoSeconds": 164.71
        },
        {
          "text": "Si vous utilisez le papier sur le terrain, il faudra ensuite reporter les présences utiles dans l'application.",
          "startMs": 19041,
          "endMs": 24116,
          "method": "silence",
          "videoSeconds": 169.264
        },
        {
          "text": "Le planning et l'arrivée sont deux informations différentes.",
          "startMs": 24689,
          "endMs": 27590,
          "method": "silence",
          "videoSeconds": 174.912
        }
      ],
      "anchors": [
        {
          "segmentId": "attendance",
          "phrase": "En revanche, cocher une case",
          "startMs": 14487,
          "endMs": 18480,
          "cueMs": 164710
        }
      ],
