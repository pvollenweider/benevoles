    {
      "chapter": "day",
      "startSeconds": 54.383,
      "endSeconds": 79.499,
      "sentences": [
        {
          "text": "Pour l'accueil, le planning par jour est plus direct.",
          "startMs": 310,
          "endMs": 3135,
          "method": "silence",
          "videoSeconds": 54.693
        },
        {
          "text": "Voici la première journée, puis la suivante.",
          "startMs": 3276,
          "endMs": 4963,
          "method": "silence",
          "videoSeconds": 57.659
        },
        {
          "text": "Les postes et les créneaux sont regroupés par date, avec le détail des personnes et des places libres.",
          "startMs": 5232,
          "endMs": 11050,
          "method": "silence",
          "videoSeconds": 59.615
        },
        {
          "text": "Repérons l'accueil du matin et la buvette.",
          "startMs": 11273,
          "endMs": 12880,
          "method": "silence",
          "videoSeconds": 65.656
        },
        {
          "text": "Cette feuille aide à orienter les arrivées sans distribuer un carnet d'adresses.",
          "startMs": 13040,
          "endMs": 17926,
          "method": "silence",
          "videoSeconds": 67.423
        },
        {
          "text": "Vérifions le contenu de la feuille, pas seulement son titre :",
          "startMs": 18413,
          "endMs": 20182,
          "method": "silence",
          "videoSeconds": 72.796
        },
        {
          "text": "les coordonnées privées des bénévoles ne doivent pas devenir une affiche publique.",
          "startMs": 20394,
          "endMs": 24817,
          "method": "silence",
          "videoSeconds": 74.777
        }
      ],
      "anchors": [
        {
