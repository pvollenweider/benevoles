      "chapter": "welcome",
      "startSeconds": 1.298,
      "endSeconds": 23.119,
      "sentences": [
        {
          "text": "Au stand d’accueil, un document clair fait gagner du temps à toute l’équipe.",
          "startMs": 282,
          "endMs": 4323,
          "method": "silence",
          "videoSeconds": 1.58
        },
        {
          "text": "Ouvrons Rapports.",
          "startMs": 4547,
          "endMs": 4910,
          "method": "silence",
          "videoSeconds": 5.845
        },
        {
          "text": "Les feuilles à afficher ou à remettre aux bénévoles arrivent en premier.",
          "startMs": 5136,
          "endMs": 9773,
          "method": "silence",
          "videoSeconds": 6.434
        },
        {
          "text": "Les documents réservés à l’organisation viennent ensuite, puis les badges, le résumé de l’événement et l’archive.",
          "startMs": 10143,
          "endMs": 15369,
          "method": "silence",
          "videoSeconds": 11.441
        },
        {
          "text": "Choisissons ensemble le bon document, avec plusieurs journées et des personnes sur plusieurs postes.",
          "startMs": 15673,
          "endMs": 21612,
          "method": "silence",
          "videoSeconds": 16.971
        }
      ],
