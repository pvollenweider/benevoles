    {
      "chapter": "complete",
      "startSeconds": 25.38,
      "endSeconds": 52.12,
      "sentences": [
        {
          "text": "Pour une vue d’ensemble, descendez dans la partie réservée aux organisateurs et ouvrez Export complet.",
          "startMs": 151,
          "endMs": 5696,
          "method": "silence",
          "videoSeconds": 25.531
        },
        {
          "text": "Ce document en couleur réunit le planning, les créneaux et le récapitulatif des bénévoles.",
          "startMs": 5908,
          "endMs": 10482,
          "method": "silence",
          "videoSeconds": 31.288
        },
        {
          "text": "Lisons une journée, puis retrouvons Léa.",
          "startMs": 10685,
          "endMs": 14874,
          "method": "silence",
          "videoSeconds": 36.065
        },
        {
          "text": "Les effectifs indiquent où il manque du monde.",
          "startMs": 15250,
          "endMs": 16430,
          "method": "silence",
          "videoSeconds": 40.63
        },
        {
          "text": "Le document décrit le planning enregistré au moment de son ouverture, pas une preuve de présence :",
          "startMs": 16604,
          "endMs": 22155,
          "method": "silence",
          "videoSeconds": 41.984
        },
        {
          "text": "une inscription ne veut pas forcément dire que la personne est arrivée.",
          "startMs": 22277,
          "endMs": 26424,
          "method": "silence",
          "videoSeconds": 47.657
        }
      ],
      "anchors": [
        {
