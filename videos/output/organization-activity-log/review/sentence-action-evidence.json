          "startMs": 11252,
          "endMs": 15439,
          "method": "silence",
          "videoSeconds": 103.67
        },
        {
          "text": "Les permissions du compte connecté restent applicables.",
          "startMs": 15790,
          "endMs": 18211,
          "method": "silence",
          "videoSeconds": 108.208
        },
        {
          "text": "On peut aussi retrouver un changement des réglages de notification.",
          "startMs": 19001,
          "endMs": 22432,
          "method": "silence",
          "videoSeconds": 111.419
        },
        {
