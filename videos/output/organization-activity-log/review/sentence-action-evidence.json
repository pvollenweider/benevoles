    {
      "chapter": "read",
      "startSeconds": 31.984,
      "endSeconds": 59.69,
      "sentences": [
        {
          "text": "Chaque ligne indique un auteur, une action et une date.",
          "startMs": 353,
          "endMs": 3086,
          "method": "silence",
          "videoSeconds": 32.337
        },
        {
          "text": "Lisons deux actions réalisées par des personnes différentes.",
          "startMs": 3355,
          "endMs": 8208,
          "method": "silence",
          "videoSeconds": 35.339
        },
        {
          "text": "Cela permet de demander à la bonne personne pourquoi elle a fait un changement.",
          "startMs": 8494,
          "endMs": 12085,
          "method": "silence",
          "videoSeconds": 40.478
        },
        {
          "text": "Le nom affiché vient du compte encore présent ;",
          "startMs": 12698,
          "endMs": 14895,
          "method": "silence",
          "videoSeconds": 44.682
        },
        {
          "text": "si ce compte n'existe plus, une indication générique peut le remplacer.",
          "startMs": 15016,
          "endMs": 19329,
          "method": "silence",
          "videoSeconds": 47
        },
        {
          "text": "Le journal n'est donc pas une signature de contrat, ni une preuve que quelqu'un a lu les consignes.",
          "startMs": 19525,
          "endMs": 24759,
          "method": "silence",
          "videoSeconds": 51.509
        },
        {
          "text": "C'est un repère pour travailler ensemble.",
          "startMs": 24964,
          "endMs": 27704,
          "method": "silence",
          "videoSeconds": 56.948
        }
      ],
      "anchors": [
        {
          "segmentId": "read",
