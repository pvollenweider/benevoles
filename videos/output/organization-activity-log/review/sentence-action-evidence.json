    {
      "chapter": "members",
      "startSeconds": 61.948,
      "endSeconds": 90.147,
      "sentences": [
        {
          "text": "Voici une création de membre, puis une modification et une désactivation.",
          "startMs": 140,
          "endMs": 4543,
          "method": "silence",
          "videoSeconds": 62.088
