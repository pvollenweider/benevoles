    {
      "chapter": "export",
      "startSeconds": 189.112,
      "endSeconds": 222.187,
      "sentences": [
        {
          "text": "Exporter tout le journal télécharge un fichier CSV.",
          "startMs": 449,
          "endMs": 3818,
          "method": "silence",
          "videoSeconds": 189.561
        },
        {
          "text": "Le mot tout est important :",
          "startMs": 4301,
          "endMs": 5203,
          "method": "silence",
          "videoSeconds": 193.413
        },
        {
          "text": "même si l'écran est filtré, ce fichier contient l'historique de l'organisation, pas seulement les lignes visibles.",
          "startMs": 5501,
          "endMs": 12135,
          "method": "silence",
          "videoSeconds": 194.613
        },
        {
          "text": "Ouvrons le vrai fichier téléchargé.",
          "startMs": 12918,
          "endMs": 14625,
          "method": "silence",
          "videoSeconds": 202.03
        },
        {
