    {
      "chapter": "members",
      "startSeconds": 61.96,
      "endSeconds": 90.161,
      "sentences": [
        {
          "text": "Voici une création de membre, puis une modification et une désactivation.",
          "startMs": 140,
          "endMs": 4543,
          "method": "silence",
          "videoSeconds": 62.1
        },
        {
          "text": "Ce sont des actions sur la fiche de l'organisation, pas la liste de tous les créneaux de cette personne.",
