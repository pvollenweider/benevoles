  "chapters": [
    {
      "chapter": "welcome",
      "startSeconds": 1.141,
      "endSeconds": 29.729,
      "sentences": [
        {
          "text": "Quand plusieurs personnes préparent une fête, on peut facilement se demander qui a changé une fiche ou un réglage.",
          "startMs": 299,
          "endMs": 6429,
          "method": "silence",
          "videoSeconds": 1.44
        },
        {
          "text": "Le journal de l'organisation aide à retrouver ces actions transversales.",
          "startMs": 6879,
          "endMs": 10396,
          "method": "silence",
          "videoSeconds": 8.02
        },
        {
          "text": "Ouvrons Journal d'activité depuis les paramètres.",
          "startMs": 11370,
          "endMs": 13999,
          "method": "silence",
          "videoSeconds": 12.511
        },
        {
          "text": "Les noms de notre équipe et les données sont fictifs.",
          "startMs": 14714,
          "endMs": 17056,
          "method": "silence",
          "videoSeconds": 15.855
        },
        {
          "text": "Nous allons lire les actions, filtrer la liste et ouvrir le fichier exporté.",
          "startMs": 17277,
          "endMs": 21635,
          "method": "silence",
          "videoSeconds": 18.418
        },
        {
          "text": "Ce journal ne remplace pas celui d'un événement :",
          "startMs": 22179,
          "endMs": 24788,
          "method": "silence",
          "videoSeconds": 23.32
        },
        {
          "text": "les horaires et les inscriptions se consultent dans leur propre historique.",
          "startMs": 25134,
          "endMs": 28238,
          "method": "silence",
          "videoSeconds": 26.275
        }
      ],
      "anchors": [
        {
