        {
          "text": "il n'accorde pas le droit de refaire cette action.",
          "startMs": 11252,
          "endMs": 15439,
          "method": "silence",
          "videoSeconds": 103.693
        },
        {
          "text": "Les permissions du compte connecté restent applicables.",
          "startMs": 15790,
          "endMs": 18211,
          "method": "silence",
          "videoSeconds": 108.231
        },
        {
          "text": "On peut aussi retrouver un changement des réglages de notification.",
          "startMs": 19001,
          "endMs": 22432,
          "method": "silence",
          "videoSeconds": 111.442
        },
        {
