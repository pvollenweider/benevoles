    {
      "chapter": "team",
      "startSeconds": 92.441,
      "endSeconds": 120.334,
      "sentences": [
        {
          "text": "Les invitations de comptes admin, les changements de rôle et les retraits de l'équipe ont aussi leur place ici.",
          "startMs": 231,
          "endMs": 6287,
          "method": "silence",
          "videoSeconds": 92.672
        },
        {
          "text": "Retrouvons une invitation puis un changement de rôle.",
          "startMs": 6476,
          "endMs": 9814,
          "method": "silence",
          "videoSeconds": 98.917
        },
        {
          "text": "Le journal décrit ce qui a été fait ;",
          "startMs": 10482,
          "endMs": 10483,
          "method": "silence",
          "videoSeconds": 102.923
