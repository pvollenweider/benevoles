    {
      "chapter": "members",
      "startSeconds": 61.969,
      "endSeconds": 90.168,
      "sentences": [
        {
          "text": "Voici une création de membre, puis une modification et une désactivation.",
          "startMs": 140,
          "endMs": 4543,
          "method": "silence",
          "videoSeconds": 62.109
