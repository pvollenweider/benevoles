            "atMs": 58668
          }
        }
      ],
      "interactions": [
        {
          "kind": "click",
          "atMs": 58018
        }
      ]
    },
    {
      "chapter": "errors",
      "id": "errors",
      "startMs": 72135,
      "endMs": 95516,
      "sentences": [
        {
          "text": "Ici, la ligne six n'a pas de prénom, et la ligne sept contient une adresse email invalide.",
          "startMs": 334,
          "endMs": 5568,
          "method": "silence",
          "absoluteStartMs": 72469
        },
        {
          "text": "La ligne neuf reprend l'email de la ligne huit :",
          "startMs": 6353,
          "endMs": 8740,
          "method": "silence",
          "absoluteStartMs": 78488
        },
        {
          "text": "ce doublon dans le fichier est également signalé.",
          "startMs": 9088,
          "endMs": 11368,
          "method": "silence",
          "absoluteStartMs": 81223
        },
        {
          "text": "Ces lignes ne seront pas importées.",
          "startMs": 11981,
          "endMs": 13473,
          "method": "silence",
          "absoluteStartMs": 84116
        },
        {
          "text": "Corrigez le fichier d'origine plutôt que de laisser une erreur de contact.",
          "startMs": 13976,
          "endMs": 17162,
          "method": "silence",
          "absoluteStartMs": 86111
        },
        {
          "text": "Deux personnes portant le même nom ne sont pas automatiquement fusionnées :",
          "startMs": 17798,
          "endMs": 21214,
          "method": "silence",
          "absoluteStartMs": 89933
        },
        {
          "text": "la comparaison utilise l'email.",
          "startMs": 21214,
          "endMs": 23018,
          "method": "estimate",
          "absoluteStartMs": 93349
        }
      ],
      "anchors": [
        {
          "segmentId": "errors",
          "phrase": "Corrigez le fichier d'origine plutôt",
          "startMs": 13976,
          "endMs": 17162,
          "cueMs": 86110,
          "sentenceAbsoluteMs": 86111,
          "firstInputAfterAnchor": null,
          "deltaMs": null,
          "frame": {
            "file": "/private/tmp/codex-video/videos/output/members-import/review/anchors/errors-1.png",
            "atMs": 86760
          }
        }
      ],
      "interactions": []
    },
    {
      "chapter": "update",
      "id": "update",
      "startMs": 95969,
      "endMs": 121718,
      "sentences": [
        {
          "text": "Avec Retour, vous pouvez changer l'option puis refaire l'analyse.",
          "startMs": 363,
          "endMs": 4138,
          "method": "silence",
          "absoluteStartMs": 96332
        },
        {
          "text": "Mettre à jour remplace le prénom, le nom, le téléphone et les tags de la fiche portant le même email.",
          "startMs": 4895,
          "endMs": 10327,
          "method": "silence",
          "absoluteStartMs": 100864
        },
        {
          "text": "Cela réactive aussi une fiche inactive.",
          "startMs": 10685,
          "endMs": 12959,
          "method": "silence",
          "absoluteStartMs": 106654
        },
        {
          "text": "Les tags ne sont donc pas simplement ajoutés aux anciens :",
          "startMs": 13591,
          "endMs": 15899,
          "method": "silence",
          "absoluteStartMs": 109560
        },
        {
          "text": "vérifiez bien les valeurs du fichier.",
          "startMs": 16367,
          "endMs": 18861,
          "method": "silence",
          "absoluteStartMs": 112336
        },
        {
          "text": "Ici, Camille et Julien passent de Ignorer à Mettre à jour, sans créer de nouvelles fiches pour ces adresses.",
          "startMs": 19079,
          "endMs": 25624,
          "method": "silence",
          "absoluteStartMs": 115048
        }
      ],
      "anchors": [
        {
          "segmentId": "update",
