{
  "videoSha256": "6c63cfc00e59ce3026b1125fed8d2f2337807bc7f8962025f98d4a144ae2e696",
  "chapters": [
    {
      "chapter": "welcome",
      "id": "welcome",
      "startMs": 137,
      "endMs": 22049,
      "sentences": [
        {
          "text": "Vous utilisez Benevol pour la première fois et vous avez déjà une liste de bénévoles ?",
          "startMs": 420,
          "endMs": 4880,
          "method": "silence",
          "absoluteStartMs": 557
        },
        {
          "text": "L'import évite de ressaisir chaque personne.",
          "startMs": 5314,
          "endMs": 7951,
          "method": "silence",
          "absoluteStartMs": 5451
        },
        {
          "text": "Il peut aussi compléter une liste existante.",
          "startMs": 8262,
          "endMs": 10547,
          "method": "silence",
          "absoluteStartMs": 8399
        },
        {
          "text": "Nous allons utiliser quarante fiches fictives, vérifier les erreurs, puis confirmer seulement quand tout est clair.",
          "startMs": 11214,
          "endMs": 17096,
          "method": "silence",
          "absoluteStartMs": 11351
        },
        {
          "text": "Bien sûr, vous pouvez toujours créer les membres manuellement avec Nouveau membre.",
          "startMs": 17519,
          "endMs": 21471,
          "method": "silence",
          "absoluteStartMs": 17656
        }
      ],
      "anchors": [],
      "interactions": []
    },
    {
      "chapter": "file",
      "id": "file",
      "startMs": 22501,
      "endMs": 46860,
      "sentences": [
        {
          "text": "Le fichier peut être un CSV ou un Excel.",
          "startMs": 443,
          "endMs": 3022,
          "method": "silence",
          "absoluteStartMs": 22944
        },
        {
          "text": "La première ligne contient les noms des colonnes :",
          "startMs": 3362,
          "endMs": 5421,
          "method": "silence",
          "absoluteStartMs": 25863
        },
        {
          "text": "prénom, nom, email, téléphone et tags.",
          "startMs": 5809,
          "endMs": 7814,
          "method": "silence",
          "absoluteStartMs": 28310
        },
        {
          "text": "Le prénom et le nom sont nécessaires.",
          "startMs": 8019,
          "endMs": 9357,
          "method": "silence",
          "absoluteStartMs": 30520
        },
        {
          "text": "Une fiche sans email reste possible, mais elle ne recevra pas de messages par email.",
          "startMs": 9989,
          "endMs": 16691,
          "method": "silence",
          "absoluteStartMs": 32490
        },
        {
          "text": "Les tags se séparent par des virgules.",
          "startMs": 17191,
          "endMs": 19004,
          "method": "silence",
          "absoluteStartMs": 39692
        },
        {
          "text": "Les disponibilités, elles, se renseignent ensuite dans la fiche :",
          "startMs": 19672,
          "endMs": 22811,
          "method": "silence",
          "absoluteStartMs": 42173
        },
        {
          "text": "elles ne sont pas importées.",
          "startMs": 22989,
          "endMs": 23957,
          "method": "silence",
          "absoluteStartMs": 45490
        }
      ],
      "anchors": [
        {
          "segmentId": "file",
          "phrase": "prénom, nom, email, téléphone et",
          "startMs": 5809,
          "endMs": 7814,
          "cueMs": 28312,
          "sentenceAbsoluteMs": 28310,
          "firstInputAfterAnchor": null,
          "deltaMs": null,
