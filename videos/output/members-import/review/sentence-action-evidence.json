    {
      "chapter": "corrected",
      "id": "corrected",
      "startMs": 122170,
      "endMs": 146615,
      "sentences": [
        {
          "text": "Nous choisissons maintenant le fichier Excel corrigé et relançons l'analyse.",
          "startMs": 150,
          "endMs": 3953,
          "method": "silence",
          "absoluteStartMs": 122320
        },
        {
          "text": "Les erreurs ont disparu.",
          "startMs": 4757,
          "endMs": 5794,
          "method": "silence",
          "absoluteStartMs": 126927
        },
        {
          "text": "Les quarante lignes sont reconnues, dont les deux adresses déjà présentes.",
          "startMs": 6373,
          "endMs": 10139,
          "method": "silence",
          "absoluteStartMs": 128543
        },
        {
          "text": "René n'a pas d'email :",
          "startMs": 10895,
          "endMs": 11980,
          "method": "silence",
          "absoluteStartMs": 133065
        },
        {
          "text": "sa fiche peut être créée avec son téléphone.",
          "startMs": 12315,
          "endMs": 14323,
          "method": "silence",
          "absoluteStartMs": 134485
        },
        {
          "text": "Vérifiez une dernière fois les noms, les catégories et le récapitulatif.",
          "startMs": 14998,
          "endMs": 19403,
          "method": "silence",
          "absoluteStartMs": 137168
        },
        {
          "text": "Le fichier est limité à deux mégaoctets et cinq mille lignes par import.",
          "startMs": 20038,
          "endMs": 24106,
          "method": "silence",
          "absoluteStartMs": 142208
        }
      ],
      "anchors": [
        {
