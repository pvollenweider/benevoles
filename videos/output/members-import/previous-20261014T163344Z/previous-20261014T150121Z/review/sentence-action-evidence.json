  {
    "chapter": "update",
    "startMs": 98796,
    "endMs": 125806,
    "sentences": [
      {
        "text": "Avec Retour, vous pouvez changer l'option puis refaire l'analyse.",
        "startMs": 458,
        "endMs": 4547,
        "method": "silence",
        "absoluteStartMs": 99254
      },
      {
        "text": "Mettre à jour remplace le prénom, le nom, le téléphone et les tags de la fiche portant le même email.",
        "startMs": 5258,
        "endMs": 11970,
        "method": "silence",
        "absoluteStartMs": 104054
      },
      {
        "text": "Cela réactive aussi une fiche inactive.",
        "startMs": 12571,
        "endMs": 14513,
        "method": "silence",
        "absoluteStartMs": 111367
      },
      {
        "text": "Les tags ne sont donc pas simplement ajoutés aux anciens :",
        "startMs": 15226,
        "endMs": 17618,
        "method": "silence",
        "absoluteStartMs": 114022
      },
      {
        "text": "vérifiez bien les valeurs du fichier.",
        "startMs": 18079,
        "endMs": 19405,
        "method": "silence",
        "absoluteStartMs": 116875
      },
      {
        "text": "Ici, Camille et Julien passent de Ignorer à Mettre à jour, sans créer de nouvelles fiches pour ces adresses.",
        "startMs": 20071,
        "endMs": 26790,
        "method": "silence",
        "absoluteStartMs": 118867
      }
    ],
    "anchors": [
      {
        "segmentId": "update",
