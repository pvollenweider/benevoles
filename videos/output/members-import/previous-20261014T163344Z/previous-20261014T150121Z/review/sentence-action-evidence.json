  {
    "chapter": "confirm",
    "startMs": 152487,
    "endMs": 176913,
    "sentences": [
      {
        "text": "Quand l'aperçu te convient, confirme l'import.",
        "startMs": 248,
        "endMs": 2975,
        "method": "silence",
        "absoluteStartMs": 152735
      },
