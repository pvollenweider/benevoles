[
  {
    "chapter": "welcome",
    "startMs": 148,
    "endMs": 22173,
    "sentences": [
      {
        "text": "Vous utilisez Benevol pour la première fois et vous avez déjà une liste de bénévoles ?",
        "startMs": 282,
        "endMs": 4765,
        "method": "silence",
        "absoluteStartMs": 430
      },
      {
        "text": "L'import évite de ressaisir chaque personne.",
        "startMs": 5183,
        "endMs": 7787,
        "method": "silence",
        "absoluteStartMs": 5331
      },
      {
        "text": "Il peut aussi compléter une liste existante.",
        "startMs": 8216,
        "endMs": 10384,
        "method": "silence",
        "absoluteStartMs": 8364
      },
      {
        "text": "Nous allons utiliser quarante fiches fictives, vérifier les erreurs, puis confirmer seulement quand tout est clair.",
        "startMs": 10828,
        "endMs": 16927,
        "method": "silence",
        "absoluteStartMs": 10976
      },
      {
        "text": "Bien sûr, vous pouvez toujours créer les membres manuellement avec Nouveau membre.",
        "startMs": 17709,
        "endMs": 21644,
        "method": "silence",
        "absoluteStartMs": 17857
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "file",
    "startMs": 22625,
    "endMs": 48232,
    "sentences": [
      {
        "text": "Le fichier peut être un CSV ou un Excel.",
        "startMs": 401,
        "endMs": 3207,
        "method": "silence",
        "absoluteStartMs": 23026
      },
      {
        "text": "La première ligne contient les noms des colonnes :",
        "startMs": 3868,
        "endMs": 5738,
        "method": "silence",
        "absoluteStartMs": 26493
      },
      {
        "text": "prénom, nom, email, téléphone et tags.",
        "startMs": 6272,
        "endMs": 8414,
        "method": "silence",
        "absoluteStartMs": 28897
      },
      {
        "text": "Le prénom et le nom sont nécessaires.",
        "startMs": 8706,
        "endMs": 10813,
        "method": "silence",
        "absoluteStartMs": 31331
      },
      {
        "text": "Une fiche sans email reste possible, mais elle ne recevra pas de messages par email.",
        "startMs": 10937,
        "endMs": 17402,
        "method": "silence",
        "absoluteStartMs": 33562
      },
      {
        "text": "Les tags se séparent par des virgules.",
        "startMs": 18120,
        "endMs": 19965,
        "method": "silence",
        "absoluteStartMs": 40745
      },
      {
        "text": "Les disponibilités, elles, se renseignent ensuite dans la fiche :",
        "startMs": 20573,
        "endMs": 23898,
        "method": "silence",
        "absoluteStartMs": 43198
      },
      {
        "text": "elles ne sont pas importées.",
        "startMs": 24258,
        "endMs": 25212,
        "method": "silence",
        "absoluteStartMs": 46883
      }
    ],
    "anchors": [
      {
        "segmentId": "file",
        "phrase": "prénom, nom, email, téléphone et",
        "startMs": 6272,
        "endMs": 8414,
        "cueMs": 28898
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 23115
      }
    ]
  },
  {
    "chapter": "preview",
    "startMs": 48685,
    "endMs": 74312,
    "sentences": [
      {
        "text": "Ouvrez Importer des membres et choisissez le fichier à vérifier.",
        "startMs": 401,
        "endMs": 3885,
        "method": "silence",
        "absoluteStartMs": 49086
      },
      {
        "text": "Si un email existe déjà, l'option Ignorer conserve la fiche actuelle.",
        "startMs": 4529,
        "endMs": 8966,
        "method": "silence",
        "absoluteStartMs": 53214
      },
      {
        "text": "Cliquez sur Analyser le fichier.",
        "startMs": 9708,
        "endMs": 10474,
        "method": "silence",
        "absoluteStartMs": 58393
      },
      {
        "text": "Le récapitulatif montre les créations prévues, les personnes déjà présentes et les lignes en erreur.",
        "startMs": 10722,
        "endMs": 16751,
        "method": "silence",
        "absoluteStartMs": 59407
      },
      {
        "text": "Les colonnes reconnues et les tags sont également indiqués.",
        "startMs": 17314,
        "endMs": 21413,
        "method": "silence",
        "absoluteStartMs": 65999
      },
      {
        "text": "Rien n'est encore enregistré :",
        "startMs": 21913,
        "endMs": 23288,
        "method": "silence",
        "absoluteStartMs": 70598
      },
      {
        "text": "vous pouvez prendre le temps de vérifier.",
        "startMs": 23828,
        "endMs": 25212,
        "method": "silence",
        "absoluteStartMs": 72513
      }
    ],
    "anchors": [
      {
        "segmentId": "preview",
        "phrase": "Le récapitulatif montre les créations",
        "startMs": 10722,
        "endMs": 16751,
        "cueMs": 59407
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 59898
      }
    ]
  },
  {
    "chapter": "errors",
    "startMs": 74765,
    "endMs": 98344,
    "sentences": [
      {
        "text": "Ici, la ligne six n'a pas de prénom, et la ligne sept contient une adresse email invalide.",
        "startMs": 464,
        "endMs": 5354,
        "method": "silence",
        "absoluteStartMs": 75229
      },
      {
        "text": "La ligne neuf reprend l'email de la ligne huit :",
        "startMs": 6060,
        "endMs": 8374,
        "method": "silence",
        "absoluteStartMs": 80825
      },
      {
        "text": "ce doublon dans le fichier est également signalé.",
        "startMs": 8985,
        "endMs": 10834,
        "method": "silence",
        "absoluteStartMs": 83750
      },
      {
        "text": "Ces lignes ne seront pas importées.",
        "startMs": 11447,
        "endMs": 13211,
        "method": "silence",
        "absoluteStartMs": 86212
      },
      {
        "text": "Corrige le fichier d'origine plutôt que de laisser une erreur de contact.",
        "startMs": 13836,
        "endMs": 17009,
        "method": "silence",
        "absoluteStartMs": 88601
      },
      {
        "text": "Deux personnes portant le même nom ne sont pas automatiquement fusionnées :",
        "startMs": 17726,
        "endMs": 20848,
        "method": "silence",
        "absoluteStartMs": 92491
      },
      {
        "text": "la comparaison utilise l'email.",
        "startMs": 21394,
        "endMs": 23118,
        "method": "silence",
        "absoluteStartMs": 96159
      }
    ],
    "anchors": [
      {
        "segmentId": "errors",
