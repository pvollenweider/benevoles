  {
    "chapter": "confirm",
    "startMs": 152477,
    "endMs": 176903,
    "sentences": [
      {
        "text": "Quand l'aperçu te convient, confirme l'import.",
        "startMs": 248,
        "endMs": 2975,
        "method": "silence",
        "absoluteStartMs": 152725
      },
      {
        "text": "Cette fois, les fiches sont enregistrées.",
        "startMs": 3558,
        "endMs": 5375,
        "method": "silence",
        "absoluteStartMs": 156035
      },
      {
        "text": "Le résultat indique combien ont été créées, mises à jour ou ignorées, et signale les éventuelles lignes non importées.",
        "startMs": 5850,
        "endMs": 12780,
        "method": "silence",
        "absoluteStartMs": 158327
      },
      {
        "text": "Ferme la fenêtre et recherchez Maya :",
        "startMs": 13538,
        "endMs": 15608,
        "method": "silence",
        "absoluteStartMs": 166015
      },
      {
        "text": "elle est maintenant dans la liste.",
        "startMs": 16110,
        "endMs": 17242,
        "method": "silence",
        "absoluteStartMs": 168587
      },
      {
        "text": "Ouvrez sa fiche pour vérifier son téléphone et ses tags.",
        "startMs": 17585,
        "endMs": 20640,
        "method": "silence",
        "absoluteStartMs": 170062
      },
      {
