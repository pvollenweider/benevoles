[
  {
    "chapter": "welcome",
    "startMs": 138,
    "endMs": 22163,
    "sentences": [
      {
        "text": "Vous utilisez Benevol pour la première fois et vous avez déjà une liste de bénévoles ?",
        "startMs": 282,
        "endMs": 4765,
        "method": "silence",
        "absoluteStartMs": 420
      },
      {
        "text": "L'import évite de ressaisir chaque personne.",
        "startMs": 5183,
        "endMs": 7787,
        "method": "silence",
        "absoluteStartMs": 5321
      },
      {
        "text": "Il peut aussi compléter une liste existante.",
        "startMs": 8216,
        "endMs": 10384,
        "method": "silence",
        "absoluteStartMs": 8354
      },
      {
        "text": "Nous allons utiliser quarante fiches fictives, vérifier les erreurs, puis confirmer seulement quand tout est clair.",
        "startMs": 10828,
        "endMs": 16927,
        "method": "silence",
        "absoluteStartMs": 10966
      },
      {
        "text": "Bien sûr, vous pouvez toujours créer les membres manuellement avec Nouveau membre.",
        "startMs": 17709,
        "endMs": 21644,
        "method": "silence",
        "absoluteStartMs": 17847
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "file",
    "startMs": 22616,
    "endMs": 48225,
    "sentences": [
      {
        "text": "Le fichier peut être un CSV ou un Excel.",
        "startMs": 401,
        "endMs": 3207,
        "method": "silence",
        "absoluteStartMs": 23017
      },
      {
        "text": "La première ligne contient les noms des colonnes :",
        "startMs": 3868,
        "endMs": 5738,
        "method": "silence",
        "absoluteStartMs": 26484
      },
      {
        "text": "prénom, nom, email, téléphone et tags.",
        "startMs": 6272,
        "endMs": 8414,
        "method": "silence",
        "absoluteStartMs": 28888
      },
      {
        "text": "Le prénom et le nom sont nécessaires.",
        "startMs": 8706,
        "endMs": 10813,
        "method": "silence",
        "absoluteStartMs": 31322
      },
      {
        "text": "Une fiche sans email reste possible, mais elle ne recevra pas de messages par email.",
        "startMs": 10937,
        "endMs": 17402,
        "method": "silence",
        "absoluteStartMs": 33553
      },
      {
        "text": "Les tags se séparent par des virgules.",
        "startMs": 18120,
        "endMs": 19965,
        "method": "silence",
        "absoluteStartMs": 40736
      },
      {
        "text": "Les disponibilités, elles, se renseignent ensuite dans la fiche :",
        "startMs": 20573,
        "endMs": 23898,
        "method": "silence",
        "absoluteStartMs": 43189
      },
      {
        "text": "elles ne sont pas importées.",
        "startMs": 24258,
        "endMs": 25212,
        "method": "silence",
        "absoluteStartMs": 46874
      }
    ],
    "anchors": [
      {
        "segmentId": "file",
