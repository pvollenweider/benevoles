        "startMs": 13029,
        "endMs": 15696,
        "method": "silence",
        "absoluteStartMs": 139280
      },
      {
        "text": "Vérifiez une dernière fois les noms, les catégories et le récapitulatif.",
        "startMs": 15912,
        "endMs": 20530,
        "method": "silence",
        "absoluteStartMs": 142163
      },
