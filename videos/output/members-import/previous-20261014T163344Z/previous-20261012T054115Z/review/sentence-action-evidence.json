        "startMs": 6272,
        "endMs": 8414,
        "cueMs": 28890
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 23090
      }
    ]
  },
  {
    "chapter": "preview",
    "startMs": 48680,
    "endMs": 74308,
    "sentences": [
      {
        "text": "Ouvrez Importer des membres et choisissez le fichier à vérifier.",
        "startMs": 401,
        "endMs": 3885,
        "method": "silence",
        "absoluteStartMs": 49081
      },
      {
        "text": "Si un email existe déjà, l'option Ignorer conserve la fiche actuelle.",
        "startMs": 4529,
        "endMs": 8966,
        "method": "silence",
        "absoluteStartMs": 53209
      },
      {
        "text": "Cliquez sur Analyser le fichier.",
        "startMs": 9708,
        "endMs": 10474,
        "method": "silence",
        "absoluteStartMs": 58388
      },
      {
        "text": "Le récapitulatif montre les créations prévues, les personnes déjà présentes et les lignes en erreur.",
        "startMs": 10722,
        "endMs": 16751,
        "method": "silence",
        "absoluteStartMs": 59402
      },
      {
        "text": "Les colonnes reconnues et les tags sont également indiqués.",
        "startMs": 17314,
        "endMs": 21413,
        "method": "silence",
        "absoluteStartMs": 65994
      },
      {
        "text": "Rien n'est encore enregistré :",
        "startMs": 21913,
        "endMs": 23288,
        "method": "silence",
        "absoluteStartMs": 70593
      },
      {
        "text": "vous pouvez prendre le temps de vérifier.",
        "startMs": 23828,
        "endMs": 25212,
        "method": "silence",
        "absoluteStartMs": 72508
      }
    ],
    "anchors": [
      {
        "segmentId": "preview",
        "phrase": "Le récapitulatif montre les créations",
        "startMs": 10722,
        "endMs": 16751,
        "cueMs": 59403
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 59890
      }
    ]
  },
  {
    "chapter": "errors",
    "startMs": 74760,
    "endMs": 98337,
    "sentences": [
      {
        "text": "Ici, la ligne six n'a pas de prénom, et la ligne sept contient une adresse email invalide.",
        "startMs": 464,
        "endMs": 5354,
        "method": "silence",
        "absoluteStartMs": 75224
      },
      {
        "text": "La ligne neuf reprend l'email de la ligne huit :",
        "startMs": 6060,
        "endMs": 8374,
        "method": "silence",
        "absoluteStartMs": 80820
      },
      {
        "text": "ce doublon dans le fichier est également signalé.",
        "startMs": 8985,
        "endMs": 10834,
        "method": "silence",
        "absoluteStartMs": 83745
      },
      {
        "text": "Ces lignes ne seront pas importées.",
        "startMs": 11447,
        "endMs": 13211,
        "method": "silence",
        "absoluteStartMs": 86207
      },
      {
        "text": "Corrige le fichier d'origine plutôt que de laisser une erreur de contact.",
        "startMs": 13836,
        "endMs": 17009,
        "method": "silence",
        "absoluteStartMs": 88596
      },
      {
        "text": "Deux personnes portant le même nom ne sont pas automatiquement fusionnées :",
        "startMs": 17726,
        "endMs": 20848,
        "method": "silence",
        "absoluteStartMs": 92486
      },
      {
        "text": "la comparaison utilise l'email.",
        "startMs": 21394,
        "endMs": 23118,
        "method": "silence",
        "absoluteStartMs": 96154
      }
    ],
    "anchors": [
      {
        "segmentId": "errors",
        "phrase": "Corrige le fichier d'origine plutôt",
        "startMs": 13836,
        "endMs": 17009,
        "cueMs": 88597
      }
    ],
    "interactions": []
