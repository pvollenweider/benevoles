  {
    "chapter": "corrected",
    "startMs": 126251,
    "endMs": 152024,
    "sentences": [
      {
        "text": "Nous choisissons maintenant le fichier Excel corrigé et relançons l'analyse.",
        "startMs": 254,
        "endMs": 5385,
        "method": "silence",
        "absoluteStartMs": 126505
      },
      {
