  {
    "chapter": "result",
    "startMs": 199271,
    "endMs": 220456,
    "sentences": [
      {
        "text": "Ta liste est prête à être utilisée pour les prochaines invitations.",
        "startMs": 536,
        "endMs": 3900,
        "method": "silence",
        "absoluteStartMs": 199807
      },
      {
        "text": "Garde un fichier simple, vérifiez les coordonnées et lis l'aperçu avant chaque confirmation.",
        "startMs": 4069,
        "endMs": 9171,
        "method": "silence",
        "absoluteStartMs": 203340
      },
      {
        "text": "Si quelques personnes manquent, ajoute-les manuellement.",
        "startMs": 9599,
        "endMs": 12247,
        "method": "silence",
        "absoluteStartMs": 208870
      },
      {
        "text": "Et si leurs disponibilités changent, complète leur fiche séparément.",
        "startMs": 12625,
        "endMs": 15945,
        "method": "silence",
        "absoluteStartMs": 211896
      },
      {
        "text": "L'import fait gagner du temps, tout en te laissant le dernier mot sur ce qui sera enregistré.",
        "startMs": 16363,
        "endMs": 20910,
        "method": "silence",
        "absoluteStartMs": 215634
      }
    ],
