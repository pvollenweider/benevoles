    {
      "chapter": "confirm",
      "id": "confirm",
      "startMs": 147078,
      "endMs": 171450,
      "sentences": [
        {
          "text": "Quand l'aperçu vous convient, confirmez l'import.",
          "startMs": 412,
          "endMs": 3183,
          "method": "silence",
          "absoluteStartMs": 147490
        },
        {
          "text": "Cette fois, les fiches sont enregistrées.",
          "startMs": 3844,
          "endMs": 5869,
          "method": "silence",
          "absoluteStartMs": 150922
        },
        {
          "text": "Le résultat indique combien ont été créées, mises à jour ou ignorées, et signale les éventuelles lignes non importées.",
          "startMs": 6639,
          "endMs": 13219,
          "method": "silence",
          "absoluteStartMs": 153717
        },
        {
          "text": "Fermez la fenêtre et recherchez Maya :",
          "startMs": 13962,
          "endMs": 16313,
          "method": "silence",
          "absoluteStartMs": 161040
        },
        {
          "text": "elle est maintenant dans la liste.",
          "startMs": 16837,
          "endMs": 18113,
          "method": "silence",
          "absoluteStartMs": 163915
        },
        {
          "text": "Ouvrez sa fiche pour vérifier son téléphone et ses tags.",
          "startMs": 18636,
          "endMs": 21079,
          "method": "silence",
          "absoluteStartMs": 165714
        },
        {
          "text": "Importer une personne ne l'inscrit à aucun créneau.",
          "startMs": 21386,
          "endMs": 24106,
          "method": "silence",
          "absoluteStartMs": 168464
        }
      ],
