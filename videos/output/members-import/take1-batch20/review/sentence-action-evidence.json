    {
      "chapter": "update",
      "id": "update",
      "startMs": 95981,
      "endMs": 121730,
      "sentences": [
        {
          "text": "Avec Retour, vous pouvez changer l'option puis refaire l'analyse.",
          "startMs": 363,
          "endMs": 4138,
          "method": "silence",
          "absoluteStartMs": 96344
        },
        {
          "text": "Mettre à jour remplace le prénom, le nom, le téléphone et les tags de la fiche portant le même email.",
          "startMs": 4895,
          "endMs": 10327,
          "method": "silence",
          "absoluteStartMs": 100876
        },
        {
          "text": "Cela réactive aussi une fiche inactive.",
          "startMs": 10685,
          "endMs": 12959,
          "method": "silence",
          "absoluteStartMs": 106666
        },
        {
          "text": "Les tags ne sont donc pas simplement ajoutés aux anciens :",
          "startMs": 13591,
          "endMs": 15899,
          "method": "silence",
          "absoluteStartMs": 109572
        },
        {
          "text": "vérifiez bien les valeurs du fichier.",
          "startMs": 16367,
          "endMs": 18861,
          "method": "silence",
          "absoluteStartMs": 112348
        },
        {
          "text": "Ici, Camille et Julien passent de Ignorer à Mettre à jour, sans créer de nouvelles fiches pour ces adresses.",
          "startMs": 19079,
          "endMs": 25624,
          "method": "silence",
          "absoluteStartMs": 115060
        }
      ],
      "anchors": [
        {
          "segmentId": "update",
