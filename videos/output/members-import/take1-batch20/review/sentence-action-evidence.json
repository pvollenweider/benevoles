            "atMs": 58648
          }
        }
      ],
      "interactions": [
        {
          "kind": "click",
          "atMs": 57998
        }
      ]
    },
    {
      "chapter": "errors",
      "id": "errors",
      "startMs": 72145,
      "endMs": 95527,
      "sentences": [
        {
          "text": "Ici, la ligne six n'a pas de prénom, et la ligne sept contient une adresse email invalide.",
          "startMs": 334,
          "endMs": 5568,
          "method": "silence",
          "absoluteStartMs": 72479
        },
        {
          "text": "La ligne neuf reprend l'email de la ligne huit :",
          "startMs": 6353,
          "endMs": 8740,
          "method": "silence",
          "absoluteStartMs": 78498
        },
        {
          "text": "ce doublon dans le fichier est également signalé.",
          "startMs": 9088,
          "endMs": 11368,
          "method": "silence",
          "absoluteStartMs": 81233
        },
        {
          "text": "Ces lignes ne seront pas importées.",
          "startMs": 11981,
          "endMs": 13473,
          "method": "silence",
          "absoluteStartMs": 84126
        },
        {
          "text": "Corrigez le fichier d'origine plutôt que de laisser une erreur de contact.",
          "startMs": 13976,
          "endMs": 17162,
          "method": "silence",
          "absoluteStartMs": 86121
        },
        {
          "text": "Deux personnes portant le même nom ne sont pas automatiquement fusionnées :",
          "startMs": 17798,
          "endMs": 21214,
          "method": "silence",
          "absoluteStartMs": 89943
        },
        {
          "text": "la comparaison utilise l'email.",
          "startMs": 21214,
          "endMs": 23018,
          "method": "estimate",
          "absoluteStartMs": 93359
        }
      ],
      "anchors": [
        {
          "segmentId": "errors",
          "phrase": "Corrigez le fichier d'origine plutôt",
          "startMs": 13976,
          "endMs": 17162,
          "cueMs": 86122,
          "sentenceAbsoluteMs": 86121,
          "firstInputAfterAnchor": null,
          "deltaMs": null,
          "frame": {
            "file": "/private/tmp/codex-video/videos/output/members-import/review/anchors/errors-1.png",
            "atMs": 86772
          }
        }
      ],
      "interactions": []
