{
  "videoSha256": "aaa2efea53a808d86c47d512edf477c4e005e4c053397952f16d1001e8e6fabd",
  "chapters": [
    {
      "chapter": "welcome",
      "id": "welcome",
      "startMs": 148,
      "endMs": 22060,
      "sentences": [
        {
          "text": "Vous utilisez Benevol pour la première fois et vous avez déjà une liste de bénévoles ?",
          "startMs": 420,
          "endMs": 4880,
          "method": "silence",
          "absoluteStartMs": 568
        },
        {
          "text": "L'import évite de ressaisir chaque personne.",
          "startMs": 5314,
          "endMs": 7951,
          "method": "silence",
          "absoluteStartMs": 5462
        },
        {
          "text": "Il peut aussi compléter une liste existante.",
          "startMs": 8262,
          "endMs": 10547,
          "method": "silence",
          "absoluteStartMs": 8410
        },
        {
          "text": "Nous allons utiliser quarante fiches fictives, vérifier les erreurs, puis confirmer seulement quand tout est clair.",
          "startMs": 11214,
          "endMs": 17096,
          "method": "silence",
          "absoluteStartMs": 11362
        },
        {
          "text": "Bien sûr, vous pouvez toujours créer les membres manuellement avec Nouveau membre.",
          "startMs": 17519,
          "endMs": 21471,
          "method": "silence",
          "absoluteStartMs": 17667
        }
      ],
      "anchors": [],
      "interactions": []
    },
    {
      "chapter": "file",
      "id": "file",
      "startMs": 22512,
      "endMs": 46872,
      "sentences": [
        {
          "text": "Le fichier peut être un CSV ou un Excel.",
          "startMs": 443,
          "endMs": 3022,
          "method": "silence",
          "absoluteStartMs": 22955
        },
        {
          "text": "La première ligne contient les noms des colonnes :",
          "startMs": 3362,
          "endMs": 5421,
          "method": "silence",
          "absoluteStartMs": 25874
        },
        {
          "text": "prénom, nom, email, téléphone et tags.",
          "startMs": 5809,
          "endMs": 7814,
          "method": "silence",
          "absoluteStartMs": 28321
        },
        {
          "text": "Le prénom et le nom sont nécessaires.",
          "startMs": 8019,
          "endMs": 9357,
          "method": "silence",
          "absoluteStartMs": 30531
        },
        {
          "text": "Une fiche sans email reste possible, mais elle ne recevra pas de messages par email.",
          "startMs": 9989,
          "endMs": 16691,
          "method": "silence",
          "absoluteStartMs": 32501
        },
        {
          "text": "Les tags se séparent par des virgules.",
          "startMs": 17191,
          "endMs": 19004,
          "method": "silence",
          "absoluteStartMs": 39703
        },
        {
          "text": "Les disponibilités, elles, se renseignent ensuite dans la fiche :",
          "startMs": 19672,
          "endMs": 22811,
          "method": "silence",
          "absoluteStartMs": 42184
        },
        {
          "text": "elles ne sont pas importées.",
          "startMs": 22989,
          "endMs": 23957,
          "method": "silence",
          "absoluteStartMs": 45501
        }
      ],
      "anchors": [
        {
          "segmentId": "file",
          "phrase": "prénom, nom, email, téléphone et",
          "startMs": 5809,
          "endMs": 7814,
          "cueMs": 28323,
          "sentenceAbsoluteMs": 28321,
          "firstInputAfterAnchor": null,
          "deltaMs": null,
