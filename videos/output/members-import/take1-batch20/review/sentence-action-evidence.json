    {
      "chapter": "preview",
      "id": "preview",
      "startMs": 47324,
      "endMs": 71694,
      "sentences": [
        {
          "text": "Ouvrez Importer des membres et choisissez le fichier à vérifier.",
          "startMs": 401,
          "endMs": 3965,
          "method": "silence",
          "absoluteStartMs": 47725
        },
        {
          "text": "Si un email existe déjà, l'option Ignorer conserve la fiche actuelle.",
          "startMs": 4640,
          "endMs": 8811,
          "method": "silence",
          "absoluteStartMs": 51964
        },
        {
          "text": "Cliquez sur Analyser le fichier.",
          "startMs": 9351,
          "endMs": 10075,
          "method": "silence",
          "absoluteStartMs": 56675
        },
        {
          "text": "Le récapitulatif montre les créations prévues, les personnes déjà présentes et les lignes en erreur.",
          "startMs": 10208,
          "endMs": 15719,
          "method": "silence",
          "absoluteStartMs": 57532
        },
        {
          "text": "Les colonnes reconnues et les tags sont également indiqués.",
          "startMs": 15971,
          "endMs": 18570,
          "method": "silence",
          "absoluteStartMs": 63295
        },
        {
          "text": "Rien n'est encore enregistré :",
          "startMs": 18694,
          "endMs": 20302,
          "method": "silence",
          "absoluteStartMs": 66018
        },
        {
          "text": "vous pouvez prendre le temps de vérifier.",
          "startMs": 20954,
          "endMs": 24044,
          "method": "silence",
          "absoluteStartMs": 68278
        }
      ],
      "anchors": [
        {
          "segmentId": "preview",
          "phrase": "Le récapitulatif montre les créations",
          "startMs": 10208,
          "endMs": 15719,
          "cueMs": 57533,
          "sentenceAbsoluteMs": 57532,
          "firstInputAfterAnchor": {
            "kind": "click",
            "atMs": 57998
          },
          "deltaMs": 466,
          "frame": {
