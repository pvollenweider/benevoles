    {
      "chapter": "result",
      "id": "result",
      "startMs": 193209,
      "endMs": 215495,
      "sentences": [
        {
          "text": "Votre liste est prête à être utilisée pour les prochaines invitations.",
          "startMs": 371,
          "endMs": 3536,
          "method": "silence",
          "absoluteStartMs": 193580
        },
        {
          "text": "Gardez un fichier simple, vérifiez les coordonnées et lisez l'aperçu avant chaque confirmation.",
          "startMs": 4282,
          "endMs": 9610,
          "method": "silence",
          "absoluteStartMs": 197491
        },
        {
          "text": "Si quelques personnes manquent, ajoutez-les manuellement.",
          "startMs": 10235,
          "endMs": 13010,
          "method": "silence",
          "absoluteStartMs": 203444
        },
        {
          "text": "Et si leurs disponibilités changent, complétez leur fiche séparément.",
          "startMs": 13668,
          "endMs": 16872,
          "method": "silence",
          "absoluteStartMs": 206877
        },
        {
          "text": "L'import fait gagner du temps, tout en vous laissant le dernier mot sur ce qui sera enregistré.",
          "startMs": 17685,
          "endMs": 21946,
          "method": "silence",
          "absoluteStartMs": 210894
        }
      ],
      "anchors": [],
