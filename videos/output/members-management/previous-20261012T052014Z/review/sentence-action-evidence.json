  {
    "chapter": "edit",
    "startMs": 44797,
    "endMs": 66521,
    "sentences": [
      {
        "text": "Avec Éditer, vous pouvez corriger la fiche et ajouter des informations.",
        "startMs": 432,
        "endMs": 3793,
        "method": "silence",
        "absoluteStartMs": 45229
      },
      {
        "text": "Les tags, séparés par des virgules, servent à retrouver un groupe, comme accueil ou permis b.",
        "startMs": 4455,
        "endMs": 9953,
        "method": "silence",
        "absoluteStartMs": 49252
      },
      {
        "text": "La note peut rappeler un détail pratique utile à l'organisation.",
        "startMs": 10827,
        "endMs": 13392,
        "method": "silence",
        "absoluteStartMs": 55624
      },
      {
        "text": "Garde-la courte et évite les informations personnelles inutiles.",
        "startMs": 13804,
        "endMs": 16813,
        "method": "silence",
        "absoluteStartMs": 58601
      },
      {
        "text": "Enregistrons, puis rouvrons la fiche pour vérifier que les changements sont conservés.",
        "startMs": 17526,
        "endMs": 21309,
        "method": "silence",
        "absoluteStartMs": 62323
      }
    ],
    "anchors": [
