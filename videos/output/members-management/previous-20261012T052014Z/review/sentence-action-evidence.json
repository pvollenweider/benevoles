  {
    "chapter": "deactivate",
    "startMs": 154671,
    "endMs": 176160,
    "sentences": [
      {
        "text": "Pour mettre une fiche de côté, vous pouvez la désactiver.",
        "startMs": 290,
        "endMs": 2904,
        "method": "silence",
        "absoluteStartMs": 154961
      },
      {
        "text": "Ici, Maya n'a aucune inscription :",
        "startMs": 3611,
        "endMs": 5696,
        "method": "silence",
        "absoluteStartMs": 158282
      },
      {
        "text": "nous confirmons sa désactivation, puis elle disparaît de la liste habituelle.",
        "startMs": 6242,
        "endMs": 10041,
        "method": "silence",
        "absoluteStartMs": 160913
      },
      {
        "text": "Avec Inclure inactifs, nous la retrouvons.",
