  {
    "chapter": "no-email",
    "startMs": 89123,
    "endMs": 107352,
    "sentences": [
      {
        "text": "Une personne peut avoir une fiche sans adresse email.",
        "startMs": 429,
        "endMs": 2868,
        "method": "silence",
        "absoluteStartMs": 89552
      },
      {
        "text": "Nous créons René Aubert avec son téléphone seulement.",
        "startMs": 3565,
        "endMs": 5877,
        "method": "silence",
        "absoluteStartMs": 92688
      },
      {
        "text": "Vous pouvez ainsi garder un contact et organiser son inscription manuellement.",
        "startMs": 6515,
        "endMs": 9740,
        "method": "silence",
        "absoluteStartMs": 95638
      },
      {
        "text": "En revanche, le système ne peut pas lui envoyer un email tant que l'adresse manque.",
        "startMs": 10448,
        "endMs": 13791,
        "method": "silence",
        "absoluteStartMs": 99571
      },
      {
        "text": "Prévoyez avec lui une autre manière de communiquer les horaires et les changements.",
        "startMs": 14306,
        "endMs": 18226,
        "method": "silence",
        "absoluteStartMs": 103429
      }
    ],
