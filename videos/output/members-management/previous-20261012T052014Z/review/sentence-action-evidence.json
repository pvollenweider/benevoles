  {
    "chapter": "result",
    "startMs": 197759,
    "endMs": 218789,
    "sentences": [
      {
        "text": "Une liste bien entretenue, ce sont les bonnes coordonnées, quelques catégories utiles et des informations que l'on comprend.",
        "startMs": 316,
        "endMs": 6737,
        "method": "silence",
        "absoluteStartMs": 198075
      },
      {
        "text": "Mets les fiches à jour quand une personne te signale un changement.",
        "startMs": 7408,
        "endMs": 9670,
        "method": "silence",
        "absoluteStartMs": 205167
      },
      {
        "text": "Utilise les disponibilités pour dialoguer, pas pour décider à sa place.",
        "startMs": 10395,
        "endMs": 14133,
        "method": "silence",
        "absoluteStartMs": 208154
      },
      {
        "text": "Et garde seulement les notes nécessaires :",
        "startMs": 14693,
        "endMs": 16343,
        "method": "silence",
        "absoluteStartMs": 212452
      },
      {
        "text": "l'objectif est de faciliter l'organisation, pas de constituer un dossier sur les bénévoles.",
        "startMs": 16551,
        "endMs": 20737,
        "method": "silence",
        "absoluteStartMs": 214310
      }
    ],
