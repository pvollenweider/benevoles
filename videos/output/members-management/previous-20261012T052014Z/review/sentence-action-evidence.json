  {
    "chapter": "filter",
    "startMs": 129843,
    "endMs": 154219,
    "sentences": [
      {
        "text": "Avec le filtre de tags, vous pouvez afficher seulement les personnes d'une catégorie, puis revenir à Tous les tags.",
        "startMs": 326,
        "endMs": 6006,
        "method": "silence",
        "absoluteStartMs": 130169
      },
      {
        "text": "Les en-têtes permettent aussi de trier la liste.",
        "startMs": 6526,
        "endMs": 8778,
        "method": "silence",
        "absoluteStartMs": 136369
      },
      {
        "text": "Les heures planifiées additionnent les durées des créneaux passés, confirmés et non annulés.",
        "startMs": 9518,
        "endMs": 13906,
        "method": "silence",
        "absoluteStartMs": 139361
      },
      {
        "text": "Les heures attestées en sont la part avec une présence enregistrée, pas un chronométrage du travail réel.",
        "startMs": 14468,
        "endMs": 20063,
        "method": "silence",
        "absoluteStartMs": 144311
      },
      {
        "text": "Ces repères aident à organiser ;",
        "startMs": 20543,
        "endMs": 22237,
        "method": "silence",
        "absoluteStartMs": 150386
      },
      {
        "text": "ils ne classent pas la valeur des bénévoles.",
        "startMs": 22658,
        "endMs": 24086,
        "method": "silence",
        "absoluteStartMs": 152501
      }
    ],
