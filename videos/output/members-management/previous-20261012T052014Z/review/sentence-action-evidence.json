  {
    "chapter": "activity",
    "startMs": 176612,
    "endMs": 197306,
    "sentences": [
      {
        "text": "Le lien Activité ouvre l'historique factuel d'une personne.",
        "startMs": 408,
        "endMs": 3877,
        "method": "silence",
        "absoluteStartMs": 177020
      },
      {
        "text": "Pour Camille, la page est déjà renseignée :",
        "startMs": 4628,
        "endMs": 6372,
        "method": "silence",
        "absoluteStartMs": 181240
      },
      {
        "text": "on peut parcourir les faits enregistrés, leurs dates et l'événement concerné.",
        "startMs": 7036,
        "endMs": 9334,
        "method": "silence",
        "absoluteStartMs": 183648
      },
      {
        "text": "Cette vue rassemble notamment les inscriptions et les autres actions disponibles dans son historique.",
        "startMs": 9666,
        "endMs": 15858,
        "method": "silence",
        "absoluteStartMs": 186278
      },
      {
        "text": "Elle ne donne pas de score.",
        "startMs": 16488,
        "endMs": 17415,
        "method": "silence",
        "absoluteStartMs": 193100
      },
      {
        "text": "Une inscription n'est pas à elle seule une preuve de présence.",
        "startMs": 17733,
        "endMs": 20337,
        "method": "silence",
        "absoluteStartMs": 194345
      }
    ],
    "anchors": [
