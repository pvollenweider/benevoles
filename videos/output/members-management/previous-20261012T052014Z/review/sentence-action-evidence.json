  {
    "chapter": "availability",
    "startMs": 66975,
    "endMs": 88665,
    "sentences": [
      {
        "text": "Les disponibilités donnent une indication générale :",
        "startMs": 231,
        "endMs": 3105,
        "method": "silence",
        "absoluteStartMs": 67206
      },
      {
        "text": "matin, après-midi, soir, et une courte exception si nécessaire.",
        "startMs": 3303,
        "endMs": 7124,
        "method": "silence",
        "absoluteStartMs": 70278
      },
      {
        "text": "Elles peuvent aider quand vous proposez un autre horaire.",
        "startMs": 7683,
        "endMs": 9802,
        "method": "silence",
        "absoluteStartMs": 74658
      },
      {
        "text": "Elles ne réservent aucune place et ne remplacent pas le choix des créneaux.",
        "startMs": 10536,
        "endMs": 13308,
        "method": "silence",
        "absoluteStartMs": 77511
      },
      {
        "text": "Ici, Maya est disponible le soir, sauf le vendredi.",
        "startMs": 14268,
        "endMs": 16377,
        "method": "silence",
        "absoluteStartMs": 81243
      },
      {
        "text": "Après enregistrement, cette indication apparaît avec ses coordonnées dans la liste.",
        "startMs": 16562,
        "endMs": 21262,
        "method": "silence",
        "absoluteStartMs": 83537
      }
    ],
    "anchors": [
      {
        "segmentId": "availability",
