  {
    "chapter": "search",
    "startMs": 107819,
    "endMs": 129397,
    "sentences": [
      {
        "text": "La recherchez aide à retrouver une personne par son nom, son email ou son téléphone.",
        "startMs": 0,
        "endMs": 4607,
        "method": "silence",
        "absoluteStartMs": 107819
      },
      {
        "text": "Les accents ne doivent pas compliquer la recherche.",
        "startMs": 4999,
        "endMs": 7301,
        "method": "silence",
        "absoluteStartMs": 112818
      },
      {
        "text": "Attention aussi aux homonymes :",
        "startMs": 7896,
        "endMs": 9606,
        "method": "silence",
        "absoluteStartMs": 115715
      },
      {
        "text": "ici, deux Stéphane Favre ont des coordonnées différentes.",
        "startMs": 9991,
        "endMs": 13281,
        "method": "silence",
        "absoluteStartMs": 117810
      },
      {
        "text": "Le même prénom et le même nom ne prouvent pas qu'il s'agit d'un doublon.",
        "startMs": 13626,
        "endMs": 16932,
        "method": "silence",
        "absoluteStartMs": 121445
      },
      {
        "text": "Vérifiez le contact et les inscriptions avant de modifier une fiche.",
        "startMs": 17434,
        "endMs": 21238,
        "method": "silence",
        "absoluteStartMs": 125253
      }
    ],
    "anchors": [
