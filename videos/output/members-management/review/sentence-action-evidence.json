    "chapter": "deactivate",
    "startMs": 154682,
    "endMs": 176170,
    "sentences": [
      {
        "text": "Pour mettre une fiche de côté, vous pouvez la désactiver.",
        "startMs": 290,
        "endMs": 2904,
        "method": "silence",
        "absoluteStartMs": 154972
      },
      {
        "text": "Ici, Maya n'a aucune inscription :",
        "startMs": 3611,
        "endMs": 5696,
        "method": "silence",
        "absoluteStartMs": 158293
      },
      {
        "text": "nous confirmons sa désactivation, puis elle disparaît de la liste habituelle.",
        "startMs": 6242,
        "endMs": 10041,
        "method": "silence",
        "absoluteStartMs": 160924
      },
      {
        "text": "Avec Inclure inactifs, nous la retrouvons.",
        "startMs": 10590,
        "endMs": 12447,
        "method": "silence",
        "absoluteStartMs": 165272
      },
      {
        "text": "Dans Éditer, la case Membre actif permet de la réactiver.",
        "startMs": 12781,
        "endMs": 17446,
        "method": "silence",
        "absoluteStartMs": 167463
      },
      {
        "text": "Après enregistrement, elle revient parmi les membres affichés normalement.",
        "startMs": 18248,
        "endMs": 21073,
        "method": "silence",
        "absoluteStartMs": 172930
      }
