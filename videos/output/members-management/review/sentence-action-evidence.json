[
  {
    "chapter": "welcome",
    "startMs": 0,
    "endMs": 22627,
    "sentences": [
      {
        "text": "La liste des membres rassemble les personnes que votre association souhaite retrouver facilement.",
        "startMs": 405,
        "endMs": 5381,
        "method": "silence",
        "absoluteStartMs": 405
      },
      {
        "text": "Ici, soixante fiches donnent un aperçu d'une vraie équipe, avec des coordonnées et des catégories variées.",
        "startMs": 6049,
        "endMs": 12208,
        "method": "silence",
        "absoluteStartMs": 6049
      },
      {
        "text": "Ajouter un membre ne l'inscrit pas automatiquement à une fête.",
        "startMs": 13049,
        "endMs": 16005,
        "method": "silence",
        "absoluteStartMs": 13049
      },
      {
        "text": "Sa fiche et ses inscriptions sont deux choses différentes.",
        "startMs": 16480,
        "endMs": 19009,
        "method": "silence",
        "absoluteStartMs": 16480
      },
      {
        "text": "Voyons comment garder cette liste utile et à jour.",
        "startMs": 19557,
        "endMs": 22163,
        "method": "silence",
        "absoluteStartMs": 19557
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "create",
    "startMs": 23097,
    "endMs": 44362,
    "sentences": [
      {
        "text": "Pour ajouter une personne, cliquez sur Nouveau membre.",
        "startMs": 466,
        "endMs": 2988,
        "method": "silence",
        "absoluteStartMs": 23563
      },
      {
        "text": "Saisissez son prénom et son nom, puis son email et son téléphone si vous les connaissez.",
        "startMs": 3514,
        "endMs": 7700,
        "method": "silence",
        "absoluteStartMs": 26611
      },
      {
        "text": "Nous ajoutons Maya Berger avec des coordonnées de démonstration.",
        "startMs": 8484,
        "endMs": 11558,
        "method": "silence",
        "absoluteStartMs": 31581
      },
      {
        "text": "Prenez le temps de vérifier l'adresse avant de créer la fiche :",
        "startMs": 12094,
        "endMs": 14846,
        "method": "silence",
        "absoluteStartMs": 35191
      },
      {
        "text": "une faute de frappe peut empêcher les prochains messages d'arriver.",
        "startMs": 15279,
        "endMs": 17848,
        "method": "silence",
        "absoluteStartMs": 38376
      },
      {
        "text": "Après la création, Maya apparaît dans la liste.",
        "startMs": 18188,
        "endMs": 20840,
        "method": "silence",
        "absoluteStartMs": 41285
      }
    ],
    "anchors": [
