[
  {
    "chapter": "welcome",
    "startMs": 0,
    "endMs": 18406,
    "sentences": [
      {
        "text": "Le jour de la fête, vous n'avez pas besoin de tout coordonner seul ou seule.",
        "startMs": 232,
        "endMs": 4049,
        "method": "silence",
        "absoluteStartMs": 232
      },
      {
        "text": "Un responsable de poste peut suivre son équipe, retrouver les créneaux et contacter les bénévoles.",
        "startMs": 4285,
        "endMs": 9210,
        "method": "silence",
        "absoluteStartMs": 4285
      },
      {
        "text": "Nous allons désigner une personne, ouvrir son vrai lien personnel et découvrir ce qu'elle peut consulter.",
        "startMs": 9760,
        "endMs": 14744,
        "method": "silence",
        "absoluteStartMs": 9760
      },
      {
        "text": "Aucun accès à toute l'administration n'est nécessaire.",
        "startMs": 15340,
        "endMs": 17886,
        "method": "silence",
        "absoluteStartMs": 15340
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "nominate",
    "startMs": 18859,
    "endMs": 39302,
    "sentences": [
      {
        "text": "Dans l'événement, ouvrez les responsables et ajoutez une personne.",
        "startMs": 521,
        "endMs": 4710,
        "method": "silence",
        "absoluteStartMs": 19380
      },
      {
        "text": "Choisissez le poste, puis renseignez son nom et son email.",
        "startMs": 5376,
        "endMs": 6308,
        "method": "silence",
        "absoluteStartMs": 24235
      },
      {
        "text": "Vérifiez bien cette adresse :",
        "startMs": 6881,
        "endMs": 8518,
        "method": "silence",
        "absoluteStartMs": 25740
      },
      {
        "text": "c'est là que son lien sera envoyé.",
        "startMs": 8938,
        "endMs": 11700,
        "method": "silence",
        "absoluteStartMs": 27797
      },
      {
        "text": "Vous pouvez désigner quelqu'un qui n'est pas lui-même inscrit à un créneau.",
        "startMs": 12676,
        "endMs": 15407,
        "method": "silence",
        "absoluteStartMs": 31535
      },
      {
        "text": "Ajouter et envoyer le lien enregistre la nomination et prépare son email.",
        "startMs": 16525,
        "endMs": 20000,
        "method": "silence",
        "absoluteStartMs": 35384
      }
    ],
    "anchors": [
      {
        "segmentId": "nominate",
