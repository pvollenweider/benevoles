  {
    "chapter": "notification",
    "startMs": 155997,
    "endMs": 175140,
    "sentences": [
      {
        "text": "Côté responsable, voici l'email réellement reçu à la suite de cette inscription.",
        "startMs": 329,
        "endMs": 4059,
        "method": "silence",
        "absoluteStartMs": 156326
      },
      {
        "text": "Il indique le nom de Nora et le créneau de la Buvette du dimanche.",
        "startMs": 4566,
        "endMs": 7381,
        "method": "silence",
        "absoluteStartMs": 160563
      },
      {
        "text": "Le lien permet de retrouver l'équipe complète.",
        "startMs": 8185,
        "endMs": 9933,
        "method": "silence",
        "absoluteStartMs": 164182
      },
      {
        "text": "En rouvrant la page, Nora apparaît maintenant dans le bon créneau, avec ses coordonnées.",
        "startMs": 10708,
        "endMs": 14422,
        "method": "silence",
        "absoluteStartMs": 166705
      },
      {
        "text": "La responsable peut ainsi suivre les changements sans accéder à toute l'administration.",
        "startMs": 15079,
        "endMs": 18786,
        "method": "silence",
        "absoluteStartMs": 171076
      }
    ],
    "anchors": [
      {
        "segmentId": "notification",
        "phrase": "En rouvrant la page, Nora",
        "startMs": 10708,
        "endMs": 14422,
        "cueMs": 166708
      }
    ],
    "interactions": []
  },
  {
    "chapter": "contact",
    "startMs": 175592,
    "endMs": 191639,
    "sentences": [
      {
        "text": "Attention à une autre distinction :",
        "startMs": 360,
        "endMs": 1983,
        "method": "silence",
        "absoluteStartMs": 175952
      },
      {
        "text": "le contact opérationnel indiqué sur un créneau est la personne que les bénévoles doivent joindre sur place.",
        "startMs": 2136,
        "endMs": 6645,
        "method": "silence",
        "absoluteStartMs": 177728
      },
      {
        "text": "Désigner un responsable ne publie pas automatiquement ses coordonnées comme contact.",
        "startMs": 7326,
        "endMs": 10846,
        "method": "silence",
        "absoluteStartMs": 182918
      },
      {
        "text": "L'organisateur renseigne ce contact séparément dans le créneau, si c'est bien la personne à appeler.",
