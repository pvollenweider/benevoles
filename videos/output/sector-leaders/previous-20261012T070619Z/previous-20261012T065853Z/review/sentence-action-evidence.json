[
  {
    "chapter": "welcome",
    "startMs": 1,
    "endMs": 18407,
    "sentences": [
      {
        "text": "Le jour de la fête, vous n'avez pas besoin de tout coordonner seul ou seule.",
        "startMs": 232,
        "endMs": 4049,
        "method": "silence",
        "absoluteStartMs": 233
      },
      {
        "text": "Un responsable de poste peut suivre son équipe, retrouver les créneaux et contacter les bénévoles.",
        "startMs": 4285,
        "endMs": 9210,
        "method": "silence",
        "absoluteStartMs": 4286
      },
      {
        "text": "Nous allons désigner une personne, ouvrir son vrai lien personnel et découvrir ce qu'elle peut consulter.",
        "startMs": 9760,
        "endMs": 14744,
        "method": "silence",
        "absoluteStartMs": 9761
      },
      {
        "text": "Aucun accès à toute l'administration n'est nécessaire.",
        "startMs": 15340,
        "endMs": 17886,
        "method": "silence",
        "absoluteStartMs": 15341
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "nominate",
    "startMs": 18862,
    "endMs": 39306,
    "sentences": [
      {
        "text": "Dans l'événement, ouvrez les responsables et ajoutez une personne.",
        "startMs": 521,
        "endMs": 4710,
        "method": "silence",
        "absoluteStartMs": 19383
      },
      {
        "text": "Choisissez le poste, puis renseignez son nom et son email.",
        "startMs": 5376,
        "endMs": 6308,
        "method": "silence",
        "absoluteStartMs": 24238
      },
      {
        "text": "Vérifiez bien cette adresse :",
        "startMs": 6881,
        "endMs": 8518,
        "method": "silence",
        "absoluteStartMs": 25743
      },
      {
        "text": "c'est là que son lien sera envoyé.",
        "startMs": 8938,
        "endMs": 11700,
        "method": "silence",
        "absoluteStartMs": 27800
      },
      {
        "text": "Vous pouvez désigner quelqu'un qui n'est pas lui-même inscrit à un créneau.",
        "startMs": 12676,
        "endMs": 15407,
        "method": "silence",
        "absoluteStartMs": 31538
      },
      {
        "text": "Ajouter et envoyer le lien enregistre la nomination et prépare son email.",
        "startMs": 16525,
        "endMs": 20000,
        "method": "silence",
        "absoluteStartMs": 35387
      }
    ],
    "anchors": [
      {
        "segmentId": "nominate",
