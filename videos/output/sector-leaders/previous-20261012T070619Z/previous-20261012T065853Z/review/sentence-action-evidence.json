  {
    "chapter": "registered",
    "startMs": 39759,
    "endMs": 56596,
    "sentences": [
      {
        "text": "Si la personne participe déjà, la liste des inscrits permet de reprendre ses coordonnées sans tout ressaisir.",
        "startMs": 380,
        "endMs": 5020,
        "method": "silence",
        "absoluteStartMs": 40139
      },
      {
        "text": "Vérifiez le poste proposé avant de confirmer.",
        "startMs": 5866,
        "endMs": 7740,
        "method": "silence",
        "absoluteStartMs": 45625
      },
      {
        "text": "Être responsable d'un poste et être bénévole sur un créneau sont deux choses différentes :",
        "startMs": 8392,
        "endMs": 12197,
        "method": "silence",
        "absoluteStartMs": 48151
      },
      {
        "text": "la nomination ne remplace pas une inscription et ne crée pas un nouvel engagement dans le planning.",
        "startMs": 12546,
        "endMs": 16275,
        "method": "silence",
        "absoluteStartMs": 52305
      }
    ],
    "anchors": [
      {
        "segmentId": "registered",
        "phrase": "Être responsable d'un poste et",
        "startMs": 8392,
        "endMs": 12197,
        "cueMs": 48153
      },
      {
        "segmentId": "registered",
        "phrase": "la nomination ne remplace pas",
        "startMs": 12546,
        "endMs": 16275,
        "cueMs": 52309
      }
    ],
    "interactions": [
      {
        "kind": "click",
        "atMs": 40228
      },
      {
        "kind": "click",
        "atMs": 41011
      },
      {
