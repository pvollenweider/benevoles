[
  {
    "chapter": "welcome",
    "startMs": 0,
    "endMs": 17552,
    "sentences": [
      {
        "text": "Le jour de la fête, vous n'avez pas besoin de tout coordonner seul ou seule.",
        "startMs": 258,
        "endMs": 3782,
        "method": "silence",
        "absoluteStartMs": 258
      },
      {
        "text": "Un responsable de poste peut suivre son équipe, retrouver les créneaux et contacter les bénévoles.",
        "startMs": 4384,
        "endMs": 8572,
        "method": "silence",
        "absoluteStartMs": 4384
      },
      {
        "text": "Nous allons désigner une personne, ouvrir son vrai lien personnel et découvrir ce qu'elle peut consulter.",
        "startMs": 8997,
        "endMs": 14232,
        "method": "silence",
        "absoluteStartMs": 8997
      },
      {
        "text": "Aucun accès à toute l'administration n'est nécessaire.",
        "startMs": 14881,
        "endMs": 17164,
        "method": "silence",
        "absoluteStartMs": 14881
      }
    ],
    "anchors": [],
    "interactions": []
  },
  {
    "chapter": "nominate",
    "startMs": 18005,
    "endMs": 36804,
    "sentences": [
      {
        "text": "Dans l'événement, ouvrez les responsables et ajoutez une personne.",
        "startMs": 354,
        "endMs": 4308,
        "method": "silence",
        "absoluteStartMs": 18359
      },
      {
        "text": "Choisissez le poste, puis renseignez son nom et son email.",
        "startMs": 4853,
        "endMs": 7137,
        "method": "silence",
        "absoluteStartMs": 22858
      },
      {
        "text": "Vérifiez bien cette adresse :",
        "startMs": 7303,
        "endMs": 7896,
        "method": "silence",
        "absoluteStartMs": 25308
      },
      {
        "text": "c'est là que son lien sera envoyé.",
        "startMs": 8333,
        "endMs": 10599,
        "method": "silence",
        "absoluteStartMs": 26338
      },
      {
        "text": "Vous pouvez désigner quelqu'un qui n'est pas lui-même inscrit à un créneau.",
        "startMs": 11100,
        "endMs": 14133,
        "method": "silence",
        "absoluteStartMs": 29105
      },
      {
        "text": "Ajouter et envoyer le lien enregistre la nomination et prépare son email.",
        "startMs": 14767,
        "endMs": 18496,
        "method": "silence",
        "absoluteStartMs": 32772
      }
    ],
    "anchors": [
      {
        "segmentId": "nominate",
