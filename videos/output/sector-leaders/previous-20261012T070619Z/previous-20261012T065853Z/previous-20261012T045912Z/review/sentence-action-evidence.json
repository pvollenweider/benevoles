  {
    "chapter": "notification",
    "startMs": 156076,
    "endMs": 175109,
    "sentences": [
      {
        "text": "Côté responsable, voici l'email réellement reçu à la suite de cette inscription.",
        "startMs": 433,
        "endMs": 3700,
        "method": "silence",
        "absoluteStartMs": 156509
      },
      {
        "text": "Il indique le nom de Nora et le créneau de la Buvette du dimanche.",
        "startMs": 4378,
        "endMs": 7243,
        "method": "silence",
        "absoluteStartMs": 160454
      },
      {
        "text": "Le lien permet de retrouver l'équipe complète.",
        "startMs": 8017,
        "endMs": 9612,
        "method": "silence",
        "absoluteStartMs": 164093
      },
      {
        "text": "En rouvrant la page, Nora apparaît maintenant dans le bon créneau, avec ses coordonnées.",
        "startMs": 10448,
        "endMs": 14251,
        "method": "silence",
        "absoluteStartMs": 166524
      },
      {
        "text": "La responsable peut ainsi suivre les changements sans accéder à toute l'administration.",
        "startMs": 15082,
        "endMs": 18627,
        "method": "silence",
        "absoluteStartMs": 171158
      }
    ],
    "anchors": [
      {
        "segmentId": "notification",
        "phrase": "En rouvrant la page, Nora",
        "startMs": 10448,
        "endMs": 14251,
        "cueMs": 166524
      }
    ],
    "interactions": []
  },
  {
    "chapter": "contact",
    "startMs": 175562,
    "endMs": 191045,
    "sentences": [
      {
        "text": "Attention à une autre distinction :",
        "startMs": 414,
        "endMs": 1890,
        "method": "silence",
        "absoluteStartMs": 175976
      },
      {
        "text": "le contact opérationnel indiqué sur un créneau est la personne que les bénévoles doivent joindre sur place.",
        "startMs": 2183,
        "endMs": 6764,
        "method": "silence",
        "absoluteStartMs": 177745
      },
      {
        "text": "Désigner un responsable ne publie pas automatiquement ses coordonnées comme contact.",
        "startMs": 7366,
        "endMs": 10654,
        "method": "silence",
        "absoluteStartMs": 182928
      },
      {
