      },
      {
        "kind": "click",
        "atMs": 52775
      }
    ]
  },
  {
    "chapter": "email",
    "startMs": 57045,
    "endMs": 71883,
    "sentences": [
      {
        "text": "Voici l'email reçu.",
        "startMs": 541,
        "endMs": 1345,
        "method": "silence",
        "absoluteStartMs": 57586
      },
      {
        "text": "Le responsable ouvre son lien personnel directement, sans créer de compte ni choisir de mot de passe.",
        "startMs": 1661,
        "endMs": 6480,
        "method": "silence",
        "absoluteStartMs": 58706
      },
      {
        "text": "Ce lien est confidentiel :",
        "startMs": 7213,
        "endMs": 8313,
        "method": "silence",
        "absoluteStartMs": 64258
      },
      {
        "text": "il donne accès aux coordonnées de l'équipe.",
        "startMs": 8647,
        "endMs": 9930,
        "method": "silence",
        "absoluteStartMs": 65692
      },
      {
        "text": "On le garde pour soi, et on ne l'affiche jamais sur une page publique ou sur le QR code de recrutement.",
        "startMs": 10510,
        "endMs": 14388,
        "method": "silence",
        "absoluteStartMs": 67555
      }
    ],
    "anchors": [],
    "interactions": [
      {
        "kind": "click",
        "atMs": 59218
      }
    ]
  },
  {
    "chapter": "roster",
    "startMs": 72336,
    "endMs": 91118,
    "sentences": [
      {
        "text": "Sur ce lien, la responsable de la Buvette retrouve uniquement les inscriptions de son poste.",
        "startMs": 454,
        "endMs": 4257,
        "method": "silence",
        "absoluteStartMs": 72790
      },
      {
        "text": "Les personnes sont regroupées par créneau, avec la date et les horaires.",
        "startMs": 4965,
        "endMs": 7751,
        "method": "silence",
        "absoluteStartMs": 77301
      },
      {
        "text": "Chaque ligne donne le nom, l'email, le téléphone lorsqu'il est renseigné et le commentaire éventuel.",
        "startMs": 8463,
        "endMs": 13505,
        "method": "silence",
        "absoluteStartMs": 80799
      },
      {
        "text": "La mention Liste d'attente distingue les personnes qui n'ont pas encore une place confirmée.",
        "startMs": 14183,
        "endMs": 18254,
        "method": "silence",
        "absoluteStartMs": 86519
      }
    ],
    "anchors": [
      {
        "segmentId": "roster",
        "phrase": "Chaque ligne donne le nom",
        "startMs": 8463,
        "endMs": 13505,
        "cueMs": 80801
      },
      {
        "segmentId": "roster",
        "phrase": "La mention Liste d'attente distingue",
        "startMs": 14183,
        "endMs": 18254,
        "cueMs": 86520
      }
    ],
    "interactions": []
  },
  {
    "chapter": "mobile",
    "startMs": 91572,
    "endMs": 110265,
    "sentences": [
      {
        "text": "Sur téléphone, la même page accompagne le responsable sur le terrain.",
        "startMs": 528,
        "endMs": 3217,
        "method": "silence",
        "absoluteStartMs": 92100
      },
      {
        "text": "Les liens email et téléphone permettent de préparer un message ou un appel avec les applications du téléphone.",
        "startMs": 3899,
        "endMs": 8745,
        "method": "silence",
        "absoluteStartMs": 95471
      },
      {
        "text": "On peut ainsi retrouver l'équipe du prochain créneau et vérifier les horaires.",
        "startMs": 9292,
        "endMs": 12534,
        "method": "silence",
        "absoluteStartMs": 100864
      },
      {
        "text": "Les coordonnées servent à l'organisation de la mission, pas à constituer une liste de diffusion personnelle.",
        "startMs": 13315,
        "endMs": 18308,
        "method": "silence",
        "absoluteStartMs": 104887
      }
    ],
    "anchors": [
      {
        "segmentId": "mobile",
        "phrase": "Les liens email et téléphone",
        "startMs": 3899,
        "endMs": 8745,
        "cueMs": 95473
      },
      {
        "segmentId": "mobile",
        "phrase": "On peut ainsi retrouver l'équipe",
        "startMs": 9292,
        "endMs": 12534,
        "cueMs": 100866
      }
    ],
    "interactions": []
  },
  {
    "chapter": "scope",
    "startMs": 110717,
    "endMs": 124570,
    "sentences": [
      {
        "text": "Cet espace est en lecture seule :",
        "startMs": 384,
        "endMs": 2050,
        "method": "silence",
        "absoluteStartMs": 111101
      },
      {
        "text": "le responsable ne modifie pas les créneaux et ne retire pas les inscriptions.",
        "startMs": 2640,
        "endMs": 5889,
        "method": "silence",
        "absoluteStartMs": 113357
      },
      {
        "text": "Il ne voit pas les équipes des autres postes.",
        "startMs": 6676,
        "endMs": 8184,
        "method": "silence",
        "absoluteStartMs": 117393
      },
      {
        "text": "Pour une modification du planning ou une décision d'inscription, il se coordonne avec l'organisateur.",
        "startMs": 8520,
        "endMs": 13487,
        "method": "silence",
        "absoluteStartMs": 119237
      }
    ],
    "anchors": [
      {
        "segmentId": "scope",
        "phrase": "Pour une modification du planning",
        "startMs": 8520,
        "endMs": 13487,
        "cueMs": 119239
      }
    ],
    "interactions": []
  },
  {
    "chapter": "new-signup",
    "startMs": 125023,
    "endMs": 153125,
    "sentences": [
      {
        "text": "Pour voir comment une équipe évolue, inscrivons une nouvelle personne à la Buvette du dimanche.",
        "startMs": 383,
        "endMs": 5658,
        "method": "silence",
        "absoluteStartMs": 125406
      },
      {
        "text": "Nora choisit ce créneau, puis continue vers le formulaire.",
        "startMs": 5948,
        "endMs": 7174,
        "method": "silence",
        "absoluteStartMs": 130971
      },
      {
        "text": "Elle renseigne son prénom et son nom, son adresse email et son téléphone.",
        "startMs": 7861,
        "endMs": 11789,
        "method": "silence",
        "absoluteStartMs": 132884
      },
      {
        "text": "La taille du t-shirt est obligatoire pour cet événement.",
        "startMs": 12051,
        "endMs": 13960,
        "method": "silence",
        "absoluteStartMs": 137074
      },
      {
        "text": "Elle choisit une taille, accepte la convention et l'utilisation de ses données pour organiser sa participation.",
        "startMs": 14507,
        "endMs": 20086,
        "method": "silence",
        "absoluteStartMs": 139530
      },
      {
        "text": "Avant de confirmer, elle vérifie ses coordonnées et le créneau choisi.",
        "startMs": 20764,
        "endMs": 23842,
        "method": "silence",
        "absoluteStartMs": 145787
      },
      {
        "text": "Nous confirmons maintenant :",
        "startMs": 24470,
        "endMs": 25288,
        "method": "silence",
        "absoluteStartMs": 149493
      },
      {
        "text": "la page indique que son inscription est enregistrée.",
        "startMs": 25850,
        "endMs": 27773,
        "method": "silence",
        "absoluteStartMs": 150873
      }
    ],
    "anchors": [
      {
        "segmentId": "new-signup",
        "phrase": "Nora choisit ce créneau, puis",
