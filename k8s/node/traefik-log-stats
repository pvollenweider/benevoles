"""Daily visit totals, without addresses, from the Traefik access log (node script, k8s/log-rotation.md).

Installed on the node as /usr/local/sbin/traefik-log-stats and run once a day by
/etc/cron.d/traefik-log-stats, after the nightly rotation. Python 3 standard library only.

Reads one UTC day of the Traefik access log (the live /var/log/traefik/access.log and the
archived files of that day and the two after it, k8s/node/traefik-access.logrotate) and writes
/var/lib/traefik-stats/YYYY-MM-DD.json with totals only:
  - benevol.app requests only (other sites of the same Traefik are ignored);
  - never the administration, the API, the operator pages, personal links or a request whose
    query carries a token or a search: those are left out entirely, not even counted;
  - per path template: a path is kept only as far as it is a fixed route of the app; event and
    page slugs, identifiers and anything unknown are replaced; requests, bots and others
    (User-Agent against a short list of robots and monitors), status classes, p50/p95 duration;
    the 404 templates apart;
  - any template with fewer than 5 requests is merged into « autres ».
No IP, no User-Agent string, no time of day, nothing that follows one visitor. Each run also
fills any of the last 7 days still missing, and deletes the totals older than two years.
A read error writes nothing and fails; a day without a single benevol.app request is written
but reported as a failure (the access log is probably not being written).

    traefik-log-stats                         # yesterday (UTC) and the missing days
    traefik-log-stats --date 2026-10-21       # one given day, overwrites its file
    traefik-log-stats --stdin --date 2026-10-21 < lines.json   # totals to stdout (tests)
"""

import argparse
import datetime
import gzip
import json
import os
import re
import stat
import sys
import tempfile
from urllib.parse import parse_qsl, unquote

LIVE_FILE = "/var/log/traefik/access.log"
ARCHIVE_DIR = "/var/log/traefik-archive"
OUT_DIR = "/var/lib/traefik-stats"
KEEP_DAYS = 730
BACKFILL_DAYS = 7
MIN_BUCKET = 5
MAX_DEPTH = 4
OTHERS = "autres"

DOMAIN = "benevol.app"
SITE_HOSTS = {DOMAIN, f"www.{DOMAIN}"}
MEDIA_HOST = f"medias.{DOMAIN}"

# First path segments that are fixed routes of the app (src/app) or files of public/, kept as
# they are. On an organisation's subdomain any other first segment is an event slug.
KNOWN_ROOTS = {
    "_next", "accessibilite", "benevoles-festival", "benevoles-fete-de-village",
    "benevoles-manifestation-sportive", "blog", "doc", "fonctionnalites", "inscription",
    "llms-full.txt", "llms.txt", "logiciel-planning-benevoles", "nouveautes", "og-image.png",
    "planning-permanences-benevoles", "pour-qui", "sitemap-index.xml", "tableur-ou-outil-dedie",
    "tarifs", "video-sitemap.xml", "videos", "legal", "robots.txt", "sitemap.xml",
    "favicon.ico", "icon.svg", "apple-icon.png", "sw.js", "doc-img",
}
# Public content published from the repository: the page name is kept when the page exists
# (status 2xx, not a redirect), so a mistyped or invented name never shows.
CONTENT_ROOTS = {"blog", "doc", "videos", "legal", "doc-img"}
# Left out entirely: administration, API, operator, personal links and token routes, the Sentry
# tunnel. Same families as k8s/ingressroute-tokens.yaml, plus everything behind a login.
EXCLUDED_ROOTS = {"admin", "api", "super-admin", "my", "leader", "waitlist", "product-updates", "monitoring"}
EXCLUDED_QUERY_KEYS = {"token", "t", "q", "deleted", "tag", "next", "callbackurl"}
# Event routes below the slug (src/app/[eventSlug]): a fixed one is kept, the rest is a page slug.
EVENT_FIXED = {"success"}
# Robot probe names worth seeing in the 404 list (/wp-login.php, /.env): hidden files and server
# script or backup extensions the app never serves, never a plain word that could be a name.
PROBE = re.compile(
    r"^(\.[\w-]{1,30}|[\w-]{1,40}\.(php\d?|aspx?|jsp|cgi|env|ini|cfg|conf|sql|bak|old))$",
    re.IGNORECASE,
)

BOT = re.compile(
    r"bot|crawl|spider|slurp|archiver|facebookexternalhit|embedly|"
    r"monitor|uptime|pingdom|statuscake|checkly|datadog|newrelic|nagios|zabbix|"
    r"lighthouse|pagespeed|headless|phantom|curl|wget|httpie|python|go-http-client|java/|"
    r"okhttp|axios|node-fetch|undici|libwww|scrapy",
    re.IGNORECASE,
)
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.IGNORECASE)
CUID = re.compile(r"^c[a-z0-9]{20,32}$")
ARCHIVED = re.compile(r"^access\.log-(\d{8})(\.gz)?$")


def is_bot(user_agent):
    return not user_agent or user_agent == "-" or bool(BOT.search(user_agent))


def identifier(value):
    """':n', ':id', ':x' or ':long' for a value that may identify, None for a plain word."""
    if value.isdigit():
        return ":n"
    if UUID.match(value) or CUID.match(value):
        return ":id"
    if len(value) >= 16 and re.search(r"\d", value) and re.search(r"[A-Za-z]", value):
        return ":id"
    if "@" in value:
        return ":x"
    if len(value) > 60:
        return ":long"
    return None


def host_kind(host):
    host = (host or "").lower().split(":", 1)[0]
    if host in SITE_HOSTS:
        return "site"
    if host == MEDIA_HOST:
        return "medias"
    if host.endswith(f".{DOMAIN}"):
        return "org"
    return None


def template(kind, parts, status):
    """The path template of a request: fixed routes kept, everything else replaced."""
    ok = isinstance(status, int) and 200 <= status < 300
    first = parts[0]
    if first == "_next":
        return ["_next", "*"]
    if first in KNOWN_ROOTS:
        out = [first]
        for i, part in enumerate(parts[1:]):
            if i == 0 and first in CONTENT_ROOTS and ok:
                out.append(identifier(part) or part)
            elif PROBE.match(part) and not identifier(part.rsplit(".", 1)[0]):
                out.append(part)
            else:
                out.append(identifier(part) or ":page")
        return out
    if kind == "org":
        out = [":event"]
        if len(parts) > 1:
            out.append(parts[1] if parts[1] in EVENT_FIXED else ":page")
        return out + [identifier(p) or ":page" for p in parts[2:]]
    if PROBE.match(first) and not identifier(first.rsplit(".", 1)[0]):
        return [first] + [identifier(p) or ":page" for p in parts[1:]]
    return [identifier(first) or ":page"] + [identifier(p) or ":page" for p in parts[1:]]


def normalise(host, raw_path, status=200):
    """('site'|'org'|'medias', '/template'), or None when the request is left out."""
    kind = host_kind(host)
    if kind is None:
        return None
    path, _, query = (raw_path or "/").partition("?")
    for key, value in parse_qsl(query, keep_blank_values=True):
        if key.strip().lower() in EXCLUDED_QUERY_KEYS and value:
            return None
    parts = [p for p in unquote(path).split("/") if p]
    if parts and parts[0].lower() in EXCLUDED_ROOTS:
        return None
    if not parts:
        return kind, "/"
    out = template(kind, parts, status)
    if len(out) > MAX_DEPTH:
        out = out[:MAX_DEPTH] + ["*"]
    return kind, "/" + "/".join(out)


def percentile(sorted_values, p):
    if not sorted_values:
        return None
    rank = max(1, -(-len(sorted_values) * p // 100))  # nearest rank, ceil
    return sorted_values[int(rank) - 1]


def status_class(status):
    try:
        return f"{int(status) // 100}xx"
    except (TypeError, ValueError):
        return "autre"


def empty_bucket():
    return {"requests": 0, "bots": 0, "others": 0, "status": {}, "durations": []}


def add(bucket, bot, status, duration_ms):
    bucket["requests"] += 1
    bucket["bots" if bot else "others"] += 1
    bucket["status"][status] = bucket["status"].get(status, 0) + 1
    if duration_ms is not None:
        bucket["durations"].append(duration_ms)


def merge(into, other):
    for key in ("requests", "bots", "others"):
        into[key] += other[key]
    for status, n in other["status"].items():
        into["status"][status] = into["status"].get(status, 0) + n
    into["durations"].extend(other["durations"])


def finish(bucket):
    durations = sorted(bucket.pop("durations"))
    bucket["status"] = dict(sorted(bucket["status"].items()))
    p50, p95 = percentile(durations, 50), percentile(durations, 95)
    bucket["p50Ms"] = None if p50 is None else round(p50, 1)
    bucket["p95Ms"] = None if p95 is None else round(p95, 1)
    return bucket


def aggregate(records, day):
    """Totals of one UTC day (YYYY-MM-DD) from parsed access-log records."""
    totals = empty_bucket()
    paths = {}
    not_found = {}
    seen = 0
    for record in records:
        if not isinstance(record, dict) or not str(record.get("StartUTC", "")).startswith(day):
            continue
        if host_kind(record.get("RequestHost")) is not None:
            seen += 1
        status_code = record.get("DownstreamStatus")
        key = normalise(record.get("RequestHost"), record.get("RequestPath"), status_code)
        if key is None:
            continue
        bot = is_bot(record.get("request_User-Agent"))
        status = status_class(status_code)
        duration = record.get("Duration")
        duration_ms = duration / 1e6 if isinstance(duration, (int, float)) else None
        add(totals, bot, status, duration_ms)
        add(paths.setdefault(key, empty_bucket()), bot, status, duration_ms)
        if status_code == 404:
            not_found[key] = not_found.get(key, 0) + 1

    rows, rest = [], empty_bucket()
    for (kind, path), bucket in paths.items():
        if bucket["requests"] < MIN_BUCKET:
            merge(rest, bucket)
        else:
            rows.append({"host": kind, "path": path, **finish(bucket)})
    rows.sort(key=lambda r: (-r["requests"], r["host"], r["path"]))
    if rest["requests"]:
        rows.append({"host": OTHERS, "path": OTHERS, **finish(rest)})

    nf_rows, nf_rest = [], 0
    for (kind, path), n in not_found.items():
        if n < MIN_BUCKET:
            nf_rest += n
        else:
            nf_rows.append({"host": kind, "path": path, "requests": n})
    nf_rows.sort(key=lambda r: (-r["requests"], r["host"], r["path"]))
    if nf_rest:
        nf_rows.append({"host": OTHERS, "path": OTHERS, "requests": nf_rest})

    return {
        "date": day,
        "scope": f"{DOMAIN}, hors administration, API et liens personnels",
        "minBucket": MIN_BUCKET,
        "totals": finish(totals),
        "paths": rows,
        "notFound": nf_rows,
    }, seen


def open_nofollow(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise ValueError(f"{path}: not a regular file")
    return os.fdopen(fd, "rb")


def read_records(paths):
    """Every JSON record of the files; raises on a read error (no partial totals)."""
    records = []
    for path in paths:
        with open_nofollow(path) as raw:
            reader = gzip.GzipFile(fileobj=raw, mode="rb") if path.endswith(".gz") else raw
            for line in reader:
                try:
                    records.append(json.loads(line))
                except ValueError:
                    continue
    return records


def input_files(archive_dir, live_file, day):
    """The live file and the archived files that can hold lines of that day (rotation lag)."""
    first = datetime.date.fromisoformat(day)
    names = [live_file] if os.path.exists(live_file) else []
    for name in sorted(os.listdir(archive_dir)) if os.path.isdir(archive_dir) else []:
        match = ARCHIVED.match(name)
        if match:
            date = datetime.datetime.strptime(match.group(1), "%Y%m%d").date()
            if first <= date <= first + datetime.timedelta(days=2):
                names.append(os.path.join(archive_dir, name))
    return names


def write_json(path, data):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".stats-", dir=directory)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)


def prune(out_dir, today, keep_days, log):
    limit = today - datetime.timedelta(days=keep_days)
    for name in sorted(os.listdir(out_dir)):
        match = re.match(r"^(\d{4}-\d{2}-\d{2})\.json$", name)
        if match and datetime.date.fromisoformat(match.group(1)) < limit:
            os.unlink(os.path.join(out_dir, name))
            log(f"deleted {name} (older than {keep_days} days)")


def days_to_compute(out_dir, today, explicit):
    if explicit:
        return [explicit]
    yesterday = today - datetime.timedelta(days=1)
    days = [yesterday.isoformat()]
    for back in range(2, BACKFILL_DAYS + 1):
        day = (today - datetime.timedelta(days=back)).isoformat()
        if not os.path.exists(os.path.join(out_dir, f"{day}.json")):
            days.append(day)
    return sorted(days)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--dir", default=ARCHIVE_DIR, help=f"archived access logs (default {ARCHIVE_DIR})")
    parser.add_argument("--live", default=LIVE_FILE, help=f"file Traefik writes (default {LIVE_FILE})")
    parser.add_argument("--out", default=OUT_DIR, help=f"directory of the daily totals (default {OUT_DIR})")
    parser.add_argument("--date", help="one UTC day YYYY-MM-DD (default yesterday and the missing days)")
    parser.add_argument("--keep-days", type=int, default=KEEP_DAYS, help=f"delete totals older than this (default {KEEP_DAYS})")
    parser.add_argument("--today", help="reference UTC date YYYY-MM-DD (tests)")
    parser.add_argument("--stdin", action="store_true", help="read JSON lines from stdin, print the totals")
    args = parser.parse_args(argv)
    log = lambda m: print(m, file=sys.stderr)

    today = datetime.date.fromisoformat(args.today) if args.today else datetime.datetime.now(datetime.timezone.utc).date()
    if args.date:
        datetime.date.fromisoformat(args.date)

    if args.stdin:
        day = args.date or (today - datetime.timedelta(days=1)).isoformat()
        records = (json.loads(l) for l in sys.stdin if l.strip())
        json.dump(aggregate(records, day)[0], sys.stdout, ensure_ascii=False, indent=1)
        sys.stdout.write("\n")
        return 0

    os.makedirs(args.out, exist_ok=True)
    failures = 0
    required = args.date or (today - datetime.timedelta(days=1)).isoformat()
    for day in days_to_compute(args.out, today, args.date):
        try:
            records = read_records(input_files(args.dir, args.live, day))
        except (OSError, ValueError, EOFError) as error:
            failures += 1
            log(f"error: {day}: {error}; nothing written")
            continue
        stats, seen = aggregate(records, day)
        if seen == 0 and day != required:
            continue  # an older missing day without any log (before the installation): nothing to fill
        write_json(os.path.join(args.out, f"{day}.json"), stats)
        log(f"{day}: {stats['totals']['requests']} requests counted, {len(stats['paths'])} paths")
        if seen == 0:
            failures += 1
            log(f"error: {day}: no {DOMAIN} request in the access log; is Traefik writing it? (k8s/log-rotation.md)")
    prune(args.out, today, args.keep_days, log)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
