#
# Installed as /etc/cron.d/traefik-log-stats (k8s/log-rotation.md; no dot in the installed name).
# Once a day, after the nightly logrotate run: anonymous totals of yesterday's benevol.app
# requests (UTC day), and of any of the last 7 days still missing, into
# /var/lib/traefik-stats/YYYY-MM-DD.json, kept two years. A day with no benevol.app request at
# all is reported as an error (access log probably not written). journalctl -t traefik-log-stats
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 4 * * * root out=$(traefik-log-stats 2>&1); rc=$?; [ -n "$out" ] && echo "$out" | logger -t traefik-log-stats; [ $rc -eq 0 ] || logger -p user.err -t traefik-log-stats "failed with exit code $rc"
