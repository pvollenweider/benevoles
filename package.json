{
  "name": "benevoles",
  "version": "2.0.2",
  "license": "AGPL-3.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "pretest:e2e": "node scripts/check-node-version.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "video:tts": "node --env-file-if-exists=.env.video.local --import tsx videos/tools/generate-tts.ts",
    "video:record": "node --env-file-if-exists=.env.video.e2e --env-file-if-exists=.env.video.local --import tsx videos/tools/record.ts",
    "video:assemble": "node --env-file-if-exists=.env.video.local --import tsx videos/tools/assemble.ts",
    "video:validate": "node --import tsx videos/tools/validate.ts",
    "video:publish": "node --import tsx videos/tools/publish.ts",
    "video:build": "node --env-file-if-exists=.env.video.e2e --env-file-if-exists=.env.video.local --import tsx videos/tools/build.ts",
    "video:pilot": "npm run video:record -- volunteer-register-mobile && npm run video:assemble -- volunteer-register-mobile",
    "video:organizer": "npm run video:record -- organizer-create-publish && npm run video:assemble -- organizer-create-publish",
    "video:features": "npm run video:record -- admin-features-tour && npm run video:assemble -- admin-features-tour",
    "video:followup": "npm run video:record -- organizer-monitor-followup && npm run video:assemble -- organizer-monitor-followup",
    "retention:docs": "tsx scripts/retention-docs.ts",
    "prepare": "husky",
    "postinstall": "[ -f prisma/schema.prisma ] && prisma generate || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^4.4.0",
    "marked": "^18.0.14",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.30.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0",
    "@hono/node-server": "^1.19.15",
    "valibot": "^1.4.2",
    "uuid": "^11.1.1",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^2": "^2.1.7",
    "brace-expansion@^5": "^5.0.12",
    "fast-uri": "^3.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
