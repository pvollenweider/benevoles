# Modèle de configuration pour la production (auto-hébergement : docs/auto-hebergement.md).
# Chaque variable lue par l'application est listée ici ; leur description complète est dans
# docs/configuration.md. Une variable commentée (#) garde sa valeur par défaut.

# --- Application ---

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/benevoles?schema=public"

# 32 caractères minimum : openssl rand -base64 48
AUTH_SECRET="une-chaine-aleatoire-32-chars-minimum"

# Chiffrement des liens personnels (obligatoire en production : le serveur refuse de démarrer sans)
# 32 octets en base64 : openssl rand -base64 32. Ne jamais la perdre (rotation : docs/configuration.md)
TOKEN_ENCRYPTION_KEY=""
# TOKEN_ENCRYPTION_KEY_ID="k1"
# Pendant une rotation seulement : "id:base64,id:base64"
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=""

# Production : https://benevol.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth v5 derrière un reverse proxy (obligatoire en production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"

# Protège /api/cron/* (obligatoire en production)
CRON_SECRET=""

# Identité de l'instance (#760). Sans valeur : le domaine de NEXT_PUBLIC_APP_URL, l'adresse de
# réponse, et aucun lien de soutien. HOSTED_SERVICE=true est réservé au service benevol.app.
# SITE_NAME=""
# CONTACT_EMAIL=""
# SUPPORT_URL=""
# HOSTED_SERVICE="false"

# Inscription en libre-service des associations (/inscription) : "off" la ferme
# SIGNUP=""

# Fuseau par défaut des événements (nom IANA)
# APP_TIME_ZONE="Europe/Zurich"

# Proxies qui ajoutent une entrée à X-Forwarded-For devant l'application
# TRUSTED_PROXY_HOPS="1"

# Vérifie une fois par jour la dernière version publiée sur GitHub (instances auto-hébergées) et
# prévient les super admins par email + bannière. Actif par défaut ; "off" le désactive
# complètement (aucune requête sortante), utile sur un intranet sans accès web.
RELEASE_CHECK="on"

# Espaces inactifs (#811) : report (défaut), on, off
# ORG_INACTIVITY="report"
# Événements passés (#813) : observe (défaut) ou enforce
# PAST_EVENT_RETENTION="observe"

# Démarrage du conteneur (docker-entrypoint.sh) : migrations et préchauffage, actifs par défaut
# MIGRATE_ON_START="true"
# WARMUP="true"
# WARMUP_TIMEOUT_MS=""
# WARMUP_REQUEST_TIMEOUT_MS=""
# WARMUP_CONCURRENCY=""
# WARMUP_READY_FILE="/tmp/benevoles-ready"

# --- Alertes à l'opérateur (optionnel) ---

# Sans valeur : les alertes partent par email aux super admins actifs
# OPERATOR_ALERT_EMAIL=""
# Sujet ntfy en https://, long et aléatoire ; jeton si le sujet est protégé
# NTFY_URL=""
# NTFY_TOKEN=""

# --- Email ---

# SMTP — exemples courants :
#   Gmail    : smtp.gmail.com:587 (mot de passe applicatif requis)
#   OVH      : ssl0.ovh.net:465  SMTP_SECURE=true
#   Infomaniak: mail.infomaniak.com:587
#   Brevo    : smtp-relay.brevo.com:587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Format avec friendly name : "Mon Asso <notifications@asso.dev>"
EMAIL_FROM="Bénévoles <notifications@votre-domaine.com>"
# Optionnel : adresse à laquelle les bénévoles atterrissent s'ils
# répondent. Pointer vers une vraie inbox lue par un humain.
EMAIL_REPLY_TO="contact@votre-domaine.com"

# Adresse qui reçoit une copie à chaque nouvelle inscription (optionnel)
ADMIN_NOTIFICATION_EMAIL=""

# Plafonds d'envoi (défauts dans docs/configuration.md)
# EMAIL_LIMIT_SIGNUP_PER_HOUR="60"
# EMAIL_LIMIT_ORG_PER_MINUTE="120"
# EMAIL_LIMIT_ORG_PER_DAY="5000"
# EMAIL_LIMIT_ORG_BULK_PER_DAY="2000"
# EMAIL_LIMIT_ORG_ACCOUNT_PER_DAY="50"
# EMAIL_LIMIT_RECIPIENT_PER_HOUR="5"
# EMAIL_LIMIT_GLOBAL_PER_MINUTE="600"

# --- Notifications push navigateur (VAPID, optionnel) ---

# Générer : node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact déclaré au service push. Défaut : EMAIL_FROM
# VAPID_EMAIL=""

# --- Bibliothèque vidéo (optionnel) ---

# Bibliothèque vidéo (/videos, non référencée dans la navigation ni le sitemap, #644) : base des
# fichiers rendus (vidéo .mp4, sous-titres .vtt, transcript .txt), sur un domaine séparé qui n'est
# pas une organisation (src/lib/org-subdomain.ts NON_ORG_SUBDOMAINS). Production : medias.benevol.app.
# En local, `make video-media-serve` sert videos/output sur un port local (voir videos/README.md).
VIDEO_MEDIA_BASE_URL="https://medias.benevol.app"

# --- Sentry (optionnel) ---

# DSN serveur ; NEXT_PUBLIC_SENTRY_DSN et SENTRY_AUTH_TOKEN servent au build de l'image
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# --- Seed (prisma/seed.ts seulement, jamais lu par l'application) ---

# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ORG_ADMIN_EMAIL=""
# ORG_ADMIN_PASSWORD=""
