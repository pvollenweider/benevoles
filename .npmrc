# Fails npm install/run loudly on the wrong Node version instead of silently continuing — see
# package.json's "engines" field and .nvmrc. Added after #228: a shell without an active Node
# version manager ran `next dev` under an unrelated system Node install, and nodemailer's
# configured timeouts silently failed to fire under that version, turning every email-sending
# route into a multi-minute hang with no error.
engine-strict=true
