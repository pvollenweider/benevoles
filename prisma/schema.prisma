generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  active           Boolean  @default(true)
  volunteerCharter String?
  hasOrgInsurance  Boolean  @default(true)
  // « Qui est inscrit » (#1068): the value a NEW event of this organisation starts with
  // (Event.shiftRosterEnabled). On by default; existing events keep their own value.
  shiftRosterDefault Boolean @default(true)
  publicTitle      String? // headline of the public events page; null = "Bénévoles"
  // IANA time zone of the organization's events (#344): shift times are local wall-clock times in
  // this zone (reminders, emails, event log, PDF export). null = deployment default (APP_TIME_ZONE).
  timeZone         String?
  // Notification settings (#381): reply-to for volunteers' answers, and which automatic emails
  // go out (src/lib/notification-settings.ts). Null = defaults.
  replyToEmail         String?
  notificationSettings Json?
  // First-run checklist hidden by an admin (#369). Progress itself is derived from the data.
  onboardingDismissedAt DateTime?
  // Suspension for abuse (#810, src/lib/org-suspension.ts): set only with active = false. Never
  // lifted by « Réactiver » or a self-service flow, never erased by the nightly cleanup.
  // The reason is the operator's note, shown only in the super admin space.
  suspendedAt      DateTime?
  suspensionReason String?
  // Grants of an organisation awaiting validation (#810, src/lib/org-approval.ts): publishing and
  // emailing third parties, separately. Null = not granted. Granted by default at creation; only
  // the self-service sign-up creates an organisation with both explicitly null.
  publicationApprovedAt   DateTime? @default(now())
  outboundEmailApprovedAt DateTime? @default(now())
  // What the association wrote about itself and its need when signing up (#810): helps the
  // operator validate the space. Shown only in the super admin space; null for other spaces.
  signupDescription String?
  // « Comment avez-vous connu … ? » (#1094, src/lib/signup-source.ts), copied from the request:
  // one of SIGNUP_SOURCES, and a short precision for « Autre ». Optional; super admin only.
  signupSource       String?
  signupSourceDetail String?
  // When the space was created by the self-service sign-up (#810): null for any other creation.
  // Feeds the sign-up indicators of the statistics (median validation delay, unused spaces).
  signupAt          DateTime?
  // Periodic check that the space is still wanted (#811, src/lib/org-inactivity.ts): the latest
  // meaningful activity (administrators' changes, volunteers' registrations; never scheduled jobs
  // nor page views), and the latest « Conserver mon organisation », kept apart on purpose.
  lastMeaningfulActivityAt DateTime?
  lastRetentionConfirmedAt DateTime?
  // The operator's hand on that check (#811): nothing happens before `inactivityPostponedUntil`,
  // and an exempt organisation is never deactivated automatically (« Ne jamais désactiver »).
  inactivityPostponedUntil DateTime?
  inactivityExempt         Boolean   @default(false)
  // Set when the check deactivated the space for lack of activity (#811). Only such a space can be
  // reactivated by its own administrators (« Réactiver mon espace »), and the nightly cleanup does
  // not erase it after 30 days like a space deactivated by the operator.
  inactivityDeactivatedAt  DateTime?
  // The procedure under way (#811, ORG_INACTIVITY=on): when the first « Souhaitez-vous conserver
  // votre espace ? » was sent (the reminders and the deactivation count from it), and how many of
  // its three emails went out. Both cleared when the procedure stops (activity, confirmation,
  // upcoming event, postponement, exclusion).
  inactivityNoticeAt       DateTime?
  inactivityEmailsSent     Int       @default(0)
  // Since #1114 each of the three messages is a row of OrgInactivityStep, confirmed once a copy
  // is accepted by the relay. The planned date: start of the day (organisation's time zone) from
  // which the space may be deactivated; it only moves later. `inactivityBlockedAt`: the procedure
  // is blocked (a step not confirmed in time, or an older procedure without proof) and the
  // operator was alerted, once; cleared when it is no longer blocked. All cleared when it stops.
  inactivityPlannedAt      DateTime?
  inactivityBlockedAt      DateTime?
  // Retention of past events (#813): the notice sent 30 days before the first batch, the last batch.
  pastEventNoticeAt DateTime?
  pastEventBatchAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events      Event[]
  volunteers  Volunteer[]
  admins      AdminUser[]
  keepLinks   OrgKeepLink[]
  inactivitySteps OrgInactivityStep[]
  slugHistory OrgSlugHistory[]
  logs        OrgLog[]
  targetedMessages TargetedMessage[]
  sendBatches SendBatch[]
  scheduledMessages ScheduledMessage[]
  messageTemplates MessageTemplate[]
  duplicateDismissals DuplicateDismissal[]
  charterVersions CharterVersion[]
  logo        OrganizationLogo?
  erasureRecords  ErasureRecord[]
  counters    OrganizationCounter[]
  emailLimitHits EmailLimitHit[]
}

// The organization's logo (#300), processed server-side (PNG or JPEG, at most 512 px on its longest
// side, about 200 KB) and served by /api/public/organizations/[id]/logo. A table of its own so that
// normal organization queries never load the image bytes; deleted with the organization (cascade).
// `hash` (SHA-256 of `data`) versions the URL and is the ETag.
model OrganizationLogo {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  mimeType       String
  width          Int
  height         Int
  hash           String
  updatedAt      DateTime     @updatedAt
}

model OrgSlugHistory {
  id             String       @id @default(cuid())
  slug           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Event {
  id                  String    @id @default(cuid())
  organizationId      String
  slug                String
  title               String
  description         String?
  location            String?
  publicStatus        String    @default("draft")
  // Unlisted events (#414): published and reachable by their link, but absent from the
  // organization's public page, the public list API and the sitemap (noindex). Discretion, not
  // access control: anyone with the link can open it. Independent from publicStatus.
  isListed            Boolean   @default(true)
  startDate           DateTime
  endDate             DateTime
  publicInstructions  String?
  confirmationMessage String?
  showSchedule        Json      @default("[]")
  reminderMessage     String?
  reminderSentAt      DateTime?
  remindersEnabled    Boolean   @default(true)
  // Public sign-up form requires a phone number (asked by an organizer who calls volunteers on
  // the day). Only the public form: an admin adding someone by hand may not have it.
  requirePhone        Boolean   @default(false)
  // Accent colour of the public page (#300, part 1): a key of the curated palette
  // (src/lib/event-accent.ts), never a free value, so the header stays readable.
  accentColorKey      String?
  // Registration window (#463), independent from publication: a published event can be visible
  // while sign-ups are closed. Open by default so existing events keep working; copies and
  // templates start closed. Optional schedule, as instants (entered in the organisation's zone).
  registrationsOpen    Boolean   @default(true)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  // Coordinates of the place (#191): typed once, shown as a map link; default for the shifts.
  latitude            Float?
  longitude           Float?
  // Day-of contact (#560): whom registered volunteers call on site when their shift has no
  // contact of its own. Shown only to registered volunteers (personal page, reminders,
  // individual printed sheet), never on the public page, the public API or metadata.
  dayContactName      String?
  dayContactPhone     String?
  // Self-cancellation deadline (#946): how long before each shift's start a confirmed
  // volunteer can still cancel with their personal link. Both null (or 0) = until the shift starts,
  // the default for every event; never after the start. Days are calendar days in the
  // organisation's zone, hours a duration on top. Admin removal is never limited by it.
  cancelDeadlineDays  Int?
  cancelDeadlineHours Int?
  // Shift roster between volunteers (#1068): when on, the event's identified viewers (confirmed
  // volunteers, invited members) see « Aline M. » for the volunteers who opted in (RosterConsent).
  // New events start with Organization.shiftRosterDefault, set by the creation routes; the column
  // default stays false (existing events and seeds keep their value). Turning it on shows nobody
  // by itself, and nobody is opted in on their behalf.
  shiftRosterEnabled  Boolean   @default(false)
  // Retention of past events (#813): when its registrations were anonymised, 3 years after its end.
  personalDataAnonymizedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts        Shift[]
  shiftRecurrences ShiftRecurrence[]
  registrations Registration[]
  memberInvites MemberInvite[]
  logs          EventLog[]
  pages         EventPage[]
  sectorLeaders SectorLeader[]
  milestones    EventMilestone[]
  targetedMessages TargetedMessage[]
  sendBatches      SendBatch[]
  scheduledMessages   ScheduledMessage[]
  questions        EventQuestion[]
  questionAnswers  QuestionAnswer[]
  groupLinks       EventGroupLink[]
  rosterConsents   RosterConsent[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Free-form extra content per event (rules, FAQ, practical info) beyond the single
// publicInstructions field — see issue #188. Flat, ordered list: no nesting, an event doesn't
// need a page hierarchy. `content` is Markdown, sanitized at render time, not on write — see
// src/lib/event-page-markdown.ts. Purely static: no variable injection (volunteer name, shift,
// ...), the public event page has no visitor identity to personalize with.
model EventPage {
  id           String   @id @default(cuid())
  eventId      String
  slug         String
  title        String
  content      String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
  @@index([eventId])
}

// "Sector leader" (responsable de secteur) — see issue #186. Scoped to a roleName within an
// event (matches how shifts already group on the planning, not per-shift: finer-grained scope
// wasn't a proven need). No login: a stable magic-link token, same pattern as MemberInvite,
// opens a read-only roster of who's signed up for that role — name, email, phone — without
// giving admin access to the rest of the event. v1 is read-only on purpose: no mutation surface
// to secure yet. Several leaders can share a roleName, and one person can lead several.
model SectorLeader {
  id        String   @id @default(cuid())
  eventId   String
  roleName  String
  name      String
  email     String
  // Access token of the personal link (#290). Looked up by `…Hash` (SHA-256); re-sent from
  // `…Enc` (AES-256-GCM, key TOKEN_ENCRYPTION_KEY, see src/lib/token-vault.ts). `…Legacy` is the
  // former clear-text column: only filled when no key is configured, and emptied by the cleanup
  // cron once one is, so a DB dump alone yields no usable link.
  tokenLegacy String?  @map("token")
  tokenHash   String   @unique
  tokenEnc    String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Also unique case-insensitively: "SectorLeader_eventId_roleName_email_ci_key" on lower(trim(email)), created by migration
  // 20260930110000_email_case_insensitive_unique (#342). Expression indexes can't be declared here;
  // if `prisma migrate dev` ever proposes dropping it, remove that statement from the generated SQL.
  @@unique([eventId, roleName, email])
  @@index([eventId])
}

// Share link per group (#947): a club or a team of a festival gets its own link and QR code,
// `/<event>?groupe=<code>`, showing only the roles it recruits for. Roles have no table of their own
// (they are the roleName shared by shifts): `roleNames` is kept in step when a role is renamed or
// deleted (src/app/api/admin/events/[id]/roles/[roleName]/route.ts), and a name no live shift
// carries any more is simply left out when the page is shown (src/lib/group-links.ts). `code` is
// random and stable, never the name: renaming the link, the event or a role keeps the URL working.
// Registrations made through it point to it (Registration.groupLinkId); deleting the link keeps
// them and only clears that reference.
model EventGroupLink {
  id        String   @id @default(cuid())
  eventId   String
  code      String   @unique
  name      String
  roleNames String[] @default([])
  hideFull  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
}

// Organizer milestone/deadline — see issue #189. Purely informational (name, due date,
// done/not-done): no automation, nothing it triggers on the rest of the event. Admin-only for
// now, not surfaced to sector leaders (#186) — most milestones cut across the whole event, not
// one role. Sorted by dueDate, not a manual displayOrder like EventPage/Shift.
model EventMilestone {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  dueDate   DateTime
  done      Boolean  @default(false)
  // Who is in charge (#985): an admin account of the event's organisation, active when chosen
  // (checked by the API, src/lib/milestones.ts). Cleared when the account is deleted.
  ownerId   String?
  // When the owner was emailed that the due date approaches (cron reminders, #985). Reset when
  // the owner or the due date changes, so the new owner or date gets its own reminder.
  ownerRemindedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([ownerId])
}

// Attached to the event, not to the entity it documents: it must survive the deletion of the
// Shift/Registration/etc. it's about (that's the whole point — "a registration disappeared,
// why?" needs an answer even after the registration is gone). Purged only when the whole event
// is deleted, same as the rest of its data.
//
// No actor display name is stored here (no `actorLabel`), on purpose: it would duplicate the
// admin's or volunteer's name into a place that outlives their own record, exactly what the
// minimal-PII rule on `changes` already rules out for the subject of an action. `actorId` (no
// foreign key) is resolved to a display name at read time by joining AdminUser/Volunteer; when
// that join misses (removed admin, RGPD-purged volunteer), the UI falls back to a generic label
// per `actorType` — see docs/roles-et-permissions.md.
model EventLog {
  id            String   @id @default(cuid())
  eventId       String
  actorType     String // "admin" | "volunteer" | "system"
  actorId       String? // AdminUser.id or Volunteer.id depending on actorType; null for system actions
  action        String // dot-namespaced, e.g. "shift.created", "registration.cancelled"
  entityType    String // "Shift" | "Registration" | "Event" | "MemberInvite" | "EventPage" | "SectorLeader" | "EventMilestone"
  entityId      String
  changes       Json? // { field: { from, to } }, non-PII values only
  causedByLogId String? // set when this entry is a direct, known consequence of another one
  // (e.g. a cancellation that triggers a waitlist offer) — never inferred from timing, only
  // ever set explicitly by the code path that knows the causal link. Powers narrative mode:
  // it follows this chain, it does not guess one from proximity.
  createdAt     DateTime @default(now())

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  causedBy  EventLog?  @relation("LogCausality", fields: [causedByLogId], references: [id], onDelete: SetNull)
  caused    EventLog[] @relation("LogCausality")

  @@index([eventId, createdAt])
  @@index([causedByLogId])
}

// Org-scoped counterpart to EventLog — see issue #194. Member (Volunteer) and AdminUser are
// organization-level entities, not attached to one event, so they can't use EventLog without an
// artificial eventId. Same principles: survives the entity it documents (member removed, admin
// removed), purged only with the organization (same 30-day cleanup cycle as the rest of org
// data), minimal PII in `changes`, no stored actor display name (resolved at read time, generic
// fallback if the actor record is gone). Simpler than EventLog on purpose — no causality chain,
// no narrative/replay modes: this log is smaller and read far less often.
// « Conserver mon organisation » links of the periodic check (#811): one per email and administrator,
// hash only, so the link of an earlier reminder still works. Gives access to no data; using one
// deletes all the organisation's links.
model OrgKeepLink {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminUserId    String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// One message of the inactivity procedure (#1114): queued once per organisation and step, confirmed
// when the first administrator's copy is accepted by the relay (set with the outbox row's « sent »
// status, in the same transaction: sent outbox rows are purged nightly). `recipientHashes`: HMAC of
// the addresses already queued (no address in clear), so an administrator added later gets the
// step once. `plannedAt`: the planned date its email announced. Deleted when the procedure stops.
model OrgInactivityStep {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  step            String // "first" | "second" | "last"
  queuedAt        DateTime
  confirmedAt     DateTime?
  recipients      Int          @default(0)
  recipientHashes String[]     @default([])
  plannedAt       DateTime
  createdAt       DateTime     @default(now())

  outbox NotificationOutbox[]

  @@unique([organizationId, step])
}

model OrgLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String // "admin" | "system"
  actorId        String? // AdminUser.id; null for system actions
  action         String // dot-namespaced, e.g. "member.created", "adminuser.removed"
  entityType     String // "Member" | "AdminUser"
  entityId       String
  changes        Json? // { field: { from, to } }, non-PII values only
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// A possible-duplicate pair (#601) dismissed by an organizer so it stops being suggested — until a
// new kind of signal appears for that pair (a new one of SignalKind in member-duplicates.ts), at
// which point the stored `signalsFingerprint` no longer matches and the pair resurfaces. Never
// stores a value computed from personal data — only ids and the sorted signal kinds — so a row
// here reveals nothing beyond "these two ids were once flagged together for these reasons".
// Cascade-deleted with either member or with the organization: no retention of its own, see
// RETENTION in src/lib/retention.ts and docs/rgpd/inventaire.md.
model DuplicateDismissal {
  id                 String   @id @default(cuid())
  organizationId     String
  // Ordered (volunteerIdA < volunteerIdB) so a pair is found regardless of which side it's
  // rebuilt from later.
  volunteerIdA       String
  volunteerIdB       String
  signalsFingerprint String
  dismissedAt        DateTime @default(now())
  dismissedBy        String? // AdminUser.id; kept even if that admin is later removed (no FK)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  volunteerA   Volunteer    @relation("DuplicateDismissalA", fields: [volunteerIdA], references: [id], onDelete: Cascade)
  volunteerB   Volunteer    @relation("DuplicateDismissalB", fields: [volunteerIdB], references: [id], onDelete: Cascade)

  @@unique([organizationId, volunteerIdA, volunteerIdB, signalsFingerprint])
  @@index([organizationId])
  @@index([volunteerIdA])
  @@index([volunteerIdB])
}

// Proof of acceptance of the volunteer charter (#569): the sign-up route hashes the exact text
// shown (src/lib/charter-hash.ts, resolveCharterText) and stores the hash plus acceptance date on
// each Registration it creates (Registration.charterAcceptedHash/At) — the simplest place to
// answer "which text, when", since one sign-up may create several registrations and each already
// carries its own creation date. This table resolves a hash back to its text later: one row per
// distinct text an organization has shown, upserted (never overwritten) the first time it's seen.
// Lives with the organization (no retention of its own): see RETENTION in src/lib/retention.ts and
// docs/rgpd/inventaire.md.
model CharterVersion {
  id             String   @id @default(cuid())
  organizationId String
  hash           String
  text           String
  firstSeenAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, hash])
  @@index([organizationId])
}

// One row per manual product-update broadcast to the beta-tester (AdminUser) pool — see
// issue #200. Not a queue/job table: sending is synchronous within the request (a handful of
// recipients, admin-triggered by hand, not periodic) — this is a history/log of what was sent,
// for the admin UI to show past sends, not a work queue to drain.
model ProductUpdateSend {
  id             String   @id @default(cuid())
  subject        String
  content        String // Markdown, same source rendered for every recipient
  sentByAdminId  String? // AdminUser.id; no FK — must survive that admin being removed later
  recipientCount Int
  successCount   Int
  createdAt      DateTime @default(now())
}

model Shift {
  id              String   @id @default(cuid())
  eventId         String
  roleName        String
  label           String
  description     String?
  date            DateTime
  startTime       String
  endTime         String
  capacity        Int
  // Minimum of people the shift can run with (#949): 1 ≤ minVolunteers ≤ capacity. Null = the same
  // as capacity, so a shift without a minimum behaves as before (« complet » or not). Only the
  // organizers see it (below minimum, minimum reached, full); the public page shows free places only.
  minVolunteers   Int?
  status          String   @default("open")
  locationDetails String?
  displayOrder    Int      @default(0)
  internalNotes   String?
  waitlistEnabled Boolean  @default(false)
  // Sign-up approval (#484): a public sign-up becomes a request (status "requested") that holds
  // a spot until an organizer accepts it (→ active) or refuses it (→ refused).
  requiresApproval Boolean @default(false)
  // Practical info for the volunteers of this shift (#397), shown with the place
  // (locationDetails) in the confirmation email, the reminders, the personal page and the
  // public sign-up recap. Short by design: no mission sheets, files or workflows.
  contactName     String?
  contactPhone    String?
  instructions    String?
  // Coordinates of the meeting point (#191); null = the event's.
  latitude        Float?
  longitude       Float?
  // Minimum age to self-register, in years — see issue #192. Enforced server-side at
  // registration (Volunteer.birthDate, collected on the public form only when at least one
  // selected shift requires it). Not proactively greyed out on the public timeline: we don't
  // know a first-time visitor's age until they fill the form, so the timeline shows it as an
  // informational badge instead — see DayTimeline.tsx.
  minAge          Int?
  // Admin override for the role's display color — a key into the curated palette in
  // src/lib/roles.tsx (never a raw hex/CSS color: every option there is pre-checked for AA
  // contrast with the white bar text). Null falls back to the existing keyword/hash-based
  // default. Shared per role, set uniformly across its shifts — see displayOrder above and
  // issue #219.
  colorKey        String?
  // Optional limit of shifts per volunteer for this role (#466): live registrations (confirmed,
  // offered, waitlist) of one volunteer on the role's shifts of the event. Shared per role, set
  // uniformly across its shifts like colorKey. Null = no limit.
  maxPerVolunteer Int?
  // Role reserved to members with one of these tags (#470), checked from the member invitation at
  // sign-up. Shared per role like colorKey. Empty = open to everyone.
  reservedTags    String[] @default([])
  // Role whose shifts may overlap any other shift of the same volunteer (#986), e.g. first aid while
  // serving coffee: two shifts overlap for one person only if neither allows it
  // (src/lib/shift-overlap.ts). Shared per role like colorKey: set on every shift of the role by the
  // role route, taken by a shift created in (or moved to) the role (src/lib/role-settings.ts, like
  // colorKey, maxPerVolunteer, reservedTags and displayOrder, #1002), and by event duplication.
  overlapAllowed  Boolean  @default(false)
  // Role « Attribué par l'organisation uniquement » (#1145): its shifts are never offered publicly
  // (public page and API, group links, embeds, invitations) and the public sign-up refuses them;
  // organisers add people by hand. A role is assigned-only as soon as one of its live shifts is
  // (src/lib/role-assignment.ts). Shared per role like colorKey (role route, src/lib/role-settings.ts,
  // event and shift duplication). False = public behaviour unchanged.
  assignedOnly    Boolean  @default(false)
  // Recurring permanence (#866) this shift was generated by; null for a shift created on its own.
  // Kept on the shift when the rule is deleted (SetNull): the shift and its registrations stay.
  recurrenceId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recurrence    ShiftRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([recurrenceId])
}

// A recurring permanence (#866): one description (« every Wednesday 14:00–17:00 until June »)
// inside an event, from which ordinary shifts are generated (src/lib/shift-recurrence.ts). Kept
// so « this date and the following ones » can be changed and the rule shown again.
model ShiftRecurrence {
  id           String   @id @default(cuid())
  eventId      String
  roleName     String
  label        String
  // ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays     Int[]
  // 1 = every week, 2 = every other week (from the week of fromDate).
  everyWeeks   Int      @default(1)
  startTime    String
  endTime      String
  slotMinutes  Int
  breakMinutes Int      @default(0)
  capacity     Int
  fromDate     DateTime
  untilDate    DateTime
  // "none" | "FR" | "CH" (src/lib/shift-recurrence.ts).
  holidays     String   @default("none")
  // Days left out by hand, "YYYY-MM-DD".
  closures     String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([eventId])
}

model Volunteer {
  id             String   @id @default(cuid())
  organizationId String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  tags           String[] @default([])
  active         Boolean  @default(true)
  notes          String?
  // Collected only when the volunteer selects a shift with a minimum age (Shift.minAge, #192) —
  // never asked upfront for everyone. Kept on the profile (not re-asked every event) once given.
  birthDate      DateTime?
  // Optional general availability (#402): "morning" / "afternoon" / "evening", and a short note
  // on exceptions. Read by organizers when placing someone by hand; never used to match or filter
  // automatically, and not asked on the public form.
  availabilityPeriods String[] @default([])
  availabilityNote    String?
  // Member merge (#600): set once this record was absorbed into another one, confirmed by an
  // organizer as the same person. `mergedIntoId` is the mapping old ids resolve through
  // (event-log-read.ts, member-activity-data.ts); `mergedAt` drives the tombstone's own retention
  // (src/lib/retention.ts) — purged by the cleanup cron like the rest of the merge data. A merged
  // record is always `active: false` and has every personal field cleared (names emptied, email
  // null, phone/notes/birthDate/tags/availability cleared) — see src/lib/member-merge-transaction.ts.
  mergedIntoId   String?
  mergedAt       DateTime?
  // Erasure of personal data (#516, owner decision 2026-10-05: anonymise, not delete): set once the
  // record was emptied (names « Bénévole effacé », every other personal field cleared, inactive)
  // while its registrations stay for counts, hours and history. Never cleared again; an erased
  // record can't be edited, merged or erased twice. See src/lib/member-erasure-transaction.ts.
  erasedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  registrations     Registration[]
  invites           MemberInvite[]
  pushSubscriptions PushSubscription[]
  questionAnswers   QuestionAnswer[]
  deliveryOutcomes  DeliveryOutcome[]
  rosterConsents    RosterConsent[]
  mergedInto        Volunteer?     @relation("VolunteerMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        Volunteer[]    @relation("VolunteerMerge")
  // Possible-duplicate dismissals (#601) naming this record as either side of the pair.
  duplicateDismissalsAsA DuplicateDismissal[] @relation("DuplicateDismissalA")
  duplicateDismissalsAsB DuplicateDismissal[] @relation("DuplicateDismissalB")

  // Also unique case-insensitively: "Volunteer_organizationId_email_ci_key" on lower(trim(email)), created by migration
  // 20260930110000_email_case_insensitive_unique (#342). Expression indexes can't be declared here;
  // if `prisma migrate dev` ever proposes dropping it, remove that statement from the generated SQL.
  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId])
  @@index([mergedIntoId])
}

model Registration {
  id               String    @id @default(cuid())
  eventId          String
  shiftId          String
  volunteerId      String
  status           String    @default("active")
  source           String    @default("public_form")
  comment          String?
  // Phone given on the public form for this registration. The volunteer profile is only updated
  // with proof of email ownership (#285), so without this a phone the event requires
  // (Event.requirePhone) would be lost for an already-known volunteer. Displayed in priority
  // over the profile's phone — see contactPhone() in src/lib/contact-phone.ts.
  phone            String?
  // Access token of the personal link (#290). Looked up by `…Hash` (SHA-256); re-sent from
  // `…Enc` (AES-256-GCM, key TOKEN_ENCRYPTION_KEY, see src/lib/token-vault.ts). `…Legacy` is the
  // former clear-text column: only filled when no key is configured, and emptied by the cleanup
  // cron once one is, so a DB dump alone yields no usable link.
  editTokenLegacy  String?   @map("editToken")
  editTokenHash    String    @unique
  editTokenEnc     String?
  reminderJ2Sent   DateTime?
  reminderJ1Sent   DateTime?
  reminderDdSent   DateTime?
  waitingPosition  Int?
  waitingOfferedAt DateTime?
  waitingExpiresAt DateTime?
  // Lightweight check-in (#399): when the organizer marked this person present on site. Null
  // until then; cleared by « Annuler la présence ». No terminals, badges or access control.
  checkedInAt      DateTime?
  // Last email carrying the personal link (confirmation or re-send), for the personal page (#376).
  linkEmailedAt    DateTime?
  // Proof of acceptance of the volunteer charter at public sign-up (#569): SHA-256 of the exact
  // text shown (src/lib/charter-hash.ts; resolved back to its text via CharterVersion) and when.
  // Null for a registration added by an admin (source "admin_manual"): no volunteer consent was
  // given there, so nothing is recorded.
  charterAcceptedHash String?
  charterAcceptedAt   DateTime?
  // The group link (#947) the public sign-up came through, set by the server from the link's code;
  // null for the main link, an admin addition, or once that group link is deleted.
  groupLinkId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shift     Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer Volunteer       @relation(fields: [volunteerId], references: [id])
  groupLink EventGroupLink? @relation(fields: [groupLinkId], references: [id], onDelete: SetNull)

  // One live registration per volunteer and shift (#264). Partial: cancelled rows are kept for
  // history, and a volunteer may cancel then register again. Backstops the route-level check,
  // which alone can't stop a double submit racing itself.
  @@unique([shiftId, volunteerId], map: "Registration_shift_volunteer_live_key", where: raw("status IN ('active', 'waiting', 'offered', 'requested')"))
  @@index([status, reminderJ2Sent])
  @@index([status, reminderJ1Sent])
  @@index([status, reminderDdSent])
  @@index([status, shiftId])
  @@index([waitingPosition, shiftId])
  @@index([groupLinkId])
}

model MemberInvite {
  id          String    @id @default(cuid())
  eventId     String
  volunteerId String
  // Access token of the personal link (#290). Looked up by `…Hash` (SHA-256); re-sent from
  // `…Enc` (AES-256-GCM, key TOKEN_ENCRYPTION_KEY, see src/lib/token-vault.ts). `…Legacy` is the
  // former clear-text column: only filled when no key is configured, and emptied by the cleanup
  // cron once one is, so a DB dump alone yields no usable link.
  tokenLegacy String?   @map("token")
  tokenHash   String    @unique
  tokenEnc    String?
  sentAt      DateTime  @default(now())
  usedAt      DateTime?
  // Set when the member answers « Je ne suis pas disponible » from the invite link (#558); never
  // from the admin side. Cleared when they register from the same link (change of mind), but a
  // later withdrawal of all their shifts does not set it back (product decision, #558).
  declinedAt  DateTime?
  // When the invitation email was last sent again (#1105): a reminder (« Relancer les invités sans
  // réponse ») or a new invitation of someone already invited. With `sentAt`, it keeps a reminder
  // from emailing the same person twice within 48 h (src/lib/invitation-sending.ts).
  lastRemindedAt DateTime?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
}

// Erasure register (#516): one row per member whose personal data was erased, so the erasure can
// be replayed after a database restore (scripts/erasure-register.ts, docs/rgpd/procedure-effacement.md).
// No personal data: the member id (whose record is itself anonymised) and a keyed hash of the
// normalized email (HMAC-SHA256 with AUTH_SECRET, bound to the organization, see
// src/lib/member-erasure-register.ts) — never the address itself. `volunteerId` has no foreign key on
// purpose: the entry must outlive the record (a later permanent deletion, #667) to stay replayable.
// Deleted with the organization.
model ErasureRecord {
  id             String   @id @default(cuid())
  organizationId String
  volunteerId    String   @unique
  emailHash      String?
  erasedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, erasedAt])
}

// Outbox for notifications sent as a consequence of a request (#293), starting with public
// sign-up: the request only writes rows here, delivery happens right after the response
// (next/server `after`) and failed sends are retried by the hourly cron with backoff, instead of
// the volunteer waiting on SMTP and a failed email being lost. `payload` is the
// NotificationPayload given to sendNotification (recipient + template data, so it holds PII):
// rows are deleted once sent (cleanup cron), and failed ones after 30 days.
model NotificationOutbox {
  id            String    @id @default(cuid())
  payload       Json
  status        String    @default("pending") // "pending" | "sending" | "sent" | "failed" | "cancelled" (#814)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  lastError     String?
  // Optional business key (#315): the same notification enqueued twice (retried request,
  // repeated trigger) is stored once. Nullable and unique, so rows without a key never collide.
  dedupeKey     String?   @unique
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  // The organization the notification belongs to (#382), for the admin delivery page. Nullable:
  // rows enqueued before the column existed, and the rare system-level ones.
  organizationId String?
  // The targeted message this email belongs to (#467), for its delivery summary.
  targetedMessageId String?
  targetedMessage   TargetedMessage? @relation(fields: [targetedMessageId], references: [id], onDelete: SetNull)
  // Last time a sending limit held this email back (#1100); null = never held. Lets one email
  // held several times count once per hour in EmailLimitHit, and tells « still held » apart.
  lastHeldAt        DateTime?
  // First time a sending limit held it (#1101): with sentAt, how long the limit delayed it.
  firstHeldAt       DateTime?
  // The batch it was sent with (#1101): invitations, a reminder, a message to volunteers.
  sendBatchId       String?
  sendBatch         SendBatch? @relation(fields: [sendBatchId], references: [id], onDelete: SetNull)
  // The inactivity step this copy belongs to (#1114): its « sent » confirms the step.
  inactivityStepId  String?
  inactivityStep    OrgInactivityStep? @relation(fields: [inactivityStepId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([targetedMessageId])
  @@index([organizationId, createdAt])
  @@index([sendBatchId])
  @@index([inactivityStepId])
}

// Per-recipient SMTP outcome of a send (#598): "accepted by our relay" is the only thing a
// submission relay proves (see src/lib/notifications/smtp-outcome.ts); it is not "delivered" and
// still less "read". No raw SMTP reply, no address, no content, no token — only a hash of the
// normalized address, so a later success to the same address is still recognizable (#599).
// `organizationId` is denormalized like NotificationOutbox.organizationId (not a FK): it must
// survive the volunteer or the outbox row being cleaned up so the retention window keeps working
// and cross-tenant reads (src/lib/delivery-outcomes-data.ts) can filter on it directly.
model DeliveryOutcome {
  id             String   @id @default(cuid())
  organizationId String?
  // The member concerned, when the recipient is one (nullable: admins, sector leaders and test
  // emails have none). Deleting a volunteer (#667, cascade) or erasing their personal data (#516,
  // explicit delete in src/lib/member-erasure-transaction.ts) removes their outcomes with it.
  volunteerId    String?
  // The outbox row this send went through, when there was one (nullable: synchronous sends).
  outboxId       String?
  kind           String
  outcome        String // "accepted_by_relay" | "rejected_permanent" | "failed_temporary" | "unknown"
  reason         String? // normalized reason, see SmtpReason in src/lib/notifications/smtp-outcome.ts
  responseCode   Int?
  enhancedStatus String? // e.g. "5.1.1"
  addressHash    String? // HMAC-SHA256 of the normalized address, keyed with AUTH_SECRET
  createdAt      DateTime @default(now())

  volunteer Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([volunteerId, createdAt])
  @@index([addressHash, createdAt])
}

// Reusable targeted-message templates of an organisation (#482): a name, a subject and a plain
// text with documented variables ({prénom}, {événement}, {poste}, {créneau}), picked and edited in
// « Écrire aux bénévoles ». A few per organisation; deleted with it.
model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, name])
}

// A question of an event's sign-up form (#483): text, yes/no, single or multiple choice, required
// or not. At most a few per event. A question with answers is never deleted: removing it archives
// it (archivedAt), so the answers stay for the admin views and exports until the event goes.
model EventQuestion {
  id         String    @id @default(cuid())
  eventId    String
  position   Int       @default(0)
  label      String
  // "text" | "yesno" | "single" | "multiple" | "number"
  type       String
  options    String[]  @default([])
  required   Boolean   @default(false)
  // Bounds of a "number" question (#1015), whole numbers 0 or more: null minValue means 0, null
  // maxValue no upper bound. Null for the other types.
  minValue   Int?
  maxValue   Int?
  // Poste the question concerns (#984, part 3): a volunteer's later change of their answer goes to
  // that role's sector leaders instead of the organisers. Roles have no table (they are the
  // roleName shared by shifts), so this is the name, kept in step like EventGroupLink.roleNames:
  // renamed with the role, cleared when the role is deleted (src/app/api/admin/events/[id]/roles/
  // [roleName]/route.ts). Null = the organisers, as before. Who is asked is displayScope's job.
  roleName   String?
  // Follow-up question (#1016): shown only when the volunteer's answer to the parent question (a
  // yes/no or choice question of the same event, itself not a follow-up) is one of showIfValues;
  // hidden and not required otherwise, its stored answer cleared when the parent answer stops
  // matching. One level only. Removing a parent removes its follow-ups too (deleted when
  // unanswered, archived otherwise), in the API: SetNull is only the database's safety net.
  parentId     String?
  showIfValues String[]  @default([])
  // Display scope (#1140), apart from roleName (which only routes change emails): "event" = asked
  // to every volunteer (default, every question created before); "roles" = asked only to volunteers
  // whose live registrations include a shift of one of displayRoleNames (the role names of the
  // event's shifts, kept in step on rename, dropped on deletion: "roles" with none left is asked to
  // nobody rather than widened to everyone). A follow-up has no scope of its own: it follows its
  // parent's (src/lib/question-scope.ts). Answers stay attached to the question, whatever the scope.
  displayScope     String   @default("event")
  displayRoleNames String[] @default([])
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parent    EventQuestion?   @relation("QuestionFollowUps", fields: [parentId], references: [id], onDelete: SetNull)
  followUps EventQuestion[]  @relation("QuestionFollowUps")
  answers   QuestionAnswer[]

  @@index([eventId, position])
}

// One volunteer's answer to one question of an event (#483), asked once per event. Values as a
// list: one item for text / yes-no / single choice / number (its digits, #1015), several for
// multiple choice.
model QuestionAnswer {
  id          String   @id @default(cuid())
  questionId  String
  eventId     String
  volunteerId String
  values      String[]
  updatedAt   DateTime @updatedAt

  question  EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([questionId, volunteerId])
  @@index([eventId])
}

// A volunteer's choice about the shift roster of one event (#1068): whether the other confirmed
// volunteers of their shifts may see their first name and last-name initial. Opt-in, one row per
// (event, volunteer), none until a choice is made (= hidden). "pending": asked on a sign-up form
// that proves nothing about who submitted it (src/lib/shift-roster.ts), shown only once confirmed
// from the personal page. `noticeVersion` names the text shown (ROSTER_NOTICE_VERSION); `source`
// how the choice was made. The grants and withdrawals are also in the event log. Deleted with the
// event, the member, on erasure, on merge and with the past event's anonymisation.
model RosterConsent {
  id            String   @id @default(cuid())
  eventId       String
  volunteerId   String
  status        String
  noticeVersion String
  source        String
  decidedAt     DateTime

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@index([volunteerId])
}

// One row per targeted message sent to volunteers (#467): who wrote what, when, to whom, and how
// it was delivered. The outbox rows are purged (sent every night, failed after 30 days), so the
// cleanup adds what it deletes to sentCount / failedCount first: the summary is those counters
// plus the rows still in the outbox. Kept 12 months (the content may hold personal information),
// then deleted by the cleanup; deleted with the event too.
model TargetedMessage {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  // AdminUser.id, and the name at the time: the account may be removed later.
  authorId       String?
  authorName     String
  subject        String
  message        String
  audienceLabel  String
  recipientCount Int
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  // Push sent with the message (#468): devices targeted, and outcomes, apart from the emails.
  pushRequested  Boolean  @default(false)
  pushDevices    Int      @default(0)
  pushSent       Int      @default(0)
  pushFailed     Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outbox       NotificationOutbox[]
  scheduled    ScheduledMessage?
  sendBatch    SendBatch?

  @@index([eventId, createdAt])
  @@index([createdAt])
}

// A targeted message scheduled for a chosen date and time (#1019). It stores the organiser's
// intent (audience selector, text, push option), not the recipients: they are computed when it
// goes, like an immediate send. The outbox cron (every 5 minutes, src/app/api/cron/outbox) picks
// the due ones, claims each with a conditional update, then in one transaction creates the
// TargetedMessage history row, queues its emails (dedupe key per scheduled message and person)
// and marks this row "sent": it goes once. A cancelled one never goes; one whose event is archived,
// whose shift is gone or whose audience is empty when due is "skipped", with the reason. Kept as
// long as targeted messages (12 months), deleted with the event.
model ScheduledMessage {
  id                String           @id @default(cuid())
  organizationId    String
  eventId           String
  authorId          String?
  authorName        String
  subject           String
  message           String
  // The audience selector of src/lib/targeted-message.ts (audienceSchema), and its label at
  // scheduling time for the list.
  audience          Json
  audienceLabel     String
  push              Boolean          @default(false)
  scheduledFor      DateTime        
  status            String           @default("scheduled") // "scheduled" | "sending" | "sent" | "cancelled" | "skipped"
  claimedAt         DateTime?       
  skipReason        String?
  cancelledAt       DateTime?       
  cancelledByName   String?
  // The history row created when it went.
  targetedMessageId String?          @unique
  createdAt         DateTime         @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetedMessage TargetedMessage? @relation(fields: [targetedMessageId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([eventId, scheduledFor])
}

// Rate limit counters (#322), shared by every app replica: one fixed window per "<route>:<key>",
// bumped by an atomic upsert in src/lib/rate-limit.ts (raw SQL, database clock). Expired rows
// are deleted by the cleanup cron.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Web push subscription, tied to one Volunteer (hence to one organization through it). Creating
// one requires the volunteer's registration editToken, not just an email: the reminder payload
// links to /my/<editToken>, so whoever owns the endpoint receives that link. Same browser can
// hold subscriptions for several volunteers (shared device, or one person in two orgs).
model PushSubscription {
  id          String   @id @default(cuid())
  volunteerId String
  endpoint    String
  auth        String
  p256dh      String
  createdAt   DateTime @default(now())

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([endpoint, volunteerId])
  @@index([volunteerId])
}

model AdminUser {
  id                     String    @id @default(cuid())
  organizationId         String?
  // Also unique case-insensitively: "AdminUser_email_ci_key" on lower(trim(email)), created by migration
  // 20260930110000_email_case_insensitive_unique (#342). Expression indexes can't be declared here;
  // if `prisma migrate dev` ever proposes dropping it, remove that statement from the generated SQL.
  email                  String    @unique
  name                   String
  passwordHash           String
  // Incremented on every password change or reset (#360); copied into the JWT at sign-in and
  // re-checked on every request (refreshAdminToken), so sessions opened before the change end.
  sessionVersion         Int       @default(0)
  role                   String    @default("admin")
  isActive               Boolean   @default(true)
  // SHA-256 (hex) of the one-time links emailed to the admin, never the tokens themselves (#269):
  // a DB dump or backup must not hand out working account-setup / password-reset links. The
  // plaintext exists only in the email; see src/lib/token-hash.ts.
  setupTokenHash         String?   @unique
  setupTokenExpiresAt    DateTime?
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  // Single-use link « Réactiver mon espace » (#811): hash only, 24 hours, for an organisation
  // deactivated for inactivity. Cleared when used, and when the organisation is active again.
  orgReactivationTokenHash String?   @unique
  orgReactivationExpiresAt DateTime?
  // Product-update emails (#200) — distinct from having an account at all. Defaults to opted
  // in (this is how the super admin reaches the beta-tester pool); an admin can unsubscribe via
  // a signed link in the email itself, no login required.
  receiveProductUpdates       Boolean   @default(true)
  productUpdatesUnsubscribedAt DateTime?
  // Release banner (#612): the version this super admin dismissed. A newer version makes the
  // banner reappear even though this field is unchanged — the comparison, not a reset, does it.
  releaseBannerDismissedVersion String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  milestones   EventMilestone[]

  @@index([organizationId])
  @@index([setupTokenHash])
}

// Last run of each scheduled job (#383): reminders and cleanup write it themselves, the backup
// CronJobs and the manual restore test post a heartbeat (POST /api/cron/heartbeat). One row per
// job, overwritten each time: the health page only needs the latest state.
model JobRun {
  job        String    @id
  startedAt  DateTime
  finishedAt DateTime?
  ok         Boolean?
  error      String?
  summary    Json?
  updatedAt  DateTime  @updatedAt
}

// Latest known GitHub release of pvollenweider/benevoles (#612), checked once a day by
// /api/cron/release-check (self-hosted instances; off by RELEASE_CHECK=off). Single row, id fixed
// to "singleton". lastNotifiedVersion keeps the super admin email from going out twice for the
// same version.
model ReleaseCheckState {
  id                  String    @id @default("singleton")
  latestVersion       String?
  releaseUrl          String?
  lastCheckedAt       DateTime?
  lastNotifiedVersion String?
  updatedAt           DateTime  @updatedAt
}

// « Cette vidéo vous a-t-elle été utile ? » (#646): one anonymous Oui/Non answer per row, tied to
// the catalogue video id and the revision it was shown at (videos/catalog.json `revision`), so a
// fully regenerated video starts with no answers. No relation to any organization, no person, no
// IP, no cookie, no session; `answeredOn` is the day only, and the id is a random UUID (not a
// cuid, which embeds a millisecond timestamp). Purged by the cleanup cron after
// RETENTION_DAYS.videoFeedback (src/lib/retention.ts).
model VideoFeedback {
  id         String   @id @default(uuid())
  videoId    String
  revision   Int
  language   String
  useful     Boolean
  // "masterclass" (the video library) or "documentation" (opened from a guide, ?from=doc).
  context    String
  answeredOn DateTime @db.Date

  @@index([videoId, revision])
  @@index([answeredOn])
}

// Cumulative usage counters for the super admin (#805): how many rows of each kind were ever created,
// never lowered by a deletion. Incremented by AFTER INSERT triggers that Prisma does not model
// (migration 20261008150000_usage_counters); the metrics are listed in src/lib/usage-counters.ts.
// Read only by the app. Counts only, no personal data.
// A sending limit reached (#1100, src/lib/notifications/limit-hits.ts): one row per limit,
// organisation and UTC hour, with how many emails it held (queued, they leave when the window
// ends) or refused (a direct send that failed, or a public-triggered email dropped). No address,
// no content, no recipient: an organisation, a limit name, times and counts. Kept 90 days
// (src/lib/retention.ts). `organizationId` null: platform emails, outside any organisation.
// One batch of emails sent at once from an event (#1101, src/lib/send-batches.ts): invitations,
// a reminder of the invitees, the manual reminder, a message to volunteers (now, scheduled, or
// « créneaux à compléter »). Who and when, how many, and how it was delivered; no recipient, no
// address, no content (a message's text stays in TargetedMessage, kept less long). The outbox rows
// are purged every night, so the cleanup folds their outcome into the counters first, like
// TargetedMessage (#467); the live summary is the counters plus the rows still queued.
// Kept 3 years (src/lib/retention.ts), or until the event is deleted.
model SendBatch {
  id                String   @id @default(cuid())
  organizationId    String
  eventId           String
  // "member_invite" | "invite_reminder" | "manual_reminder" | "targeted_message" | "scheduled_message" | "open_shifts"
  kind              String
  // AdminUser.id of who sent it (who scheduled it, for a scheduled message); the name is read at
  // display, like OrgLog. Null: no administrator (removed meanwhile, or none).
  actorId           String?
  // Emails queued with the batch.
  recipientCount    Int      @default(0)
  // Outcomes of rows already purged from the outbox.
  sentCount         Int      @default(0)
  // Among them, sent after a sending limit held them back.
  heldSentCount     Int      @default(0)
  failedCount       Int      @default(0)
  cancelledCount    Int      @default(0)
  // Longest wait a limit caused among the purged rows, in seconds.
  maxHeldWaitSec    Int      @default(0)
  // The message history row (#467) for the message kinds; null once that one is deleted.
  targetedMessageId String?  @unique
  createdAt         DateTime @default(now())

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetedMessage TargetedMessage?     @relation(fields: [targetedMessageId], references: [id], onDelete: SetNull)
  outbox          NotificationOutbox[]

  @@index([organizationId, eventId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model EmailLimitHit {
  id             String   @id @default(cuid())
  // limit:organisation-or-"platform":UTC hour, the upsert key.
  bucket         String   @unique
  organizationId String?
  limit          String
  hourStart      DateTime
  heldCount      Int      @default(0)
  refusedCount   Int      @default(0)
  firstAt        DateTime @default(now())
  lastAt         DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([lastAt])
  @@index([organizationId, lastAt])
}

model PlatformCounter {
  metric String @id
  value  BigInt @default(0)
}

// The same counters per organisation, deleted with it: its counts stay in PlatformCounter.
model OrganizationCounter {
  organizationId String
  metric         String
  value          BigInt @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, metric])
}

// Self-service sign-up request (#810, src/lib/signup.ts): what was typed on /inscription, until the
// address is confirmed. Only the token's hash is kept. No foreign key to the organisation it
// creates: the request is deleted by the nightly cleanup 7 days after its creation either way.
model SignupRequest {
  id               String    @id @default(cuid())
  organizationName String
  contactName      String
  email            String
  description      String?
  // Optional « Comment avez-vous connu … ? » answer (#1094), copied to the organisation.
  source           String?
  sourceDetail     String?
  tokenHash        String    @unique
  expiresAt        DateTime
  confirmedAt      DateTime?
  organizationId   String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
}

// Block list of the self-service sign-up (#810, src/lib/signup-blocklist.ts). `value` is the
// normalised address or domain, or the keyed hash of an IP (never the IP itself); `label` is what
// the super admin sees (the address, the domain, or « IP …xx » for an IP). An IP entry always expires.
model SignupBlock {
  id          String    @id @default(cuid())
  kind        String
  value       String
  label       String
  reason      String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([kind, value])
}

// The operator's decisions (#810, src/lib/operator-log.ts): kept apart from OrgLog, which goes with
// its organisation, so a refused or deleted space still leaves a trace. Labels are copied at the
// decision. Deleted after RETENTION_DAYS.operatorLog by the nightly cleanup.
model OperatorLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorLabel String?
  entityType String
  entityId   String
  target     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A platform-wide setting changed from the super admin space, one row per key (#810): the
// « Inscriptions fermées » switch (key "signup", value { closed }).
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}
