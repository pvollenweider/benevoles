.git
.next
node_modules
.env
.env.*
!.env.example
docker-compose*.yml
*.md
# The sources of the public content pages (PUBLIC_PAGES in src/lib/doc-pages.ts) are read at
# build time (next build prerenders /fonctionnalites, /doc/admin) and at runtime:
# each must be listed here, or the *.md rule above breaks the production build (ENOENT).
# Checked by src/lib/__tests__/docker-public-sources.test.ts.
!content/pages/FEATURES.md
!content/pages/LOGICIEL-PLANNING-BENEVOLES.md
!content/pages/POUR-QUI.md
!content/pages/BENEVOLES-FETE-DE-VILLAGE.md
!content/pages/BENEVOLES-FESTIVAL.md
!content/pages/BENEVOLES-MANIFESTATION-SPORTIVE.md
!content/pages/PLANNING-PERMANENCES-BENEVOLES.md
!content/pages/TARIFS.md
!content/pages/TABLEUR-OU-OUTIL-DEDIE.md
# The home's FAQ (#951, LANDING_FAQ_SOURCE in src/lib/landing-seo.ts), read at runtime too.
!content/pages/FAQ-ACCUEIL.md
!content/pages/ACCESSIBILITE.md
!content/legal/ACCORD-SOUS-TRAITANCE.md
!content/legal/SOUS-TRAITANTS.md
!CHANGELOG.md
!content/guide/GUIDE_ADMIN.md
!content/guide/GUIDE_BENEVOLE.md
# The documentation units (#649, src/lib/doc-units.ts), rendered by /doc/<slug>.
!content/guide/*.md
# The blog posts (#944, src/lib/blog.ts), rendered by /blog, /blog/<slug> and /blog/feed.xml.
!content/blog/*.md
# Their last commit dates (scripts/doc-lastmod.mjs, run by deploy.yml before the build): the
# sitemap's lastmod. Not matched by the rules above, re-included in case one ever does.
!doc-lastmod.json
.DS_Store
coverage
# Video sources and renders (#636, #644): the generation tools, their library and any rendered
# output never belong in the app image — only the catalogue, manifests and scripts do, read by
# src/lib/video-catalog.ts at build and at runtime, the same way the guides above are. `*.md`
# above already excludes every .md file including the scripts and the plan: re-included below,
# like content/pages/FEATURES.md. Checked by src/lib/__tests__/video-docker-sources.test.ts.
videos/assets
videos/lib
videos/tools
videos/output
videos/video.env.example
# The video seeds import videos/lib: they run only on the video database, never in the app.
scripts/seed-video-*.ts
!videos/MASTERCLASS_PLAN.md
!videos/scripts/*.md
