# Config pour la stack e2e (docker-compose.e2e.yml).
# `make e2e-setup` copie ce fichier vers `.env.e2e` s'il n'existe pas encore
# (fichier réel gitignoré — voir Makefile / .gitignore).
#
# Ports dédiés (5433/1026/8026) pour ne jamais toucher la DB/mailbox de dev.

DATABASE_URL="postgresql://benevoles:benevoles@localhost:5433/benevoles_e2e"

ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="e2e-admin-password"

# `make e2e-setup` en génère un si absent — 32 caractères minimum.
AUTH_SECRET=""

# Volontairement PAS l'org admin (org-admin@localhost) : les tests vérifient
# que les notifs partent bien vers l'org admin réel, jamais vers ce fallback.
ADMIN_NOTIFICATION_EMAIL="fallback-should-not-receive@localhost"

ORG_ADMIN_EMAIL="org-admin@localhost"
ORG_ADMIN_PASSWORD="e2e-org-admin-password"

SMTP_HOST="localhost"
SMTP_PORT="1026"
SMTP_SECURE="false"
SMTP_USER="dev"
SMTP_PASSWORD="dev"
EMAIL_FROM="Bénévoles e2e <notifications@benevol.app>"

NEXT_PUBLIC_APP_URL="http://localhost:3100"
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"
